"Thirty-six-second Fabia cluster demonstration on physical SocketCAN by default."
analysis PlanarBEVFabiaDrive
  extends RealtimeDrive(duration = 36, can_interface = "can0", window = false)
  model = PlanarBEVFabiaScriptedDrive(m = m, esp_on = esp_on, abs_on = abs_on, mu = mu)
  parameter m::Mass = 1500
end
