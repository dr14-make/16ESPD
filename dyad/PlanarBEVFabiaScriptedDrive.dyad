"Fabia demonstration: acceleration, indicated left lane change, cruise and emergency braking."
component PlanarBEVFabiaScriptedDrive
  parameter m::Mass = 1500
  parameter esp_on::Real = 1
  parameter abs_on::Real = 1
  parameter mu::Real = 1
  parameter tachometer_scale::Real = 0.5
  parameter dimming::Real = 1.0
  structural parameter table::String = "dyad://VehicleSystemsComponents/drivers/fabia_drive.csv"
  driver = VehicleSystemsComponents.Vehicle.Planar.FabiaScriptedDriver(table = table) {^driver}
  vehicle = VehicleSystemsComponents.Vehicle.Planar.FabiaCanVehicle(m = m, esp_on = esp_on, abs_on = abs_on, mu = mu) {^vehicle}
  adapter = VehicleSystemsComponents.Vehicle.Planar.FabiaAdapter() {^adapter}
  cluster = VehicleSystemsComponents.Vehicle.Planar.FabiaClusterNode(tachometer_scale = tachometer_scale, dimming = dimming) {^cluster}
  indicate_start = BlockComponents.Sources.BooleanStep(startTime = 12.0) {^indicate_start}
  indicate_end = BlockComponents.Sources.BooleanStep(startTime = 18.0, startValue = true) {^indicate_end}
  indicate_left = BlockComponents.Logical.And() {^indicate_left}
  off = BlockComponents.Sources.BooleanConstant(k = false) {^off}
relations
  connect(driver.throttle_signal, vehicle.throttle) {^w1}
  connect(driver.brake_signal, vehicle.brake) {^w2}
  connect(driver.steer_signal, vehicle.steer) {^w3}
  connect(adapter.bus, vehicle.bus, cluster.bus) {^w4}
  connect(vehicle.motor_speed, cluster.motor_speed) {^w5}
  connect(indicate_start.y, indicate_left.u1) {^w6}
  connect(indicate_end.y, indicate_left.u2) {^w7}
  connect(indicate_left.y, cluster.left) {^w8}
  connect(off.y, cluster.right) {^w9}
metadata {
