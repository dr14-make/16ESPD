end

"Engine-only full WLTC on the step 1 starter (derived; Lecture5.P2EngineWLTCTransient)."
analysis Step1EngineWLTCTransient
  extends TransientAnalysis(stop = 1800.0, alg = ODEAlg.Rodas5P(), dtmax = 1.0, optimize = OptimizationLevel.None())
  model = Step1EngineWLTC()
end
