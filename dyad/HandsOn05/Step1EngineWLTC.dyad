":{"placement":{"diagram":{"x1":250,"x2":330,"y1":188,"y2":268}}}},"meter":{"Dyad":{"placement":{"diagram":{"x1":700,"y1":114.0,"x2":800,"y2":214.0}}}},"ff_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":175,"y":85}],"E":2}],"renderStyle":"standard"}},"kmh_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":105,"y":320},{"x":105,"y":232.7}],"E":2},{"S":1,"M":[{"x":235,"y":320},{"x":235,"y":244}],"E":3}],"renderStyle":"standard"}},"left_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":555,"y":520.0},{"x":555,"y":785.0}],"E":2}],"renderStyle":"standard"}},"right_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":838,"y":520.0},{"x":838,"y":785.0}],"E":2}],"renderStyle":"standard"}},"chassis_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"vx_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":1015,"y":794.0},{"x":1015,"y":985},{"x":5,"y":985},{"x":5,"y":320}],"E":2},{"S":1,"M":[{"x":1015,"y":794.0},{"x":1015,"y":300},{"x":685,"y":300},{"x":685,"y":194.0}],"E":3}],"renderStyle":"standard"}},"unused_command":{"Dyad":{"placement":{"diagram":{"x1":290,"x2":350,"y1":76,"y2":136}}}},"pedal_command":{"Dyad":{"placement":{"diagram":{"x1":360,"x2":420,"y1":300,"y2":360}}}},"brakes":{"Dyad":{"placement":{"diagram":{"x1":300,"x2":420,"y1":580,"y2":700}}}},"brake_fl_wire":{"Dyad":{"edges":[{"E":2,"M":[{"x":515.0,"y":604.0},{"x":515.0,"y":767.0}],"S":1}],"renderStyle":"standard"}},"brake_fr_wire":{"Dyad":{"edges":[{"E":2,"M":[{"x":605.0,"y":628.0},{"x":605.0,"y":767.0}],"S":1}],"renderStyle":"standard"}},"brake_rl_wire":{"Dyad":{"edges":[{"E":2,"M":[{"x":515.0,"y":652.0},{"x":515.0,"y":857.0}],"S":1}],"renderStyle":"standard"}},"brake_rr_wire":{"Dyad":{"edges":[{"E":2,"M":[{"x":605.0,"y":676.0},{"x":605.0,"y":857.0}],"S":1}],"renderStyle":"standard"}},"stored_power":{"Dyad":{"placement":{"diagram":{"x1":700,"x2":780,"y1":240,"y2":300}}}},"engagement_command":{"Dyad":{"placement":{"diagram":{"x1":460,"x2":540,"y1":320,"y2":380}}}},"stored_voltage_wire":{"Dyad":{"edges":[{"E":2,"M":[{"x":678.0,"y":240.0}