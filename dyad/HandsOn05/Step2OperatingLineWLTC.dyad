"""
Hands-on 05 step 2 starter: the operating-line fixture without its line, with the powertrain still
pedal-commanded. Placing LineSpeedCommand as `speed_command`, wiring its pedal and speed ports
and the zero command to the ignored inputs, and setting `speed_commanded = true`
completes it to Lecture5.P2OperatingLineWLTC.
"""
test component Step2OperatingLineWLTC
  "Vehicle and road-load mass (assumed; shared planar benchmark)"
  parameter m::Mass = 1500.0
  "Wheel radius (derived; planar benchmark)"
  parameter radius::Length = 0.31
  "PI gain [N.m per km/h], shared with H0"
  parameter k::Real = 110.0
  "PI integral time (assumed; shared Lecture 5 driver)"
  parameter Ti::Time = 1.0
  "Positive PI ceiling [N.m], pedal saturation"
  parameter tau_max::Torque = 150.0
  "Initial wheel surface speed offset (assumed; MultibodyComponents #185)"
  parameter dv_wheel::Velocity = 0.01
  "Center of K0 launch engagement [rpm] (assumed; CentrifugalClutch)"
  parameter engage_rpm::Real = 1300.0
  "Width of K0 launch engagement [rpm] (assumed; CentrifugalClutch)"
  parameter engage_width_rpm::Real(min = eps(Float64)) = 120.0
  "Negative PI limit [N.m], independent of propulsion saturation"
  parameter tau_brake::Torque = 205.0
  "Total wheel brake torque per negative driver N.m, launch ratio reference"
  parameter brake_gain::Real = 12.0
  "Center of machine-side K0 lock-up ramp [rpm]; open at 800 rpm idle, closed by 880 rpm"
  parameter lock_rpm::Real = 840.0
  "Width of machine-side K0 lock-up ramp [rpm]"
  parameter lock_width_rpm::Real(min = eps(Float64)) = 12.0
  trace = VehicleSystemsComponents.Vehicle.DriveCycle() {^trace}
  driver = BlockComponents.Continuous.LimPID(with_D = false, k = k, Ti = Ti, y_max = tau_max, y_min = -tau_brake) {^driver}
  no_ff = BlockComponents.Sources.Constant(k = 0.0) {^no_ff}
  kmh = VehicleSystemsComponents.Vehicle.ToKmPerHour() {^kmh}
  powertrain = VehicleSystemsComponents.Vehicle.P2Powertrain(speed_commanded = false, position_start = 0.0, drive(P_aux = 0.0, T_f = 0.0, K_i = 0.0, k_w = 0.0, C = 0.0, J = 0.0)) {^powertrain}
  differential = MultibodyComponents.PlanarMechanics.DifferentialGear() {^differential}
  mount = RotationalComponents.Components.Fixed() {^mount}
  straight = RotationalComponents.Components.Fixed() {^straight}
  flat = BlockComponents.Sources.Constant(k = 0.0) {^flat}
  car = VehicleSystemsComponents.Vehicle.Planar.PlanarCar(m = m, radius = radius) {^car}
  motion = VehicleSystemsComponents.Vehicle.Planar.BusMotion() {^motion}
  roadload = VehicleSystemsComponents.Vehicle.Planar.PlanarRoadLoad(m = m) {^roadload}
  meter = VehicleSystemsComponents.Vehicle.SoCCorrectedFuel() {^meter}
  "Zero for unused command inputs (assumed; fixed-mode fixture)"
  unused_command = BlockComponents.Sources.Constant(k = 0.0) {^unused_command}
  brakes = VehicleSystemsComponents.Vehicle.BrakeSplit(gain = brake_gain, signed_driver = true) {^brakes}
  pedal_command = VehicleSystemsComponents.Vehicle.ParameterGate() {^pedal_command}
relations
  connect(car.bus, motion.bus) {^bus_wire}
  connect(trace.y, driver.u_s) {^trace_wire}
  connect(motion.vx, kmh.u, meter.speed) {^vx_wire}
  connect(kmh.y, driver.u_m) {^kmh_wire}
  connect(no_ff.y, driver.u_ff) {^ff_wire}
  connect(powertrain.spline, differential.flange_b) {^spline_wire}
  connect(differential.flange_left, car.spin_fl) {^left_wire}
  connect(differential.flange_right, car.spin_fr) {^right_wire}
  connect(powertrain.support, mount.spline) {^mount_wire}
  connect(car.steering, straight.spline) {^steering_wire}
  connect(flat.y, roadload.grade) {^grade_wire}
  connect(car.chassis, roadload.chassis) {^chassis_wire}
  connect(powertrain.mdot_fuel, meter.mdot_fuel) {^fuel_wire}
  meter.P_stored = powertrain.E * powertrain.i
  pedal_command.u = min(max(driver.y / tau_max, 0.0), 1.0)
  connect(pedal_command.y, powertrain.engine_pedal) {^pedal_command_wire}
  powertrain.engage = max(0.5 * (1 + tanh((powertrain.engine_speed * 30 / pi - engage_rpm) / engage_width_rpm)), 0.5 * (1 + tanh((powertrain.variator.w_a * 30 / pi - lock_rpm) / lock_width_rpm)))
  powertrain.tau_ref = 0.0
  connect(driver.y, brakes.u) {^brake_demand_wire}
  connect(brakes.tau_fl, car.tau_fl) {^brake_fl_wire}
  connect(brakes.tau_fr, car.tau_fr) {^brake_fr_wire}
  connect(brakes.tau_rl, car.tau_rl) {^brake_rl_wire}
  connect(brakes.tau_rr, car.tau_rr) {^brake_rr_wire}
  initial car.body.r = [0, 0]
  initial car.body.v = [0, 0]
  initial car.body.phi = 0.0
  initial car.body.w = 0.0
  initial car.fl.inertia.w = dv_wheel / radius
  initial car.fr.inertia.w = dv_wheel / radius
  initial car.rl.inertia.w = dv_wheel / radius
  initial car.rr.inertia.w = dv_wheel / radius
  initial car.fl.inertia.phi = 0.0
  initial car.fr.inertia.phi = 0.0
  initial car.rl.inertia.phi = 0.0
  initial car.rr.inertia.phi = 0.0
  initial car.fl.brake.tau_actual = 0.0
  initial car.fr.brake.tau_actual = 0.0
  initial car.rl.brake.tau_actual = 0.0
  initial car.rr.brake.tau_actual = 0.0
  initial powertrain.drive.converter.i_out = 0.0
metadata {"_links":{"trace":{"Dyad":{"placement":{"diagram":{"x1":20,"y1":140,"x2":90,"y2":210}}}},"driver":{"Dyad":{"placement":{"diagram":{"x1":150,"y1":150.7,"x2":240,"y2":240.7}}}},"no_ff":{"Dyad":{"placement":{"diagram":{"x1":120,"y1":30,"x2":180,"y2":90}}}},"kmh":{"Dyad":{"placement":{"diagram":{"x1":30,"y1":280,"x2":100,"y2":350}}}},"powertrain":{"Dyad":{"placement":{"diagram":{"x1":460,"y1":80,"x2":660,"y2":280}}}},"differential":{"Dyad":{"placement":{"diagram":{"x1":580,"y1":640,"x2":820,"y2":400}}}},"mount":{"Dyad":{"placement":{"diagram":{"x1":420,"y1":320,"x2":470,"y2":370}}}},"straight":{"Dyad":{"placement":{"diagram":{"x1":675,"y1":660,"x2":725,"y2":710,"rot":180}}}},"flat":{"Dyad":{"placement":{"diagram":{"x1":400,"y1":900.0,"x2":440,"y2":940.0}}}},"car":{"Dyad":{"placement":{"diagram":{"x1":610,"y1":740,"x2":790,"y2":920}}}},"motion":{"Dyad":{"placement":{"diagram":{"x1":850,"y1":755.0,"x2":1000,"y2":905.0}}}},"roadload":{"Dyad":{"placement":{"diagram":{"x1":480,"y1":885.0,"x2":550,"y2":955.0}}}},"meter":{"Dyad":{"placement":{"diagram":{"x1":700,"y1":114.0,"x2":800,"y2":214.0}}}},"ff_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":195.0,"y":60.0}],"E":2}],"renderStyle":"standard"}},"kmh_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":125,"y":315.0},{"x":125,"y":216.4}],"E":2}],"renderStyle":"standard"}},"mount_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":445.0,"y":280.0}],"E":2}],"renderStyle":"standard"}},"spline_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":840,"y":106.0},{"x":840,"y":388.0}],"E":2}],"renderStyle":"standard"}},"left_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":555,"y":520.0},{"x":555,"y":785.0}],"E":2}],"renderStyle":"standard"}},"right_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":838,"y":520.0},{"x":838,"y":785.0}],"E":2}],"renderStyle":"standard"}},"chassis_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"fuel_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"vx_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":1015,"y":794.0},{"x":1015,"y":985},{"x":12,"y":985},{"x":12,"y":315.0}],"E":2},{"S":1,"M":[{"x":1015,"y":794.0},{"x":1015,"y":300},{"x":685,"y":300},{"x":685,"y":194.0}],"E":3}],"renderStyle":"standard"}},"unused_command":{"Dyad":{"placement":{"diagram":{"x1":300,"x2":360,"y1":76,"y2":136}}}},"brakes":{"Dyad":{"placement":{"diagram":{"x1":300,"x2":420,"y1":580,"y2":700}}}},"brake_fl_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":515.0,"y":604.0},{"x":515.0,"y":767.0}],"E":2}],"renderStyle":"standard"}},"brake_fr_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":545,"y":628.0},{"x":545,"y":720},{"x":810.0,"y":720},{"x":810.0,"y":767.0}],"E":2}],"renderStyle":"standard"}},"brake_rl_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":515.0,"y":652.0},{"x":515.0,"y":857.0}],"E":2}],"renderStyle":"standard"}},"brake_rr_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":535,"y":676.0},{"x":535,"y":720},{"x":825.0,"y":720},{"x":825.0,"y":857.0}],"E":2}],"renderStyle":"standard"}},"brake_demand_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":270.0,"y":195.7},{"x":270.0,"y":640.0}],"E":2}],"renderStyle":"standard"}},"pedal_command":{"Dyad":{"placement":{"diagram":{"x1":270,"x2":330,"y1":340,"y2":400}}}},"pedal_command_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":395.0,"y":370.0},{"x":395.0,"y":165.6}],"E":2}],"renderStyle":"standard"}},"bus_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"trace_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":117.75,"y":175.0}],"E":2}],"renderStyle":"standard"}},"steering_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"grade_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}}}}
end

"Full WLTC on the step 2 starter (derived; Lecture5.P2OperatingLineWLTCTransient)."
analysis Step2OperatingLineWLTCTransient
  extends TransientAnalysis(stop = 1800.0, alg = ODEAlg.Rodas5P(), dtmax = 1.0, optimize = OptimizationLevel.None())
  model = Step2OperatingLineWLTC()
end
