":680,"y2":720},"icon":{"x1":960,"x2":1040,"y1":660,"y2":740}}}},"spline":{"Dyad":{"placement":{"diagram":{"x1":980,"x2":1020,"y1":110,"y2":150},"icon":{"x1":960,"x2":1040,"y1":90,"y2":170}}}},"support":{"Dyad":{"placement":{"diagram":{"x1":480,"x2":520,"y1":980,"y2":1020},"icon":{"x1":460,"x2":540,"y1":960,"y2":1040}}}},"tau_ref":{"Dyad":{"placement":{"diagram":{"x1":-20,"x2":20,"y1":640,"y2":680},"icon":{"x1":-40,"x2":40,"y1":620,"y2":700}}}},"variator":{"Dyad":{"placement":{"diagram":{"x1":790,"y1":440,"x2":910,"y2":560}}}},"speed_variator":{"Dyad":{"placement":{"diagram":{"x1":790,"y1":650,"x2":910,"y2":770}}}},"engine_torque_ref":{"Dyad":{"placement":{"diagram":{"x1":-20,"x2":20,"y1":110,"y2":150},"icon":{"x1":-40,"x2":40,"y1":90,"y2":170}}}},"engine_on":{"Dyad":{"placement":{"diagram":{"x1":-20,"x2":20,"y1":518,"y2":558},"icon":{"x1":-40,"x2":40,"y1":498,"y2":578}}}},"available_torque":{"Dyad":{"placement":{"diagram":{"x1":980,"x2":1020,"y1":460,"y2":500},"icon":{"x1":960,"x2":1040,"y1":440,"y2":520}}}},"engage_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":490.0,"y":220}],"E":2}],"renderStyle":"standard"}},"support_bus":{"Dyad":{"edges":[{"S":1,"M":[{"x":85,"y":512.0},{"x":85,"y":610},{"x":500,"y":610}],"E":4},{"S":2,"M":[{"x":580,"y":560.0},{"x":580,"y":610},{"x":500,"y":610}],"E":4},{"S":3,"M":[{"x":760,"y":560.0},{"x":760,"y":610},{"x":500,"y":610}],"E":4}],"renderStyle":"standard"}},"torque_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":250,"y":416.0},{"x":250,"y":200}],"E":2}],"renderStyle":"standard"}},"fuel_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":265,"y":440.0},{"x":265,"y":270}],"E":2}],"renderStyle":"standard"}},"soc_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":670.0,"y":410}],"E":2}],"renderStyle":"standard"}}}}
end
