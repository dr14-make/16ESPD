cement":{"diagram":{"x1":980,"x2":1020,"y1":480,"y2":520},"icon":{"x1":960,"x2":1040,"y1":460,"y2":540}}}},"support":{"Dyad":{"placement":{"diagram":{"x1":500,"x2":540,"y1":895,"y2":935},"icon":{"x1":450,"x2":550,"y1":950,"y2":1050}}}},"tau_ref":{"Dyad":{"placement":{"diagram":{"x1":-20,"x2":20,"y1":610,"y2":650},"icon":{"x1":-40,"x2":40,"y1":590,"y2":670}}}},"variator":{"Dyad":{"placement":{"diagram":{"x1":630,"x2":730,"y1":450,"y2":550}}}},"speed_variator":{"Dyad":{"placement":{"diagram":{"x1":630,"x2":730,"y1":620,"y2":720}}}},"engine_torque_ref":{"Dyad":{"placement":{"diagram":{"x1":-20,"x2":20,"y1":350,"y2":390},"icon":{"x1":-40,"x2":40,"y1":330,"y2":410}}}},"engine_on":{"Dyad":{"placement":{"diagram":{"x1":-20,"x2":20,"y1":480,"y2":520},"icon":{"x1":-40,"x2":40,"y1":460,"y2":540}}}},"available_torque":{"Dyad":{"placement":{"diagram":{"x1":980,"x2":1020,"y1":255,"y2":295},"icon":{"x1":960,"x2":1040,"y1":235,"y2":315}}}}}}
end
