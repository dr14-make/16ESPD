"x1":970.0,"x2":1030.0,"y1":170.0,"y2":230.0}}}},"hold":{"Dyad":{"placement":{"diagram":{"x1":260,"x2":320,"y1":500,"y2":560}}}},"i":{"Dyad":{"placement":{"diagram":{"x1":980,"x2":1020,"y1":850,"y2":890},"icon":{"x1":960,"x2":1040,"y1":860,"y2":940}}}},"k0":{"Dyad":{"placement":{"diagram":{"x1":430,"x2":550,"y1":440,"y2":560}}}},"machine_torque":{"Dyad":{"placement":{"diagram":{"x1":980,"x2":1020,"y1":700,"y2":740},"icon":{"x1":960,"x2":1040,"y1":560,"y2":640}}}},"mdot_fuel":{"Dyad":{"placement":{"diagram":{"x1":980,"x2":1020,"y1":325,"y2":365},"icon":{"x1":970.0,"x2":1030.0,"y1":240.0,"y2":300.0}}}},"position":{"Dyad":{"placement":{"diagram":{"x1":980,"x2":1020,"y1":395,"y2":435},"icon":{"x1":960,"x2":1040,"y1":660,"y2":740}}}},"spline":{"Dyad":{"placement":{"diagram":{"x1":980,"x2":1020,"y1":480,"y2":520},"icon":{"x1":970.0,"x2":1030.0,"y1":100.0,"y2":160.0}}}},"support":{"Dyad":{"placement":{"diagram":{"x1":480,"x2":520,"y1":980,"y2":1020},"icon":{"x1":460,"x2":540,"y1":960,"y2":1040}}}},"tau_ref":{"Dyad":{"placement":{"diagram":{"x1":-20,"x2":20,"y1":728,"y2":768},"icon":{"x1":-40,"x2":40,"y1":620,"y2":700}}}},"variator":{"Dyad":{"placement":{"diagram":{"x1":790,"x2":910,"y1":440,"y2":560}}}},"engine_torque_ref":{"Dyad":{"placement":{"diagram":{"x1":-20,"x2":20,"y1":640,"y2":680},"icon":{"x1":-40,"x2":40,"y1":90,"y2":170}}}},"engine_on":{"Dyad":{"placement":{"diagram":{"x1":-20,"x2":20,"y1":830,"y2":870},"icon":{"x1":-40,"x2":40,"y1":498,"y2":578}}}},"available_torque":{"Dyad":{"placement":{"diagram":{"x1":980,"x2":1020,"y1":185,"y2":225},"icon":{"x1":970.0,"x2":1030.0,"y1":450.0,"y2":510.0}}}},"engage_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":490,"y":320}],"E":2}],"renderStyle":"standard"}},"support_bus":{"Dyad":{"edges":[{"S":1,"M":[{"x":85,"y":512},{"x":85,"y":960},{"x":500,"y":960}],"E":4},{"S":2,"M":[{"x":420,"y":560},{"x":420,"y":600},{"x":85,"y":600},{"x":85,"y":960},{"x":500,"y":960}],"E":4},{"S":3,"M":[{"x":600,"y":780},{"x":600,"y":960},{"x":500,"y":960