test component TestRoadLoad
  "Holds the flange at a fixed speed, overridden per case"
  speed = TranslationalComponents.Sources.ConstantVelocity(v_fixed = 30.0)
  "A 10 % climb"
  grade = BlockComponents.Sources.Constant(k = 0.1)
  roadload = VehicleSystemsComponents.Vehicle.RoadLoad()
  fixed = TranslationalComponents.Components.Fixed()
relations
  connect(speed.flange, roadload.flange)
  connect(speed.support, fixed.flange)
  connect(grade.y, roadload.grade)
  initial speed.s = 0.0
metadata {
  "Dyad": {
    "tests": {
      "forward_climb": {
        "stop": 1,
        "params": {"speed.v_fixed": 30.0},
        "atol": {
          "roadload.flange.f": 0.001,
          "roadload.drag.f": 0.001,
          "roadload.rolling.f": 0.001,
          "roadload.gradeforce.f": 0.001
        },
        "expect": {
          "initial": {"roadload.flange.f": 1870.2514931432536},
          "final": {
            "roadload.flange.f": 1870.2514931432536,
            "roadload.drag.f": 340.2,
            "roadload.rolling.f": 163.93408855106287,
            "roadload.gradeforce.f": 1366.1174045921907
          }
        }
      },
      "reverse_climb": {
        "stop": 1,
        "params": {"speed.v_fixed": -30.0},
        "atol": {
          "roadload.flange.f": 0.001,
          "roadload.drag.f": 0.001,
          "roadload.rolling.f": 0.001,
          "roadload.gradeforce.f": 0.001
        },
        "expect": {
          "initial": {"roadload.flange.f": 861.9833160411279},
          "final": {
            "roadload.flange.f": 861.9833160411279,
            "roadload.drag.f": -340.2,
            "roadload.rolling.f": -163.93408855106287,
            "roadload.gradeforce.f": 1366.1174045921907
          }
        }
      }
    }
  }
}
end