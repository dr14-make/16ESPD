"""
Single-wheel-equivalent straight-line ABS braking test.

The vehicle begins in pure rolling at `v0`. A brake-demand step passes through the slip controller
when `abs_enabled` is one, or directly to the wheel's brake when it is zero.

The whole vehicle is lumped onto one equivalent `BrakedWheel`: `F_z` is the full vehicle weight
and `J_w` is the four road wheels together, so `brake_demand` is the total of all four brakes.
This is what makes the deceleration representative of a real stop.

Load transfer is not modelled, so `F_z` is static. A real stop moves load forward and the axles
reach their friction limits at different times; this lumped model reports the average.
"""
component ABSBrakeTest
  "Initial vehicle speed"
  parameter v0::Velocity = 25.0
  "Driver brake demand, total across all four brakes"
  parameter brake_demand::Torque = 6000.0
  "Brake application time"
  parameter brake_time::Time = 0.5
  "One enables ABS; zero bypasses modulation"
  parameter abs_enabled::Real = 1.0
  "Road-friction multiplier"
  parameter road_mu::Real = 1.0
  "Vehicle mass"
  parameter m::Dyad.Mass = 1400.0
  "Wheel radius"
  parameter radius::Length = 0.31
  "Lumped inertia of the four road wheels"
  parameter J_w::MomentOfInertia = 4.0
  "Brake regularisation speed; 0.2 rad/s holds the locked wheel to under 0.1 m/s of surface creep"
  parameter w0::AngularVelocity = 0.2
  "Wheel-speed differentiator filter time constant"
  parameter T_meas::Time = 0.005
  "Maximum fall rate of the wheel-only vehicle-speed estimate"
  parameter a_ref::Acceleration = 10.0
  "ABS pressure increase rate after its first release cycle"
  parameter k_inc_slow::Real = 8000.0
  "Initial wheel angular speed; set to zero for the locked-wheel recovery test"
  parameter wheel_w0::AngularVelocity = v0 / radius
  demand = BlockComponents.Sources.Step(height = brake_demand, offset = 0.0, start_time = brake_time)
  road = BlockComponents.Sources.Constant(k = road_mu)
  flat = BlockComponents.Sources.Constant(k = 0.0)
  controller = VehicleSystemsComponents.Vehicle.ABSControllerWheelOnly(radius = radius,
    a_ref = a_ref, T_filter = T_meas, omega0 = wheel_w0, v_ref0 = v0,
    k_inc_slow = k_inc_slow)
  "Ideal wheel-speed sensor mounted on the wheel spline"
  wsensor = RotationalComponents.Sensors.VelocitySensor()
  wheel = VehicleSystemsComponents.Vehicle.Wheel.BrakedWheel(radius = radius, J_w = J_w,
    F_z = m * 9.80665, tau_max = brake_demand, w0 = w0)
  body = VehicleSystemsComponents.Vehicle.VehicleBody(m = m)
  fixed = RotationalComponents.Components.Fixed()
relations
  connect(demand.y, controller.demand)
  connect(wsensor.spline, wheel.spline)
  connect(wsensor.w, controller.omega)
  wheel.tau_cmd = demand.y * (1.0 - abs_enabled) + controller.tau_cmd * abs_enabled
  # wheel.spline is the free inboard end where a driveline would attach.
  connect(wheel.support, fixed.spline)
  connect(wheel.flange, body.flange)
  connect(road.y, wheel.mu_scale)
  connect(flat.y, body.grade)
  initial wheel.brake.tau_actual = 0.0
  initial wheel.inertia.phi = 0.0
  initial wheel.inertia.w = wheel_w0
  initial body.mass.s = 0.0
  initial body.mass.v = v0
end

analysis ABSBrakeTransient
  extends TransientAnalysis(stop = 6.0)
  parameter road_mu::Real = 1.0
  parameter a_ref::Acceleration = 10.0
  parameter k_inc_slow::Real = 8000.0
  model = ABSBrakeTest(road_mu = road_mu, abs_enabled = 1.0, a_ref = a_ref,
    k_inc_slow = k_inc_slow)
relations
end

analysis LockedBrakeTransient
  extends TransientAnalysis(stop = 6.0)
  parameter road_mu::Real = 1.0
  model = ABSBrakeTest(road_mu = road_mu, abs_enabled = 0.0)
relations
end


analysis ABSLockedWheelRecoveryTransient
  extends TransientAnalysis(stop = 0.5)
  model = ABSBrakeTest(brake_time = 0.0, abs_enabled = 1.0, wheel_w0 = 0.0)
relations
end
