"Ideal continuous benchmark using true slip and vehicle speed."
component ABSIdealBrakeTest
  parameter v0::Velocity = 25.0
  parameter brake_demand::Torque = 6000.0
  parameter brake_time::Time = 0.5
  parameter road_mu::Real = 1.0
  parameter m::Dyad.Mass = 1400.0
  parameter radius::Length = 0.31
  parameter J_w::MomentOfInertia = 4.0
  parameter w0::AngularVelocity = 0.2
  demand = BlockComponents.Sources.Step(height = brake_demand, offset = 0.0, start_time = brake_time)
  road = BlockComponents.Sources.Constant(k = road_mu)
  flat = BlockComponents.Sources.Constant(k = 0.0)
  controller = VehicleSystemsComponents.Vehicle.ABSIdealController()
  wheel = VehicleSystemsComponents.Vehicle.Wheel.BrakedWheel(radius = radius, J_w = J_w,
    F_z = m * 9.80665, tau_max = brake_demand, w0 = w0)
  body = VehicleSystemsComponents.Vehicle.VehicleBody(m = m)
  fixed = RotationalComponents.Components.Fixed()
relations
  connect(demand.y, controller.demand)
  connect(wheel.kappa, controller.kappa)
  controller.v = body.mass.v
  connect(controller.tau_cmd, wheel.tau_cmd)
  connect(wheel.support, fixed.spline)
  connect(wheel.flange, body.flange)
  connect(road.y, wheel.mu_scale)
  connect(flat.y, body.grade)
  initial wheel.brake.tau_actual = 0.0
  initial wheel.inertia.phi = 0.0
  initial wheel.inertia.w = v0 / radius
  initial body.mass.s = 0.0
  initial body.mass.v = v0
end

"Ideal-sensing sampled pressure-memory ABS harness."
component ABSIdealModulatorBrakeTest
  parameter v0::Velocity = 25.0
  parameter brake_demand::Torque = 6000.0
  parameter brake_time::Time = 0.5
  parameter road_mu::Real = 1.0
  parameter m::Dyad.Mass = 1400.0
  parameter radius::Length = 0.31
  parameter J_w::MomentOfInertia = 4.0
  parameter w0::AngularVelocity = 0.2
  parameter dt::Time = 0.005
  parameter alpha_rel::Real = 0.6
  parameter beta_reapply::Real = 0.85
  parameter T_p::Time = 0.03
  parameter k_inc_slow::Real = 8000.0
  demand = BlockComponents.Sources.Step(height = brake_demand, offset = 0.0, start_time = brake_time)
  road = BlockComponents.Sources.Constant(k = road_mu)
  flat = BlockComponents.Sources.Constant(k = 0.0)
  clock = DiscreteComponents.PeriodicClock(dt = 0.005)
  slip_sampler = DiscreteComponents.Sampler()
  speed_sampler = DiscreteComponents.Sampler()
  demand_sampler = DiscreteComponents.Sampler()
  controller = VehicleSystemsComponents.Vehicle.ABSModulatorDiscrete(dt = dt,
    alpha_rel = alpha_rel, beta_reapply = beta_reapply, T_p = T_p,
    k_inc_slow = k_inc_slow)
  hold = DiscreteComponents.ZeroOrderHold()
  wheel = VehicleSystemsComponents.Vehicle.Wheel.BrakedWheel(radius = radius, J_w = J_w,
    F_z = m * 9.80665, tau_max = brake_demand, w0 = w0)
  body = VehicleSystemsComponents.Vehicle.VehicleBody(m = m)
  fixed = RotationalComponents.Components.Fixed()
relations
  connect(wheel.kappa, slip_sampler.u)
  speed_sampler.u = body.mass.v
  connect(demand.y, demand_sampler.u)
  connect(slip_sampler.y, controller.lambda, clock.y)
  connect(speed_sampler.y, controller.v_ref)
  connect(demand_sampler.y, controller.demand)
  connect(controller.tau_cmd, hold.u)
  connect(hold.y, wheel.tau_cmd)
  connect(wheel.support, fixed.spline)
  connect(wheel.flange, body.flange)
  connect(road.y, wheel.mu_scale)
  connect(flat.y, body.grade)
  initial wheel.brake.tau_actual = 0.0
  initial wheel.inertia.phi = 0.0
  initial wheel.inertia.w = v0 / radius
  initial body.mass.s = 0.0
  initial body.mass.v = v0
end

"Wheel-speed-only sampled ABS braking harness."
component ABSBrakeTest
  parameter v0::Velocity = 25.0
  parameter brake_demand::Torque = 6000.0
  parameter brake_time::Time = 0.5
  parameter road_mu::Real = 1.0
  parameter m::Dyad.Mass = 1400.0
  parameter radius::Length = 0.31
  parameter J_w::MomentOfInertia = 4.0
  parameter w0::AngularVelocity = 0.2
  parameter dt::Time = 0.005
  parameter a_ref::Acceleration = 8.0
  parameter k_inc_slow::Real = 8000.0
  parameter wheel_w0::AngularVelocity = v0 / radius
  demand = BlockComponents.Sources.Step(height = brake_demand, offset = 0.0, start_time = brake_time)
  road = BlockComponents.Sources.Constant(k = road_mu)
  flat = BlockComponents.Sources.Constant(k = 0.0)
  clock = DiscreteComponents.PeriodicClock(dt = 0.005)
  speed_sampler = DiscreteComponents.Sampler()
  demand_sampler = DiscreteComponents.Sampler()
  controller = VehicleSystemsComponents.Vehicle.ABSControllerWheelOnly(dt = dt, radius = radius,
    a_ref = a_ref, omega0 = wheel_w0, v_ref0 = v0, k_inc_slow = k_inc_slow)
  hold = DiscreteComponents.ZeroOrderHold()
  wsensor = RotationalComponents.Sensors.VelocitySensor()
  wheel = VehicleSystemsComponents.Vehicle.Wheel.BrakedWheel(radius = radius, J_w = J_w,
    F_z = m * 9.80665, tau_max = brake_demand, w0 = w0)
  body = VehicleSystemsComponents.Vehicle.VehicleBody(m = m)
  fixed = RotationalComponents.Components.Fixed()
relations
  connect(wsensor.spline, wheel.spline)
  connect(wsensor.w, speed_sampler.u)
  connect(demand.y, demand_sampler.u)
  connect(speed_sampler.y, controller.omega, clock.y)
  connect(demand_sampler.y, controller.demand)
  connect(controller.tau_cmd, hold.u)
  connect(hold.y, wheel.tau_cmd)
  connect(wheel.support, fixed.spline)
  connect(wheel.flange, body.flange)
  connect(road.y, wheel.mu_scale)
  connect(flat.y, body.grade)
  initial wheel.brake.tau_actual = 0.0
  initial wheel.inertia.phi = 0.0
  initial wheel.inertia.w = wheel_w0
  initial body.mass.s = 0.0
  initial body.mass.v = v0
end

"Locked-wheel baseline with unmodulated driver demand."
component LockedBrakeTest
  parameter v0::Velocity = 25.0
  parameter brake_demand::Torque = 6000.0
  parameter brake_time::Time = 0.5
  parameter road_mu::Real = 1.0
  parameter m::Dyad.Mass = 1400.0
  parameter radius::Length = 0.31
  parameter J_w::MomentOfInertia = 4.0
  parameter w0::AngularVelocity = 0.2
  demand = BlockComponents.Sources.Step(height = brake_demand, offset = 0.0, start_time = brake_time)
  road = BlockComponents.Sources.Constant(k = road_mu)
  flat = BlockComponents.Sources.Constant(k = 0.0)
  wheel = VehicleSystemsComponents.Vehicle.Wheel.BrakedWheel(radius = radius, J_w = J_w,
    F_z = m * 9.80665, tau_max = brake_demand, w0 = w0)
  body = VehicleSystemsComponents.Vehicle.VehicleBody(m = m)
  fixed = RotationalComponents.Components.Fixed()
relations
  connect(demand.y, wheel.tau_cmd)
  connect(wheel.support, fixed.spline)
  connect(wheel.flange, body.flange)
  connect(road.y, wheel.mu_scale)
  connect(flat.y, body.grade)
  initial wheel.brake.tau_actual = 0.0
  initial wheel.inertia.phi = 0.0
  initial wheel.inertia.w = v0 / radius
  initial body.mass.s = 0.0
  initial body.mass.v = v0
end

analysis IdealModulatorBrakeTransient
  extends TransientAnalysis(stop = 6.0)
  parameter road_mu::Real = 1.0
  model = ABSIdealModulatorBrakeTest(road_mu = road_mu)
relations
end

analysis IdealBrakeTransient
  extends TransientAnalysis(stop = 6.0)
  parameter road_mu::Real = 1.0
  parameter brake_demand::Torque = 6000.0
  model = ABSIdealBrakeTest(road_mu = road_mu, brake_demand = brake_demand)
relations
end

analysis ABSBrakeTransient
  extends TransientAnalysis(stop = 6.0)
  parameter road_mu::Real = 1.0
  parameter brake_demand::Torque = 6000.0
  parameter a_ref::Acceleration = 8.0
  parameter k_inc_slow::Real = 8000.0
  model = ABSBrakeTest(road_mu = road_mu, brake_demand = brake_demand, a_ref = a_ref,
    k_inc_slow = k_inc_slow)
relations
end

analysis LockedBrakeTransient
  extends TransientAnalysis(stop = 6.0)
  parameter road_mu::Real = 1.0
  model = LockedBrakeTest(road_mu = road_mu)
relations
end

analysis ABSLockedWheelRecoveryTransient
  extends TransientAnalysis(stop = 0.5)
  model = ABSBrakeTest(brake_time = 0.0, wheel_w0 = 0.0)
relations
end
