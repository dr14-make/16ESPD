"""
Single-wheel-equivalent straight-line ABS braking test.

The vehicle begins in pure rolling at `v0`. A brake-demand step passes through the slip controller
when `abs_enabled` is one, or directly to the hydraulic actuator when it is zero.

The whole vehicle is lumped onto one equivalent wheel: `F_z` is the full vehicle weight and `J_w`
is the four road wheels together, so `brake_demand` is the total of all four brakes. This is what
makes the deceleration representative of a real stop. Loading the equivalent wheel with only half
the weight, as a single-axle reading would, halves the friction ceiling and roughly doubles the
stopping distance, because the whole vehicle mass is still being retarded. `SlipWheel1D` keeps a
half-weight default because its own traction test models one driven axle; braking uses all four.

Load transfer is not modelled, so `F_z` is static. A real stop moves load forward and the axles
reach their friction limits at different times; this lumped model reports the average.
"""
component ABSBrakeTest
  "Initial vehicle speed"
  parameter v0::Velocity = 25.0
  "Driver brake demand, total across all four brakes"
  parameter brake_demand::Torque = 6000.0
  "Brake application time"
  parameter brake_time::Time = 0.5
  "One enables ABS; zero bypasses modulation"
  parameter abs_enabled::Real = 1.0
  "Road-friction multiplier"
  parameter road_mu::Real = 1.0
  "Vehicle mass"
  parameter m::Dyad.Mass = 1400.0
  "Wheel radius"
  parameter radius::Length = 0.31
  "Lumped inertia of the four road wheels"
  parameter J_w::MomentOfInertia = 4.0
  "Brake regularisation speed; 0.2 rad/s holds the locked wheel to under 0.1 m/s of surface creep"
  parameter w0::AngularVelocity = 0.2
  "Wheel-speed sensing and slip-estimation lag"
  parameter T_meas::Time = 0.005
  demand = BlockComponents.Sources.Step(height = brake_demand, offset = 0.0, start_time = brake_time)
  road = BlockComponents.Sources.Constant(k = road_mu)
  flat = BlockComponents.Sources.Constant(k = 0.0)
  controller = VehicleSystemsComponents.Vehicle.ABSController()
  "Slip reaches the controller through a sensing lag rather than instantaneously"
  slipfilter = BlockComponents.Continuous.FirstOrder(T = T_meas)
  "Vehicle reference speed for the controller's low-speed dropout"
  vsensor = TranslationalComponents.Sensors.VelocitySensor()
  brake = VehicleSystemsComponents.Vehicle.BrakeActuator(tau_max = brake_demand, w0 = w0)
  wheel_inertia = RotationalComponents.Components.Inertia(J = J_w)
  wheel = VehicleSystemsComponents.Vehicle.SlipWheel1D(radius = radius, F_z = m * 9.80665)
  body = VehicleSystemsComponents.Vehicle.VehicleBody(m = m)
  fixed = RotationalComponents.Components.Fixed()
relations
  connect(demand.y, controller.demand)
  slipfilter.u = wheel.kappa
  connect(slipfilter.y, controller.kappa)
  connect(vsensor.flange, body.flange)
  connect(vsensor.v, controller.v_ref)
  brake.tau_cmd = demand.y * (1.0 - abs_enabled) + controller.tau_cmd * abs_enabled
  # The brake sits in-line between the wheel inertia and the tire, so brake.spline_b.tau is the
  # torque delivered to the contact patch. wheel_inertia.spline_a is the free inboard end where a
  # driveline would attach.
  connect(wheel_inertia.spline_b, brake.spline_a)
  connect(brake.spline_b, wheel.spline)
  connect(brake.support, fixed.spline)
  connect(wheel.flange, body.flange)
  connect(road.y, wheel.mu_scale)
  connect(flat.y, body.grade)
  initial brake.tau_actual = 0.0
  initial slipfilter.x = 0.0
  initial wheel_inertia.phi = 0.0
  initial wheel_inertia.w = v0 / radius
  initial body.mass.s = 0.0
  initial body.mass.v = v0
end

analysis ABSBrakeTransient
  extends TransientAnalysis(stop = 6.0)
  parameter road_mu::Real = 1.0
  model = ABSBrakeTest(road_mu = road_mu, abs_enabled = 1.0)
relations
end

analysis LockedBrakeTransient
  extends TransientAnalysis(stop = 6.0)
  parameter road_mu::Real = 1.0
  model = ABSBrakeTest(road_mu = road_mu, abs_enabled = 0.0)
relations
end
