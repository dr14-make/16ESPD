"Wheel-speed-only sampled ABS braking harness."
component ABSBrakeTest
  demand = BlockComponents.Sources.Step(height = brake_demand, offset = 0.0, start_time = brake_time) {^demand}
  road = BlockComponents.Sources.Constant(k = road_mu) {^road}
  flat = BlockComponents.Sources.Constant(k = 0.0) {^flat}
  clock = DiscreteComponents.PeriodicClock(dt = 0.005) {^clock}
  speed_sampler = DiscreteComponents.Sampler() {^speed_sampler}
  demand_sampler = DiscreteComponents.Sampler() {^demand_sampler}
  controller = VehicleSystemsComponents.Vehicle.ABSControllerWheelOnly(dt = dt, radius = radius, a_ref = a_ref, omega0 = wheel_w0, v_ref0 = v0, k_inc_slow = k_inc_slow) {^controller}
  hold = DiscreteComponents.ZeroOrderHold() {^hold}
  wsensor = RotationalComponents.Sensors.VelocitySensor() {^wsensor}
  wheel = VehicleSystemsComponents.Vehicle.Wheel.BrakedWheel(radius = radius, J_w = J_w, F_z = m * 9.80665, tau_max = brake_demand, w0 = w0) {^wheel}
  body = VehicleSystemsComponents.Vehicle.VehicleBody(m = m) {^body}
  fixed = RotationalComponents.Components.Fixed() {^fixed}
  parameter v0::Velocity = 25.0
  parameter brake_demand::Torque = 6000.0
  parameter brake_time::Time = 0.5
  parameter road_mu::Real = 1.0
  parameter m::Dyad.Mass = 1400.0
  parameter radius::Length = 0.31
  parameter J_w::MomentOfInertia = 4.0
  parameter w0::AngularVelocity = 0.2
  parameter dt::Time = 0.005
  parameter a_ref::Acceleration = 8.0
  parameter k_inc_slow::Real = 8000.0
  parameter wheel_w0::AngularVelocity = v0 / radius
relations
  connect(wsensor.spline, wheel.spline) {^id13}
  connect(wsensor.w, speed_sampler.u) {^id14}
  connect(demand.y, demand_sampler.u) {^id15}
  connect(speed_sampler.y, controller.omega, clock.y) {^id16}
  connect(demand_sampler.y, controller.demand) {^id17}
  connect(controller.tau_cmd, hold.u) {^id18}
  connect(hold.y, wheel.tau_cmd) {^id19}
  connect(wheel.support, fixed.spline) {^id20}
  connect(wheel.flange, body.flange) {^id21}
  connect(road.y, wheel.mu_scale) {^id22}
  connect(flat.y, body.grade) {^id23}
  initial wheel.brake.tau_actual = 0.0
  initial wheel.inertia.phi = 0.0
  initial wheel.inertia.w = wheel_w0
  initial body.mass.s = 0.0
  initial body.mass.v = v0
metadata {
