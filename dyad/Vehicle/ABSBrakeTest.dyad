"Ideal continuous benchmark using true slip and vehicle speed."
component ABSIdealBrakeTest
  demand = BlockComponents.Sources.Step(height = brake_demand, offset = 0.0, start_time = brake_time) {^demand}
  road = BlockComponents.Sources.Constant(k = road_mu) {^road}
  flat = BlockComponents.Sources.Constant(k = 0.0) {^flat}
  controller = VehicleSystemsComponents.Vehicle.ABSIdealController() {^controller}
  wheel = VehicleSystemsComponents.Vehicle.Wheel.BrakedWheel(radius = radius, J_w = J_w, F_z = m * 9.80665, tau_max = brake_demand, w0 = w0) {^wheel}
  body = VehicleSystemsComponents.Vehicle.VehicleBody(m = m) {^body}
  fixed = RotationalComponents.Components.Fixed() {^fixed}
  parameter v0::Velocity = 25.0
  parameter brake_demand::Torque = 6000.0
  parameter brake_time::Time = 0.5
  parameter road_mu::Real = 1.0
  parameter m::Dyad.Mass = 1400.0
  parameter radius::Length = 0.31
  parameter J_w::MomentOfInertia = 4.0
  parameter w0::AngularVelocity = 0.2
relations
  connect(demand.y, controller.demand) {^id8}
  connect(wheel.kappa, controller.kappa) {^id9}
  controller.v = body.mass.v
  connect(controller.tau_cmd, wheel.tau_cmd) {^id10}
  connect(wheel.support, fixed.spline) {^id11}
  connect(wheel.flange, body.flange) {^id12}
  connect(road.y, wheel.mu_scale) {^id13}
  connect(flat.y, body.grade) {^id14}
  initial wheel.brake.tau_actual = 0.0
  initial wheel.inertia.phi = 0.0
  initial wheel.inertia.w = v0 / radius
  initial body.mass.s = 0.0
  initial body.mass.v = v0
metadata {
