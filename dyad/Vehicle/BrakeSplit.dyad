"""
Split signed driver torque into positive wheel-brake torque commands.

Assumed Lecture5 brake allocation, extracted from the front-only braking equations
in Lecture5.P2OperatingLineWLTC. Negative `u` requests braking; nonnegative `u`
requests no friction braking. Car brake inputs take positive torque magnitudes.
The default `front_fraction = 1.0` preserves the original per-front-wheel command
`-min(u, 0.0) * brake_gain / 2.0` and leaves the rear brakes at zero. The rear axle
receives the complementary fraction; each axle splits its share equally left/right.
"""
component BrakeSplit
  "Signed driver torque request [N.m]: positive drives, negative brakes"
  u = RealInput() {^u}
  "Front-left brake torque magnitude [N.m], positive for braking"
  tau_fl = RealOutput() {^tau_fl}
  "Front-right brake torque magnitude [N.m], positive for braking"
  tau_fr = RealOutput() {^tau_fr}
  "Rear-left brake torque magnitude [N.m], positive for braking"
  tau_rl = RealOutput() {^tau_rl}
  "Rear-right brake torque magnitude [N.m], positive for braking"
  tau_rr = RealOutput() {^tau_rr}
  "Driver-to-wheel brake torque gain (assumed Lecture5 default)"
  parameter brake_gain::Real = 12.0
  "Fraction of total braking assigned to the front axle (assumed Lecture5 front-only default)"
  parameter front_fraction::Real(min = 0.0, max = 1.0) = 1.0
relations
  tau_fl = -min(u, 0.0) * brake_gain * front_fraction / 2.0
  tau_fr = tau_fl
  tau_rl = -min(u, 0.0) * brake_gain * (1.0 - front_fraction) / 2.0
  tau_rr = tau_rl
metadata {
  "_links": {
    "u": {"Dyad": {"placement": {"diagram": {"x1": -25, "y1": 475, "x2": 25, "y2": 525}, "icon": {"x1": -50, "y1": 450, "x2": 50, "y2": 550}}}},
    "tau_fl": {"Dyad": {"placement": {"diagram": {"x1": 975, "y1": 175, "x2": 1025, "y2": 225}, "icon": {"x1": 950, "y1": 150, "x2": 1050, "y2": 250}}}},
    "tau_fr": {"Dyad": {"placement": {"diagram": {"x1": 975, "y1": 375, "x2": 1025, "y2": 425}, "icon": {"x1": 950, "y1": 350, "x2": 1050, "y2": 450}}}},
    "tau_rl": {"Dyad": {"placement": {"diagram": {"x1": 975, "y1": 575, "x2": 1025, "y2": 625}, "icon": {"x1": 950, "y1": 550, "x2": 1050, "y2": 650}}}},
    "tau_rr": {"Dyad": {"placement": {"diagram": {"x1": 975, "y1": 775, "x2": 1025, "y2": 825}, "icon": {"x1": 950, "y1": 750, "x2": 1050, "y2": 850}}}}
  }
}
end
