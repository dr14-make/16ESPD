"""
Allocate a total positive brake-torque magnitude to four wheel-brake commands.

By default `u` is a positive magnitude: total wheel torque is `max(u, 0) * gain`.
With structural `signed_driver = true`, `u` is instead a signed driver request:
negative requests braking and total wheel torque is `-min(u, 0) * gain`.
`front_fraction` assigns the front axle share; the rear receives its complement.
Each axle splits equally left/right. Outputs are positive braking magnitudes.
Defaults `gain = 1.0` and `front_fraction = 1.0` give front-only braking.
With fixed_mode, electric brake input is already per front wheel; ratio refers it
to wheel torque without a second axle split. Engine mode uses signed u.
"""
component BrakeSplit
  "Brake torque magnitude [N.m], or signed driver request when signed_driver is true"
  u = RealInput() {^u}
  "Front-left brake torque magnitude [N.m], positive for braking"
  tau_fl = RealOutput() {^tau_fl}
  "Front-right brake torque magnitude [N.m], positive for braking"
  tau_fr = RealOutput() {^tau_fr}
  "Rear-left brake torque magnitude [N.m], positive for braking"
  tau_rl = RealOutput() {^tau_rl}
  "Rear-right brake torque magnitude [N.m], positive for braking"
  tau_rr = RealOutput() {^tau_rr}
  "Input-to-total-wheel brake torque gain"
  parameter gain::Real = 1.0
  "Interpret negative driver requests as braking instead of positive magnitudes"
  structural parameter signed_driver::Boolean = false
  structural parameter fixed_mode::Boolean = false
  structural parameter electric::Boolean = false
  "Per-front-wheel brake magnitude before the CVT [N.m]"
  brake = RealInput() if fixed_mode {^brake}
  "Actual CVT input-to-wheel reduction"
  ratio = RealInput() if fixed_mode {^ratio}
  variable magnitude::Real
  variable axle_divisor::Real
  "Fraction of total braking assigned to the front axle (assumed Lecture5 front-only default)"
  parameter front_fraction::Real(min = 0.0, max = 1.0) = 1.0
relations
  if fixed_mode and electric
    magnitude = max(brake, 0.0) * ratio
    axle_divisor = 1.0
  elseif signed_driver
    axle_divisor = 2.0
    magnitude = -min(u, 0.0)
  else
    axle_divisor = 2.0
    magnitude = max(u, 0.0)
  end
  tau_fl = magnitude * gain * front_fraction / axle_divisor
  tau_fr = tau_fl
  tau_rl = magnitude * gain * (1.0 - front_fraction) / axle_divisor
  tau_rr = tau_rl
