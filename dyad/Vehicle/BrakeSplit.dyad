enum BrakeInput =
  | Magnitude
  | SignedDriver
  | FixedEngine
  | FixedElectric

"""
Allocate braking to four positive per-wheel torque magnitudes.

Magnitude uses max(u, 0) * gain as total wheel torque. SignedDriver and
FixedEngine use -min(u, 0) * gain. FixedElectric uses the per-wheel brake
input referred through ratio; its total is 2 * max(brake, 0) * ratio and
does not use gain. Fixed modes expose brake and ratio for a fixed-mode bench.
front_fraction assigns the front axle share; both axles split equally left/right.
"""
component BrakeSplit
  structural parameter input::BrakeInput = BrakeInput.Magnitude()
  "Positive brake magnitude or signed driver torque [N.m], according to input"
  u = RealInput() {^u}
  "Front-left per-wheel braking magnitude [N.m]"
  tau_fl = RealOutput() {^tau_fl}
  "Front-right per-wheel braking magnitude [N.m]"
  tau_fr = RealOutput() {^tau_fr}
  "Rear-left per-wheel braking magnitude [N.m]"
  tau_rl = RealOutput() {^tau_rl}
  "Rear-right per-wheel braking magnitude [N.m]"
  tau_rr = RealOutput() {^tau_rr}
  "Input-to-total-wheel torque gain in magnitude and signed-driver modes"
  parameter gain::Real = 1.0
  "Per-wheel brake magnitude before the CVT [N.m], used in FixedElectric"
  brake = RealInput() if input == BrakeInput.FixedEngine() or input == BrakeInput.FixedElectric() {^brake}
  "Actual CVT input-to-wheel reduction, used in FixedElectric"
  ratio = RealInput() if input == BrakeInput.FixedEngine() or input == BrakeInput.FixedElectric() {^ratio}
  variable magnitude::Real
  "Fraction of total braking assigned to the front axle"
  parameter front_fraction::Real(min = 0.0, max = 1.0) = 1.0
relations
  if input == BrakeInput.FixedElectric()
    magnitude = 2.0 * max(brake, 0.0) * ratio
  elseif input == BrakeInput.Magnitude()
    magnitude = max(u, 0.0) * gain
  else
    magnitude = -min(u, 0.0) * gain
  end
  tau_fl = magnitude * front_fraction / 2.0
  tau_fr = tau_fl
  tau_rl = magnitude * (1.0 - front_fraction) / 2.0
  tau_rr = tau_rl
