"One-dimensional engine-speed curve backed by the standard two-dimensional table."
component SpeedCurve
  "Engine angular speed [rad/s]"
  omega = RealInput() {^omega}
  "Curve output"
  y = RealOutput() {^y}
  structural parameter rpm_axis::Real[:]
  structural parameter data::Real[:, :]
  table = BlockComponents.Tables.InterpolatedTable(axis1 = rpm_axis, axis2 = [0, 1], data = data, interpolation_dim1 = BlockComponents.Tables.InterpolationDimension.LinearInterpolationDimension(), interpolation_dim2 = BlockComponents.Tables.InterpolationDimension.LinearInterpolationDimension()) {^table}
relations
  table.u1 = min(max(omega * 30 / pi, rpm_axis[1]), rpm_axis[end])
  table.u2 = 0.0
  connect(table.y, y)
metadata {
  "Dyad": {"labels": [{"label": "$(instance)", "x": 500, "y": 1100, "rot": 0}, {"label": "ω → curve", "x": 500, "y": 300, "rot": 0}], "doc": {"behavior": false}},
  "_links": {
    "omega": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 450, "x2": 50, "y2": 550}}}},
    "y": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}}}},
    "table": {"Dyad": {"placement": {"diagram": {"x1": 450, "y1": 450, "x2": 550, "y2": 550}}}}
  }
}
end

test component TestSpeedCurve
  omega = BlockComponents.Sources.Constant(k = 1500 * pi / 30)
  curve = VehicleSystemsComponents.Vehicle.Engine.SpeedCurve(rpm_axis = [1000, 2000], data = [[10, 10], [20, 20]])
relations
  connect(omega.y, curve.omega)
metadata {
  "Dyad": {"tests": {"interpolate": {"stop": 0.1, "atol": {"curve.y": 1e-12}, "expect": {"initial": {"curve.y": 15.0}, "final": {"curve.y": 15.0}, "signals": ["curve.y"]}}}}
}
end
