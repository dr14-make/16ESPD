"Blend fired and motored values with a continuous cut fraction."
component CutBlend
  "Fired value"
  fired = RealInput() {^fired}
  "Cut fraction, 0 fired to 1 cut"
  cut = RealInput() {^cut}
  "Motored value"
  motored = RealInput() {^motored}
  "Blended value"
  y = RealOutput() {^y}
relations
  y = (1 - cut) * fired + cut * motored
metadata {
  "Dyad": {"labels": [{"label": "$(instance)", "x": 500, "y": 1100, "rot": 0}, {"label": "cut blend", "x": 500, "y": 300, "rot": 0}]},
  "_links": {
    "fired": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 150, "x2": 50, "y2": 250}}}},
    "cut": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 450, "x2": 50, "y2": 550}}}},
    "motored": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 750, "x2": 50, "y2": 850}}}},
    "y": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}}}}
  }
}
end

test component TestCutBlend
  fired = BlockComponents.Sources.Constant(k = 100.0)
  motored = BlockComponents.Sources.Constant(k = -20.0)
  fired_end = BlockComponents.Sources.Constant(k = 0.0)
  motored_end = BlockComponents.Sources.Constant(k = 1.0)
  at_fired = VehicleSystemsComponents.Vehicle.Engine.CutBlend()
  at_motored = VehicleSystemsComponents.Vehicle.Engine.CutBlend()
relations
  connect(fired.y, at_fired.fired, at_motored.fired)
  connect(motored.y, at_fired.motored, at_motored.motored)
  connect(fired_end.y, at_fired.cut)
  connect(motored_end.y, at_motored.cut)
metadata {
  "Dyad": {"tests": {"ends": {"stop": 0.1, "atol": {"at_fired.y": 1e-12, "at_motored.y": 1e-12}, "expect": {"initial": {"at_fired.y": 100.0, "at_motored.y": -20.0}, "final": {"at_fired.y": 100.0, "at_motored.y": -20.0}, "signals": ["at_fired.y", "at_motored.y"]}}}}
}
end
