"""
Two-dimensional engine map with SI inputs and an SI-scaled output.

The table axes remain in rpm and kPa to match the source data. Inputs are clamped at the table
boundary so the interpolator is never asked to extrapolate.
"""
component SpeedLoadMap
  "Engine angular speed [rad/s]"
  omega = RealInput() {^omega}
  "Manifold absolute pressure [Pa]"
  p_m = RealInput() {^p_m}
  "Mapped output in SI units"
  y = RealOutput() {^y}
  structural parameter rpm_axis::Real[:]
  structural parameter kpa_axis::Real[:]
  structural parameter data::Real[:, :]
  "Scale from the table's output units to SI (derived)"
  parameter gain::Real = 1.0
  table = BlockComponents.Tables.InterpolatedTable(axis1 = rpm_axis, axis2 = kpa_axis, data = data, interpolation_dim1 = BlockComponents.Tables.InterpolationDimension.LinearInterpolationDimension(), interpolation_dim2 = BlockComponents.Tables.InterpolationDimension.LinearInterpolationDimension()) {^table}
relations
  table.u1 = min(max(omega * 30 / pi, rpm_axis[1]), rpm_axis[end])
  table.u2 = min(max(p_m / 1000, kpa_axis[1]), kpa_axis[end])
  y = gain * table.y
metadata {
  "Dyad": {"labels": [{"label": "$(instance)", "x": 500, "y": 1100, "rot": 0}, {"label": "ω,p → map", "x": 500, "y": 300, "rot": 0}], "doc": {"behavior": false}},
  "_links": {
    "omega": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 250, "x2": 50, "y2": 350}}}},
    "p_m": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 650, "x2": 50, "y2": 750}}}},
    "y": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}}}},
    "table": {"Dyad": {"placement": {"diagram": {"x1": 450, "y1": 450, "x2": 550, "y2": 550}}}}
  }
}
end

test component TestSpeedLoadMap
  omega_node = BlockComponents.Sources.Constant(k = 2000 * pi / 30)
  pressure_node = BlockComponents.Sources.Constant(k = 20000.0)
  omega_clamped = BlockComponents.Sources.Constant(k = 0.0)
  pressure_clamped = BlockComponents.Sources.Constant(k = 30000.0)
  node = VehicleSystemsComponents.Vehicle.Engine.SpeedLoadMap(rpm_axis = [1000, 2000], kpa_axis = [10, 20], data = [[1, 2], [3, 4]], gain = 1e-3)
  clamped = VehicleSystemsComponents.Vehicle.Engine.SpeedLoadMap(rpm_axis = [1000, 2000], kpa_axis = [10, 20], data = [[1, 2], [3, 4]], gain = 1e-3)
relations
  connect(omega_node.y, node.omega)
  connect(pressure_node.y, node.p_m)
  connect(omega_clamped.y, clamped.omega)
  connect(pressure_clamped.y, clamped.p_m)
metadata {
  "Dyad": {"tests": {"node_and_clamp": {"stop": 0.1, "atol": {"node.y": 1e-12, "clamped.y": 1e-12}, "expect": {"initial": {"node.y": 0.004, "clamped.y": 0.002}, "final": {"node.y": 0.004, "clamped.y": 0.002}, "signals": ["node.y", "clamped.y"]}}}}
}
end

component CutMap
  "Engine angular speed [rad/s]"
  omega = RealInput() {^omega}
  "Manifold absolute pressure [Pa]"
  p_m = RealInput() {^p_m}
  "Fuel-cut fraction, 0 fired to 1 cut"
  cut = RealInput() {^cut}
  "Gated mapped output in SI units"
  y = RealOutput() {^y}
  structural parameter rpm_axis::Real[:]
  structural parameter kpa_axis::Real[:]
  structural parameter data::Real[:, :]
  "Scale from the table's output units to SI (derived)"
  parameter gain::Real = 1.0
  map = VehicleSystemsComponents.Vehicle.Engine.SpeedLoadMap(rpm_axis = rpm_axis, kpa_axis = kpa_axis, data = data, gain = gain) {^map}
relations
  connect(omega, map.omega)
  connect(p_m, map.p_m)
  y = (1 - cut) * map.y
metadata {
  "Dyad": {"labels": [{"label": "$(instance)", "x": 500, "y": 1100, "rot": 0}, {"label": "cut map", "x": 500, "y": 300, "rot": 0}], "doc": {"behavior": false}},
  "_links": {
    "omega": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 200, "x2": 50, "y2": 300}}}},
    "p_m": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 450, "x2": 50, "y2": 550}}}},
    "cut": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 700, "x2": 50, "y2": 800}}}},
    "y": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}}}},
    "map": {"Dyad": {"placement": {"diagram": {"x1": 450, "y1": 450, "x2": 550, "y2": 550}}}}
  }
}
end

test component TestCutMap
  omega = BlockComponents.Sources.Constant(k = 2000 * pi / 30)
  pressure = BlockComponents.Sources.Constant(k = 20000.0)
  cut = BlockComponents.Sources.Constant(k = 1.0)
  map = VehicleSystemsComponents.Vehicle.Engine.CutMap(rpm_axis = [1000, 2000], kpa_axis = [10, 20], data = [[1, 2], [3, 4]], gain = 1e-3)
relations
  connect(omega.y, map.omega)
  connect(pressure.y, map.p_m)
  connect(cut.y, map.cut)
metadata {
  "Dyad": {"tests": {"cut": {"stop": 0.1, "atol": {"map.y": 1e-12}, "expect": {"initial": {"map.y": 0.0}, "final": {"map.y": 0.0}, "signals": ["map.y"]}}}}
}
end
