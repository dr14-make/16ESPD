"""
Mean-value air path of a throttled petrol engine: throttle, intake manifold and cylinders.

Throttle position and engine speed set the manifold pressure `p_m`, the signal the engine maps
are read at and the vacuum the brake booster draws on. `mdot_bst` is the booster's inflow
through its check valve; hold it at zero when no booster is connected. `mdot_cyl` is the air the
cylinders draw, which the fuel path meters against, and `mdot_thr` is what a mass-airflow
sensor upstream of the throttle would read.

With the defaults: 33 kPa at idle (closed throttle, 800 rpm), 13.5 kPa on overrun at 3000 rpm,
about 100 kPa at wide-open throttle, and a manifold time constant of about 0.15 s at idle.
"""
component AirPath
  "Throttle position: 0 closed against its stop, 1 wide open"
  u_thr = RealInput() {^u_thr}
  "Engine speed [rad/s]"
  omega = RealInput() {^omega}
  "Air flow in from the brake booster [kg/s]"
  mdot_bst = RealInput() {^mdot_bst}
  "Manifold absolute pressure [Pa]"
  p_m = RealOutput() {^p_m}
  "Air mass flow into the cylinders [kg/s]"
  mdot_cyl = RealOutput() {^mdot_cyl}
  "Air mass flow through the throttle [kg/s]"
  mdot_thr = RealOutput() {^mdot_thr}
  throttle = VehicleSystemsComponents.Vehicle.Engine.Throttle(A_idle = A_idle, C_d = C_d, D_thr = D_thr) {^throttle}
  manifold = VehicleSystemsComponents.Vehicle.Engine.IntakeManifold(V_m = V_m, T_m = T_m) {^manifold}
  cylinders = VehicleSystemsComponents.Vehicle.Engine.CylinderAirflow(V_d = V_d, T_m = T_m) {^cylinders}
  "Leakage plus idle-bypass area, sets 33 kPa idle at 800 rpm (derived)"
  parameter A_idle::Area = 7.4e-6
  "Throttle discharge coefficient (assumed)"
  parameter C_d::Real = 0.8
  "Throttle bore diameter (MathWorks)"
  parameter D_thr::Length = 0.05
  "Manifold volume (MathWorks)"
  parameter V_m::Volume = 1.0e-3
  "Displacement (MathWorks)"
  parameter V_d::Volume = 1.5e-3
  "Manifold air temperature (MathWorks)"
  parameter T_m::Temperature = 298.15
relations
  connect(u_thr, throttle.u_thr) {^id1}
  connect(omega, cylinders.omega) {^id2}
  connect(mdot_bst, manifold.mdot_bst) {^id3}
  connect(throttle.mdot_thr, manifold.mdot_thr, mdot_thr) {^id4}
  connect(cylinders.mdot_cyl, manifold.mdot_cyl, mdot_cyl) {^id5}
  connect(manifold.p_m, throttle.p_m, cylinders.p_m, p_m) {^id6}
metadata {
  "Dyad": {"icons": {"default": "dyad://VehicleSystemsComponents/Vehicle/Engine/AirPath.svg"}},
  "_links": {
    "u_thr": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 150, "x2": 50, "y2": 250}}}},
    "mdot_bst": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 450, "x2": 50, "y2": 550}}}},
    "omega": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 750, "x2": 50, "y2": 850}}}},
    "mdot_thr": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 150, "x2": 1050, "y2": 250}}}},
    "p_m": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}}}},
    "mdot_cyl": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 750, "x2": 1050, "y2": 850}}}},
    "throttle": {"Dyad": {"placement": {"diagram": {"x1": 250, "y1": 150, "x2": 350, "y2": 250}}}},
    "manifold": {"Dyad": {"placement": {"diagram": {"x1": 500, "y1": 450, "x2": 600, "y2": 550}}}},
    "cylinders": {"Dyad": {"placement": {"diagram": {"x1": 700, "y1": 700, "x2": 800, "y2": 800}}}},
    "id1": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 150, "y": 200}, {"x": 150, "y": 180}], "E": 2}], "path": {}}},
    "id2": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 650, "y": 800}, {"x": 650, "y": 770}], "E": 2}], "path": {}}},
    "id3": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id4": {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 400, "y": 470}], "E": 2}, {"S": -1, "M": [], "E": 3}], "junctions": [{"x": 400, "y": 200}], "path": {}}},
    "id5": {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 850, "y": 880}, {"x": 450, "y": 880}, {"x": 450, "y": 530}], "E": 2}, {"S": -1, "M": [{"x": 850, "y": 800}], "E": 3}], "junctions": [{"x": 850, "y": 750}], "path": {}}},
    "id6": {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 650, "y": 350}, {"x": 200, "y": 350}, {"x": 200, "y": 220}], "E": 2}, {"S": -1, "M": [{"x": 650, "y": 730}], "E": 3}, {"S": -1, "M": [], "E": 4}], "junctions": [{"x": 650, "y": 500}], "path": {}}}
  }
}
