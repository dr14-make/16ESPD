_speed_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}]}},"available_torque_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":468.0,"y":168.0},{"x":468.0,"y":120.0}],"E":2}]}},"torque_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":-1},{"S":-1,"M":[],"E":2},{"S":-1,"M":[{"x":582.0,"y":88.0}],"E":3}],"junctions":[{"x":970,"y":210}]}},"fuel_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":-1},{"S":-1,"M":[],"E":2},{"S":-1,"M":[{"x":576.0,"y":620.0}],"E":3}],"junctions":[{"x":960,"y":710}]}},"co2_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}]}},"lambda_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}]}},"hc_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}]}},"co_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}]}},"nox_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}]}},"drive_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}]}},"shaft_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":-1},{"S":-1,"M":[],"E":2},{"S":-1,"M":[{"x":780.0,"y":344.0}],"E":3}],"junctions":[{"x":1300,"y":210}]}},"support_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}]}}}}
end
