"""
Map-based petrol engine assembled as a visible pedal-to-torque signal chain.

The maps are generated from `scripts/alpha_engine_maps.jl`. Small blocks keep engineering-unit
conversion, interpolation, actuator dynamics, and fuel-cut behavior at their natural boundaries.
The torque comes from the same `TorqueMap` students draw in Hands-on 02; the fuel and emission
maps are `CutMap`s, because the fuel cut has to gate them.
"""
component MappedEngine
  extends VehicleSystemsComponents.Vehicle.Engine.EngineMapData
  "Driver pedal command, 0 closed to 1 fully open"
  pedal = RealInput() {^pedal}
  "Vacuum take-off: the hose to the brake booster, at manifold pressure"
  vacuum = VehicleSystemsComponents.Vehicle.GasPort() {^vacuum}
  "Engine output shaft"
  spline = Spline() {^spline}
  "Reaction support (engine mounts)"
  support = Spline() {^support}
  "Manifold absolute pressure [Pa]"
  p_m = RealOutput() {^p_m}
  "Fuel mass flow [kg/s]"
  mdot_fuel = RealOutput() {^mdot_fuel}
  "Carbon-dioxide mass flow [kg/s]"
  mdot_co2 = RealOutput() {^mdot_co2}
  "Engine-out hydrocarbon mass flow [kg/s] (assumed map)"
  mdot_hc = RealOutput() {^mdot_hc}
  "Engine-out carbon-monoxide mass flow [kg/s] (assumed map)"
  mdot_co = RealOutput() {^mdot_co}
  "Engine-out nitrogen-oxide mass flow [kg/s] (assumed map)"
  mdot_nox = RealOutput() {^mdot_nox}
  "Brake torque [N.m]"
  tau_e = RealOutput() {^tau_e}
  "Air-fuel equivalence ratio"
  lambda = RealOutput() {^lambda}

  "Progressive drive-by-wire pedal exponent (assumed)"
  parameter pedal_exponent::Real = 1.5
  "Drive-by-wire throttle actuator time constant (assumed)"
  parameter throttle_time::Time(min = eps(Float64)) = 0.05
  "Engine plus flywheel inertia (assumed; lecture-02-dyad-tasks.md)"
  parameter J_e::MomentOfInertia = 0.15
  "Closed-pedal threshold for deceleration fuel cut (assumed)"
  parameter pedal_closed::Real = 1e-4
  "Deceleration fuel-cut speed [rpm] (assumed)"
  parameter fuel_cut_rpm::Real = 1300.0
  "Deceleration fuel-resume speed [rpm] (assumed)"
  parameter fuel_resume_rpm::Real = 1000.0
  "Rev-limiter fuel-cut speed [rpm] (assumed)"
  parameter rev_cut_rpm::Real = 6500.0
  "Rev-limiter fuel-resume speed [rpm] (assumed)"
  parameter rev_resume_rpm::Real = 6300.0
  "Continuous latch transition time (assumed)"
  parameter latch_time::Time(min = eps(Float64)) = 0.01
  "Gasoline carbon balance at full oxidation (textbook)"
  parameter co2_per_fuel::Real = 3.09

  pedal_map = VehicleSystemsComponents.Vehicle.Engine.PedalMap(pedal_exponent = pedal_exponent, throttle_time = throttle_time) {^pedal_map}
  air = VehicleSystemsComponents.Vehicle.Engine.AirPath() {^air}
  speed = RotationalComponents.Sensors.VelocitySensor() {^speed}
  cut_logic = VehicleSystemsComponents.Vehicle.Engine.FuelCutLogic(pedal_closed = pedal_closed, fuel_cut_rpm = fuel_cut_rpm, fuel_resume_rpm = fuel_resume_rpm, rev_cut_rpm = rev_cut_rpm, rev_resume_rpm = rev_resume_rpm, latch_time = latch_time) {^cut_logic}
  torque_map = VehicleSystemsComponents.Vehicle.Engine.TorqueMap(rpm_axis = rpm_axis, kpa_axis = kpa_axis, torque_data = torque_data, full_load_rpm = full_load_rpm, full_load_data = full_load_data) {^torque_map}
  closed_throttle = VehicleSystemsComponents.Vehicle.Engine.SpeedCurve(rpm_axis = closed_rpm, data = closed_data) {^closed_throttle}
  torque_blend = VehicleSystemsComponents.Vehicle.Engine.CutBlend() {^torque_blend}
  fuel_map = VehicleSystemsComponents.Vehicle.Engine.CutMap(rpm_axis = rpm_axis, kpa_axis = kpa_axis, data = fuel_data, gain = 1e-3) {^fuel_map}
  lambda_map = VehicleSystemsComponents.Vehicle.Engine.SpeedLoadMap(rpm_axis = rpm_axis, kpa_axis = kpa_axis, data = lambda_data) {^lambda_map}
  hc_map = VehicleSystemsComponents.Vehicle.Engine.CutMap(rpm_axis = rpm_axis, kpa_axis = kpa_axis, data = hc_data, gain = 1e-3) {^hc_map}
  co_map = VehicleSystemsComponents.Vehicle.Engine.CutMap(rpm_axis = rpm_axis, kpa_axis = kpa_axis, data = co_data, gain = 1e-3) {^co_map}
  nox_map = VehicleSystemsComponents.Vehicle.Engine.CutMap(rpm_axis = rpm_axis, kpa_axis = kpa_axis, data = nox_data, gain = 1e-3) {^nox_map}
  co2_gain = BlockComponents.Math.Gain(k = co2_per_fuel) {^co2_gain}
  torque_source = RotationalComponents.Sources.TorqueSource() {^torque_source}
  crankshaft = RotationalComponents.Components.Inertia(J = J_e) {^crankshaft}
  "Engine speed [rpm]"
  variable N::Real
relations
  N = speed.w * 30 / pi
  connect(pedal, pedal_map.pedal, cut_logic.pedal) {^pedal_wire}
  connect(pedal_map.u_thr, air.u_thr) {^throttle_wire}
  connect(vacuum, air.vacuum) {^booster_wire}
  connect(air.p_m, p_m, torque_map.p_m, lambda_map.p_m, fuel_map.p_m, hc_map.p_m, co_map.p_m, nox_map.p_m) {^pressure_wire}
  connect(speed.w, air.omega, cut_logic.omega, torque_map.omega, closed_throttle.omega, lambda_map.omega, fuel_map.omega, hc_map.omega, co_map.omega, nox_map.omega) {^speed_wire}
  connect(torque_map.y, torque_blend.fired) {^fired_wire}
  connect(closed_throttle.y, torque_blend.motored) {^motored_wire}
  connect(cut_logic.cut, torque_blend.cut, fuel_map.cut, hc_map.cut, co_map.cut, nox_map.cut) {^cut_wire}
  connect(torque_blend.y, torque_source.tau, tau_e) {^torque_wire}
  connect(fuel_map.y, mdot_fuel, co2_gain.u) {^fuel_wire}
  connect(co2_gain.y, mdot_co2) {^co2_wire}
  connect(lambda_map.y, lambda) {^lambda_wire}
  connect(hc_map.y, mdot_hc) {^hc_wire}
  connect(co_map.y, mdot_co) {^co_wire}
  connect(nox_map.y, mdot_nox) {^nox_wire}
  connect(torque_source.spline, crankshaft.spline_a) {^drive_wire}
  connect(crankshaft.spline_b, spline, speed.spline) {^shaft_wire}
  connect(torque_source.support, support) {^support_wire}
