    "V2": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 650, "x2": 1050, "y2": 750}}}},
    "reference_level": {"Dyad": {"placement": {"diagram": {"x1": 0, "y1": 100, "x2": 100, "y2": 200}}}},
    "reference": {"Dyad": {"placement": {"diagram": {"x1": 150, "y1": 100, "x2": 250, "y2": 200, "rot": 270}}}},
