"Best-BSFC speed command blended between engine request and electric-mode drive demand."
component HybridLineSpeedCommand
  "Requested engine power [W] (derived; EnergyManager.P_engine)"
  P_engine = RealInput() {^P_engine}
  "Requested drive power [W] (derived; EnergyManager.P_drive)"
  P_drive = RealInput() {^P_drive}
  "Engine running fraction (derived; EnergyManager.engine_on)"
  engine_on = RealInput() {^engine_on}
  "Transmission speed command [rpm] (derived; blended operating lines with idle floor)"
  N_ref = RealOutput() {^N_ref}
  "Minimum locked speed [rpm] (assumed; Lecture 5 lock-up calibration, 1000 rpm)"
  parameter N_locked::Real = 1000.0
  line = VehicleSystemsComponents.Vehicle.OperatingLine() {^line}
  demand_line = VehicleSystemsComponents.Vehicle.OperatingLine() {^demand_line}
relations
  connect(P_engine, line.P) {^engine_wire}
  connect(P_drive, demand_line.P) {^drive_wire}
  N_ref = max(engine_on * line.N + (1.0 - engine_on) * demand_line.N, N_locked)
