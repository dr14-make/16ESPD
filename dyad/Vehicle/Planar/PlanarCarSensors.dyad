"""Ideal planar-car sensor cluster attached only through physical ports."""
component PlanarCarSensors
  chassis = Frame2D() {^chassis}
  steering = Spline() {^steering}
  wheel_fl = Frame2D() {^wheel_fl}
  wheel_fr = Frame2D() {^wheel_fr}
  wheel_rl = Frame2D() {^wheel_rl}
  wheel_rr = Frame2D() {^wheel_rr}
  spin_fl = Spline() {^spin_fl}
  spin_fr = Spline() {^spin_fr}
  spin_rl = Spline() {^spin_rl}
  spin_rr = Spline() {^spin_rr}
  vx = RealOutput() {^vx}
  vy = RealOutput() {^vy}
  r = RealOutput() {^r}
  ax = RealOutput() {^ax}
  ay = RealOutput() {^ay}
  x = RealOutput() {^x}
  y = RealOutput() {^y}
  psi = RealOutput() {^psi}
  beta = RealOutput() {^beta}
  delta_sw = RealOutput() {^delta_sw}
  kappa_fl = RealOutput() {^kappa_fl}
  kappa_fr = RealOutput() {^kappa_fr}
  kappa_rl = RealOutput() {^kappa_rl}
  kappa_rr = RealOutput() {^kappa_rr}
  alpha_fl = RealOutput() {^alpha_fl}
  alpha_fr = RealOutput() {^alpha_fr}
  alpha_rl = RealOutput() {^alpha_rl}
  alpha_rr = RealOutput() {^alpha_rr}
  omega_fl = RealOutput() {^omega_fl}
  omega_fr = RealOutput() {^omega_fr}
  omega_rl = RealOutput() {^omega_rl}
  omega_rr = RealOutput() {^omega_rr}
  "Wheel radius (repository default)"
  parameter radius::Length = 0.31
  vel = MultibodyComponents.PlanarMechanics.AbsoluteVelocity() {^vel}
  acc = MultibodyComponents.PlanarMechanics.AbsoluteAcceleration() {^acc}
  pos = MultibodyComponents.PlanarMechanics.AbsolutePosition(resolve_in_frame = MultibodyComponents.ResolveInFrame.World()) {^pos}
  swa = RotationalComponents.Sensors.AngleSensor() {^swa}
  slip_fl = VehicleSystemsComponents.Vehicle.Planar.WheelSlipSensor(radius = radius) {^slip_fl}
  slip_fr = VehicleSystemsComponents.Vehicle.Planar.WheelSlipSensor(radius = radius) {^slip_fr}
  slip_rl = VehicleSystemsComponents.Vehicle.Planar.WheelSlipSensor(radius = radius) {^slip_rl}
  slip_rr = VehicleSystemsComponents.Vehicle.Planar.WheelSlipSensor(radius = radius) {^slip_rr}
relations
  connect(chassis, vel.frame_a, acc.frame_a, pos.frame_a) {^w1}
  connect(steering, swa.spline) {^w2}
  connect(wheel_fl, slip_fl.frame_a) {^w3}
  connect(wheel_fr, slip_fr.frame_a) {^w4}
  connect(wheel_rl, slip_rl.frame_a) {^w5}
  connect(wheel_rr, slip_rr.frame_a) {^w6}
  connect(spin_fl, slip_fl.spline) {^w7}
  connect(spin_fr, slip_fr.spline) {^w8}
  connect(spin_rl, slip_rl.spline) {^w9}
  connect(spin_rr, slip_rr.spline) {^w10}
  vx = vel.v_x
  vy = vel.v_y
  r = vel.w
  ax = acc.a_x
  ay = acc.a_y
  x = pos.x
  y = pos.y
  psi = pos.phi
  beta = atan(vy / max(vx, 1.0))
  delta_sw = swa.phi
  kappa_fl = slip_fl.kappa
  kappa_fr = slip_fr.kappa
  kappa_rl = slip_rl.kappa
  kappa_rr = slip_rr.kappa
  alpha_fl = slip_fl.alpha
  alpha_fr = slip_fr.alpha
  alpha_rl = slip_rl.alpha
  alpha_rr = slip_rr.alpha
  omega_fl = slip_fl.omega
  omega_fr = slip_fr.omega
  omega_rl = slip_rl.omega
  omega_rr = slip_rr.omega
metadata {
  "Dyad": {"icons": {"default": "dyad://RotationalComponents/MultiSensor.svg"}},
  "_links": {
    "chassis": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 50, "x2": 50, "y2": 150}, "diagram": {"x1": -40, "y1": 200, "x2": 40, "y2": 280}}}},
    "steering": {"Dyad": {"placement": {"icon": {"x1": 450, "y1": -50, "x2": 550, "y2": 50}, "diagram": {"x1": -40, "y1": 510, "x2": 40, "y2": 590}}}},
    "wheel_fl": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 150, "x2": 50, "y2": 250}, "diagram": {"x1": -40, "y1": 640, "x2": 40, "y2": 720}}}},
