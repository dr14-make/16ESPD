"""
Planar car on WLTC in a straight line: road load through `PlanarRoadLoad` and a PI driver on
the front axle.

The driver tracks the trace in km/h. Its output is split by sign, as in Lecture 2's WLTC bench:
the positive part is a drive torque on both front spin flanges, the negative part a command to
both front brakes. A friction brake cannot reverse the car, so the car never rolls backwards at
a stop; a negative drive torque would, and `RoadLoad`'s rolling-resistance regularization
overflows (`exp(-v / 1e-3)`) once the car reverses faster than 0.71 m/s. With `cycle = false`
the bench holds the constant `v_set` instead (`PlanarCruise`).

**Standstill.** `SlipBasedWheelJoint` adds its regularization outside the square root of the slip
speed, so its Jacobian is NaN whenever a wheel's longitudinal and lateral slip speeds are both
exactly zero (JuliaComputing/MultibodyComponents.jl#185). A car initialized at exact rest is in
that state at t = 0 and Rodas5P aborts on the first step. The bench therefore starts the wheels
`dv_wheel` faster than the body. Once moving, the car does not return to exact zero: braked to a
stop, its slip speeds settle at round-off (about 1e-22 m/s) rather than at zero, which carries it
through every WLTC stop and a 400 s park.
"""
test component PlanarWLTC
  "Vehicle mass, shared by the car and its road load (probe)"
  parameter m::Mass = 1500.0
  "Wheel radius (repository default)"
  parameter radius::Length = 0.31
  "Driver gain, per front flange (assumed)"
  parameter k::Real = 200.0
  "Driver integral time (assumed)"
  parameter Ti::Time = 2.0
  "Driver torque limit, per front flange (assumed)"
  parameter tau_max::Torque = 1000.0
  "Constant target speed when cycle = false, km/h (assumed)"
  parameter v_set::Real = 50.0
  "Initial speed (assumed)"
  parameter v0::Velocity = 0.0
  "Initial wheel surface speed above v0, keeps the start off zero slip (assumed)"
  parameter dv_wheel::Velocity = 0.01
  "Follow the WLTC trace; false holds v_set"
  structural parameter cycle::Boolean = true
  trace = VehicleSystemsComponents.Vehicle.DriveCycle() if cycle {^trace}
  cruise = BlockComponents.Sources.Constant(k = v_set) if !cycle {^cruise}
  driver = BlockComponents.Continuous.LimPID(with_D = false, k = k, Ti = Ti, y_max = tau_max, y_min = -tau_max) {^driver}
  no_ff = BlockComponents.Sources.Constant(k = 0.0) {^no_ff}
  kmh = VehicleSystemsComponents.Vehicle.ToKmPerHour() {^kmh}
  to_drive = BlockComponents.Nonlinear.Limiter(y_max = tau_max, y_min = 0.0) {^to_drive}
  brake_part = BlockComponents.Nonlinear.Limiter(y_max = 0.0, y_min = -tau_max) {^brake_part}
  to_brake = BlockComponents.Math.Gain(k = -1.0) {^to_brake}
  drive_fl = RotationalComponents.Sources.TorqueSource() {^drive_fl}
  drive_fr = RotationalComponents.Sources.TorqueSource() {^drive_fr}
  mount = RotationalComponents.Components.Fixed() {^mount}
  straight = RotationalComponents.Components.Fixed() {^straight}
  no_brake = BlockComponents.Sources.Constant(k = 0.0) {^no_brake}
  flat = BlockComponents.Sources.Constant(k = 0.0) {^flat}
  car = VehicleSystemsComponents.Vehicle.Planar.PlanarCar(m = m, radius = radius) {^car}
  motion = VehicleSystemsComponents.Vehicle.Planar.BusMotion() {^motion}
  roadload = VehicleSystemsComponents.Vehicle.Planar.PlanarRoadLoad(m = m) {^roadload}
relations
  connect(car.bus, motion.bus) {^wbus}
  if cycle
    connect(trace.y, driver.u_s) {^w1}
  else
    connect(cruise.y, driver.u_s) {^w2}
  end
  connect(motion.vx, kmh.u) {^w4}
  connect(kmh.y, driver.u_m) {^w5}
  connect(no_ff.y, driver.u_ff) {^w6}
  connect(driver.y, to_drive.u, brake_part.u) {^w7}
  connect(to_drive.y, drive_fl.tau, drive_fr.tau) {^w24}
  connect(brake_part.y, to_brake.u) {^w25}
  connect(to_brake.y, car.tau_fl, car.tau_fr) {^w26}
  connect(drive_fl.spline, car.spin_fl) {^w8}
  connect(drive_fr.spline, car.spin_fr) {^w9}
  connect(drive_fl.support, drive_fr.support, mount.spline) {^w10}
  connect(car.steering, straight.spline) {^w11}
  connect(no_brake.y, car.tau_rl, car.tau_rr) {^w12}
  connect(flat.y, roadload.grade) {^w13}
  connect(car.chassis, roadload.chassis) {^w14}
  initial car.body.r = [0, 0]
  initial car.body.v = [v0, 0]
  initial car.body.phi = 0.0
  initial car.body.w = 0.0
  initial car.fl.inertia.w = (v0 + dv_wheel) / radius
  initial car.fr.inertia.w = (v0 + dv_wheel) / radius
  initial car.rl.inertia.w = (v0 + dv_wheel) / radius
  initial car.rr.inertia.w = (v0 + dv_wheel) / radius
  initial car.fl.inertia.phi = 0.0
  initial car.fr.inertia.phi = 0.0
  initial car.rl.inertia.phi = 0.0
  initial car.rr.inertia.phi = 0.0
  initial car.fl.brake.tau_actual = 0.0
  initial car.fr.brake.tau_actual = 0.0
  initial car.rl.brake.tau_actual = 0.0
  initial car.rr.brake.tau_actual = 0.0
metadata {
  "_links": {
    "wbus": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "trace": {"Dyad": {"placement": {"diagram": {"x1": 20, "y1": 57, "x2": 100, "y2": 137}}}},
    "cruise": {"Dyad": {"placement": {"diagram": {"x1": 20, "y1": 105, "x2": 80, "y2": 165}}}},
    "driver": {"Dyad": {"placement": {"diagram": {"x1": 140, "y1": 70, "x2": 240, "y2": 170}}}},
    "to_drive": {"Dyad": {"placement": {"diagram": {"x1": 290, "y1": 95, "x2": 340, "y2": 145}}}},
    "brake_part": {"Dyad": {"placement": {"diagram": {"x1": 290, "y1": 175, "x2": 340, "y2": 225}}}},
    "to_brake": {"Dyad": {"placement": {"diagram": {"x1": 380, "y1": 175, "x2": 430, "y2": 225}}}},
    "no_ff": {"Dyad": {"placement": {"diagram": {"x1": 100, "y1": 10, "x2": 140, "y2": 50}}}},
    "kmh": {"Dyad": {"placement": {"diagram": {"x1": 40, "y1": 190, "x2": 110, "y2": 260}}}},
    "drive_fl": {"Dyad": {"placement": {"diagram": {"x1": 400, "y1": 620, "x2": 470, "y2": 690}}}},
    "drive_fr": {"Dyad": {"placement": {"diagram": {"x1": 400, "y1": 400, "x2": 470, "y2": 470}}}},
    "mount": {"Dyad": {"placement": {"diagram": {"x1": 380, "y1": 740, "x2": 440, "y2": 790}}}},
    "straight": {"Dyad": {"placement": {"diagram": {"x1": 605, "y1": 500, "x2": 655, "y2": 550, "rot": 180}}}},
    "no_brake": {"Dyad": {"placement": {"diagram": {"x1": 420, "y1": 945, "x2": 460, "y2": 985}}}},
    "flat": {"Dyad": {"placement": {"diagram": {"x1": 505, "y1": 885, "x2": 535, "y2": 915}}}},
    "car": {"Dyad": {"placement": {"diagram": {"x1": 520, "y1": 600, "x2": 740, "y2": 820}}}},
    "motion": {"Dyad": {"placement": {"diagram": {"x1": 775, "y1": 610, "x2": 975, "y2": 810}}}},
    "roadload": {"Dyad": {"placement": {"diagram": {"x1": 550, "y1": 865, "x2": 620, "y2": 935}}}},
    "w1": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w2": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 115, "y": 135}, {"x": 115, "y": 97}], "E": 2}]}},
    "w4": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 990, "y": 662.0}, {"x": 990, "y": 985}, {"x": 15, "y": 985}, {"x": 15, "y": 225}], "E": 2}]}},
    "w5": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 125, "y": 225}, {"x": 125, "y": 143}], "E": 2}]}},
    "w6": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 190, "y": 30}], "E": 2}]}},
    "w7": {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [], "E": 2}, {"S": -1, "M": [{"x": 265, "y": 200}], "E": 3}], "junctions": [{"x": 265, "y": 120}]}},
    "w24": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 360, "y": 120}], "E": -1}, {"S": -1, "M": [{"x": 360, "y": 655}], "E": 2}, {"S": -1, "M": [], "E": 3}], "junctions": [{"x": 360, "y": 435}]}},
    "w25": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w26": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 500, "y": 200}], "E": -1}, {"S": -1, "M": [{"x": 500, "y": 633}], "E": 2}, {"S": -1, "M": [{"x": 750, "y": 470}, {"x": 750, "y": 633}], "E": 3}], "junctions": [{"x": 500, "y": 470}]}},
    "w8": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w9": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 765, "y": 435}, {"x": 765, "y": 655}], "E": 2}]}},
    "w10": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 470, "y": 690}], "E": -1}, {"S": -1, "M": [{"x": 490, "y": 720}, {"x": 490, "y": 470}], "E": 2}, {"S": -1, "M": [{"x": 410, "y": 720}], "E": 3}], "junctions": [{"x": 470, "y": 720}]}},
    "w11": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w12": {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 500, "y": 743}], "E": 2}, {"S": -1, "M": [{"x": 750, "y": 965}, {"x": 750, "y": 743}], "E": 3}], "junctions": [{"x": 500, "y": 965}]}},
    "w13": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w14": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 680, "y": 820}, {"x": 680, "y": 900}], "E": 2}]}}
  }
}
end

analysis PlanarWLTCTransient
  extends TransientAnalysis(stop = 1800.0, alg = ODEAlg.Rodas5P(), dtmax = 1.0, optimize = OptimizationLevel.None())
  parameter k::Real = 200.0
  parameter Ti::Time = 2.0
  model = VehicleSystemsComponents.Vehicle.Planar.PlanarWLTC(k = k, Ti = Ti)
relations
end

"""
The WLTC bench holding a constant `v_set` instead of the trace, from a start at that speed: the
constant-speed road-load check.
"""
test component PlanarCruise
  extends VehicleSystemsComponents.Vehicle.Planar.PlanarWLTC(cycle = false, v0 = v_set / 3.6)
end

analysis PlanarCruiseTransient
  extends TransientAnalysis(stop = 60.0, alg = ODEAlg.Rodas5P(), dtmax = 1.0, optimize = OptimizationLevel.None())
  parameter v_set::Real = 50.0
  model = VehicleSystemsComponents.Vehicle.Planar.PlanarCruise(v_set = v_set)
relations
end
