    "dT_fl": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 150, "x2": 50, "y2": 250}, "diagram": {"x1": -15.0, "y1": 275.0, "x2": 15.0, "y2": 305.0}}}},
