"""
Sampled four-channel ABS with continuous sensor and brake-command ports.

Sampling and zero-order holds represent the ECU boundary. Setting `abs_on` below 0.5 bypasses the
sampled modulator while retaining the nonnegative ESP brake increments.

With `report_front = true` the unit also reports, on `front_active`, whether it is acting on a
front wheel: 1 while it holds either front brake below what is asked of that brake (the driver's
demand plus any positive ESP increment), else 0. That covers an ABS release, hold or slow reapply,
and an ESP cut. On a first application the channel builds up at `k_inc_fast`, 800 N.m a sample at
the defaults, so a demand that rises more slowly than that does not set it; a step demand sets it
for the few samples the build-up takes. It is sampled and held like the brake commands, and it is
0 with `abs_on` below 0.5. A regenerative blend reads it to withdraw regen from the front axle
(`Vehicle.Electric.RegenBlend` with `abs_rule = true`).
"""
component ABSUnit
  demand = RealInput(units = "N.m") {^demand}
  dT_fl = RealInput(units = "N.m") {^dT_fl}
  dT_fr = RealInput(units = "N.m") {^dT_fr}
  dT_rl = RealInput(units = "N.m") {^dT_rl}
  dT_rr = RealInput(units = "N.m") {^dT_rr}
  kappa_fl = RealInput() {^kappa_fl}
  kappa_fr = RealInput() {^kappa_fr}
  kappa_rl = RealInput() {^kappa_rl}
  kappa_rr = RealInput() {^kappa_rr}
  vx = RealInput(units = "m/s") {^vx}
  tau_fl = RealOutput(units = "N.m") {^tau_fl}
  tau_fr = RealOutput(units = "N.m") {^tau_fr}
  tau_rl = RealOutput(units = "N.m") {^tau_rl}
  tau_rr = RealOutput(units = "N.m") {^tau_rr}
  "1 while the unit holds a front brake below its demand, else 0; present only with report_front = true"
  front_active = RealOutput() if report_front {^front_active}
  structural parameter dt::Time = 0.005
  "Add the front_active output, which tells a regenerative blend when the ABS acts on a front wheel"
  structural parameter report_front::Boolean = false
  parameter abs_on::Real = 1.0
  parameter select_low::Real = 1.0
  "Prediction includes hydraulic lag and sampled release/reapply delay (derived)"
  parameter T_p::Time = 0.08
  "Predicted release just beyond the front tire's 0.12 peak slip (derived)"
  parameter lambda_1_f::Real = 0.14
  "Predicted release just beyond the rear tire's 0.09 peak slip (derived)"
  parameter lambda_1_r::Real = 0.11
  parameter lambda_lock::Real = 0.20
  "Retain 90 percent of incipient-limit pressure; calibrated with lag (assumed)"
  parameter alpha_rel::Real = 0.9
  parameter beta_reapply::Real = 0.85
  "Reapply near peak adhesion rather than demanding near-zero slip (derived)"
  parameter l_rec::Real = 0.12
  "Two ECU ticks before another recovery decision (assumed)"
  parameter T_hold_max::Time = 0.01
  parameter k_dec::Real = 40000.0
  "Initial build limited to 200 N.m per 5 ms tick for low-grip recovery (assumed)"
  parameter k_inc_fast::Real = 40000.0
  parameter k_inc_slow::Real = 16000.0
  parameter v_min::Velocity = 1.5
  clock = DiscreteComponents.PeriodicClock(dt = dt) {^clock}
  demand_sampler = DiscreteComponents.Sampler() {^demand_sampler}
  speed_sampler = DiscreteComponents.Sampler() {^speed_sampler}
  dT_fl_sampler = DiscreteComponents.Sampler() {^dT_fl_sampler}
  dT_fr_sampler = DiscreteComponents.Sampler() {^dT_fr_sampler}
  dT_rl_sampler = DiscreteComponents.Sampler() {^dT_rl_sampler}
  dT_rr_sampler = DiscreteComponents.Sampler() {^dT_rr_sampler}
  kappa_fl_sampler = DiscreteComponents.Sampler() {^kappa_fl_sampler}
  kappa_fr_sampler = DiscreteComponents.Sampler() {^kappa_fr_sampler}
  kappa_rl_sampler = DiscreteComponents.Sampler() {^kappa_rl_sampler}
  kappa_rr_sampler = DiscreteComponents.Sampler() {^kappa_rr_sampler}
  abs = VehicleSystemsComponents.Vehicle.Planar.FourChannelABS(dt = dt, T_p = T_p, lambda_1_f = lambda_1_f, lambda_1_r = lambda_1_r, lambda_lock = lambda_lock, alpha_rel = alpha_rel, beta_reapply = beta_reapply, l_rec = l_rec, T_hold_max = T_hold_max, k_dec = k_dec, k_inc_fast = k_inc_fast, k_inc_slow = k_inc_slow, v_min = v_min, select_low = select_low) {^abs}
  hold_fl = DiscreteComponents.ZeroOrderHold() {^hold_fl}
  hold_fr = DiscreteComponents.ZeroOrderHold() {^hold_fr}
  hold_rl = DiscreteComponents.ZeroOrderHold() {^hold_rl}
  hold_rr = DiscreteComponents.ZeroOrderHold() {^hold_rr}
  hold_front = DiscreteComponents.ZeroOrderHold() if report_front {^hold_front}
relations
  connect(demand, demand_sampler.u) {^w1}
  connect(vx, speed_sampler.u) {^w2}
  connect(dT_fl, dT_fl_sampler.u) {^w3}
  connect(dT_fr, dT_fr_sampler.u) {^w4}
  connect(dT_rl, dT_rl_sampler.u) {^w5}
  connect(dT_rr, dT_rr_sampler.u) {^w6}
  connect(kappa_fl, kappa_fl_sampler.u) {^w7}
  connect(kappa_fr, kappa_fr_sampler.u) {^w8}
  connect(kappa_rl, kappa_rl_sampler.u) {^w9}
  connect(kappa_rr, kappa_rr_sampler.u) {^w10}
  connect(demand_sampler.y, abs.demand, clock.y) {^w11}
  connect(speed_sampler.y, abs.v_ref) {^w12}
  connect(dT_fl_sampler.y, abs.dT_fl) {^w13}
  connect(dT_fr_sampler.y, abs.dT_fr) {^w14}
  connect(dT_rl_sampler.y, abs.dT_rl) {^w15}
  connect(dT_rr_sampler.y, abs.dT_rr) {^w16}
  connect(kappa_fl_sampler.y, abs.kappa_fl) {^w17}
  connect(kappa_fr_sampler.y, abs.kappa_fr) {^w18}
  connect(kappa_rl_sampler.y, abs.kappa_rl) {^w19}
  connect(kappa_rr_sampler.y, abs.kappa_rr) {^w20}
  connect(abs.tau_fl, hold_fl.u) {^w21}
  connect(abs.tau_fr, hold_fr.u) {^w22}
  connect(abs.tau_rl, hold_rl.u) {^w23}
  connect(abs.tau_rr, hold_rr.u) {^w24}
  tau_fl = ifelse(abs_on > 0.5, hold_fl.y, demand + max(0.0, dT_fl))
  tau_fr = ifelse(abs_on > 0.5, hold_fr.y, demand + max(0.0, dT_fr))
  tau_rl = ifelse(abs_on > 0.5, hold_rl.y, demand + max(0.0, dT_rl))
  tau_rr = ifelse(abs_on > 0.5, hold_rr.y, demand + max(0.0, dT_rr))
  if report_front
    # A channel's command never exceeds what it is asked for, so `<` is exactly "held below";
    # the comparison runs on the same samples the channels used.
    hold_front.u = ifelse(abs.tau_fl < demand_sampler.y + max(dT_fl_sampler.y, 0.0) or abs.tau_fr < demand_sampler.y + max(dT_fr_sampler.y, 0.0), 1.0, 0.0)
    front_active = ifelse(abs_on > 0.5, hold_front.y, 0.0)
  end
metadata {
