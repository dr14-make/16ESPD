"Fabia receiver icon and port positions for the teaching-CAN receiver."
component FabiaCanRx
  bus = CanNet() {^bus}
  y = RealOutput() {^y}
  structural parameter slot::Integer = 1
  structural parameter id::Integer = 128
  receiver = CanRxReal(slot = slot, id = id)
relations
  connect(bus, receiver.bus)
  connect(receiver.y, y)
metadata {
  "Dyad": {"icons": {"default": "dyad://VehicleSystemsComponents/fabia-node.svg"}},
  "_links": {
    "bus": {"Dyad": {"placement": {"icon": {"x1": 485, "x2": 515, "y1": -15, "y2": 15}}}},
    "y": {"Dyad": {"placement": {"icon": {"x1": 985, "x2": 1015, "y1": 485, "y2": 515}}}}
  }
}
end
