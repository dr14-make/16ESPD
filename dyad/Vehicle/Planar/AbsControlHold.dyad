analysis AbsControlHoldRun
  extends TransientAnalysis(stop = 0.5, reltol = 1e-7, abstol = 1e-8)
  parameter release_time::Time = 0.2
  parameter stop_time::Time = 0.4
  model = AbsControlHoldBench(release_time = release_time, stop_time = stop_time)
end
