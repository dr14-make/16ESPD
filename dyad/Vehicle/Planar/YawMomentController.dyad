"""Continuous yaw-error controller with deadband and speed-dependent enable."""
component YawMomentController
  "Measured yaw rate"
  r = RealInput(units = "rad/s")
  "Reference yaw rate"
  r_ref = RealInput(units = "rad/s")
  "Measured longitudinal speed"
  vx = RealInput(units = "m/s")
  "Requested corrective yaw moment"
  Mz = RealOutput(units = "N.m")
  "One for oversteer, zero for understeer"
  oversteer = RealOutput()
  "Proportional yaw gain (probe)"
  parameter Kp::Real = 40000.0
  "Integral yaw gain (probe)"
  parameter Ki::Real = 0.0
  "Yaw-error deadband (probe)"
  parameter deadband::AngularVelocity = 0.03
  "ESP enable speed (assumed)"
  parameter v_on::Velocity = 5.0
  "Maximum requested yaw moment (assumed)"
  parameter Mz_max::Torque = 10000.0
  variable e::AngularVelocity
  variable e_active::AngularVelocity
  variable e_int::Angle
  variable Mz_raw::Torque
relations
  e = r - r_ref
  e_active = ifelse(abs(e) > deadband, e - deadband * sign(e), 0.0)
  initial e_int = 0.0
  der(e_int) = e
  Mz_raw = -Kp * e_active - Ki * e_int
  Mz = ifelse(vx > v_on, min(max(Mz_raw, -Mz_max), Mz_max), 0.0)
  oversteer = ifelse(abs(r) > abs(r_ref), 1.0, 0.0)
end

"Yaw controller checks active control, deadband, and low-speed inhibition."
test component TestYawMomentController
  measured = BlockComponents.Sources.Constant(k = 0.30)
  reference = BlockComponents.Sources.Constant(k = 0.20)
  speed = BlockComponents.Sources.Constant(k = 20.0)
  control = VehicleSystemsComponents.Vehicle.Planar.YawMomentController()
relations
  connect(measured.y, control.r)
  connect(reference.y, control.r_ref)
  connect(speed.y, control.vx)
metadata {
  "Dyad": {
    "tests": {
      "active": {
        "solver": "Tsit5", "stop": 1.0,
        "expect": {"final": {"control.Mz": -2800.0, "control.oversteer": 1.0}},
        "atol": {"control.Mz": 1e-6, "control.oversteer": 1e-6}
      },
      "deadband": {
        "solver": "Tsit5", "stop": 1.0,
        "params": {"measured.k": 0.21},
        "expect": {"final": {"control.Mz": 0.0}},
        "atol": {"control.Mz": 1e-9}
      },
      "low_speed": {
        "solver": "Tsit5", "stop": 1.0,
        "params": {"speed.k": 4.0},
        "expect": {"final": {"control.Mz": 0.0}},
        "atol": {"control.Mz": 1e-9}
      }
    }
  }
}
end
