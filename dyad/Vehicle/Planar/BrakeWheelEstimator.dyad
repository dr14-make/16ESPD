"""
Wheel-speed-only sampled brake estimator with independent wheel references.
Zero initial references adopt measured rolling speed on the first tick; vx is the
maximum held reference speed, while each slip uses its own wheel reference.
"""
component BrakeWheelEstimator
  omega_fl = RealInput(units = "rad/s") {^omega_fl}
  omega_fr = RealInput(units = "rad/s") {^omega_fr}
  omega_rl = RealInput(units = "rad/s") {^omega_rl}
  omega_rr = RealInput(units = "rad/s") {^omega_rr}
  kappa_fl = RealOutput() {^kappa_fl}
  kappa_fr = RealOutput() {^kappa_fr}
  kappa_rl = RealOutput() {^kappa_rl}
  kappa_rr = RealOutput() {^kappa_rr}
  vx = RealOutput(units = "m/s") {^vx}
  structural parameter dt::Time = 0.005
  parameter radius::Length = 0.31
  clock_fl = DiscreteComponents.PeriodicClock(dt = dt) {^clock_fl}
  clock_fr = DiscreteComponents.PeriodicClock(dt = dt) {^clock_fr}
  clock_rl = DiscreteComponents.PeriodicClock(dt = dt) {^clock_rl}
  clock_rr = DiscreteComponents.PeriodicClock(dt = dt) {^clock_rr}
  sample_fl = DiscreteComponents.Sampler() {^sample_fl}
  estimator_fl = VehicleSystemsComponents.Vehicle.ABSWheelOnlyEstimatorDiscrete(dt = dt, radius = radius, v_ref0 = 0.0, omega0 = 0.0) {^estimator_fl}
  hold_kappa_fl = DiscreteComponents.ZeroOrderHold() {^hold_kappa_fl}
  hold_vref_fl = DiscreteComponents.ZeroOrderHold() {^hold_vref_fl}
  sample_fr = DiscreteComponents.Sampler() {^sample_fr}
  estimator_fr = VehicleSystemsComponents.Vehicle.ABSWheelOnlyEstimatorDiscrete(dt = dt, radius = radius, v_ref0 = 0.0, omega0 = 0.0) {^estimator_fr}
  hold_kappa_fr = DiscreteComponents.ZeroOrderHold() {^hold_kappa_fr}
  hold_vref_fr = DiscreteComponents.ZeroOrderHold() {^hold_vref_fr}
  sample_rl = DiscreteComponents.Sampler() {^sample_rl}
  estimator_rl = VehicleSystemsComponents.Vehicle.ABSWheelOnlyEstimatorDiscrete(dt = dt, radius = radius, v_ref0 = 0.0, omega0 = 0.0) {^estimator_rl}
  hold_kappa_rl = DiscreteComponents.ZeroOrderHold() {^hold_kappa_rl}
  hold_vref_rl = DiscreteComponents.ZeroOrderHold() {^hold_vref_rl}
  sample_rr = DiscreteComponents.Sampler() {^sample_rr}
  estimator_rr = VehicleSystemsComponents.Vehicle.ABSWheelOnlyEstimatorDiscrete(dt = dt, radius = radius, v_ref0 = 0.0, omega0 = 0.0) {^estimator_rr}
  hold_kappa_rr = DiscreteComponents.ZeroOrderHold() {^hold_kappa_rr}
  hold_vref_rr = DiscreteComponents.ZeroOrderHold() {^hold_vref_rr}
relations
  connect(omega_fl, sample_fl.u) {^input_fl}
  connect(sample_fl.y, estimator_fl.omega, clock_fl.y) {^sampled_fl}
  connect(estimator_fl.lambda, hold_kappa_fl.u) {^lambda_fl}
  connect(estimator_fl.v_ref_out, hold_vref_fl.u) {^reference_fl}
  connect(hold_kappa_fl.y, kappa_fl) {^output_fl}
  connect(omega_fr, sample_fr.u) {^input_fr}
  connect(sample_fr.y, estimator_fr.omega, clock_fr.y) {^sampled_fr}
  connect(estimator_fr.lambda, hold_kappa_fr.u) {^lambda_fr}
  connect(estimator_fr.v_ref_out, hold_vref_fr.u) {^reference_fr}
  connect(hold_kappa_fr.y, kappa_fr) {^output_fr}
  connect(omega_rl, sample_rl.u) {^input_rl}
  connect(sample_rl.y, estimator_rl.omega, clock_rl.y) {^sampled_rl}
  connect(estimator_rl.lambda, hold_kappa_rl.u) {^lambda_rl}
  connect(estimator_rl.v_ref_out, hold_vref_rl.u) {^reference_rl}
  connect(hold_kappa_rl.y, kappa_rl) {^output_rl}
  connect(omega_rr, sample_rr.u) {^input_rr}
  connect(sample_rr.y, estimator_rr.omega, clock_rr.y) {^sampled_rr}
  connect(estimator_rr.lambda, hold_kappa_rr.u) {^lambda_rr}
  connect(estimator_rr.v_ref_out, hold_vref_rr.u) {^reference_rr}
  connect(hold_kappa_rr.y, kappa_rr) {^output_rr}
  vx = max(max(hold_vref_fl.y, hold_vref_fr.y), max(hold_vref_rl.y, hold_vref_rr.y))
