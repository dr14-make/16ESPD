"Listen-only CAN receiver and signal conditioning for the Fabia dashboard."
component FabiaClusterNode
  bus = CanNet() {^bus}
  motor_speed = RealInput() {^motor_speed}
  left = BooleanInput() {^left}
  right = BooleanInput() {^right}
  parameter tachometer_scale::Real = 0.5
  parameter dimming::Real = 1.0
  parameter speed_filter_time::Time = 0.15
  parameter emergency_deceleration::Real = 6.0
  parameter emergency_min_speed::Real = 5.0
  parameter hazard_charge_time::Time = 0.05
  parameter hazard_decay_time::Time = 3.0
  speed_rx = FabiaCanRx(slot = 1, id = 128) {^speed_rx}
  abs_rx = FabiaCanRx(slot = 5, id = 112) {^abs_rx}
  speed_limit = BlockComponents.Nonlinear.Limiter(y_min = 0.0, y_max = 1e300) {^speed_limit}
  motor_abs = BlockComponents.Math.Abs() {^motor_abs}
  rpm_gain = BlockComponents.Math.Gain(k = 60.0 / (2.0 * 3.141592653589793)) {^rpm_gain}
  rpm_scale = BlockComponents.Math.Gain(k = tachometer_scale) {^rpm_scale}
  rpm_limit = BlockComponents.Nonlinear.Limiter(y_min = 0.0, y_max = 6000.0) {^rpm_limit}
  emergency_hazard = EmergencyHazard(speed_filter_time = speed_filter_time, emergency_deceleration = emergency_deceleration, emergency_min_speed = emergency_min_speed, hazard_charge_time = hazard_charge_time, hazard_decay_time = hazard_decay_time) {^emergency_hazard}
  abs_active = BlockComponents.Logical.GreaterThreshold(threshold = 0.5) {^abs_active}
  flash_sine = BlockComponents.Sources.Sine(amplitude = 1.0, frequency = 2.5) {^flash_sine}
  flash_positive = BlockComponents.Logical.GreaterThreshold(threshold = 0.0) {^flash_positive}
  esp_flash = BlockComponents.Logical.And() {^esp_flash}
  coolant = BlockComponents.Sources.Constant(k = 90.0) {^coolant}
  off = BlockComponents.Sources.BooleanConstant(k = false) {^off}
  display = FabiaCluster(dimming = dimming) {^display}
relations
  connect(bus, speed_rx.bus, abs_rx.bus) {^w1}
  connect(speed_rx.y, speed_limit.u, emergency_hazard.speed) {^w2}
  connect(speed_limit.y, display.speed) {^w3}
  connect(motor_speed, motor_abs.u) {^w4}
  connect(motor_abs.y, rpm_gain.u) {^motor_rpm_wire}
  connect(rpm_gain.y, rpm_scale.u) {^w5}
  connect(rpm_scale.y, rpm_limit.u) {^w6}
  connect(rpm_limit.y, display.rpm) {^w7}
  connect(emergency_hazard.y, display.hazard) {^w8}
  connect(abs_rx.y, abs_active.u) {^w9}
  connect(abs_active.y, esp_flash.u1) {^w10}
  connect(flash_sine.y, flash_positive.u) {^w11}
  connect(flash_positive.y, esp_flash.u2) {^w12}
  connect(esp_flash.y, display.asr_lamp) {^w13}
  connect(coolant.y, display.coolant) {^w14}
  connect(off.y, display.abs_lamp, display.brake_lamp, display.mil, display.epc, display.charging, display.airbag_lamp) {^w15}
  connect(left, display.left) {^w16}
  connect(right, display.right) {^w17}
