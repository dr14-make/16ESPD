"Signal-only Fabia instrument cluster; physical CAN encoding belongs to the realtime transport."
component FabiaCluster
  "Road speed in m/s"
  speed = RealInput() {^speed}
  "Displayed engine-equivalent speed in rpm"
  rpm = RealInput() {^rpm}
  "Coolant indication in degrees Celsius, not kelvin"
  coolant = RealInput() {^coolant}
  left = BooleanInput() {^left}
  right = BooleanInput() {^right}
  hazard = BooleanInput() {^hazard}
  abs_lamp = BooleanInput() {^abs_lamp}
  asr_lamp = BooleanInput() {^asr_lamp}
  brake_lamp = BooleanInput() {^brake_lamp}
  mil = BooleanInput() {^mil}
  epc = BooleanInput() {^epc}
  charging = BooleanInput() {^charging}
  airbag_lamp = BooleanInput() {^airbag_lamp}
  "Cluster illumination fraction"
  parameter dimming::Real = 1.0
