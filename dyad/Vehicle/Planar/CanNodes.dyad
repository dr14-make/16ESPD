component CanBlendNode
  bus = CanNet() {^bus}
  structural parameter ideal::Boolean = false
  structural parameter friction_period::Real = 0.02
  structural parameter torque_period::Real = 0.02
  parameter ratio::Real = 8.193
  parameter radius::Length = 0.31
  parameter tau_max::Torque = 320
  parameter P_charge::Power = 80.5e3
  parameter v_fade::Real = 10
  blend = VehicleSystemsComponents.Vehicle.Electric.RegenBlend(abs_rule = true, ratio = ratio, radius = radius, tau_max = tau_max, P_charge = P_charge, v_fade = v_fade) {^blend}
  kmh = VehicleSystemsComponents.Vehicle.ToKmPerHour() {^kmh}
  friction_tx = CanTxReal(slot = 4, id = 256, ideal = ideal, period = friction_period, scale = 0.1, raw_min = 0, raw_max = 65535) {^friction_tx}
  torque_tx = CanTxReal(slot = 6, id = 272, ideal = ideal, period = torque_period, scale = 0.1, raw_min = -32768, raw_max = 32767) {^torque_tx}
  pedal_request_rx = CanRxReal(slot = 12, id = 192) {^pedal_request_rx}
  vehicle_speed_rx = CanRxReal(slot = 1, id = 128) {^vehicle_speed_rx}
  front_abs_active_rx = CanRxReal(slot = 5, id = 112) {^front_abs_active_rx}
relations
  connect(bus, vehicle_speed_rx.bus, front_abs_active_rx.bus, pedal_request_rx.bus) {^network}
  connect(pedal_request_rx.y, blend.tau_ref) {^request}
  connect(vehicle_speed_rx.y, kmh.u) {^speed}
  connect(kmh.y, blend.v) {^kmh_speed}
  connect(front_abs_active_rx.y, blend.abs_active) {^abs_state}
  connect(blend.tau_brake, friction_tx.u) {^friction}
  connect(blend.tau_motor, torque_tx.u) {^torque}
  connect(bus, friction_tx.bus) {^friction_bus}
  connect(bus, torque_tx.bus) {^torque_bus}
