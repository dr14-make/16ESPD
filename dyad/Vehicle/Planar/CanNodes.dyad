component CanDriveNode
  bus = CanNet() {^bus}
  spline = Spline() {^spline}
  support = Spline() {^support}
  structural parameter ideal::Boolean = false
  parameter ratio::Real = 8.193
  parameter P_aux::Power = 300
  "Receiver conditioning keeps the inverter request continuous above base speed"
  parameter T_receive::Time = 0.01
  drive = VehicleSystemsComponents.Vehicle.Electric.ElectricDrive(ratio = ratio, P_aux = P_aux)
  response = BlockComponents.Continuous.FirstOrder(T = T_receive) if !ideal
  motor_request_rx = CanRxReal(slot = 6, id = 272)
relations
  connect(bus, motor_request_rx.bus)
  if ideal
    drive.tau_ref = motor_request_rx.y
  else
    response.u = motor_request_rx.y
    connect(response.y, drive.tau_ref)
    initial response.x = 0
  end
  connect(drive.spline, spline)
  connect(drive.support, support)
metadata {
  "_links": {
    "bus": {
      "Dyad": {
        "placement": {
          "icon": {
            "x1": -30,
