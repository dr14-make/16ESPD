component CanPedalNode
  structural parameter pedal_period::Real = 0.01
  bus = CanNet() {^bus}
  tau_ref = RealInput() {^tau_ref}
  structural parameter ideal::Boolean = false
  request_tx = CanTxReal(slot = 12, id = 192, ideal = ideal, period = pedal_period, scale = 0.1, raw_min = -32768, raw_max = 32767) {^request_tx}
relations
  connect(tau_ref, request_tx.u) {^request}
  connect(bus, request_tx.bus) {^network}
