component CanBusBrakeNode
  bus = CanNet() {^bus}
  omega_fl = RealInput(units = "rad/s") {^omega_fl}
  omega_fr = RealInput(units = "rad/s") {^omega_fr}
  omega_rl = RealInput(units = "rad/s") {^omega_rl}
  omega_rr = RealInput(units = "rad/s") {^omega_rr}
  tau_fl = RealOutput() {^tau_fl}
  tau_fr = RealOutput() {^tau_fr}
  tau_rl = RealOutput() {^tau_rl}
  tau_rr = RealOutput() {^tau_rr}
  structural parameter ideal::Boolean = false
  structural parameter speed_period::Real = 0.01
  structural parameter abs_period::Real = 0.01
  structural parameter wheel_period::Real = 0.01
  parameter esp_on::Real = 1
  parameter abs_on::Real = 1
  parameter radius::Length = 0.31
  parameter T_full::Torque = 2500
  ecu = BrakeControlUnit(report_front = true, esp_on = esp_on, abs_on = abs_on, radius = radius, T_max = T_full) {^ecu}
  abs_tx = CanTxReal(slot = 5, id = 112, ideal = ideal, period = abs_period, scale = 1, raw_min = 0, raw_max = 1) {^abs_tx}
  estimator = BrakeWheelEstimator(radius = radius) {^estimator}
  abs_hold = AbsControlHold() {^abs_hold}
  speed_tx = CanTxReal(slot = 1, id = 128, ideal = ideal, period = speed_period, scale = 0.01, raw_min = -32768, raw_max = 32767) {^speed_tx}
  wheel_fl_tx = CanTxReal(slot = 8, id = 176, ideal = ideal, period = wheel_period, scale = 0.01, raw_min = -32768, raw_max = 32767) {^wheel_fl_tx}
  wheel_fr_tx = CanTxReal(slot = 9, id = 177, ideal = ideal, period = wheel_period, scale = 0.01, raw_min = -32768, raw_max = 32767) {^wheel_fr_tx}
  wheel_rl_tx = CanTxReal(slot = 10, id = 178, ideal = ideal, period = wheel_period, scale = 0.01, raw_min = -32768, raw_max = 32767) {^wheel_rl_tx}
  wheel_rr_tx = CanTxReal(slot = 11, id = 179, ideal = ideal, period = wheel_period, scale = 0.01, raw_min = -32768, raw_max = 32767) {^wheel_rr_tx}
  steering_angle_rx = CanRxReal(slot = 2, id = 144) {^steering_angle_rx}
  yaw_rate_rx = CanRxReal(slot = 3, id = 160) {^yaw_rate_rx}
  friction_demand_rx = CanRxReal(slot = 4, id = 256) {^friction_demand_rx}
relations
  connect(bus, steering_angle_rx.bus, yaw_rate_rx.bus, friction_demand_rx.bus, speed_tx.bus, wheel_fl_tx.bus, wheel_fr_tx.bus, wheel_rl_tx.bus, wheel_rr_tx.bus) {^network}
  connect(friction_demand_rx.y, ecu.demand, abs_hold.demand) {^demand}
  connect(estimator.vx, ecu.vx, speed_tx.u, abs_hold.vx) {^speed}
  connect(steering_angle_rx.y, ecu.delta_sw) {^steering}
  connect(yaw_rate_rx.y, ecu.r) {^yaw}
  connect(estimator.kappa_fl, ecu.kappa_fl) {^slip_fl}
  connect(omega_fl, estimator.omega_fl, wheel_fl_tx.u) {^wheel_fl}
  connect(estimator.kappa_fr, ecu.kappa_fr) {^slip_fr}
  connect(omega_fr, estimator.omega_fr, wheel_fr_tx.u) {^wheel_fr}
  connect(estimator.kappa_rl, ecu.kappa_rl) {^slip_rl}
  connect(omega_rl, estimator.omega_rl, wheel_rl_tx.u) {^wheel_rl}
  connect(estimator.kappa_rr, ecu.kappa_rr) {^slip_rr}
  connect(omega_rr, estimator.omega_rr, wheel_rr_tx.u) {^wheel_rr}
  connect(ecu.tau_fl, tau_fl) {^torque_fl}
  connect(ecu.tau_fr, tau_fr) {^torque_fr}
  connect(ecu.tau_rl, tau_rl) {^torque_rl}
  connect(ecu.tau_rr, tau_rr) {^torque_rr}
  connect(ecu.front_active, abs_hold.active) {^abs_state}
  connect(abs_hold.y, abs_tx.u) {^abs_held}
  connect(bus, abs_tx.bus) {^abs_bus}
