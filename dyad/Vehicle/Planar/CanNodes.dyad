component CanClusterNode
  termination = CanTermination()
  bus = CanNet() {^bus}
  speed = RealOutput() {^speed}
  dashboard_speed_rx = CanRxReal(slot = 7, id = 768)
relations
  connect(bus, dashboard_speed_rx.bus)
  connect(bus, termination.bus)
  speed = dashboard_speed_rx.y {^speed}
