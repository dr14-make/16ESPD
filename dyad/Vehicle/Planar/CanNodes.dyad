component CanSensorNode
  bus = CanNet() {^bus}
  measurements = CarBusIn() {^measurements}
  structural parameter ideal::Boolean = false
  structural parameter steering_period::Real = 0.01
  structural parameter yaw_period::Real = 0.01
  structural parameter dashboard_period::Real = 0.1
  motion = BusMotion() {^motion}
  steering_tx = CanTxReal(slot = 2, id = 144, ideal = ideal, period = steering_period, scale = 0.001, raw_min = -32768, raw_max = 32767) {^steering_tx}
  yaw_tx = CanTxReal(slot = 3, id = 160, ideal = ideal, period = yaw_period, scale = 0.001, raw_min = -32768, raw_max = 32767) {^yaw_tx}
  dashboard_tx = CanTxReal(slot = 7, id = 768, ideal = ideal, period = dashboard_period, scale = 0.01, raw_min = -32768, raw_max = 32767) {^dashboard_tx}
relations
  connect(measurements, motion.bus) {^measure}
  connect(motion.vx, dashboard_tx.u) {^dashboard}
  connect(motion.delta_sw, steering_tx.u) {^steering}
  connect(motion.r, yaw_tx.u) {^yaw}
  connect(bus, steering_tx.bus, yaw_tx.bus, dashboard_tx.bus) {^network}
