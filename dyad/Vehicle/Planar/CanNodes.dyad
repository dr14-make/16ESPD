component CanSensorNode
  bus = CanNet() {^bus}
  measurements = CarBusIn() {^measurements}
  structural parameter ideal::Boolean = false
  structural parameter speed_period::Real = 0.01
  structural parameter steering_period::Real = 0.01
  structural parameter yaw_period::Real = 0.01
  structural parameter dashboard_period::Real = 0.1
  motion = BusMotion()
  speed_tx = CanTxReal(slot = 1, id = 128, ideal = ideal, period = speed_period, scale = 0.01, raw_min = -32768, raw_max = 32767)
  steering_tx = CanTxReal(slot = 2, id = 144, ideal = ideal, period = steering_period, scale = 0.001, raw_min = -32768, raw_max = 32767)
  yaw_tx = CanTxReal(slot = 3, id = 160, ideal = ideal, period = yaw_period, scale = 0.001, raw_min = -32768, raw_max = 32767)
  dashboard_tx = CanTxReal(slot = 7, id = 768, ideal = ideal, period = dashboard_period, scale = 0.01, raw_min = -32768, raw_max = 32767)
relations
  connect(measurements, motion.bus)
  connect(motion.vx, speed_tx.u, dashboard_tx.u)
  connect(motion.delta_sw, steering_tx.u)
  connect(motion.r, yaw_tx.u)
  connect(bus, speed_tx.bus)
  connect(bus, steering_tx.bus)
  connect(bus, yaw_tx.bus)
  connect(bus, dashboard_tx.bus)
metadata {
  "_links": {
    "bus": {
      "Dyad": {
        "placement": {
          "icon": {
            "x1": 470,
            "x2": 530,
            "y1": -30,
            "y2": 30
          }
        }
      }
    },
    "measurements": {
      "Dyad": {
        "placement": {
          "icon": {
            "x1": -30,
            "x2": 30,
            "y1": 470,
            "y2": 530
          }
        }
      }
    }
  }
}
end

component CanBlendNode
  bus = CanNet() {^bus}
  tau_ref = RealInput() {^tau_ref}
  structural parameter ideal::Boolean = false
  structural parameter friction_period::Real = 0.02
  structural parameter torque_period::Real = 0.02
  parameter ratio::Real = 8.193
  parameter radius::Length = 0.31
  parameter tau_max::Torque = 320
  parameter P_charge::Power = 80.5e3
  parameter v_fade::Real = 10
  blend = VehicleSystemsComponents.Vehicle.Electric.RegenBlend(abs_rule = true, ratio = ratio, radius = radius, tau_max = tau_max, P_charge = P_charge, v_fade = v_fade)
  kmh = VehicleSystemsComponents.Vehicle.ToKmPerHour()
  friction_tx = CanTxReal(slot = 4, id = 256, ideal = ideal, period = friction_period, scale = 0.1, raw_min = 0, raw_max = 65535)
  torque_tx = CanTxReal(slot = 6, id = 272, ideal = ideal, period = torque_period, scale = 0.1, raw_min = -32768, raw_max = 32767)
  vehicle_speed_rx = CanRxReal(slot = 1, id = 128)
  front_abs_active_rx = CanRxReal(slot = 5, id = 112)
relations
  connect(bus, vehicle_speed_rx.bus, front_abs_active_rx.bus)
  connect(tau_ref, blend.tau_ref)
  kmh.u = vehicle_speed_rx.y
  connect(kmh.y, blend.v)
  blend.abs_active = front_abs_active_rx.y
  connect(blend.tau_brake, friction_tx.u)
  connect(blend.tau_motor, torque_tx.u)
  connect(bus, friction_tx.bus)
  connect(bus, torque_tx.bus)
metadata {
  "_links": {
    "bus": {
      "Dyad": {
        "placement": {
          "icon": {
            "x1": 470,
            "x2": 530,
            "y1": 970,
            "y2": 1030
          }
        }
      }
    },
    "tau_ref": {
      "Dyad": {
        "placement": {
          "icon": {
            "x1": -30,
            "x2": 30,
            "y1": 270,
            "y2": 330
          }
        }
      }
    }
  }
}
end

component CanBrakeNode
  bus = CanNet() {^bus}
  kappa_fl = RealInput() {^kappa_fl}
  kappa_fr = RealInput() {^kappa_fr}
  kappa_rl = RealInput() {^kappa_rl}
  kappa_rr = RealInput() {^kappa_rr}
  tau_fl = RealOutput() {^tau_fl}
  tau_fr = RealOutput() {^tau_fr}
  tau_rl = RealOutput() {^tau_rl}
  tau_rr = RealOutput() {^tau_rr}
  structural parameter ideal::Boolean = false
  structural parameter abs_period::Real = 0.01
  parameter esp_on::Real = 1
  parameter abs_on::Real = 1
  parameter radius::Length = 0.31
  parameter T_full::Torque = 2500
  ecu = BrakeControlUnit(report_front = true, esp_on = esp_on, abs_on = abs_on, radius = radius, T_max = T_full)
  abs_tx = CanTxReal(slot = 5, id = 112, ideal = ideal, period = abs_period, scale = 1, raw_min = 0, raw_max = 1)
  vehicle_speed_rx = CanRxReal(slot = 1, id = 128)
  steering_angle_rx = CanRxReal(slot = 2, id = 144)
  yaw_rate_rx = CanRxReal(slot = 3, id = 160)
  friction_demand_rx = CanRxReal(slot = 4, id = 256)
relations
  connect(bus, vehicle_speed_rx.bus, steering_angle_rx.bus, yaw_rate_rx.bus, friction_demand_rx.bus)
  ecu.demand = friction_demand_rx.y
  ecu.vx = vehicle_speed_rx.y
  ecu.delta_sw = steering_angle_rx.y
  ecu.r = yaw_rate_rx.y
  connect(kappa_fl, ecu.kappa_fl)
  connect(kappa_fr, ecu.kappa_fr)
  connect(kappa_rl, ecu.kappa_rl)
  connect(kappa_rr, ecu.kappa_rr)
  connect(ecu.tau_fl, tau_fl)
  connect(ecu.tau_fr, tau_fr)
  connect(ecu.tau_rl, tau_rl)
  connect(ecu.tau_rr, tau_rr)
  connect(ecu.front_active, abs_tx.u)
  connect(bus, abs_tx.bus)
