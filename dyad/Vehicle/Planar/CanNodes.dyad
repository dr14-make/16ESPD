    }
  }
}
end

"VCU: wired accelerator plus brake ECU regeneration request; no actual-torque feedback."
component CanVcuNode
  bus = CanNet() {^bus}
  spline = Spline() {^spline}
  support = Spline() {^support}
  structural parameter ideal::Boolean = false
  parameter ratio::Real = 8.193
  parameter P_aux::Power = 300
  "Receiver conditioning keeps the inverter request continuous above base speed"
  parameter T_receive::Time = 0.01
  accelerator_request = RealInput() {^accelerator_request}
  "Machine shaft speed"
  motor_speed = RealOutput() {^motor_speed}
  request_sum = BlockComponents.Math.Add() {^request_sum}
  drive = VehicleSystemsComponents.Vehicle.Electric.ElectricDrive(ratio = ratio, P_aux = P_aux) {^drive}
  response = BlockComponents.Continuous.FirstOrder(T = T_receive) {^response}
  "Ideal passes the decoded request; otherwise the conditioned one"
  receive = VehicleSystemsComponents.Vehicle.ParameterSwitch(on = ideal) {^receive}
  motor_request_rx = CanRxReal(slot = 6, id = 272) {^motor_request_rx}
relations
  connect(accelerator_request, request_sum.u1) {^accelerator}
  connect(request_sum.y, drive.tau_ref) {^regen}
  connect(bus, motor_request_rx.bus) {^network}
  connect(motor_request_rx.y, response.u, receive.u1) {^decoded}
  connect(response.y, receive.u2) {^conditioned}
  connect(receive.y, request_sum.u2) {^received}
  connect(drive.machine_speed, motor_speed) {^speed_wire}
  initial response.x = 0
  connect(drive.spline, spline) {^shaft}
  connect(drive.support, support) {^mount}
