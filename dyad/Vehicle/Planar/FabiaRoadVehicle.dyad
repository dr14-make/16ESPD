"Fabia-only signal exports; the shared vehicle equations remain unchanged."
component FabiaRoadVehicle
  extends RoadBEVDrive
  motor_speed = RealOutput() {^motor_speed}
  speed = RealOutput() {^speed}
  abs_active = RealOutput() {^abs_active}
relations
  motor_speed = drive.machine.w
  connect(motion.vx, speed)
  connect(ecu.front_active, abs_active)
