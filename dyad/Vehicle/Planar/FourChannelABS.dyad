"""Four independently modulated sampled ABS channels with optional rear select-low."""
component FourChannelABS@[input clk extends Discrete]
  demand = RealInput@[clk]() {^demand}
  v_ref = RealInput@[clk]() {^v_ref}
  dT_fl = RealInput@[clk]() {^dT_fl}
  dT_fr = RealInput@[clk]() {^dT_fr}
  dT_rl = RealInput@[clk]() {^dT_rl}
  dT_rr = RealInput@[clk]() {^dT_rr}
  kappa_fl = RealInput@[clk]() {^kappa_fl}
  kappa_fr = RealInput@[clk]() {^kappa_fr}
  kappa_rl = RealInput@[clk]() {^kappa_rl}
  kappa_rr = RealInput@[clk]() {^kappa_rr}
  tau_fl = RealOutput@[clk]() {^tau_fl}
  tau_fr = RealOutput@[clk]() {^tau_fr}
  tau_rl = RealOutput@[clk]() {^tau_rl}
  tau_rr = RealOutput@[clk]() {^tau_rr}
  fl = VehicleSystemsComponents.Vehicle.Planar.BrakeChannel(dt = dt, T_p = T_p, lambda_1 = lambda_1_f, lambda_lock = lambda_lock, alpha_rel = alpha_rel, beta_reapply = beta_reapply, l_rec = l_rec, T_hold_max = T_hold_max, k_dec = k_dec, k_inc_fast = k_inc_fast, k_inc_slow = k_inc_slow, v_min = v_min) {^fl}
  fr = VehicleSystemsComponents.Vehicle.Planar.BrakeChannel(dt = dt, T_p = T_p, lambda_1 = lambda_1_f, lambda_lock = lambda_lock, alpha_rel = alpha_rel, beta_reapply = beta_reapply, l_rec = l_rec, T_hold_max = T_hold_max, k_dec = k_dec, k_inc_fast = k_inc_fast, k_inc_slow = k_inc_slow, v_min = v_min) {^fr}
  rl = VehicleSystemsComponents.Vehicle.Planar.BrakeChannel(dt = dt, T_p = T_p, lambda_1 = lambda_1_r, lambda_lock = lambda_lock, alpha_rel = alpha_rel, beta_reapply = beta_reapply, l_rec = l_rec, T_hold_max = T_hold_max, k_dec = k_dec, k_inc_fast = k_inc_fast, k_inc_slow = k_inc_slow, v_min = v_min) {^rl}
  rr = VehicleSystemsComponents.Vehicle.Planar.BrakeChannel(dt = dt, T_p = T_p, lambda_1 = lambda_1_r, lambda_lock = lambda_lock, alpha_rel = alpha_rel, beta_reapply = beta_reapply, l_rec = l_rec, T_hold_max = T_hold_max, k_dec = k_dec, k_inc_fast = k_inc_fast, k_inc_slow = k_inc_slow, v_min = v_min) {^rr}
  parameter dt::Time(min = eps(Float64)) = 0.005
  parameter T_p::Time(min = 0.0) = 0.03
  parameter lambda_1_f::Real = 0.08
  parameter lambda_1_r::Real = 0.06
  parameter lambda_lock::Real = 0.20
  parameter alpha_rel::Real = 0.6
  parameter beta_reapply::Real = 0.85
  parameter l_rec::Real = 0.03
  parameter T_hold_max::Time(min = eps(Float64)) = 0.06
  parameter k_dec::Real = 40000.0
  parameter k_inc_fast::Real = 160000.0
  parameter k_inc_slow::Real = 16000.0
  parameter v_min::Velocity = 1.5
  parameter select_low::Real = 1.0
  variable rear_low::Torque
relations
  connect(demand, fl.demand, fr.demand, rl.demand, rr.demand) {^w1}
  connect(v_ref, fl.v_ref, fr.v_ref, rl.v_ref, rr.v_ref) {^w2}
  connect(dT_fl, fl.dT) {^w3}
  connect(dT_fr, fr.dT) {^w4}
  connect(dT_rl, rl.dT) {^w5}
  connect(dT_rr, rr.dT) {^w6}
  connect(kappa_fl, fl.kappa) {^w7}
  connect(kappa_fr, fr.kappa) {^w8}
  connect(kappa_rl, rl.kappa) {^w9}
  connect(kappa_rr, rr.kappa) {^w10}
  connect(fl.tau_cmd, tau_fl) {^w11}
  connect(fr.tau_cmd, tau_fr) {^w12}
  rear_low = min(rl.tau_cmd, rr.tau_cmd)
  tau_rl = ifelse(select_low > 0.5, rear_low, rl.tau_cmd)
  tau_rr = ifelse(select_low > 0.5, rear_low, rr.tau_cmd)
metadata {
  "Dyad": {"icons": {"default": "dyad://MultibodyComponents/CascadeServoController.svg"}},
  "_links": {
    "demand": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 100, "x2": 50, "y2": 200}, "diagram": {"x1": 390, "y1": -50, "x2": 490, "y2": 50, "rot": 90}}}},
    "v_ref": {"Dyad": {"placement": {"icon": {"x1": 50, "y1": 950, "x2": 150, "y2": 1050, "rot": 270}, "diagram": {"x1": 350, "y1": 1000, "x2": 450, "y2": 1100, "rot": 270}}}},
    "dT_fl": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 300, "x2": 50, "y2": 400}, "diagram": {"x1": -30, "y1": 30, "x2": 30, "y2": 90}}}},
