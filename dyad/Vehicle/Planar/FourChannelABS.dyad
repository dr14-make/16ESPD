"""Four independently modulated sampled ABS channels with optional rear select-low."""
component FourChannelABS@[input clk extends Discrete]
  demand = RealInput@[clk]()
  v_ref = RealInput@[clk]()
  dT_fl = RealInput@[clk]()
  dT_fr = RealInput@[clk]()
  dT_rl = RealInput@[clk]()
  dT_rr = RealInput@[clk]()
  kappa_fl = RealInput@[clk]()
  kappa_fr = RealInput@[clk]()
  kappa_rl = RealInput@[clk]()
  kappa_rr = RealInput@[clk]()
  tau_fl = RealOutput@[clk]()
  tau_fr = RealOutput@[clk]()
  tau_rl = RealOutput@[clk]()
  tau_rr = RealOutput@[clk]()
  fl = VehicleSystemsComponents.Vehicle.Planar.BrakeChannel(dt = dt, T_p = T_p, lambda_1 = lambda_1_f, lambda_lock = lambda_lock, alpha_rel = alpha_rel, beta_reapply = beta_reapply, l_rec = l_rec, T_hold_max = T_hold_max, k_dec = k_dec, k_inc_fast = k_inc_fast, k_inc_slow = k_inc_slow, v_min = v_min)
  fr = VehicleSystemsComponents.Vehicle.Planar.BrakeChannel(dt = dt, T_p = T_p, lambda_1 = lambda_1_f, lambda_lock = lambda_lock, alpha_rel = alpha_rel, beta_reapply = beta_reapply, l_rec = l_rec, T_hold_max = T_hold_max, k_dec = k_dec, k_inc_fast = k_inc_fast, k_inc_slow = k_inc_slow, v_min = v_min)
  rl = VehicleSystemsComponents.Vehicle.Planar.BrakeChannel(dt = dt, T_p = T_p, lambda_1 = lambda_1_r, lambda_lock = lambda_lock, alpha_rel = alpha_rel, beta_reapply = beta_reapply, l_rec = l_rec, T_hold_max = T_hold_max, k_dec = k_dec, k_inc_fast = k_inc_fast, k_inc_slow = k_inc_slow, v_min = v_min)
  rr = VehicleSystemsComponents.Vehicle.Planar.BrakeChannel(dt = dt, T_p = T_p, lambda_1 = lambda_1_r, lambda_lock = lambda_lock, alpha_rel = alpha_rel, beta_reapply = beta_reapply, l_rec = l_rec, T_hold_max = T_hold_max, k_dec = k_dec, k_inc_fast = k_inc_fast, k_inc_slow = k_inc_slow, v_min = v_min)
  parameter dt::Time(min = eps(Float64)) = 0.005
  parameter T_p::Time(min = 0.0) = 0.03
  parameter lambda_1_f::Real = 0.08
  parameter lambda_1_r::Real = 0.06
  parameter lambda_lock::Real = 0.20
  parameter alpha_rel::Real = 0.6
  parameter beta_reapply::Real = 0.85
  parameter l_rec::Real = 0.03
  parameter T_hold_max::Time(min = eps(Float64)) = 0.06
  parameter k_dec::Real = 40000.0
  parameter k_inc_fast::Real = 160000.0
  parameter k_inc_slow::Real = 16000.0
  parameter v_min::Velocity = 1.5
  parameter select_low::Real = 1.0
  variable rear_low::Torque
relations
  connect(demand, fl.demand, fr.demand, rl.demand, rr.demand)
  connect(v_ref, fl.v_ref, fr.v_ref, rl.v_ref, rr.v_ref)
  connect(dT_fl, fl.dT)
  connect(dT_fr, fr.dT)
  connect(dT_rl, rl.dT)
  connect(dT_rr, rr.dT)
  connect(kappa_fl, fl.kappa)
  connect(kappa_fr, fr.kappa)
  connect(kappa_rl, rl.kappa)
  connect(kappa_rr, rr.kappa)
  connect(fl.tau_cmd, tau_fl)
  connect(fr.tau_cmd, tau_fr)
  rear_low = min(rl.tau_cmd, rr.tau_cmd)
  tau_rl = ifelse(select_low > 0.5, rear_low, rl.tau_cmd)
  tau_rr = ifelse(select_low > 0.5, rear_low, rr.tau_cmd)
end

"Rear select-low wiring check."
test component TestFourChannelABS
  clock = DiscreteComponents.PeriodicClock(dt = 0.005)
  demand = BlockComponents.Sources.Constant(k = 1000.0)
  speed = BlockComponents.Sources.Constant(k = 20.0)
  zero = BlockComponents.Sources.Constant(k = 0.0)
  cut = BlockComponents.Sources.Constant(k = -200.0)
  demand_sampler = DiscreteComponents.Sampler()
  speed_sampler = DiscreteComponents.Sampler()
  zero_sampler = DiscreteComponents.Sampler()
  cut_sampler = DiscreteComponents.Sampler()
  abs = VehicleSystemsComponents.Vehicle.Planar.FourChannelABS(select_low = 1.0)
  hold_rl = DiscreteComponents.ZeroOrderHold()
  hold_rr = DiscreteComponents.ZeroOrderHold()
relations
  connect(demand.y, demand_sampler.u)
  connect(speed.y, speed_sampler.u)
  connect(zero.y, zero_sampler.u)
  connect(cut.y, cut_sampler.u)
  connect(demand_sampler.y, abs.demand, clock.y)
  connect(speed_sampler.y, abs.v_ref)
  connect(zero_sampler.y, abs.dT_fl, abs.dT_fr, abs.dT_rl, abs.kappa_fl, abs.kappa_fr, abs.kappa_rl, abs.kappa_rr)
  connect(cut_sampler.y, abs.dT_rr)
  connect(abs.tau_rl, hold_rl.u)
  connect(abs.tau_rr, hold_rr.u)
metadata {
  "Dyad": {
    "tests": {
      "rear_select_low": {
        "solver": "Tsit5", "stop": 0.02,
        "atol": {"hold_rl.y": 1e-8, "hold_rr.y": 1e-8},
        "expect": {"final": {"hold_rl.y": 800.0, "hold_rr.y": 800.0}, "signals": ["hold_rl.y", "hold_rr.y"]}
      }
    }
  }
}
end
