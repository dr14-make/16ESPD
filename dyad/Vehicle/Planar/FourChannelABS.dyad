    "tau_rr": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 750, "x2": 1050, "y2": 850}, "diagram": {"x1": 950, "y1": 850, "x2": 1050, "y2": 950}}}},
    "fl": {"Dyad": {"placement": {"diagram": {"x1": 500, "y1": 100, "x2": 600, "y2": 200}}}},
    "fr": {"Dyad": {"placement": {"diagram": {"x1": 500, "y1": 350, "x2": 600, "y2": 450}}}},
