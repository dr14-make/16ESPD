end

"Rear select-low wiring check."
test component TestFourChannelABS
  clock = DiscreteComponents.PeriodicClock(dt = 0.005) {^clock}
  demand = BlockComponents.Sources.Constant(k = 1000.0) {^demand}
  speed = BlockComponents.Sources.Constant(k = 20.0) {^speed}
  zero = BlockComponents.Sources.Constant(k = 0.0) {^zero}
  cut = BlockComponents.Sources.Constant(k = -200.0) {^cut}
  demand_sampler = DiscreteComponents.Sampler() {^demand_sampler}
  speed_sampler = DiscreteComponents.Sampler() {^speed_sampler}
  zero_sampler = DiscreteComponents.Sampler() {^zero_sampler}
  cut_sampler = DiscreteComponents.Sampler() {^cut_sampler}
  abs = VehicleSystemsComponents.Vehicle.Planar.FourChannelABS(select_low = 1.0) {^abs}
  hold_rl = DiscreteComponents.ZeroOrderHold() {^hold_rl}
  hold_rr = DiscreteComponents.ZeroOrderHold() {^hold_rr}
relations
  connect(demand.y, demand_sampler.u) {^w1}
  connect(speed.y, speed_sampler.u) {^w2}
  connect(zero.y, zero_sampler.u) {^w3}
  connect(cut.y, cut_sampler.u) {^w4}
  connect(demand_sampler.y, abs.demand, clock.y) {^w5}
  connect(speed_sampler.y, abs.v_ref) {^w6}
  connect(zero_sampler.y, abs.dT_fl, abs.dT_fr, abs.dT_rl, abs.kappa_fl, abs.kappa_fr, abs.kappa_rl, abs.kappa_rr) {^w7}
  connect(cut_sampler.y, abs.dT_rr) {^w8}
  connect(abs.tau_rl, hold_rl.u) {^w9}
  connect(abs.tau_rr, hold_rr.u) {^w10}
metadata {
  "Dyad": {
    "tests": {
      "rear_select_low": {
        "solver": "Tsit5", "stop": 0.02,
        "atol": {"hold_rl.y": 1e-8, "hold_rr.y": 1e-8},
        "expect": {"final": {"hold_rl.y": 800.0, "hold_rr.y": 800.0}, "signals": ["hold_rl.y", "hold_rr.y"]}
      }
    }
  },
  "_links": {
