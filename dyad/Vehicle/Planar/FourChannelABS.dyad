    "kappa_rl": {"Dyad": {"placement": {"icon": {"x1": 650, "y1": 950, "x2": 750, "y2": 1050, "rot": 270}, "diagram": {"x1": -30, "y1": 710, "x2": 30, "y2": 770}}}},
