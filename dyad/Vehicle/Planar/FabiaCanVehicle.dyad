"Fabia-only signal exports; the shared vehicle equations remain unchanged."
component FabiaCanVehicle
  extends PlanarBEVCanDrive
  motor_speed = RealOutput() {^motor_speed}
  bus = CanNet() {^bus}
relations
  motor_speed = drive.drive.machine.w
  connect(bus, motion.bus)
