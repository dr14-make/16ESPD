"""
One sampled wheel-brake channel combining driver demand, ESP allocation, and ABS.

Positive ESP demand enters before ABS. A negative ESP request cuts pressure after ABS so
it remains effective when driver demand exceeds available tire friction.
"""
component BrakeChannel@[input clk extends Discrete]
  demand = RealInput@[clk]()
  dT = RealInput@[clk]()
  kappa = RealInput@[clk]()
  v_ref = RealInput@[clk]()
  tau_cmd = RealOutput@[clk]()
  modulator = VehicleSystemsComponents.Vehicle.ABSModulatorDiscrete(dt = dt, T_p = T_p, lambda_1 = lambda_1, lambda_lock = lambda_lock, alpha_rel = alpha_rel, beta_reapply = beta_reapply, l_rec = l_rec, T_hold_max = T_hold_max, k_dec = k_dec, k_inc_fast = k_inc_fast, k_inc_slow = k_inc_slow, v_min = v_min)
  parameter dt::Time(min = eps(Float64)) = 0.005
  parameter T_p::Time(min = 0.0) = 0.03
  parameter lambda_1::Real = 0.08
  parameter lambda_lock::Real = 0.20
  parameter alpha_rel::Real = 0.6
  parameter beta_reapply::Real = 0.85
  parameter l_rec::Real = 0.03
  parameter T_hold_max::Time(min = eps(Float64)) = 0.06
  parameter k_dec::Real = 40000.0
  parameter k_inc_fast::Real = 160000.0
  parameter k_inc_slow::Real = 16000.0
  parameter v_min::Velocity = 1.5
relations
  modulator.demand = demand + max(dT, 0.0)
  connect(kappa, modulator.lambda)
  connect(v_ref, modulator.v_ref)
  tau_cmd = max(modulator.tau_cmd - max(-dT, 0.0), 0.0)
end

"Sampled channel wiring check with held output."
test component TestBrakeChannel
  clock = DiscreteComponents.PeriodicClock(dt = 0.005)
  demand = BlockComponents.Sources.Constant(k = 1000.0)
  correction = BlockComponents.Sources.Constant(k = -200.0)
  slip = BlockComponents.Sources.Constant(k = 0.0)
  speed = BlockComponents.Sources.Constant(k = 20.0)
  demand_sampler = DiscreteComponents.Sampler()
  correction_sampler = DiscreteComponents.Sampler()
  slip_sampler = DiscreteComponents.Sampler()
  speed_sampler = DiscreteComponents.Sampler()
  channel = VehicleSystemsComponents.Vehicle.Planar.BrakeChannel()
  hold = DiscreteComponents.ZeroOrderHold()
relations
  connect(demand.y, demand_sampler.u)
  connect(correction.y, correction_sampler.u)
  connect(slip.y, slip_sampler.u)
  connect(speed.y, speed_sampler.u)
  connect(demand_sampler.y, channel.demand, clock.y)
  connect(correction_sampler.y, channel.dT)
  connect(slip_sampler.y, channel.kappa)
  connect(speed_sampler.y, channel.v_ref)
  connect(channel.tau_cmd, hold.u)
metadata {
  "Dyad": {
    "tests": {
      "post_abs_cut": {
        "solver": "Tsit5", "stop": 0.02,
        "atol": {"hold.y": 1e-8},
        "expect": {"final": {"hold.y": 800.0}, "signals": ["hold.y"]}
      }
    }
  }
}
end
