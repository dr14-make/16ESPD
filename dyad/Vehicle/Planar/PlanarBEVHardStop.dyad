    "w14": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 170, "y": 800}, {"x": 170, "y": 860}, {"x": 260, "y": 860}], "E": 2}]}},
    "w15": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 160, "y": 820}, {"x": 160, "y": 880}, {"x": 300, "y": 880}], "E": 2}]}},
