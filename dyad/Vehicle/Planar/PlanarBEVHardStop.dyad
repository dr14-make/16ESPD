    "w11": {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 180, "y": 633}], "E": 2}, {"S": -1, "M": [], "E": 3}, {"S": -1, "M": [], "E": -2}, {"S": -2, "M": [], "E": 4}, {"S": -2, "M": [{"x": 180, "y": 693}], "E": 5}], "junctions": [{"x": 180, "y": 653}, {"x": 180, "y": 673}]}},
    "w12": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 180, "y": 760}, {"x": 180, "y": 733}], "E": 2}]}},
