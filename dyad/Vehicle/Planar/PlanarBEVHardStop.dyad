end

analysis PlanarBEVHardStopTransient
  extends TransientAnalysis(stop = 6.0, alg = ODEAlg.Rodas5P(), dtmax = 0.005, tstops = [0.5, 0.6], optimize = OptimizationLevel.None())
  parameter T_cmd::Torque = 2500.0
  parameter tau_max::Torque = 320.0
  parameter P_charge::Power = 80.5e3
  parameter v_fade::Real = 10.0
  "Withdraw regen while the front ABS acts; 0 reproduces step 5"
  parameter withdraw::Real = 1.0
  "Road grip multiplier, 0.3 for the low-grip comparison"
  parameter road_mu::Real = 1.0
  model = VehicleSystemsComponents.Vehicle.Planar.PlanarBEVHardStop(T_cmd = T_cmd, tau_max = tau_max, P_charge = P_charge, v_fade = v_fade, withdraw = withdraw, road_mu = road_mu)
relations
end
