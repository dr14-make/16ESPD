    "w18": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 460, "y": 713}, {"x": 460, "y": 743}], "E": 2}]}},
    "w19": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 450, "y": 753}, {"x": 450, "y": 900}, {"x": 750, "y": 900}, {"x": 750, "y": 743}], "E": 2}]}},
    "w20": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 320, "y": 520}], "E": 2}]}}
