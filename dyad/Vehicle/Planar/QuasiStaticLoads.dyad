"""Quasi-static wheel loads from filtered chassis acceleration."""
component QuasiStaticLoads
  chassis = Frame2D() {^chassis}
  fl = Flange() {^fl}
  fr = Flange() {^fr}
  rl = Flange() {^rl}
  rr = Flange() {^rr}
  "Vehicle mass (probe)"
  parameter m::Mass = 1500.0
  "CG distance to front axle (probe)"
  parameter a::Length = 1.2
  "CG distance to rear axle (probe)"
  parameter b::Length = 1.5
  "Track width (probe)"
  parameter tw::Length = 1.55
  "Gravitational acceleration used for vertical loads (probe)"
  parameter g::Acceleration = 9.81
  "CG height above the road (NHTSA)"
  parameter h::Length = 0.0
  "Enable acceleration filtering and load transfer (derived)"
  structural parameter load_transfer::Boolean = false
  "Load-transfer lag time constant (assumed)"
  parameter T_lt::Time = 0.05
  final parameter L::Length = a + b
  "Static normal load on each front wheel (derived)"
  variable Nf::Force
  "Static normal load on each rear wheel (derived)"
  variable Nr::Force
  "Filtered longitudinal acceleration (assumed)"
  variable axf::Acceleration
  "Filtered lateral acceleration (assumed)"
  variable ayf::Acceleration
  variable d_long::Force
  variable dN_fl::Force
  variable dN_fr::Force
  variable dN_rl::Force
  variable dN_rr::Force
  acc = MultibodyComponents.PlanarMechanics.AbsoluteAcceleration() {^acc}
relations
  connect(chassis, acc.frame_a) {^w1}
  Nf = m * g * b / (2 * L)
  Nr = m * g * a / (2 * L)
  if load_transfer == false
    axf = 0.0
    ayf = 0.0
  else
    der(axf) = (acc.a_x - axf) / T_lt
    der(ayf) = (acc.a_y - ayf) / T_lt
    initial axf = 0.0
    initial ayf = 0.0
  end
  d_long = -m * axf * h / (2 * L)
  dN_fl = d_long - m * ayf * h * (b / L) / tw
  dN_fr = d_long + m * ayf * h * (b / L) / tw
  dN_rl = -d_long - m * ayf * h * (a / L) / tw
  dN_rr = -d_long + m * ayf * h * (a / L) / tw
  fl.f = -(Nf + dN_fl)
  fr.f = -(Nf + dN_fr)
  rl.f = -(Nr + dN_rl)
  rr.f = -(Nr + dN_rr)
metadata {
  "Dyad": {"icons": {"default": "dyad://TranslationalComponents/Force.svg"}},
  "_links": {
    "chassis": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 450, "x2": 50, "y2": 550}, "diagram": {"x1": -50, "y1": 450, "x2": 50, "y2": 550}}}},
    "fl": {"Dyad": {"placement": {"icon": {"x1": 200, "y1": -50, "x2": 300, "y2": 50}, "diagram": {"x1": 200, "y1": -50, "x2": 300, "y2": 50}}}},
    "fr": {"Dyad": {"placement": {"icon": {"x1": 700, "y1": -50, "x2": 800, "y2": 50}, "diagram": {"x1": 700, "y1": -50, "x2": 800, "y2": 50}}}},
    "rl": {"Dyad": {"placement": {"icon": {"x1": 200, "y1": 950, "x2": 300, "y2": 1050}, "diagram": {"x1": 200, "y1": 950, "x2": 300, "y2": 1050}}}},
    "rr": {"Dyad": {"placement": {"icon": {"x1": 700, "y1": 950, "x2": 800, "y2": 1050}, "diagram": {"x1": 700, "y1": 950, "x2": 800, "y2": 1050}}}},
    "acc": {"Dyad": {"placement": {"diagram": {"x1": 450, "y1": 450, "x2": 550, "y2": 550}}}},
    "w1": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}}
  }
}
end

"""Prescribed-acceleration rig for quasi-static wheel-load transfer."""
test component TestQuasiStaticLoads
  parameter ax::Acceleration = -4.0
  parameter ay::Acceleration = 0.0
  parameter h::Length = 0.55
  vx = BlockComponents.Sources.Ramp(offset = 0.0, height = 2 * ax, duration = 2.0, start_time = 0.0) {^vx}
  vy = BlockComponents.Sources.Ramp(offset = 0.0, height = 2 * ay, duration = 2.0, start_time = 0.0) {^vy}
  motion = MultibodyComponents.PlanarMechanics.PrescribedVelocity(fixed_orientation = true) {^motion}
  loads = VehicleSystemsComponents.Vehicle.Planar.QuasiStaticLoads(h = h, load_transfer = true) {^loads}
  fixed_fl = TranslationalComponents.Components.Fixed() {^fixed_fl}
  fixed_fr = TranslationalComponents.Components.Fixed() {^fixed_fr}
  fixed_rl = TranslationalComponents.Components.Fixed() {^fixed_rl}
  fixed_rr = TranslationalComponents.Components.Fixed() {^fixed_rr}
relations
  connect(vx.y, motion.v_x) {^w1}
  connect(vy.y, motion.v_y) {^w2}
  connect(motion.frame_b, loads.chassis) {^w3}
  connect(loads.fl, fixed_fl.flange) {^w4}
  connect(loads.fr, fixed_fr.flange) {^w5}
  connect(loads.rl, fixed_rl.flange) {^w6}
  connect(loads.rr, fixed_rr.flange) {^w7}
metadata {
  "Dyad": {
    "tests": {
      "longitudinal": {
        "solver": "Tsit5", "stop": 1.0,
        "params": {"ax": -4.0, "ay": 0.0, "h": 0.55},
        "atol": {"loads.dN_fl": 0.1, "loads.dN_fr": 0.1, "loads.dN_rl": 0.1, "loads.dN_rr": 0.1},
        "expect": {"final": {"loads.dN_fl": 611.1, "loads.dN_fr": 611.1, "loads.dN_rl": -611.1, "loads.dN_rr": -611.1}, "signals": ["loads.dN_fl", "loads.dN_fr", "loads.dN_rl", "loads.dN_rr"]}
      },
      "lateral": {
        "solver": "Tsit5", "stop": 1.0,
        "params": {"ax": 0.0, "ay": 3.873, "h": 0.55},
        "atol": {"loads.dN_fl": 0.5, "loads.dN_fr": 0.5, "loads.dN_rl": 0.5, "loads.dN_rr": 0.5},
        "expect": {"final": {"loads.dN_fl": -1145.2, "loads.dN_fr": 1145.2, "loads.dN_rl": -916.2, "loads.dN_rr": 916.2}, "signals": ["loads.dN_fl", "loads.dN_fr", "loads.dN_rl", "loads.dN_rr"]}
      }
    }
  },
  "_links": {
    "vx": {"Dyad": {"placement": {"diagram": {"x1": 50, "y1": 230, "x2": 150, "y2": 330}}}},
    "vy": {"Dyad": {"placement": {"diagram": {"x1": 50, "y1": 380, "x2": 150, "y2": 480}}}},
    "motion": {"Dyad": {"placement": {"diagram": {"x1": 250, "y1": 300, "x2": 350, "y2": 400}}}},
    "loads": {"Dyad": {"placement": {"diagram": {"x1": 500, "y1": 300, "x2": 600, "y2": 400}}}},
    "fixed_fl": {"Dyad": {"placement": {"diagram": {"x1": 380, "y1": 130, "x2": 480, "y2": 230, "rot": 180}}}},
    "fixed_fr": {"Dyad": {"placement": {"diagram": {"x1": 620, "y1": 130, "x2": 720, "y2": 230, "rot": 180}}}},
    "fixed_rl": {"Dyad": {"placement": {"diagram": {"x1": 380, "y1": 470, "x2": 480, "y2": 570}}}},
    "fixed_rr": {"Dyad": {"placement": {"diagram": {"x1": 620, "y1": 470, "x2": 720, "y2": 570}}}},
    "w1": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 202.5, "y": 280}, {"x": 202.5, "y": 330}], "E": 2}]}},
    "w2": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 202.5, "y": 430}, {"x": 202.5, "y": 370}], "E": 2}]}},
    "w3": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w4": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 525, "y": 265}, {"x": 430, "y": 265}], "E": 2}]}},
    "w5": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 575, "y": 265}, {"x": 670, "y": 265}], "E": 2}]}},
    "w6": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 525, "y": 435}, {"x": 430, "y": 435}], "E": 2}]}},
    "w7": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 575, "y": 435}, {"x": 670, "y": 435}], "E": 2}]}}
  }
}
end

analysis QuasiStaticLoadsTransient
  extends TransientAnalysis(stop = 1.0, alg = ODEAlg.Tsit5(), dtmax = 0.005)
  parameter ax::Acceleration = -4.0
  parameter ay::Acceleration = 0.0
  parameter h::Length = 0.55
  model = VehicleSystemsComponents.Vehicle.Planar.TestQuasiStaticLoads(ax = ax, ay = ay, h = h)
relations
end
