"""
Ideal continuously variable transmission that holds its input shaft at a commanded speed.

The physics and parameters are ControlledVariator's: the ratio is total engine-side to
wheel-side speed reduction, the requested ratio places the input shaft at the target speed, and
the actual ratio reaches it through a first-order lag. The target comes from a signal, such as an
engine operating line, instead of the pedal schedule. Outside [i_overdrive, i_launch] the ratio
saturates and the input speed leaves the target: below it at launch, above it at speed. The
output speed floor biases the ratio low by sqrt(1 + (floor / N_b)^2), 0.6 % at 450 rpm.
"""
component SpeedCommandedVariator
  "Input shaft"
  spline_a = Spline() {^spline_a}
  "Output shaft"
  spline_b = Spline() {^spline_b}
  "Transmission housing"
  support = Spline() {^support}
  "Target input speed [rpm]"
  N_ref = RealInput() {^N_ref}
  "Launch ratio, including final drive (assumed for a small-car belt CVT)"
  parameter i_launch::Real = 12.0
  "Overdrive ratio, including final drive (assumed for a small-car belt CVT)"
  parameter i_overdrive::Real = 2.8
  "Ratio actuator time constant [s] (assumed for a hydraulic belt CVT)"
  parameter ratio_time::Time(min = eps(Float64)) = 0.5
  "Regularizing output speed [rpm] (assumed to keep the launch command finite)"
  parameter output_rpm_floor::Real(min = eps(Float64)) = 50.0
  "Initial total ratio (assumed launch setting; override for initialized cruise)"
  parameter ratio_initial::Real = i_launch
  "Input speed relative to the housing [rad/s]"
  variable w_a::AngularVelocity
  "Output speed relative to the housing [rad/s]"
  variable w_b::AngularVelocity
  "Input speed [rpm]"
  variable N_a::Real
  "Output speed magnitude [rpm]"
  variable N_b::Real
  "Bounded ratio command"
  variable i_command::Real
  "Actual total speed ratio"
  variable ratio::Real
relations
  w_a = der(spline_a.phi) - der(support.phi)
  w_b = der(spline_b.phi) - der(support.phi)
  N_a = w_a * 30 / pi
  N_b = sqrt((w_b * 30 / pi)^2 + output_rpm_floor^2)
  i_command = min(max(N_ref / N_b, i_overdrive), i_launch)
  der(ratio) = (i_command - ratio) / ratio_time
  w_a = ratio * w_b
  0 = ratio * spline_a.tau + spline_b.tau
  support.tau = -spline_a.tau - spline_b.tau
  initial ratio = ratio_initial
metadata {
  "Dyad": {"icons": {"default": "dyad://RotationalComponents/IdealGear.svg"}},
  "_links": {
    "spline_a": {"Dyad": {"placement": {"icon": {"iconName": "spline_a", "x1": -50, "y1": 450, "x2": 50, "y2": 550}, "diagram": {"iconName": "spline_a", "x1": -25, "y1": 475, "x2": 25, "y2": 525}}}},
    "spline_b": {"Dyad": {"placement": {"icon": {"iconName": "spline_b", "x1": 950, "y1": 450, "x2": 1050, "y2": 550}, "diagram": {"iconName": "spline_b", "x1": 975, "y1": 475, "x2": 1025, "y2": 525}}}},
    "support": {"Dyad": {"placement": {"icon": {"x1": 450, "y1": 950, "x2": 550, "y2": 1050}, "diagram": {"x1": 475, "y1": 975, "x2": 525, "y2": 1025}}}},
    "N_ref": {"Dyad": {"placement": {"icon": {"x1": 250, "y1": -50, "x2": 350, "y2": 50}, "diagram": {"x1": 275, "y1": -25, "x2": 325, "y2": 25}}}}
  }
}
end
