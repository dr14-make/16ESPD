"""
DC-equivalent traction machine: a back-EMF element behind armature resistance and inductance,
with the deck's speed-dependent losses as parts on the shaft.

    v = R i + L di/dt + E        E = k w        tau_em = k i
    tau = tau_em - T_f - K_i - k_w w^2 - C / w - J dw/dt

`k` is KΦ, the torque and back-EMF constant. `i` flows into `p`, through the armature and out
of `n`; it is negative while the machine generates. `tau` is the torque the shaft delivers at
`spline`, measured against the housing `support`. Every loss is its own part, and its power is
readable on its own: `P_cu = R i^2` in the resistor, `P_fric = T_f w` (bearing friction),
`P_iron = K_i w` (hysteresis), `P_wind = k_w w^3` (windage) and `P_const = C`, the losses
present at any speed. They sum to `P_loss`, so `P_elec = P_mech + P_loss` in steady state.
Below `w_reg` the speed-independent loss torques fade linearly to zero, so that the machine
has no infinite drag at standstill; above it each loss is exactly the deck's term. Copper loss
already lives in the resistor, so a measured efficiency map layered on this machine counts it
twice; the map is something the machine reproduces, not an extra loss. The inverter's losses
belong to the inverter, which is why the coefficients follow the motor-only map.

Defaults are a Nissan Leaf ZE1-class machine. `k` is derived so that at the 350 V pack
voltage and base speed the shaft delivers the full 320 N.m: the armature then draws 332 A and
the shaft 110 kW. The loss coefficients are chosen to land the motor-only efficiency near ORNL's
measured map of the 2012 Leaf: 88 % at 220 N.m and 1000 rpm, rising to 95 % at 3000 rpm; 97 %
at 7300 rpm and 85 N.m; about 70 % at 5 N.m, where the speed losses dominate. Source tags: (Nissan) ZE1 specification
sheet, catalog 1709; (ORNL) 2013 benchmarking of the 2012 Leaf; (derived) computed from other
numbers, method given; (assumed) the course's choice.
"""
component DCMachine
  extends ElectricalComponents.Analog.Interfaces.TwoPin
  "Rotor shaft"
  spline = Spline() {^spline}
  "Housing"
  support = Spline() {^support}
  resistor = ElectricalComponents.Analog.Basic.Resistor(R = R) {^resistor}
  inductor = ElectricalComponents.Analog.Basic.Inductor(L = L) {^inductor}
  emf = ElectricalComponents.Analog.Basic.RotationalEMF(k = k) {^emf}
  rotor = RotationalComponents.Components.Inertia(J = J) {^rotor}
  friction = RotationalComponents.Sources.SignTorque(tau_nominal = -T_f, reg = RotationalComponents.Sources.Regularization.Linear(), w0 = w_reg) {^friction}
  iron = RotationalComponents.Sources.SignTorque(tau_nominal = -K_i, reg = RotationalComponents.Sources.Regularization.Linear(), w0 = w_reg) {^iron}
  windage = RotationalComponents.Sources.QuadraticSpeedDependentTorque(tau_nominal = -k_w * w_base ^ 2, w_nominal = w_base, TorqueDirection = false) {^windage}
  constant_loss = RotationalComponents.Sources.InverseSpeedDependentTorque(tau_nominal = -C / w_reg, w_nominal = w_reg, w0 = w_reg, TorqueDirection = false) {^constant_loss}
  "Peak shaft torque, held from standstill to base speed (Nissan)"
  parameter T_max::Torque = 320.0
  "Base speed, 3283 rpm, where 320 N.m meets 110 kW (Nissan)"
  parameter w_base::AngularVelocity = 3283.0 * pi / 30.0
  "Supply voltage at which the machine reaches base speed at full torque: the ZE1 pack's 350 V nominal (Nissan)"
  parameter V_nom::Voltage = 350.0
  "Armature resistance; 5.5 kW copper loss at the corner point (assumed, fitted to ORNL's motor-only map)"
  parameter R::Resistance = 0.05
  "Armature inductance; electrical time constant L/R = 10 ms (assumed)"
  parameter L::Inductance = 0.5e-3
  "Rotor inertia (assumed)"
  parameter J::Inertia = 0.05
  "Friction torque T_f; loss T_f w (assumed)"
  parameter T_f::Torque = 0.5
  "Iron loss coefficient K_i; loss K_i w, 1 kW at 9550 rpm (assumed)"
  parameter K_i::Torque = 1.0
  "Windage coefficient k_w; loss k_w w^3, 300 W at the 10100 rpm top speed [N.m.s2] (assumed)"
  parameter k_w::Real = 300.0 / (10100.0 * pi / 30.0) ^ 3
  "Constant loss C, present at any speed (assumed)"
  parameter C::Power = 200.0
  "Speed below which the speed-independent loss torques fade to zero, 95 rpm (assumed)"
  parameter w_reg::AngularVelocity = 10.0
  "Torque the losses take at base speed, so that the shaft delivers T_max there (derived)"
  parameter tau_loss_base::Torque = T_f + K_i + k_w * w_base ^ 2 + C / w_base
  "Torque and back-EMF constant KΦ: k w_base + R (T_max + tau_loss_base) / k = V_nom, solved for k (derived)"
  parameter k::ElectricalTorqueConstant = (V_nom + sqrt(V_nom ^ 2 - 4.0 * w_base * R * (T_max + tau_loss_base))) / (2.0 * w_base)
  "Armature current, into p"
  variable i::Current
  "Back-EMF, E = k w"
  variable E::Voltage
  "Electromagnetic torque, tau_em = k i"
  variable tau_em::Torque
  "Shaft speed relative to the housing"
  variable w::AngularVelocity
  "Torque delivered at the shaft"
  variable tau::Torque
  "Electrical power into the terminals"
  variable P_elec::Power
  "Mechanical power out of the shaft"
  variable P_mech::Power
  "Copper loss, R i^2"
  variable P_cu::Power
  "Friction loss"
  variable P_fric::Power
  "Iron loss"
  variable P_iron::Power
  "Windage loss"
  variable P_wind::Power
  "Constant loss"
  variable P_const::Power
  "Sum of the losses"
  variable P_loss::Power
relations
  connect(p, resistor.p) {^id1}
  connect(resistor.n, inductor.p) {^id2}
  connect(inductor.n, emf.p) {^id3}
  connect(emf.n, n) {^id4}
  connect(emf.rotor, rotor.spline_a, friction.spline, iron.spline, windage.spline, constant_loss.spline) {^id5}
  connect(rotor.spline_b, spline) {^id6}
  connect(emf.housing, friction.support, iron.support, windage.support, constant_loss.support, support) {^id7}
  i = p.i
  E = emf.v
  tau_em = -emf.tau
  w = emf.w
  tau = -spline.tau
  P_elec = v * i
  P_mech = tau * w
  P_cu = resistor.v * resistor.i
  P_fric = -friction.tau * w
  P_iron = -iron.tau * w
  P_wind = -windage.tau * w
  P_const = -constant_loss.tau * w
  P_loss = P_cu + P_fric + P_iron + P_wind + P_const
metadata {
  "Dyad": {"labels": [{"label": "$(instance)", "x": 500, "y": 1150, "rot": 0}]},
  "_links": {
    "spline": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}, "diagram": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}}}},
    "support": {"Dyad": {"placement": {"icon": {"iconName": "support", "x1": 450, "y1": 950, "x2": 550, "y2": 1050}, "diagram": {"iconName": "support", "x1": 450, "y1": 950, "x2": 550, "y2": 1050}}}},
    "p": {"Dyad": {"placement": {"icon": {"iconName": "pos", "x1": 150, "y1": -50, "x2": 250, "y2": 50}, "diagram": {"iconName": "pos", "x1": 150, "y1": -50, "x2": 250, "y2": 50}}}},
    "n": {"Dyad": {"placement": {"icon": {"iconName": "neg", "x1": 750, "y1": -50, "x2": 850, "y2": 50}, "diagram": {"iconName": "neg", "x1": 750, "y1": -50, "x2": 850, "y2": 50}}}},
    "resistor": {"Dyad": {"placement": {"diagram": {"x1": 150, "y1": 150, "x2": 250, "y2": 250}}}},
    "inductor": {"Dyad": {"placement": {"diagram": {"x1": 300, "y1": 150, "x2": 400, "y2": 250}}}},
    "emf": {"Dyad": {"placement": {"diagram": {"x1": 450, "y1": 400, "x2": 550, "y2": 500}}}},
    "rotor": {"Dyad": {"placement": {"diagram": {"x1": 750, "y1": 450, "x2": 850, "y2": 550}}}},
    "friction": {"Dyad": {"placement": {"diagram": {"x1": 100, "y1": 700, "x2": 200, "y2": 800}}}},
    "iron": {"Dyad": {"placement": {"diagram": {"x1": 250, "y1": 700, "x2": 350, "y2": 800}}}},
    "windage": {"Dyad": {"placement": {"diagram": {"x1": 600, "y1": 700, "x2": 700, "y2": 800}}}},
    "constant_loss": {"Dyad": {"placement": {"diagram": {"x1": 750, "y1": 700, "x2": 850, "y2": 800}}}}
  }
}
end
