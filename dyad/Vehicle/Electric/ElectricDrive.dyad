"""
The battery-electric drive of a Leaf-class car: battery, average converter and DC-equivalent
machine, the 12 V auxiliaries on the DC link, and the single-speed reduction to the shaft that
drives the differential.

    battery -> DC link -> converter -> machine -> reduction (ratio) -> spline
                       -> aux

`tau_ref` is the machine torque asked for, positive motoring, negative braking. The converter
imposes a current, so the drive turns the torque into the current that gives it at full field,
`i_ref = tau_ref / k`. Above base speed the converter weakens the field and the machine gives
less than `tau_ref` per ampere; a driver closed around the car's speed asks for more. A negative
`tau_ref` makes the machine a generator: the converter's and the battery's currents reverse and
the pack charges.

`spline` turns `ratio` times slower than the machine and carries `ratio` times its torque; the
reduction is ideal, so it costs nothing. `support` takes the reactions of the machine housing
and the gear case.

Defaults are the Nissan Leaf ZE1. Source tags: (Nissan) ZE1 specification sheet, catalog 1709;
(assumed) the course's choice.
"""
component ElectricDrive
  "Machine torque asked for, positive motoring"
  tau_ref = RealInput() {^tau_ref}
  "Reduction output shaft, to the differential"
  spline = Spline() {^spline}
  "Machine housing and gear case"
  support = Spline() {^support}
  "Battery state of charge"
  SoC = RealOutput() {^SoC}
  battery = VehicleSystemsComponents.Vehicle.Electric.Battery(SoC0 = SoC0) {^battery}
  aux = VehicleSystemsComponents.Vehicle.Electric.AuxLoad(P_aux = P_aux) {^aux}
  converter = VehicleSystemsComponents.Vehicle.Electric.Converter() {^converter}
  machine = VehicleSystemsComponents.Vehicle.Electric.DCMachine(field_weakening = true) {^machine}
  ground = ElectricalComponents.Analog.Basic.Ground() {^ground}
  reduction = RotationalComponents.Components.IdealGear(ratio = ratio) {^reduction}
  "Single-speed reduction, machine to differential (Nissan)"
  parameter ratio::Real = 8.193
  "Power drawn by the 12 V network (assumed)"
  parameter P_aux::Power = 300.0
  "Battery state of charge at t = 0 (assumed)"
  parameter SoC0::Real = 0.9
relations
  connect(battery.p, converter.p_in, aux.p) {^w1}
  connect(battery.n, converter.n, aux.n, machine.n, ground.g) {^w2}
  connect(converter.p_out, machine.p) {^w3}
  connect(converter.field, machine.field) {^w4}
  connect(machine.spline, reduction.spline_a) {^w5}
  connect(reduction.spline_b, spline) {^w6}
  connect(machine.support, reduction.support, support) {^w7}
  connect(battery.SoC, SoC) {^w8}
  converter.i_ref = tau_ref / machine.k
metadata {
  "_links": {
    "tau_ref": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 450, "x2": 50, "y2": 550}, "diagram": {"x1": -50, "y1": 450, "x2": 50, "y2": 550}}}},
    "spline": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}, "diagram": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}}}},
    "support": {"Dyad": {"placement": {"icon": {"iconName": "support", "x1": 450, "y1": 950, "x2": 550, "y2": 1050}, "diagram": {"iconName": "support", "x1": 650, "y1": 950, "x2": 750, "y2": 1050}}}},
    "SoC": {"Dyad": {"placement": {"icon": {"x1": 450, "y1": -50, "x2": 550, "y2": 50, "rot": 270}, "diagram": {"x1": 150, "y1": -50, "x2": 250, "y2": 50, "rot": 270}}}},
    "battery": {"Dyad": {"placement": {"diagram": {"x1": 100, "y1": 200, "x2": 200, "y2": 300, "rot": 90}}}},
    "aux": {"Dyad": {"placement": {"diagram": {"x1": 250, "y1": 600, "x2": 350, "y2": 700, "rot": 90}}}},
    "converter": {"Dyad": {"placement": {"diagram": {"x1": 300, "y1": 300, "x2": 400, "y2": 400}}}},
    "machine": {"Dyad": {"placement": {"diagram": {"x1": 500, "y1": 400, "x2": 600, "y2": 500}}}},
    "ground": {"Dyad": {"placement": {"diagram": {"x1": 400, "y1": 800, "x2": 500, "y2": 900}}}},
