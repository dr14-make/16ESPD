"""
Coulomb counter with a biased current sensor and equilibrium-voltage correction.
I is discharge-positive current before the modeled sensor bias; I_measured = I + I_offset.
Use I_offset = 0 when supplying an already biased measurement. After uninterrupted sampled
rest, each tick anchors the estimate to OCV until current resumes. Inputs must be sampled
fast enough to resolve the current profile; excursions between ticks are not detected.
The inverse table requires strictly increasing per-cell voltages and clamps its endpoints.
"""
component SoCEstimator
  I = RealInput(units = "A") {^I}
  V = RealInput(units = "V") {^V}
  SoC = RealOutput() {^SoC}
  "Sensor offset [A] (assumed; [SOC-257] exercise 2)"
  parameter I_offset::Current = 0.05
  "Equilibrium rest [s] (verified; [USABC-EV-R4], default rest at least 1 h)"
  parameter t_rest::Time(min = 0.0) = 3600.0
  "Measured-current rest threshold [A] (assumed; [SOC-257], above 50 mA bias)"
  parameter I_rest::Current(min = 0.0) = 0.1
  "Capacity [C] (derived; [NISSAN-ZE1], 40 kWh / 350 V, as TheveninCell)"
  parameter Q_nom::ElectricCharge(min = eps(Float64)) = 40.0e3 * 3600.0 / 350.0
  "Series count (derived; [NISSAN-ZE1], 96s2p, as TheveninCell)"
  parameter Ns::Real(min = eps(Float64)) = 96.0
  "Initial estimate (assumed; [SOC-257], matches TheveninCell)"
  parameter SoC0::Real = 0.9
  "BMS sample period [s] (assumed; [SOC-257], resolves bench transitions)"
  structural parameter dt::Time = 1.0
  "Per-cell OCV axis [V] (derived; [CHEN-2020], PyBaMM, as TheveninCell)"
  structural parameter ocv_axis::Real[:] = [2.500, 3.296, 3.485, 3.581, 3.667, 3.751, 3.841, 3.948, 4.042, 4.097, 4.200]
  "Inverse SoC table on dummy axis (derived; [CHEN-2020], 10 percent steps)"
  structural parameter soc_data::Real[:, :] = [[0.0, 0.0], [0.1, 0.1], [0.2, 0.2], [0.3, 0.3], [0.4, 0.4], [0.5, 0.5], [0.6, 0.6], [0.7, 0.7], [0.8, 0.8], [0.9, 0.9], [1.0, 1.0]]
  clock = DiscreteComponents.PeriodicClock(dt = dt) {^clock}
  current = DiscreteComponents.Sampler() {^current}
  voltage_soc = DiscreteComponents.Sampler() {^voltage_soc}
  inverse = BlockComponents.Tables.InterpolatedTable(axis1 = ocv_axis, axis2 = [0, 1], data = soc_data, interpolation_dim1 = BlockComponents.Tables.InterpolationDimension.LinearInterpolationDimension(), interpolation_dim2 = BlockComponents.Tables.InterpolationDimension.LinearInterpolationDimension()) {^inverse}
  counter = VehicleSystemsComponents.Vehicle.Electric.SoCCounter(dt = dt, t_rest = t_rest, I_rest = I_rest, Q_nom = Q_nom, SoC0 = SoC0) {^counter}
  hold = DiscreteComponents.ZeroOrderHold() {^hold}
  offset = BlockComponents.Sources.Constant(k = I_offset) {^offset}
  measured = BlockComponents.Math.Add() {^measured}
  per_cell = BlockComponents.Math.Gain(k = 1 / Ns) {^per_cell}
  clamp_voltage = BlockComponents.Nonlinear.Limiter(y_min = ocv_axis[1], y_max = ocv_axis[size(ocv_axis, 1)]) {^clamp_voltage}
  dummy = BlockComponents.Sources.Constant(k = 0.0) {^dummy}
  variable I_measured::Current
relations
  I_measured = measured.y
  connect(I, measured.u1) {^input_current}
  connect(offset.y, measured.u2) {^bias}
  connect(measured.y, current.u) {^sample_current}
  connect(V, per_cell.u) {^input_voltage}
  connect(per_cell.y, clamp_voltage.u) {^cell_voltage}
  connect(clamp_voltage.y, inverse.u1) {^table_voltage}
  connect(dummy.y, inverse.u2) {^table_dummy}
  connect(inverse.y, voltage_soc.u) {^w1}
  connect(current.y, counter.I, clock.y) {^w2}
  connect(voltage_soc.y, counter.ocv_soc) {^w3}
  connect(counter.SoC, hold.u) {^w4}
  connect(hold.y, SoC) {^w5}
metadata {"_links":{"I":{"Dyad":{"placement":{"diagram":{"x1":0,"x2":40,"y1":200,"y2":240},"icon":{"x1":0,"x2":40,"y1":200,"y2":240}}}},"SoC":{"Dyad":{"placement":{"diagram":{"x1":960,"x2":1000,"y1":220,"y2":260},"icon":{"x1":960,"x2":1000,"y1":220,"y2":260}}}},"V":{"Dyad":{"placement":{"diagram":{"x1":0,"x2":40,"y1":440,"y2":480},"icon":{"x1":0,"x2":40,"y1":440,"y2":480}}}},"bias":{"Dyad":{"edges":[{"E":2,"M":[{"x":184.0,"y":244.0}],"S":1}],"renderStyle":"standard"}},"cell_voltage":{"Dyad":{"edges":[{"E":2,"M":[],"S":1}],"renderStyle":"standard"}},"clamp_voltage":{"Dyad":{"placement":{"diagram":{"x1":260,"x2":340,"y1":420,"y2":500}}}},"clock":{"Dyad":{"placement":{"diagram":{"x1":400,"x2":480,"y1":60,"y2":120}}}},"counter":{"Dyad":{"placement":{"diagram":{"x1":720,"x2":820,"y1":200,"y2":300}}}},"current":{"Dyad":{"placement":{"diagram":{"x1":400,"x2":480,"y1":180,"y2":260}}}},"dummy":{"Dyad":{"placement":{"diagram":{"x1":260,"x2":340,"y1":620,"y2":700}}}},"hold":{"Dyad":{"placement":{"diagram":{"x1":860,"x2":940,"y1":200,"y2":280}}}},"input_current":{"Dyad":{"edges":[{"E":2,"M":[{"x":236.0,"y":220.0}],"S":1}],"renderStyle":"standard"}},"input_voltage":{"Dyad":{"edges":[{"E":2,"M":[],"S":1}],"renderStyle":"standard"}},"inverse":{"Dyad":{"placement":{"diagram":{"x1":420,"x2":520,"y1":420,"y2":520}}}},"measured":{"Dyad":{"placement":{"diagram":{"x1":240,"x2":320,"y1":180,"y2":260}}}},"offset":{"Dyad":{"placement":{"diagram":{"x1":100,"x2":180,"y1":60,"y2":140}}}},"per_cell":{"Dyad":{"placement":{"diagram":{"x1":100,"x2":180,"y1":420,"y2":500}}}},"sample_current":{"Dyad":{"edges":[{"E":2,"M":[],"S":1}],"renderStyle":"standard"}},"table_dummy":{"Dyad":{"edges":[{"E":2,"M":[{"x":360.0,"y":660.0},{"x":360.0,"y":500.0}],"S":1}],"renderStyle":"standard"}},"table_voltage":{"Dyad":{"edges":[{"E":2,"M":[{"x":360.0,"y":460.0},{"x":360.0,"y":440.0}],"S":1}],"renderStyle":"standard"}},"voltage_soc":{"Dyad":{"placement":{"diagram":{"x1":580,"x2":660,"y1":420,"y2":500}}}},"w1":{"Dyad":{"edges":[{"E":2,"M":[{"x":580.8,"y":470.0}],"S":1}],"renderStyle":"standard"}},"w2":{"Dyad":{"edges":[{"E":2,"M":[],"S":1},{"E":3,"M":[{"x":480.8,"y":188.0},{"x":480.0,"y":188.0}],"S":1}],"renderStyle":"standard"}},"w3":{"Dyad":{"edges":[{"E":2,"M":[{"x":660.8,"y":372.0},{"x":722.0,"y":372.0}],"S":1}],"renderStyle":"standard"}},"w4":{"Dyad":{"edges":[{"E":2,"M":[{"x":860.8,"y":250.0}],"S":1}],"renderStyle":"standard"}},"w5":{"Dyad":{"edges":[{"E":2,"M":[],"S":1}],"renderStyle":"standard"}}}}
end

"Sampled counter; left-endpoint integration avoids counting a future interval at t = 0."
component SoCCounter@[input clk extends Discrete]
  I = RealInput@[clk]() {^I}
  ocv_soc = RealInput@[clk]() {^ocv_soc}
  SoC = RealOutput@[clk]() {^SoC}
  parameter dt::Time
  parameter t_rest::Time
  parameter I_rest::Current
  parameter Q_nom::ElectricCharge
  parameter SoC0::Real
  absolute_current = BlockComponents.Math.Abs() {^absolute_current}
  rest_threshold = BlockComponents.Logical.LessThreshold(threshold = I_rest) {^rest_threshold}
  quiet_value = BlockComponents.Math.BooleanToReal() {^quiet_value}
  previous_quiet = DiscreteComponents.UnitDelay(initial_condition = 0.0) {^previous_quiet}
  was_quiet = BlockComponents.Logical.GreaterThreshold(threshold = 0.5) {^was_quiet}
  consecutive_rest = BlockComponents.Logical.And() {^consecutive_rest}
  previous_rest = DiscreteComponents.UnitDelay(initial_condition = 0.0) {^previous_rest}
  tick_duration = BlockComponents.Sources.Constant(k = dt) {^tick_duration}
  rest_increment = BlockComponents.Math.Add() {^rest_increment}
  zero = BlockComponents.Sources.Constant(k = 0.0) {^zero}
  rest_gate = BlockComponents.Logical.Switch() {^rest_gate}
  enough_rest = BlockComponents.Logical.GreaterEqualThreshold(threshold = t_rest) {^enough_rest}
  correction_gate = BlockComponents.Logical.And() {^correction_gate}
  previous_current = DiscreteComponents.UnitDelay(initial_condition = 0.0) {^previous_current}
  charge_step = BlockComponents.Math.Gain(k = dt) {^charge_step}
  capacity = BlockComponents.Sources.Constant(k = Q_nom) {^capacity}
  charge_fraction = BlockComponents.Math.Division() {^charge_fraction}
  previous_estimate = DiscreteComponents.UnitDelay(initial_condition = SoC0) {^previous_estimate}
  coulomb_step = BlockComponents.Math.Add(k2 = -1.0) {^coulomb_step}
  estimate_gate = BlockComponents.Logical.Switch() {^estimate_gate}
  variable estimate::Real
  variable quiet::Real
  variable rest_time::Time
relations
  # UnitDelay initializes the previous sample, not the present output. At the
  # first tick rest_time is zero and coulomb_step is SoC0; t_rest = 0 can
  # nevertheless select the present OCV. Both branches run on the input clock.
  quiet = quiet_value.y
  rest_time = rest_gate.y
  estimate = estimate_gate.y
  connect(I, absolute_current.u, previous_current.u) {^current_paths}
  connect(absolute_current.y, rest_threshold.u) {^current_magnitude}
  connect(rest_threshold.y, quiet_value.u, consecutive_rest.u1, correction_gate.u1) {^quiet_paths}
  connect(quiet_value.y, previous_quiet.u) {^quiet_history}
  connect(previous_quiet.y, was_quiet.u) {^previous_quiet_value}
  connect(was_quiet.y, consecutive_rest.u2) {^previous_quiet_gate}
  connect(previous_rest.y, rest_increment.u1) {^rest_history}
  connect(tick_duration.y, rest_increment.u2) {^rest_tick}
  connect(rest_increment.y, rest_gate.u1) {^incremented_rest}
  connect(consecutive_rest.y, rest_gate.u2) {^rest_enable}
  connect(zero.y, rest_gate.u3) {^rest_reset}
  connect(rest_gate.y, previous_rest.u, enough_rest.u) {^rest_paths}
  connect(enough_rest.y, correction_gate.u2) {^rest_ready}
  connect(previous_current.y, charge_step.u) {^left_current}
  connect(charge_step.y, charge_fraction.u1) {^interval_charge}
  connect(capacity.y, charge_fraction.u2) {^nominal_capacity}
  connect(charge_fraction.y, coulomb_step.u2) {^soc_decrement}
  connect(previous_estimate.y, coulomb_step.u1) {^estimate_history}
  connect(coulomb_step.y, estimate_gate.u3) {^integrated_soc}
  connect(ocv_soc, estimate_gate.u1) {^ocv_correction}
  connect(correction_gate.y, estimate_gate.u2) {^correction_enable}
  connect(estimate_gate.y, previous_estimate.u, SoC) {^estimate_paths}
