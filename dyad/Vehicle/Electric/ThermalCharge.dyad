"""
Leaf electrothermal charge bench. Heat excludes reversible/entropic heat and charger
losses; resistance and OCV remain temperature independent. INL studied a different
24 kWh pack and did not state the charge windows for its average temperature rises.
"""
component ThermalCharge
  "Passive conductance [THERMAL-BENCH] (assumed), 4 m^2 times 5 W/(m^2 K)"
  parameter G_air::ThermalConductance = 20.0
  "Initial temperature [THERMAL-BENCH] (assumed), 25 C"
  parameter T0::Temperature = 298.15
  "Charge power [INL-DCFC-2015] (verified), 50 kW rating"
  parameter P_full::Power = 50000.0
  "Current ceiling [CHARGING-1] (derived), rounded 50 kW / 350 V"
  parameter I_cc::Current = 143.0
  "Two-charge sequence [THERMAL-BENCH] (assumed), disabled for single charge"
  structural parameter cycling::Boolean = false
  "Steady highway terminal power [THERMAL-BENCH] (assumed), 20 kW"
  parameter P_drive::Power = 20000.0
  variable throughput::Real
  stage = RealOutput() {^stage}
  battery = VehicleSystemsComponents.Vehicle.Electric.ThermalTheveninCell(SoC0 = 0.1) {^battery}
  charger = VehicleSystemsComponents.Vehicle.Electric.CCCVCharger(use_power_limit = true, I_cc = I_cc) {^charger}
  thermal = VehicleSystemsComponents.Vehicle.Electric.PackThermal(G_air = G_air, T0 = T0) {^thermal}
  derating = VehicleSystemsComponents.Vehicle.Electric.ThermalDerating(P_full = P_full) {^derating}
  ground = ElectricalComponents.Analog.Basic.Ground() {^ground}
  link = ElectricalComponents.Analog.Basic.Capacitor(C = 0.01) {^link}
  load = ElectricalComponents.Analog.Sources.CurrentSource() {^load}
  voltage_sensor = ElectricalComponents.Analog.Sensors.VoltageSensor() {^voltage_sensor}
  absolute_current = BlockComponents.Math.Abs() {^absolute_current}
  throughput_integrator = BlockComponents.Continuous.Integrator(k = 1.0 / battery.Q_nom, x0 = 0.0) {^throughput_integrator}
  leg1 = BlockComponents.Logical.LessThreshold(threshold = ifelse(cycling, 0.7, 1e300)) {^leg1}
  leg2 = BlockComponents.Logical.LessThreshold(threshold = ifelse(cycling, 1.4, -1e300)) {^leg2}
  leg3 = BlockComponents.Logical.LessThreshold(threshold = 2.1) {^leg3}
  one = BlockComponents.Sources.Constant(k = 1.0) {^one}
  two = BlockComponents.Sources.Constant(k = 2.0) {^two}
  three = BlockComponents.Sources.Constant(k = 3.0) {^three}
  four = BlockComponents.Sources.Constant(k = 4.0) {^four}
  last_stage = BlockComponents.Logical.Switch() {^last_stage}
  middle_stage = BlockComponents.Logical.Switch() {^middle_stage}
  first_stage = BlockComponents.Logical.Switch() {^first_stage}
  not_leg1 = BlockComponents.Logical.Not() {^not_leg1}
  drive_gate = BlockComponents.Logical.And() {^drive_gate}
  not_leg2 = BlockComponents.Logical.Not() {^not_leg2}
  second_charge = BlockComponents.Logical.And() {^second_charge}
  charge_gate = BlockComponents.Logical.Or() {^charge_gate}
  zero = BlockComponents.Sources.Constant(k = 0.0) {^zero}
  charge_power = BlockComponents.Logical.Switch() {^charge_power}
  drive_current = VehicleSystemsComponents.Vehicle.Blocks.TerminalPowerCurrentEquation(P = P_drive) {^drive_current}
  drive_command = BlockComponents.Logical.Switch() {^drive_command}
relations
  # Initial voltage continuity is an initial condition, not a signal connection.
  initial link.v = battery.E
  # Compatibility alias: the standard integrator owns the throughput state.
  throughput = throughput_integrator.y
  connect(battery.p, charger.p, link.p, load.p, voltage_sensor.p) {^thermal_wire1}
  connect(battery.n, charger.n, ground.g, link.n, load.n, voltage_sensor.n) {^thermal_wire2}
  connect(battery.heat_port, thermal.heat_port) {^thermal_wire3}
  connect(thermal.T, derating.T) {^thermal_wire4}
  connect(battery.stored_current, absolute_current.u) {^thermal_wire5}
  connect(absolute_current.y, throughput_integrator.u) {^thermal_wire6}
  connect(throughput_integrator.y, leg1.u, leg2.u, leg3.u) {^thermal_wire7}
  connect(one.y, first_stage.u1) {^thermal_wire8}
  connect(two.y, middle_stage.u1) {^thermal_wire9}
  connect(three.y, last_stage.u1) {^thermal_wire10}
  connect(four.y, last_stage.u3) {^thermal_wire11}
  connect(leg3.y, last_stage.u2, second_charge.u2) {^thermal_wire12}
  connect(last_stage.y, middle_stage.u3) {^thermal_wire13}
  connect(leg2.y, middle_stage.u2, drive_gate.u2, not_leg2.u) {^thermal_wire14}
  connect(middle_stage.y, first_stage.u3) {^thermal_wire15}
  connect(leg1.y, first_stage.u2, not_leg1.u, charge_gate.u1) {^thermal_wire16}
  connect(first_stage.y, stage) {^thermal_wire17}
  connect(not_leg1.y, drive_gate.u1) {^thermal_wire18}
  connect(not_leg2.y, second_charge.u1) {^thermal_wire19}
  connect(second_charge.y, charge_gate.u2) {^thermal_wire20}
  connect(derating.P_max, charge_power.u1) {^thermal_wire21}
  connect(charge_gate.y, charge_power.u2) {^thermal_wire22}
  connect(zero.y, charge_power.u3, drive_command.u3) {^thermal_wire23}
  connect(charge_power.y, charger.P_max) {^thermal_wire24}
  connect(voltage_sensor.v, drive_current.u1) {^thermal_wire25}
  connect(drive_current.y, drive_command.u1) {^thermal_wire26}
  connect(drive_gate.y, drive_command.u2) {^thermal_wire27}
  connect(drive_command.y, load.I) {^thermal_wire28}
