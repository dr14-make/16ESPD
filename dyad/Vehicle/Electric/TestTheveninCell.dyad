"""
ORNL pulse-5 bench: rest for 10 s, discharge at 30 A for 30 s, then rest.
R0 gives 48 mV immediately; polarization adds 27.7 mV after 30 s and relaxes
with tau1 = 25.7 s. OCV also drifts with the coulomb-counted SoC.
"""
test component TestTheveninCell
  parameter I_load::Current = 30.0
  parameter R1::Resistance = 0.00134
  parameter SoC0::Real = 0.6
  parameter Ns::Real = 1.0
  structural parameter ocv_data::Real[:, :] = [[2.500, 2.500], [3.296, 3.296], [3.485, 3.485], [3.581, 3.581], [3.667, 3.667], [3.751, 3.751], [3.841, 3.841], [3.948, 3.948], [4.042, 4.042], [4.097, 4.097], [4.200, 4.200]]
  pulse_on = BlockComponents.Sources.Step(height = I_load, start_time = 10.0) {^pulse_on}
  pulse_off = BlockComponents.Sources.Step(height = -I_load, start_time = 40.0) {^pulse_off}
  pulse_sum = BlockComponents.Math.Add() {^pulse_sum}
  load = ElectricalComponents.Analog.Sources.CurrentSource() {^load}
  battery = VehicleSystemsComponents.Vehicle.Electric.TheveninCell(Ns = Ns, Q_nom = 33.1 * 3600, R0 = 0.00160, R1 = R1, tau1 = 25.7, SoC0 = SoC0, ocv_data = ocv_data) {^battery}
  ground = ElectricalComponents.Analog.Basic.Ground() {^ground}
relations
  connect(pulse_on.y, pulse_sum.u1) {^pulse_start}
  connect(pulse_off.y, pulse_sum.u2) {^pulse_stop}
  connect(pulse_sum.y, load.I) {^load_command}
  connect(battery.p, load.p) {^w1}
  connect(load.n, battery.n, ground.g) {^w2}
metadata {
  "_links": {
    "pulse_on": {"Dyad": {"placement": {"diagram": {"x1": 80, "y1": 100, "x2": 160, "y2": 180}}}},
    "pulse_off": {"Dyad": {"placement": {"diagram": {"x1": 80, "y1": 300, "x2": 160, "y2": 380}}}},
    "pulse_sum": {"Dyad": {"placement": {"diagram": {"x1": 300, "y1": 200, "x2": 380, "y2": 280}}}},
    "load": {"Dyad": {"placement": {"diagram": {"x1": 650, "y1": 450, "x2": 750, "y2": 550, "rot": 90}}}},
    "battery": {"Dyad": {"placement": {"diagram": {"x1": 300, "y1": 600, "x2": 460, "y2": 760}}}},
    "ground": {"Dyad": {"placement": {"diagram": {"x1": 650, "y1": 840, "x2": 710, "y2": 900}}}},
    "pulse_start": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 240, "y": 140}, {"x": 240, "y": 216}], "E": 2}], "path": {}}},
    "pulse_stop": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 220, "y": 340}, {"x": 220, "y": 264}], "E": 2}], "path": {}}},
    "load_command": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 850, "y": 240}, {"x": 850, "y": 500}], "E": 2}], "path": {}}},
    "w1": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 260, "y": 680}, {"x": 260, "y": 420}, {"x": 700, "y": 420}], "E": 2}], "path": {}}},
    "w2": {"Dyad": {"junctions": [{"x": 680, "y": 800}], "edges": [{"S": 1, "M": [{"x": 700, "y": 800}], "E": -1}, {"S": 2, "M": [{"x": 540, "y": 680}, {"x": 540, "y": 800}], "E": -1}, {"S": -1, "M": [], "E": 3}], "path": {}}}
  }
}
end

analysis TheveninPulseTransient
  extends TransientAnalysis(stop = 180.0, tstops = [10.0, 40.0], reltol = 1e-8, abstol = 1e-10)
  model = VehicleSystemsComponents.Vehicle.Electric.TestTheveninCell()
end
