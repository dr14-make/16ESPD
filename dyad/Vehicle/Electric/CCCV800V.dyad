"""
800 V-class, 200 kW exercise [CCCV-BENCH] (assumed): 192 series cells,
R0 = 0.2 ohm and R1 = 0; 250 A gives 0.2604 V/cell IR rise and a
3.9396 V/cell OCV at the CC/CV switch (derived).
Capacity is retained from the Leaf (assumed) to isolate series count and resistance;
this is not a model of a particular production 800 V pack.
"""
component CCCV800V
  charger = VehicleSystemsComponents.Vehicle.Electric.CCCVCharger(I_cc = 250.0, V_max = 192.0 * 4.20) {^charger}
  battery = VehicleSystemsComponents.Vehicle.Electric.TheveninCell(Ns = 192.0, R0 = 0.2, R1 = 0.0, SoC0 = 0.1) {^battery}
  ground = ElectricalComponents.Analog.Basic.Ground() {^ground}
relations
  connect(charger.p, battery.p) {^positive}
  connect(charger.n, battery.n, ground.g) {^negative}
metadata {
  "_links": {
    "charger": {"Dyad": {"placement": {"diagram": {"x1": 150, "x2": 250, "y1": 450, "y2": 550}}}},
    "battery": {"Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 450, "y2": 550}}}},
    "ground": {"Dyad": {"placement": {"diagram": {"x1": 650, "x2": 710, "y1": 600, "y2": 660}}}},
    "positive": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "negative": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}, {"S": 2, "M": [], "E": 3}], "path": {}}}
  }
}
end

analysis CCCV800VTransient
  extends TransientAnalysis(stop = 8000.0, alg = ODEAlg.Rodas5P(), reltol = 1e-8, abstol = 1e-10)
  model = VehicleSystemsComponents.Vehicle.Electric.CCCV800V()
end
