"""
Three-day offset-drift bench using the default Leaf TheveninCell.
A modest discharge block each day keeps true SoC inside the OCV table without a charger.
The estimator sees only current and terminal voltage, not the cell's true SoC.
"""
test component SoCDriftDays
  "Drive current [A] (assumed; [SOC-257], multi-day teaching profile)"
  parameter I_drive::Current = 5.0
  "Drive duration [s] (assumed; [SOC-257], two hours per day)"
  parameter t_drive::Time = 7200.0
  "Pattern period [s] (assumed; [SOC-257], one day)"
  parameter period::Time = 86400.0
  "Sensor offset [A] (assumed; [SOC-257], exercise 2)"
  parameter I_offset::Current = 0.05
  "Rest duration required [s] (verified; [USABC-EV-R4], at least 1 h)"
  parameter t_rest::Time = 3600.0
  "Measured rest threshold [A] (assumed; [SOC-257], above sensor bias)"
  parameter I_rest::Current = 0.1
  "Initial estimate (assumed; [SOC-257], matches default cell)"
  parameter SoC0_est::Real = 0.9
  "BMS sample interval [s] (assumed; [SOC-257], resolves block edges)"
  structural parameter dt::Time = 1.0
  battery = VehicleSystemsComponents.Vehicle.Electric.TheveninCell() {^battery}
  load = ElectricalComponents.Analog.Sources.CurrentSource() {^load}
  ground = ElectricalComponents.Analog.Basic.Ground() {^ground}
  estimator = VehicleSystemsComponents.Vehicle.Electric.SoCEstimator(I_offset = I_offset, t_rest = t_rest, I_rest = I_rest, SoC0 = SoC0_est, dt = dt) {^estimator}
  soc_true = RealOutput() {^soc_true}
  estimated_soc = RealOutput() {^estimated_soc}
  error = RealOutput() {^error}
  elapsed = BlockComponents.Sources.ContinuousClock() {^elapsed}
  phase = VehicleSystemsComponents.Vehicle.Blocks.SoCPhaseEquation(period = period) {^phase}
  drive_gate = BlockComponents.Logical.LessThreshold(threshold = t_drive) {^drive_gate}
  drive = BlockComponents.Sources.Constant(k = I_drive) {^drive}
  rest = BlockComponents.Sources.Constant(k = 0.0) {^rest}
  current_command = BlockComponents.Logical.Switch() {^current_command}
  terminal = ElectricalComponents.Analog.Sensors.VoltageSensor() {^terminal}
  difference = BlockComponents.Math.Feedback() {^difference}
relations
  connect(elapsed.y, phase.u1) {^wire1}
  connect(phase.y, drive_gate.u) {^wire2}
  connect(drive_gate.y, current_command.u2) {^wire3}
  connect(drive.y, current_command.u1) {^wire4}
  connect(rest.y, current_command.u3) {^wire5}
  connect(current_command.y, load.I) {^wire6}
  connect(battery.p, load.p, terminal.p) {^wire7}
  connect(load.n, battery.n, ground.g, terminal.n) {^wire8}
  connect(battery.stored_current, estimator.I) {^wire9}
  connect(terminal.v, estimator.V) {^wire10}
  connect(battery.SoC, soc_true, difference.u2) {^wire11}
  connect(estimator.SoC, estimated_soc, difference.u1) {^wire12}
  connect(difference.y, error) {^wire13}
metadata {"_links":{"battery":{"Dyad":{"placement":{"diagram":{"x1":100,"x2":220,"y1":600,"y2":720}}}},"current_command":{"Dyad":{"placement":{"diagram":{"x1":540,"x2":620,"y1":120,"y2":240}}}},"difference":{"Dyad":{"placement":{"diagram":{"x1":800,"x2":880,"y1":760,"y2":840}}}},"drive":{"Dyad":{"placement":{"diagram":{"x1":380,"x2":460,"y1":240,"y2":320}}}},"drive_gate":{"Dyad":{"placement":{"diagram":{"x1":380,"x2":460,"y1":60,"y2":140}}}},"elapsed":{"Dyad":{"placement":{"diagram":{"x1":60,"x2":140,"y1":60,"y2":140}}}},"error":{"Dyad":{"placement":{"diagram":{"x1":960,"x2":1000,"y1":780,"y2":820},"icon":{"x1":960,"x2":1000,"y1":780,"y2":820}}}},"estimated_soc":{"Dyad":{"placement":{"diagram":{"x1":960,"x2":1000,"y1":640,"y2":680},"icon":{"x1":960,"x2":1000,"y1":640,"y2":680}}}},"estimator":{"Dyad":{"placement":{"diagram":{"x1":540,"x2":660,"y1":600,"y2":720}}}},"ground":{"Dyad":{"placement":{"diagram":{"x1":120,"x2":200,"y1":840,"y2":920}}}},"load":{"Dyad":{"placement":{"diagram":{"x1":700,"x2":800,"y1":120,"y2":220}}}},"phase":{"Dyad":{"placement":{"diagram":{"x1":220,"x2":300,"y1":60,"y2":140}}}},"rest":{"Dyad":{"placement":{"diagram":{"x1":380,"x2":460,"y1":420,"y2":500}}}},"soc_true":{"Dyad":{"placement":{"diagram":{"x1":960,"x2":1000,"y1":520,"y2":560},"icon":{"x1":960,"x2":1000,"y1":520,"y2":560}}}},"terminal":{"Dyad":{"placement":{"diagram":{"x1":340,"x2":420,"y1":600,"y2":680}}}},"wire1":{"Dyad":{"edges":[{"E":2,"M":[],"S":1}],"renderStyle":"standard"}},"wire10":{"Dyad":{"edges":[{"E":2,"M":[{"x":542.4,"y":680.0}],"S":1}],"renderStyle":"standard"}},"wire11":{"Dyad":{"edges":[{"E":2,"M":[{"x":480.0,"y":600.0},{"x":480.0,"y":548.0},{"x":820.0,"y":548.0},{"x":820.0,"y":540.0}],"S":1},{"E":3,"M":[{"x":200.0,"y":600.0},{"x":200.0,"y":736.0},{"x":480.0,"y":736.0},{"x":480.0,"y":820.0},{"x":840.0,"y":820.0}],"S":1}],"renderStyle":"standard"}},"wire12":{"Dyad":{"edges":[{"E":2,"M":[{"x":900.0,"y":628.8},{"x":900.0,"y":660.0}],"S":1},{"E":3,"M":[{"x":657.6,"y":772.