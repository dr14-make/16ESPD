    "wire5": {"Dyad": {"edges": [{"S": 2, "M": [{"x": 440, "y": 225.6}, {"x": 440, "y": 270}, {"x": 430, "y": 270}, {"x": 430, "y": 360}, {"x": 515.0, "y": 360}, {"x": 515.0, "y": 310}], "E": 1}]}},
