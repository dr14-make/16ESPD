    "estimated_soc": {"Dyad": {"placement": {"diagram": {"x1": 930, "y1": 690, "x2": 950, "y2": 710}, "icon": {"x1": 960, "x2": 1000, "y1": 640, "y2": 680}}}},
    "error": {"Dyad": {"placement": {"diagram": {"x1": 930, "y1": 820, "x2": 950, "y2": 840}, "icon": {"x1": 960, "x2": 1000, "y1": 780, "y2": 820}}}}
  }
}
end

analysis SoCDriftDaysTransient
  extends TransientAnalysis(stop = 259200.0, reltol = 1e-8, abstol = 1e-10)
  model = VehicleSystemsComponents.Vehicle.Electric.SoCDriftDays()
end
