"""
Single-phase H-bridge inverter, switched: deck 7 slides 30 and 31. Four `Switch`es, each with a
freewheeling diode across it, connect the outputs `a` and `b` to either rail of the DC link.

    p ---+-----------+          A, B: upper switches; C, D: lower switches
         A           B          each with its diode, anode on the lower node
    a ---+           +--- b     the load goes from a to b
         C           D
    n ---+-----------+

The gate pattern is the deck's (slide 31). The reference `u`, between -1 and 1, is the wanted
output voltage as a fraction of the DC link. While `u > 0`, D stays on and A is pulse-width
modulated with duty `u`; while `u < 0`, B stays on and C is modulated with duty `-u`. When the
modulated switch is off, the load current freewheels through the lower (or upper) diode of the
same leg and the switch that stays on. The output `v_ab` is therefore a train of pulses between
0 and `+V_dc` in the positive half and between 0 and `-V_dc` in the negative one, and its
average over a carrier period is `u V_dc`. A sine reference of amplitude `m` gives a
fundamental of `m V_dc` plus harmonics clustered around multiples of the carrier frequency
`f_s` (slide 31). A reference held beyond 1 keeps A and D, then B and C, on for whole half
cycles: square-wave operation (slide 30), which gives the largest fundamental, `4 V_dc / pi`.

No two switches of a leg are ever on together. The switch that stays on for a half cycle, D or
B, ramps on and off while `|u|` is below `u_band` instead of jumping at the zero crossing, so
that its resistance stays continuous; all four switches are off at `u = 0` and the diodes carry
the current. The diodes are the standard library's exponential `Diode` with its MSL defaults:
0.6 V at 3.3 A, then 12 mOhm. Losses are readable per part and sum to `P_loss`; over whole
periods in steady state `P_dc = P_ac + P_loss`. Defaults switch at 10 kHz, an EV inverter's
range, with 1 us edges; the bench `TestHBridge` puts the bridge on the Leaf pack's 350 V. Source
tags: (deck) slides 30 and 31; (assumed) the course's choice.
"""
component HBridge
  "DC link, positive rail"
  p = Pin() {^p}
  "DC link, negative rail"
  n = Pin() {^n}
  "Output of the left leg, between A and C"
  a = Pin() {^a}
  "Output of the right leg, between B and D"
  b = Pin() {^b}
  "Reference output voltage as a fraction of the DC link, -1 to 1"
  u = RealInput() {^u}
  switch_a = VehicleSystemsComponents.Vehicle.Electric.Switch(R_on = R_on, R_off = R_off, C_oss = C_oss) {^switch_a}
  switch_b = VehicleSystemsComponents.Vehicle.Electric.Switch(R_on = R_on, R_off = R_off, C_oss = C_oss) {^switch_b}
  switch_c = VehicleSystemsComponents.Vehicle.Electric.Switch(R_on = R_on, R_off = R_off, C_oss = C_oss) {^switch_c}
  switch_d = VehicleSystemsComponents.Vehicle.Electric.Switch(R_on = R_on, R_off = R_off, C_oss = C_oss) {^switch_d}
  diode_a = ElectricalComponents.Analog.Semiconductors.Diode() {^diode_a}
  diode_b = ElectricalComponents.Analog.Semiconductors.Diode() {^diode_b}
  diode_c = ElectricalComponents.Analog.Semiconductors.Diode() {^diode_c}
  diode_d = ElectricalComponents.Analog.Semiconductors.Diode() {^diode_d}
  "Modulates A while u > 0"
  pwm_a = VehicleSystemsComponents.Vehicle.Electric.PWM(f_s = f_s, t_sw = t_sw) {^pwm_a}
  "Modulates C while u < 0"
  pwm_c = VehicleSystemsComponents.Vehicle.Electric.PWM(f_s = f_s, t_sw = t_sw) {^pwm_c}
  "Switching (carrier) frequency (assumed)"
  parameter f_s::Frequency = 10.0e3
  "Duration of each gate edge of A and C (assumed)"
  parameter t_sw::Time = 1.0e-6
  "Switch on-resistance (assumed)"
  parameter R_on::Resistance = 10.0e-3
  "Switch off-resistance (assumed)"
  parameter R_off::Resistance = 1.0e6
  "Switch output capacitance (assumed)"
  parameter C_oss::Capacitance = 1.0e-9
  "Band of |u| over which D and B ramp on and off around the zero crossing (assumed)"
  parameter u_band::Real = 1.0e-3
  "Output voltage, a against b"
  variable v_ab::Voltage
  "Output current, out of a, through the load, into b"
  variable i_ab::Current
  "Power drawn from the DC link"
  variable P_dc::Power
  "Power delivered to the load"
  variable P_ac::Power
  "Sum of the switch and diode losses"
  variable P_loss::Power
relations
  connect(p, switch_a.p, diode_a.n, switch_b.p, diode_b.n) {^id1}
  connect(switch_a.n, diode_a.p, switch_c.p, diode_c.n, a) {^id2}
  connect(switch_b.n, diode_b.p, switch_d.p, diode_d.n, b) {^id3}
  connect(switch_c.n, diode_c.p, switch_d.n, diode_d.p, n) {^id4}
  connect(pwm_a.y, switch_a.g) {^id5}
  connect(pwm_c.y, switch_c.g) {^id6}
  pwm_a.u = max(u, 0)
  pwm_c.u = max(-u, 0)
  switch_d.g = max(0, min(1, u / u_band))
  switch_b.g = max(0, min(1, -u / u_band))
  v_ab = a.v - b.v
  i_ab = -a.i
  P_dc = (p.v - n.v) * p.i
  P_ac = v_ab * i_ab
  P_loss = switch_a.P_loss + switch_b.P_loss + switch_c.P_loss + switch_d.P_loss + diode_a.LossPower + diode_b.LossPower + diode_c.LossPower + diode_d.LossPower
metadata {
  "Dyad": {"labels": [{"label": "$(instance)", "x": 500, "y": 1100, "rot": 0}]},
  "_links": {
    "p": {"Dyad": {"placement": {"icon": {"iconName": "pos", "x1": -50, "y1": 150, "x2": 50, "y2": 250}, "diagram": {"iconName": "pos", "x1": -50, "y1": 50, "x2": 50, "y2": 150}}}},
    "n": {"Dyad": {"placement": {"icon": {"iconName": "neg", "x1": -50, "y1": 750, "x2": 50, "y2": 850}, "diagram": {"iconName": "neg", "x1": -50, "y1": 850, "x2": 50, "y2": 950}}}},
    "a": {"Dyad": {"placement": {"icon": {"iconName": "pos", "x1": 950, "y1": 150, "x2": 1050, "y2": 250}, "diagram": {"iconName": "pos", "x1": 250, "y1": 950, "x2": 350, "y2": 1050}}}},
    "b": {"Dyad": {"placement": {"icon": {"iconName": "neg", "x1": 950, "y1": 750, "x2": 1050, "y2": 850}, "diagram": {"iconName": "neg", "x1": 650, "y1": 950, "x2": 750, "y2": 1050}}}},
    "u": {"Dyad": {"placement": {"icon": {"x1": 450, "y1": -50, "x2": 550, "y2": 50, "rot": 90}, "diagram": {"x1": 450, "y1": -50, "x2": 550, "y2": 50, "rot": 90}}}},
    "pwm_a": {"Dyad": {"placement": {"diagram": {"x1": 100, "y1": 100, "x2": 200, "y2": 200}}}},
    "pwm_c": {"Dyad": {"placement": {"diagram": {"x1": 100, "y1": 600, "x2": 200, "y2": 700}}}},
    "switch_a": {"Dyad": {"placement": {"diagram": {"x1": 250, "y1": 200, "x2": 350, "y2": 300, "rot": 90}}}},
    "diode_a": {"Dyad": {"placement": {"diagram": {"x1": 380, "y1": 200, "x2": 480, "y2": 300, "rot": 270}}}},
    "switch_c": {"Dyad": {"placement": {"diagram": {"x1": 250, "y1": 650, "x2": 350, "y2": 750, "rot": 90}}}},
    "diode_c": {"Dyad": {"placement": {"diagram": {"x1": 380, "y1": 650, "x2": 480, "y2": 750, "rot": 270}}}},
    "switch_b": {"Dyad": {"placement": {"diagram": {"x1": 650, "y1": 200, "x2": 750, "y2": 300, "rot": 90}}}},
    "diode_b": {"Dyad": {"placement": {"diagram": {"x1": 780, "y1": 200, "x2": 880, "y2": 300, "rot": 270}}}},
    "switch_d": {"Dyad": {"placement": {"diagram": {"x1": 650, "y1": 650, "x2": 750, "y2": 750, "rot": 90}}}},
    "diode_d": {"Dyad": {"placement": {"diagram": {"x1": 780, "y1": 650, "x2": 880, "y2": 750, "rot": 270}}}}
  }
}
end
