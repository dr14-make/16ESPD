"""
Constant current (CC) supplies I_cc until the battery nears V_max; constant voltage
(CV) then tapers the current, keeping the voltage below V_max by at most I_cc*R_reg
(1.43 mV at 143 A, 2.5 mV at 250 A with the assumed R_reg = 10 microohm).
Phase is computed as 1 (CC), 2 (CV), or 3 (done below I_cut), but current keeps tapering
rather than switching off or latching; positive current leaves p and enters the battery.
No switching ripple is modeled. The always-present P_max input limits terminal power;
with use_power_limit false the original CC-CV law is unchanged.
Defaults: [CHARGING-1] is charging.md section 1; [CCCV-BENCH] is issue #256.
"""
component CCCVCharger
  "CC current [A] (derived; [CHARGING-1], rounded 50 kW / 350 V)"
  parameter I_cc::Current = 143.0
  "Terminal voltage ceiling [V] (derived; [PAN-NCR18650B], 96 times 4.20 V; Leaf applicability assumed)"
  parameter V_max::Voltage = 96.0 * 4.20
  "Termination current [A] (derived; [PAN-NCR18650B], C/50 using Leaf 40 kWh / 350 V)"
  parameter I_cut::Current = (40000.0 / 350.0) / 50.0
  "Regulator resistance [ohm] (assumed; [CCCV-BENCH])"
  parameter R_reg::Resistance = 1e-5
  "Enable terminal power limit [THERMAL-BENCH] (assumed), disabled for compatibility"
  structural parameter use_power_limit::Boolean = false
  P_max = RealInput() {^P_max}
  variable v::Voltage
  p = Pin() {^p}
  n = Pin() {^n}
  current = RealOutput() {^current}
  phase = RealOutput() {^phase}
  voltage = ElectricalComponents.Analog.Sensors.VoltageSensor() {^voltage}
  source = ElectricalComponents.Analog.Sources.CurrentSource() {^source}
  delivered = ElectricalComponents.Analog.Sensors.CurrentSensor() {^delivered}
  voltage_limit = VehicleSystemsComponents.Vehicle.Blocks.CCCVVoltageCurrentEquation(I_cc = I_cc, V_max = V_max, R_reg = R_reg) {^voltage_limit}
  power_limit = VehicleSystemsComponents.Vehicle.Blocks.CCCVPowerCurrentEquation(I_cc = I_cc) {^power_limit}
  power_enabled = BlockComponents.Sources.BooleanConstant(k = use_power_limit) {^power_enabled}
  cc_ceiling = BlockComponents.Sources.Constant(k = I_cc) {^cc_ceiling}
  power_selector = BlockComponents.Logical.Switch() {^power_selector}
  ceiling = BlockComponents.Math.Min() {^ceiling}
  sign = BlockComponents.Math.Gain(k = -1.0) {^sign}
  cc_phase = BlockComponents.Logical.LessEqualThreshold(threshold = V_max - I_cc * R_reg) {^cc_phase}
  done_phase = BlockComponents.Logical.LessThreshold(threshold = I_cut) {^done_phase}
  code_cc = BlockComponents.Sources.Constant(k = 1.0) {^code_cc}
  code_cv = BlockComponents.Sources.Constant(k = 2.0) {^code_cv}
  code_done = BlockComponents.Sources.Constant(k = 3.0) {^code_done}
  cc_cv = BlockComponents.Logical.Switch() {^cc_cv}
  phase_selector = BlockComponents.Logical.Switch() {^phase_selector}
relations
  v = voltage.v
  connect(p, voltage.p, delivered.n) {^positive}
  connect(delivered.p, source.p) {^source_positive}
  connect(n, voltage.n, source.n) {^negative}
  connect(voltage.v, voltage_limit.u1, power_limit.u1, cc_phase.u) {^voltage_wire}
  connect(P_max, power_limit.u2) {^power_wire}
  connect(power_limit.y, power_selector.u1) {^limited_wire}
  connect(power_enabled.y, power_selector.u2) {^enabled_wire}
  connect(cc_ceiling.y, power_selector.u3) {^disabled_wire}
  connect(voltage_limit.y, ceiling.u1) {^voltage_ceiling_wire}
  connect(power_selector.y, ceiling.u2) {^power_ceiling_wire}
  connect(ceiling.y, sign.u) {^current_wire}
  connect(delivered.i, current, done_phase.u) {^delivered_wire}
  connect(sign.y, source.I) {^source_wire}
  connect(cc_phase.y, cc_cv.u2) {^cc_phase_wire}
  connect(code_cc.y, cc_cv.u1) {^cc_code_wire}
  connect(code_cv.y, cc_cv.u3) {^cv_code_wire}
  connect(code_done.y, phase_selector.u1) {^done_code_wire}
  connect(done_phase.y, phase_selector.u2) {^done_phase_wire}
  connect(cc_cv.y, phase_selector.u3) {^cc_cv_wire}
  connect(phase_selector.y, phase) {^phase_wire}
