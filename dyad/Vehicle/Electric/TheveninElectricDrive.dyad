    "torque_per_amp": {"Dyad":{"placement":{"diagram":{"x1":700,"x2":800,"y1":100,"y2":200}}}},
    "w1": {"Dyad":{"edges":[{"E":-1,"M":[{"x":40,"y":450},{"x":40,"y":300}],"S":1},{"E":2,"M":[{"x":420,"y":300},{"x":420,"y":392}],"S":-1},{"E":3,"M":[{"x":240,"y":450}],"S":-1}],"junctions":[{"x":240,"y":300}]}},
