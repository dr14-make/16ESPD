    "w6": {"Dyad":{"edges":[{"E":2,"M":[],"S":1}]}},
    "w7": {"Dyad":{"edges":[{"E":-1,"M":[{"x":780,"y":850}],"S":1},{"E":-1,"M":[{"x":910,"y":850}],"S":2},{"E":3,"M":[{"x":840,"y":850}],"S":-1}],"junctions":[{"x":840,"y":850}]}},
