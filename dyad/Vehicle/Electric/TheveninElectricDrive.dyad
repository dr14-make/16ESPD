    "w3": {"Dyad":{"edges":[{"E":2,"M":[{"x":660,"y":392},{"x":660,"y":402}],"S":1}]}},
    "w4": {"Dyad":{"edges":[{"E":-1,"M":[{"x":650,"y":472}],"S":1},{"E":2,"M":[{"x":650,"y":450}],"S":-1},{"E":3,"M":[{"x":670,"y":620},{"x":670,"y":150}],"S":-1}],"junctions":[{"x":650,"y":620}]}},
