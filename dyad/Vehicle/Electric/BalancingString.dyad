"""
Four-cell series bench. I_string is discharge-positive; the test harness sequences
CC, a timed low-current top-up, and discharge without replacing the cell states.
The low-current stage is a CV stand-in, not the production charger.
"""
test component BalancingString
  "Per-cell capacity multipliers [BALANCING-BENCH] (assumed), plus/minus 3 percent"
  parameter capacity_scale::Real[4] = [1.03, 1.01, 0.99, 0.97]
  "Initial SoC spread [BALANCING-BENCH] (assumed)"
  parameter SoC0::Real[4] = [0.30, 0.32, 0.34, 0.36]
  "Bench current, discharge-positive [BALANCING-BENCH] (assumed), C/10 charge"
  parameter I_string::Current = -3.31
  "Balancing gate, 0/1 [BALANCING-BENCH] (assumed); off during CC/discharge"
  parameter balancing::Real = 0.0
  c1 = VehicleSystemsComponents.Vehicle.Electric.BleedCell(Q_nom = 33.1 * 3600 * capacity_scale[1], SoC0 = SoC0[1]) {^c1}
  b1 = VehicleSystemsComponents.Vehicle.Electric.PassiveBalancer() {^b1}
  c2 = VehicleSystemsComponents.Vehicle.Electric.BleedCell(Q_nom = 33.1 * 3600 * capacity_scale[2], SoC0 = SoC0[2]) {^c2}
  b2 = VehicleSystemsComponents.Vehicle.Electric.PassiveBalancer() {^b2}
  c3 = VehicleSystemsComponents.Vehicle.Electric.BleedCell(Q_nom = 33.1 * 3600 * capacity_scale[3], SoC0 = SoC0[3]) {^c3}
  b3 = VehicleSystemsComponents.Vehicle.Electric.PassiveBalancer() {^b3}
  c4 = VehicleSystemsComponents.Vehicle.Electric.BleedCell(Q_nom = 33.1 * 3600 * capacity_scale[4], SoC0 = SoC0[4]) {^c4}
  b4 = VehicleSystemsComponents.Vehicle.Electric.PassiveBalancer() {^b4}
  source = ElectricalComponents.Analog.Sources.CurrentSource() {^source}
  ground = ElectricalComponents.Analog.Basic.Ground() {^ground}
  variable v_min::Voltage
  variable v_max::Voltage
  variable Ah_out::Real
  current = BlockComponents.Sources.Constant(k = I_string) {^current}
  enabled = BlockComponents.Sources.Constant(k = balancing) {^enabled}
  min12 = BlockComponents.Math.Min() {^min12}
  min34 = BlockComponents.Math.Min() {^min34}
  minimum = BlockComponents.Math.Min() {^minimum}
  max12 = BlockComponents.Math.Max() {^max12}
  max34 = BlockComponents.Math.Max() {^max34}
  maximum = BlockComponents.Math.Max() {^maximum}
  v1 = ElectricalComponents.Analog.Sensors.VoltageSensor() {^v1}
  v2 = ElectricalComponents.Analog.Sensors.VoltageSensor() {^v2}
  v3 = ElectricalComponents.Analog.Sensors.VoltageSensor() {^v3}
  v4 = ElectricalComponents.Analog.Sensors.VoltageSensor() {^v4}
  discharge_rate = BlockComponents.Sources.Constant(k = max(I_string, 0.0) / 3600) {^discharge_rate}
  discharge = BlockComponents.Continuous.Integrator(x0 = 0.0) {^discharge}
relations
  v_min = minimum.y
  v_max = maximum.y
  Ah_out = discharge.y
  connect(discharge_rate.y, discharge.u) {^discharge_wire}
  connect(current.y, source.I) {^wire1}
  connect(enabled.y, b1.active, b2.active, b3.active, b4.active) {^wire2}
  connect(c1.n, ground.g, source.n, v1.n) {^wire3}
  connect(c1.p, c2.n, v1.p, v2.n) {^wire4}
  connect(c2.p, c3.n, v2.p, v3.n) {^wire5}
  connect(c3.p, c4.n, v3.p, v4.n) {^wire6}
  connect(c4.p, source.p, v4.p) {^wire7}
  connect(minimum.y, b1.minimum_voltage, b2.minimum_voltage, b3.minimum_voltage, b4.minimum_voltage) {^wire8}
  connect(min12.y, minimum.u1) {^wire9}
  connect(min34.y, minimum.u2) {^wire10}
  connect(max12.y, maximum.u1) {^wire11}
  connect(max34.y, maximum.u2) {^wire12}
  connect(v1.v, b1.voltage, min12.u1, max12.u1) {^wire13}
  connect(b1.bleed, c1.enable) {^wire14}
  connect(v2.v, b2.voltage, min12.u2, max12.u2) {^wire15}
  connect(b2.bleed, c2.enable) {^wire16}
  connect(v3.v, b3.voltage, min34.u1, max34.u1) {^wire17}
  connect(b3.bleed, c3.enable) {^wire18}
  connect(v4.v, b4.voltage, min34.u2, max34.u2) {^wire19}
  connect(b4.bleed, c4.enable) {^wire20}
