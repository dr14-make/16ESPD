end

test component TestThermalTheveninCell
  "Charge current [THERMAL-BENCH] (assumed), representative DC operation"
  parameter I::Current = 143.0
  "R1 [ORNL-LEAF-ECM] (derived), inherited pack fit"
  parameter R1::Resistance = 0.1 * 1.34 / 1.60
  command = BlockComponents.Sources.Constant(k = -I) {^command}
  source = ElectricalComponents.Analog.Sources.CurrentSource() {^source}
  battery = VehicleSystemsComponents.Vehicle.Electric.ThermalTheveninCell(SoC0 = 0.1, R1 = R1) {^battery}
  ambient = ThermalComponents.Sources.FixedTemperature(T = 298.15) {^ambient}
  ground = ElectricalComponents.Analog.Basic.Ground() {^ground}
relations
  connect(command.y, source.I) {^thermal_wire1}
  connect(battery.p, source.p) {^thermal_wire2}
  connect(battery.n, source.n, ground.g) {^thermal_wire3}
  connect(battery.heat_port, ambient.port) {^thermal_wire4}
