"""
TheveninCell with resistor heat delivered to a thermal port (positive flow enters
an element). RC stored energy is not heat; only v1^2/R1 is dissipated.
Electrical defaults and their provenance are inherited unchanged.
"""
component ThermalTheveninCell
  extends VehicleSystemsComponents.Vehicle.Electric.TheveninCell
  heat_port = HeatPort() {^heat_port}
  dissipated = RealOutput() {^dissipated}
  ohmic_square = BlockComponents.Math.Product() {^ohmic_square}
  ohmic_heat = BlockComponents.Math.Gain(k = R0) {^ohmic_heat}
  polarization_sensor = ElectricalComponents.Analog.Sensors.VoltageSensor() {^polarization_sensor}
  polarization_square = BlockComponents.Math.Product() {^polarization_square}
  polarization_heat = BlockComponents.Math.Gain(k = ifelse(R1 > 0.0, 1.0 / max(R1, 1e-30), 0.0)) {^polarization_heat}
  heat_sum = BlockComponents.Math.Add() {^heat_sum}
  heat_source = ThermalComponents.Sources.PrescribedHeatFlow() {^heat_source}
relations
  connect(stored_current, ohmic_square.u1, ohmic_square.u2) {^thermal_wire1}
  connect(ohmic_square.y, ohmic_heat.u) {^thermal_wire2}
  connect(capacitor.p, polarization_sensor.p) {^polarization_positive}
  connect(capacitor.n, polarization_sensor.n) {^polarization_negative}
  connect(polarization_sensor.v, polarization_square.u1, polarization_square.u2) {^thermal_wire3}
  connect(polarization_square.y, polarization_heat.u) {^thermal_wire4}
  connect(ohmic_heat.y, heat_sum.u1) {^thermal_wire5}
  connect(polarization_heat.y, heat_sum.u2) {^thermal_wire6}
  connect(heat_sum.y, dissipated, heat_source.Q_flow) {^thermal_wire7}
  connect(heat_source.port, heat_port) {^thermal_wire8}
metadata {
  "Dyad": {"labels": [{"label": "$(instance)", "x": 500, "y": -100, "rot": 0}]},
  "_links": {
    "polarization_sensor": {"Dyad": {"placement": {"diagram": {"x1": 380, "y1": 280, "x2": 300, "y2": 200}}}},
    "polarization_square": {"Dyad": {"placement": {"diagram": {"x1": 520, "y1": 60, "x2": 600, "y2": 140}}}},
    "polarization_heat": {"Dyad": {"placement": {"diagram": {"x1": 680, "y1": 60, "x2": 760, "y2": 140}}}},
    "ohmic_square": {"Dyad": {"placement": {"diagram": {"x1": 520, "y1": 260, "x2": 600, "y2": 340}}}},
