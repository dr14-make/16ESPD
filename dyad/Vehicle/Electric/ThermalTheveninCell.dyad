    "thermal_wire3": {"Dyad": {"junctions": [{"x": 720, "y": 625}], "edges": [{"S": 1, "M": [{"x": 720, "y": 340}], "E": -1}, {"S": 2, "M": [{"x": 300, "y": 340}, {"x": 300, "y": 625}], "E": -1}, {"S": 3, "M": [], "E": -1}]}},
    "thermal_wire4": {"Dyad": {"edges": [{"S": 2, "M": [{"x": 568.0, "y": 540}], "E": 1}]}}
  }
}
end
