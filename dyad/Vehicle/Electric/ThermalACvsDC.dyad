"""
Independent charges from 10 % SoC and 25 C. Compare at each pack's 80 % crossing,
not at the same elapsed time. Adiabatic variants retain the same temperature-based
power ceiling; G_air = 0 removes cooling only. AC rating is terminal power, with
no unmodeled onboard-charger heat injected into the pack.
"""
component ThermalACvsDC
  "Passive conductance [THERMAL-BENCH] (assumed), 20 W/K; zero for adiabatic check"
  parameter G_air::ThermalConductance = 20.0
  dc = VehicleSystemsComponents.Vehicle.Electric.ThermalCharge(G_air = G_air) {^dc}
  "ACL2 power [INL-DCFC-2015] (verified), 3.3 kW"
  ac = VehicleSystemsComponents.Vehicle.Electric.ThermalCharge(G_air = G_air, P_full = 3300.0) {^ac}
metadata {
  "_links": {
    "dc": {"Dyad": {"placement": {"diagram": {"x1": 250, "y1": 250, "x2": 450, "y2": 450}}}},
    "ac": {"Dyad": {"placement": {"diagram": {"x1": 650, "y1": 250, "x2": 850, "y2": 450}}}}
  }
}
end

analysis ThermalACvsDCTransient
  extends TransientAnalysis(stop = 34000.0, alg = ODEAlg.Rodas5P(), reltol = 1e-9, abstol = 1e-10, dtmax = 10.0)
  model = VehicleSystemsComponents.Vehicle.Electric.ThermalACvsDC()
end
