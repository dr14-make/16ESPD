    "stored_voltage": {"Dyad": {"placement": {"icon": {"x1": 250, "y1": 950, "x2": 350, "y2": 1050, "rot": 90}, "diagram": {"x1": -50, "y1": 390, "x2": 50, "y2": 490, "rot": 180}}}},
    "stored_current": {"Dyad": {"placement": {"icon": {"x1": 650, "y1": 950, "x2": 750, "y2": 1050, "rot": 90}, "diagram": {"x1": 250, "y1": 950, "x2": 350, "y2": 1050, "rot": 90}}}},
    "wire1": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 980, "y": 500}, {"x": 980, "y": 840}, {"x": 820, "y": 840}, {"x": 820, "y": 900}], "E": 2}], "path": {}}},
