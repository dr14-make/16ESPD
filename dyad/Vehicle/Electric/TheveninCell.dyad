    "wire11": {"Dyad": {"junctions": [{"x": 640, "y": 820}], "edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 580, "y": 820}, {"x": 580, "y": 760}], "E": 2}, {"S": -1, "M": [{"x": 620, "y": 820}, {"x": 620, "y": 440}], "E": 3}], "path": {}}}
  }
}
end
