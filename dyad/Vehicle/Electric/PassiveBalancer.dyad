"""
One channel of a minimum-referenced passive balancer; instantiate once per cell.
Only enabled near top of charge. A smooth regenerative latch retains its fraction
inside the voltage deadband. Its output is a duty-averaged shunt command; finite
voltage resolution and measurement dynamics avoid sliding on a hard threshold.
The top gate resets at V_active - delta_on, below its turn-on voltage, so the
shunt's own terminal-voltage sag cannot toggle the gate.
"""
component PassiveBalancer
  voltage = RealInput() {^voltage}
  minimum_voltage = RealInput() {^minimum_voltage}
  active = RealInput() {^active}
  bleed = RealOutput() {^bleed}
  "Set threshold [BALANCING-BENCH] (assumed), 10 mV above minimum"
  parameter delta_on::Voltage = 0.010
  "Reset threshold [BALANCING-BENCH] (assumed), 5 mV above minimum"
  parameter delta_off::Voltage = 0.005
  "Top-of-charge gate [BALANCING-BENCH] (assumed), NMC stand-in"
  parameter V_active::Voltage = 4.05
  "Duty-command transition time [BALANCING-BENCH] (assumed)"
  parameter latch_time::Time = 0.1
  "Voltage measurement filter [BALANCING-BENCH] (assumed), slower than shunt actuation"
  parameter measurement_time::Time = 1.0
  variable measured_voltage::Voltage
  variable measured_delta::Voltage
  "Smooth threshold width [BALANCING-BENCH] (assumed), below hysteresis band"
  parameter voltage_width::Voltage = 0.0002
  variable fraction::Real
  variable request::Real
  variable delta_threshold::Voltage
  variable top_threshold::Voltage
  delta = BlockComponents.Math.Feedback() {^delta}
  voltage_filter = BlockComponents.Continuous.FirstOrder(T = measurement_time) {^voltage_filter}
  delta_filter = BlockComponents.Continuous.FirstOrder(T = measurement_time) {^delta_filter}
  latch = BlockComponents.Continuous.FirstOrder(T = latch_time) {^latch}
  enabled = BlockComponents.Nonlinear.Limiter(y_min = 0.0, y_max = 1.0) {^enabled}
  delta_set = BlockComponents.Sources.Constant(k = delta_on) {^delta_set}
  top_set = BlockComponents.Sources.Constant(k = V_active) {^top_set}
  delta_level = BlockComponents.Math.Add(k2 = -(delta_on - delta_off)) {^delta_level}
  top_level = BlockComponents.Math.Add(k2 = -delta_on) {^top_level}
  demand = VehicleSystemsComponents.Vehicle.Blocks.BalancerRequestEquation(voltage_width = voltage_width) {^demand}
  command = BlockComponents.Math.Product() {^command}
relations
  initial voltage_filter.y = voltage
  initial delta_filter.y = voltage - minimum_voltage
  initial latch.y = 0.0
  measured_voltage = voltage_filter.y
  measured_delta = delta_filter.y
  fraction = latch.y
  delta_threshold = delta_level.y
  top_threshold = top_level.y
  request = demand.y
  connect(voltage, delta.u1) {^signal1}
  connect(minimum_voltage, delta.u2) {^signal2}
  connect(voltage, voltage_filter.u) {^signal3}
  connect(delta.y, delta_filter.u) {^signal4}
  connect(active, enabled.u) {^signal5}
  connect(delta_set.y, delta_level.u1) {^signal6}
  connect(top_set.y, top_level.u1) {^signal7}
  connect(latch.y, delta_level.u2, top_level.u2, command.u2) {^signal8}
  connect(enabled.y, demand.u1, command.u1) {^signal9}
  connect(delta_filter.y, demand.u2) {^signal10}
  connect(delta_level.y, demand.u3) {^signal11}
  connect(voltage_filter.y, demand.u4) {^signal12}
  connect(top_level.y, demand.u5) {^signal13}
  connect(demand.y, latch.u) {^signal14}
  connect(command.y, bleed) {^signal15}
metadata {"_links":{"active":{"Dyad":{"placement":{"diagram":{"x1":0,"x2":40,"y1":720,"y2":760},"icon":{"x1":0,"x2":40,"y1":720,"y2":760}}}},"bleed":{"Dyad":{"placement":{"diagram":{"x1":960,"x2":1000,"y1":760,"y2":800},"icon":{"x1":960,"x2":1000,"y1":760,"y2":800}}}},"command":{"Dyad":{"placement":{"diagram":{"x1":860,"x2":940,"y1":740,"y2":820}}}},"delta":{"Dyad":{"placement":{"diagram":{"x1":140,"x2":220,"y1":280,"y2":360}}}},"delta_filter":{"Dyad":{"placement":{"diagram":{"x1":280,"x2":360,"y1":280,"y2":360}}}},"delta_level":{"Dyad":{"placement":{"diagram":{"x1":560,"x2":640,"y1":60,"y2":140}}}},"delta_set":{"Dyad":{"placement":{"diagram":{"x1":420,"x2":500,"y1":60,"y2":140}}}},"demand":{"Dyad":{"placement":{"diagram":{"x1":700,"x2":800,"y1":240,"y2":400}}}},"enabled":{"Dyad":{"placement":{"diagram":{"x1":140,"x2":220,"y1":700,"y2":780}}}},"latch":{"Dyad":{"placement":{"diagram":{"x1":700,"x2":800,"y1":580,"y2":680}}}},"minimum_voltage":{"Dyad":{"placement":{"diagram":{"x1":0,"x2":40,"y1":300,"y2":340},"icon":{"x1":0,"x2":40,"y1":300,"y2":340}}}},"signal1":{"Dyad":{"edges":[{"E":2,"M":[{"x":20.0,"y":208.0},{"x":135.2,"y":208.0}],"S":1}],"renderStyle":"standard"}},"signal10":{"Dyad":{"edges":[{"E":2,"M":[{"x":364.0,"y":293.3333333333333}],"S":1}],"renderStyle":"standard"}},"signal11":{"Dyad":{"edges":[{"E":2,"M":[{"x":644.0,"y":188.0},{"x":680.0,"y":188.0},{"x":680.0,"y":260.0},{"x":702.0,"y":260.0}],"S":1}],"renderStyle":"standard"}},"signal12":{"Dyad":{"edges":[{"E":2,"M":[{"x":364.0,"y":188.0},{"x":520.0,"y":188.0},{"x":520.0,"y":260.0},{"x":702.0,"y":260.0}],"S":1}],"renderStyle":"standard"}},"signal13":{"Dyad":{"edges":[{"E":2,"M":[{"x":660.0,"y":500.0},{"x":660.0,"y":408.0},{"x":702.0,"y":408.0}],"S":1}],"renderStyle":"standard"}},"signal14":{"Dyad":{"edges":[{"E":2,"M":[{"x":798.0,"y":588.0},{"x":695.0,"y":588.0}],"S":1}],"renderStyle":"standard"}},"signal15":{"Dyad":{"edges":[{"E":2,"M":[],"S":1}],"renderStyle":"standard"}},"signal2":{"Dyad":{"edges":[{"E":2,"M":[{"x":20.0,"y":364.8}],"S":1}],"renderStyle":"standard"}},"signal3":{"Dyad":{"edges":[{"E":2,"M":[],"S":1}],"renderStyle":"standard"}},"signal4":{"Dyad":{"edges":[{"E":2,"M":[],"S":1}],"renderStyle":"standard"}},"signal5":{"Dyad":{"edges":[{"E":2,"M":[],"S":1}],"renderStyle":"standard"}},"signal6":{"Dyad":{"edges":[{"E":2,"M":[{"x":556.0,"y":100.0}],"S":1}],"renderStyle":"standard"}},"signal7":{"Dyad":{"edges":[{"E":2,"M":[{"x":520.0,"y":500.0},{"x":520.0,"y":476.0}],"S":1}],"renderStyle":"standard"}},"signal8":{"Dyad":{"edges":[{"E":2,"M":[{"x":680.0,"y":630.0},{"x":680.0,"y":456.0},{"x":660.0,"y":456.0},{"x":660.0,"y":208.0},{"x":556.0,"y":208.0}],"S":1},{"E":3,"M":[{"x":680.0,"y":630.0},{"x":680.0,"y":524.0}],"S":1},{"E":4,"M":[{"x":856.0,"y":630.0}],"S":1}],"renderStyle":"standard"}},"signal9":{"Dyad":{"edges":[{"E":2,"M":[{"x":224.0,"y":730.0},{"x":380.0,"y":730.0},{"x":380.0,"y":720.0},{"x":540.0,"y":720.0},{"x":540.0,"y":440.0},{"x":660.0,"y":440.0},{"x":660.0,"y":266.6666666666667}],"S":1},{"E":3,"M":[{"x":540.0,"y":740.0},{"x":540.0,"y":756.0}],"S":1}],"renderStyle":"standard"}},"top_level":{"Dyad":{"placement":{"diagram":{"x1":560,"x2":640,"y1":460,"y2":540}}}},"top_set":{"Dyad":{"placement":{"diagram":{"x1":420,"x2":500,"y1":460,"y2":540}}}},"voltage":{"Dyad":{"placement":{"diagram":{"x1":0,"x2":40,"y1":100,"y2":140},"icon":{"x1":0,"x2":40,"y1":100,"y2":140}}}},"voltage_filter":{"Dyad":{"placement":{"diagram":{"x1":280,"x2":360,"y1":80,"y2":160}}}}}}
end

test component TestPassiveBalancer
  "Test voltage [BALANCING-BENCH] (assumed), above turn-on threshold"
  parameter voltage::Voltage = 4.12
  "String minimum [BALANCING-BENCH] (assumed)"
  parameter minimum_voltage::Voltage = 4.10
  channel = VehicleSystemsComponents.Vehicle.Electric.PassiveBalancer() {^channel}
  active = BlockComponents.Sources.Step(height = -1.0, offset = 1.0, start_time = 100.0) {^active}
  cell_voltage = BlockComponents.Sources.Constant(k = voltage) {^cell_voltage}
  min_voltage = BlockComponents.Sources.Constant(k = minimum_voltage) {^min_voltage}
relations
  connect(cell_voltage.y, channel.voltage) {^cell_wire}
  connect(min_voltage.y, channel.minimum_voltage) {^minimum_wire}
  connect(active.y, channel.active) {^command}
metadata {"_links":{"active":{"Dyad":{"placement":{"diagram":{"x1":160,"x2":260,"y1":660,"y2":760}}}},"cell_voltage":{"Dyad":{"placement":{"diagram":{"x1":160,"x2":260,"y1":100,"y2":200}}}},"cell_wire":{"Dyad":{"edges":[{"E":2,"M":[{"x":663.2,"y":150.0}],"S":1}],"renderStyle":"standard"}},"channel":{"Dyad":{"placement":{"diagram":{"x1":660,"x2":820,"y1":300,"y2":460}}}},"command":{"Dyad":{"edges":[{"E":2,"M":[{"x":663.2,"y":710.0}],"S":1}],"renderStyle":"standard"}},"min_voltage":{"Dyad":{"placement":{"diagram":{"x1":160,"x2":260,"y1":380,"y2":480}}}},"minimum_wire":{"Dyad":{"edges":[{"E":2,"M":[{"x":663.2,"y":430.0}],"S":1}],"renderStyle":"standard"}}}}
end

analysis BalancerTransient
  extends TransientAnalysis(stop = 150.0, tstops = [100.0], reltol = 1e-8, abstol = 1e-10)
  model = VehicleSystemsComponents.Vehicle.Electric.TestPassiveBalancer()
end
