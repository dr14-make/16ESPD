    "thermal_wire7": {"Dyad":{"edges":[{"E":2,"M":[],"S":1}],"path":{}}},
    "thermal_wire8": {"Dyad":{"edges":[{"E":2,"M":[{"x":220.0,"y":400.0},{"x":220.0,"y":800.0}],"S":1}],"path":{}}},
