  }
}
end

test component TestPackThermal
  "Initial temperature [THERMAL-BENCH] (assumed), 10 K above ambient"
  parameter T0::Temperature = 308.15
  pack = VehicleSystemsComponents.Vehicle.Electric.PackThermal(T0 = T0) {^pack}
  source = ThermalComponents.Sources.FixedHeatFlow(Q_flow = 0.0) {^source}
relations
  connect(source.port, pack.heat_port) {^thermal_wire1}
