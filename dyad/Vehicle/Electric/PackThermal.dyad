"""
One-temperature ZE1 pack, 250 kJ/K (303 kg times approximately 825 J/(kg K)).
Effective capacity uses the Steinhardt 2022 pouch-cell median and partial case
coupling; passive air conductance follows INL cooling (about seven hours).
Coolant conductance zero disables the optional parallel path without switching.
Known omissions: entropic heat (net approximately +/-0.7 K), daily ambient swing, auxiliary heat.
"""
component PackThermal
  "Pack mass [NISSAN] (verified), ZE1 US 303 kg"
  parameter mass::Mass = 303.0
  "Effective specific heat [STEINHARDT-2022] (derived), 250 kJ/K on 303 kg"
  parameter cp::Real = 250000.0 / 303.0
  "Passive conductance [INL-DCFC-2015] (derived), Figs. 5–6 cooling, W/K"
  parameter G_air::ThermalConductance = 10.0
  "Coolant conductance [THERMAL-BENCH] (assumed), off by default"
  parameter G_coolant::ThermalConductance = 0.0
  "Ambient [THERMAL-BENCH] (assumed), 25 C"
  parameter T_ambient::Temperature = 298.15
  "Coolant boundary [THERMAL-BENCH] (assumed), 25 C"
  parameter T_coolant::Temperature = 298.15
  "Initial pack temperature [THERMAL-BENCH] (assumed), ambient"
  parameter T0::Temperature = T_ambient
  heat_port = HeatPort() {^heat_port}
  T = RealOutput() {^T}
  variable E_in::Energy
  variable E_out::Energy
  input_flow = ThermalComponents.Sensors.HeatFlowSensor() {^input_flow}
  capacity = ThermalComponents.Components.HeatCapacitor(C = mass * cp, T0 = T0) {^capacity}
  air = ThermalComponents.Components.ThermalConductor(G = G_air) {^air}
  coolant = ThermalComponents.Components.ThermalConductor(G = G_coolant) {^coolant}
  ambient = ThermalComponents.Sources.FixedTemperature(T = T_ambient) {^ambient}
  coolant_boundary = ThermalComponents.Sources.FixedTemperature(T = T_coolant) {^coolant_boundary}
  temperature_sensor = ThermalComponents.Sensors.TemperatureSensor() {^temperature_sensor}
  air_flow = ThermalComponents.Sensors.HeatFlowSensor() {^air_flow}
  coolant_flow = ThermalComponents.Sensors.HeatFlowSensor() {^coolant_flow}
  out_sum = BlockComponents.Math.Add() {^out_sum}
  in_energy = BlockComponents.Continuous.Integrator(x0 = 0.0) {^in_energy}
  out_energy = BlockComponents.Continuous.Integrator(x0 = 0.0) {^out_energy}
relations
  # Compatibility aliases retain the public energy histories; states live in integrators.
  E_in = in_energy.y
  E_out = out_energy.y
  connect(heat_port, input_flow.port_a) {^thermal_wire1}
  connect(input_flow.port_b, capacity.port, air_flow.port_a, coolant_flow.port_a, temperature_sensor.port) {^thermal_wire2}
  connect(air_flow.port_b, air.port_a) {^thermal_wire3}
  connect(coolant_flow.port_b, coolant.port_a) {^thermal_wire4}
  connect(air.port_b, ambient.port) {^thermal_wire5}
  connect(coolant.port_b, coolant_boundary.port) {^thermal_wire6}
  connect(temperature_sensor.T, T) {^thermal_wire7}
  connect(input_flow.Q_flow, in_energy.u) {^thermal_wire8}
  connect(air_flow.Q_flow, out_sum.u1) {^thermal_wire9}
  connect(coolant_flow.Q_flow, out_sum.u2) {^thermal_wire10}
  connect(out_sum.y, out_energy.u) {^thermal_wire11}
metadata {
