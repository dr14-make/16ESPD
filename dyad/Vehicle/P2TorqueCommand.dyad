"Machine demand with optional start compensation (derived; P2 clutch-start torque balance)."
component P2TorqueCommand
  "Requested machine torque [N.m] (derived; EnergyManager)"
  u = RealInput() {^u}
  "Engine target torque [N.m] (derived; EnergyManager)"
  engine_target = RealInput() {^engine_target}
  "Torque entering K0 [N.m] (derived; DisconnectClutch)"
  k0_torque = RealInput() {^k0_torque}
  variable compensation::Torque
  "Machine shaft speed [rad/s] (derived; DCMachine)"
  w = RealInput() {^w}
  "Compensated and bounded demand [N.m] (derived; P2 clutch-start torque balance)"
  y = RealOutput() {^y}
  "Enable clutch-start compensation (assumed; fixed configuration)"
  structural parameter on::Boolean = false
  "Machine peak torque [N.m] (derived; HybridDrive rating)"
  parameter T_max::Torque = 205.0
  "Machine rated power [W] (derived; HybridDrive rating)"
  parameter P_rated::Power = 30.0e3
  variable limit::Torque
relations
  if on
    compensation = engine_target - k0_torque
    limit = min(T_max, P_rated / max(abs(w), 1.0))
    y = min(max(u + compensation, -limit), limit)
  else
    compensation = 0.0
    limit = 0.0
    y = u
  end
