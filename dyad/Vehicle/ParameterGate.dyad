"Parameter-selected signal path without events (derived; Lecture 5 fixed configurations)."
component ParameterGate
  "Signal to pass (derived; fixed-mode selection)"
  u = RealInput() {^u}
  "Selected signal (derived; fixed-mode selection)"
  y = RealOutput() {^y}
  "Pass the signal rather than the fallback (assumed; fixed configuration)"
  parameter on::Boolean = true
  "Output when disabled (assumed; fixed configuration)"
  parameter fallback::Real = 0.0
relations
  y = ifelse(on, u, fallback)
