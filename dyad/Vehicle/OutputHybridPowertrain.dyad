"""
Output-coupled 30 kW hybrid. `rear=false` is P3: machine joins the front
CVT output. `rear=true` is P4: machine drives only `rear_spline`; the engine
still drives front `spline`. Each output is wheel-speed, before an external
unity-ratio axle differential. P4 therefore requires a separate rear differential
in the vehicle fixture, not a connection of front and rear shafts inside this model.
CVT defaults already include the front final drive; i_output is the separate
machine-to-wheel reduction, not another front engine final drive.
The rear port is always present and torque-free in P3. An ideal axle router
selects only the machine branch without locking front and rear shaft speeds.
Both CVT scheduling modes use P2Variator's shared ratio actuator and schedule.

An ideal separate starter accelerates the crank while K0 request is gated by
firing_fraction, so traction machine torque is not used for push-starting.
Starter mechanical work P_start must be included in the fixture's stored-energy meter
at its assumed electrical efficiency; no starter current or solenoid dynamics are modeled.
"""
component OutputHybridPowertrain
  "Place the electric branch on a separate rear axle (assumed structural P3/P4 selection)"
  structural parameter rear::Boolean = false
  "Select speed-commanded CVT scheduling (assumed comparison option)"
  structural parameter speed_commanded::Boolean = false
  engine_pedal = RealInput() {^engine_pedal}
  engine_on = RealInput() {^engine_on}
  engage = RealInput() {^engage}
  tau_ref = RealInput() {^tau_ref}
  engine_torque_ref = RealInput() {^engine_torque_ref}
  variable machine_limit::Torque
  variable start_compensation::Torque
  cvt_pedal = RealInput() {^cvt_pedal}
  N_ref = RealInput() {^N_ref}
  "Front wheel-speed output; connect an external differential"
  spline = Spline() {^spline}
  "Rear wheel-speed output; torque-free for P3, connect a separate rear differential"
  rear_spline = Spline() {^rear_spline}
  support = Spline() {^support}
  engine_speed = RealOutput() {^engine_speed}
  engine_torque = RealOutput() {^engine_torque}
  available_torque = RealOutput() {^available_torque}
  mdot_fuel = RealOutput() {^mdot_fuel}
  machine_torque = RealOutput() {^machine_torque}
  position = RealOutput() {^position}
  SoC = RealOutput() {^SoC}
  E = RealOutput() {^E}
  i = RealOutput() {^i}
  "Starter mechanical power [W], for the fixture energy meter (derived; torque times crank speed)"
  P_start = RealOutput() {^P_start}
  "Machine/wheel speed ratio (derived; Lecture 4 Leaf reduction)"
  parameter i_output::Real(min = eps(Float64)) = 8.193
  "Machine rated power (ORNL-2011 Sonata anchor, common HybridDrive comparison basis)"
  parameter P_rated::Power = 30.0e3
  "Machine peak torque (ORNL-2011 Sonata anchor, common HybridDrive comparison basis)"
  parameter T_max::Torque = 205.0
  "Lower firing speed [rpm] (assumed; same as P2Powertrain)"
  parameter firing_rpm::Real = 400.0
  "Firing speed band [rpm] (assumed; same as P2Powertrain)"
  parameter firing_width::Real(min = eps(Float64)) = 300.0
  "Ideal starter crank torque (assumed: exceeds engine motoring drag, not a fitted starter)"
  parameter starter_torque::Torque(min = 0.0) = 50.0
  "Initial crank speed (assumed stopped fixture)"
  parameter engine_speed_start::AngularVelocity = 0.0
  "Initial K0 position (assumed open to avoid initial push-start)"
  parameter position_start::Real = 0.0
  "Linear fraction across firing band (derived: engine rpm)"
  variable firing_fraction::Real
  "Starter activation fraction (derived: engine request times unfired fraction)"
  variable start_fraction::Real
  engine = VehicleSystemsComponents.Vehicle.Engine.MappedEngine(fuel_controlled = true)
  k0 = VehicleSystemsComponents.Vehicle.DisconnectClutch(position_start = position_start)
  drive = VehicleSystemsComponents.Vehicle.Electric.HybridDrive(P_rated = P_rated, T_max = T_max, ratio = i_output)
  starter = RotationalComponents.Sources.TorqueSource()
  speed_variator = VehicleSystemsComponents.Vehicle.P2Variator(speed_commanded = speed_commanded) {^speed_variator}
  axle_router = VehicleSystemsComponents.Vehicle.OutputHybridAxleRouter(rear = rear)
  shaft_speed = RealOutput() {^shaft_speed}
  ratio = RealOutput() {^ratio}
relations
  connect(speed_variator.w_a, shaft_speed) {^shaft_speed_wire}
  connect(speed_variator.ratio, ratio) {^ratio_wire}
  initial engine.air.manifold.p = 101325.0
  initial engine.crankshaft.w = engine_speed_start
  initial engine.crankshaft.phi = 0.0
  initial k0.spline_b.phi = 0.0

  connect(engine_pedal, engine.pedal)
  machine_limit = min(drive.T_max, drive.P_rated / max(abs(drive.machine.w), 1.0))
  start_compensation = engine_torque_ref - k0.tau
  drive.tau_ref = min(max((tau_ref + start_compensation) * speed_variator.ratio / i_output, -machine_limit), machine_limit)
  firing_fraction = min(max((engine.N - firing_rpm) / firing_width, 0.0), 1.0)
  engine.fuel_enable = engine_on * firing_fraction^2 * (3.0 - 2.0 * firing_fraction)
  k0.engage = engage * firing_fraction
  start_fraction = min(max(engine_on, 0.0), 1.0) * (1.0 - firing_fraction)
  starter.tau = starter_torque * start_fraction
  P_start = max(starter.tau * engine.speed.w, 0.0)
  connect(engine.spline, k0.spline_a, starter.spline)
  connect(N_ref, speed_variator.N_ref)
  connect(cvt_pedal, speed_variator.pedal)
  connect(k0.spline_b, speed_variator.spline_a)
  connect(speed_variator.spline_b, spline)
  connect(speed_variator.support, support)
  connect(drive.spline, axle_router.machine)
  connect(axle_router.front, spline)
  connect(axle_router.rear_axle, rear_spline)
  connect(engine.support, k0.support, starter.support, drive.support, support)
  engine_speed = engine.speed.w
  engine_torque = engine.tau_e
  available_torque = engine.torque_map.full_load.y
  mdot_fuel = engine.mdot_fuel
  machine_torque = drive.machine.tau
  position = k0.position
  SoC = drive.SoC
  E = drive.battery.E
  i = drive.battery.i
