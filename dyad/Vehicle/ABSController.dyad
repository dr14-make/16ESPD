    },
    "id6": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id7": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  }
}
end

"""
Clocked ABS pressure-memory state machine.

Phase is -1 decrease, 0 hold, 1 increase, and 2 off. All memory changes only on `clk`.
"""
component ABSModulatorDiscrete@[input clk extends Discrete]
  lambda = RealInput@[clk]() {^lambda}
  v_ref = RealInput@[clk]() {^v_ref}
  demand = RealInput@[clk]() {^demand}
  tau_cmd = RealOutput@[clk]() {^tau_cmd}
  phase_out = RealOutput@[clk]() {^phase_out}
  tau_lock_out = RealOutput@[clk]() {^tau_lock_out}
  lambda_dot_out = RealOutput@[clk]() {^lambda_dot_out}
  parameter dt::Time(min = eps(Float64)) = 0.005
  parameter T_p::Time(min = 0.0) = 0.03
  parameter lambda_1::Real = 0.04
  parameter lambda_lock::Real = 0.20
  parameter alpha_rel::Real = 0.6
  parameter beta_reapply::Real = 0.85
  parameter l_rec::Real = 0.03
  parameter T_hold_max::Time(min = eps(Float64)) = 0.06
  parameter k_dec::Real = 80000.0
  parameter k_inc_fast::Real = 80000.0
  parameter k_inc_slow::Real = 8000.0
  parameter v_min::Velocity = 1.5
  variable p::Torque
  variable phase::Real
  variable tau_lock::Torque
  variable hold_count::Real
  variable released::Real
  variable fast_reapply::Real
  variable lambda_dot::Real
  variable lambda_pred::Real
  variable release_now::Real
  variable rate::Real
  variable dec_rate::Real
  variable fast_rate::Real
  variable slow_rate::Real
relations
  initial p@(clk-1) = 0.0
  initial phase@(clk-1) = 2.0
  initial tau_lock@(clk-1) = 0.0
  initial hold_count@(clk-1) = 0.0
  initial released@(clk-1) = 0.0
  initial fast_reapply@(clk-1) = 0.0
  initial lambda@(clk-1) = 0.0
  lambda_dot@clk = (lambda@clk - lambda@(clk-1)) / dt
  lambda_pred@clk = lambda@clk + T_p * lambda_dot@clk
  release_now@clk = ifelse(lambda_pred@clk < -lambda_1 or lambda@clk < -lambda_lock, 1.0, 0.0)
  phase@clk = ifelse(v_ref@clk < v_min or demand@clk <= 0.0, 2.0, ifelse(phase@(clk-1) < -0.5, ifelse(p@(clk-1) <= alpha_rel * tau_lock@(clk-1), 0.0, -1.0), ifelse(phase@(clk-1) < 0.5, ifelse(lambda_pred@clk > -l_rec, 1.0, ifelse(hold_count@(clk-1) * dt >= T_hold_max, -1.0, 0.0)), ifelse(release_now@clk > 0.5, -1.0, 1.0))))
  tau_lock@clk = ifelse(phase@clk < -0.5 and phase@(clk-1) >= -0.5, p@(clk-1), tau_lock@(clk-1))
  released@clk = ifelse(phase@clk < -0.5, 1.0, released@(clk-1))
  hold_count@clk = ifelse(phase@clk > -0.5 and phase@clk < 0.5, hold_count@(clk-1) + 1.0, 0.0)
  fast_reapply@clk = ifelse(phase@clk < 0.5, 0.0, ifelse(phase@(clk-1) < 0.5 and phase@clk > 0.5, 1.0, ifelse(fast_reapply@(clk-1) > 0.5 and p@(clk-1) < beta_reapply * tau_lock@(clk-1), 1.0, 0.0)))
  dec_rate@clk = ifelse(released@(clk-1) > 0.5, 15.0 * tau_lock@(clk-1), k_dec)
  fast_rate@clk = ifelse(released@(clk-1) > 0.5, 15.0 * tau_lock@(clk-1), k_inc_fast)
  slow_rate@clk = ifelse(released@(clk-1) > 0.5, 1.5 * tau_lock@(clk-1), k_inc_slow)
  rate@clk = ifelse(phase@clk < -0.5, -dec_rate@clk, ifelse(phase@clk < 0.5, 0.0, ifelse(released@(clk-1) < 0.5 or fast_reapply@clk > 0.5, fast_rate@clk, slow_rate@clk)))
  p@clk = ifelse(phase@clk > 1.5, max(demand@clk, 0.0), min(max(p@(clk-1) + rate@clk * dt, 0.0), max(demand@clk, 0.0)))
  tau_cmd = p
  phase_out = phase
  tau_lock_out = tau_lock
  lambda_dot_out = lambda_dot
metadata {
  "_links": {
    "lambda": {"Dyad": {"placement": {"icon": {"x1": -50, "x2": 50, "y1": 200, "y2": 300}}}},
    "v_ref": {"Dyad": {"placement": {"icon": {"x1": -50, "x2": 50, "y1": 450, "y2": 550}}}},
    "demand": {"Dyad": {"placement": {"icon": {"x1": -50, "x2": 50, "y1": 700, "y2": 800}}}},
    "tau_cmd": {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 150, "y2": 250}}}},
    "phase_out": {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 350, "y2": 450}}}},
    "tau_lock_out": {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 550, "y2": 650}}}},
    "lambda_dot_out": {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 750, "y2": 850}}}}
  }
}
end

"Clocked wheel-only reference-speed and slip estimator."
component ABSWheelOnlyEstimatorDiscrete@[input clk extends Discrete]
  omega = RealInput@[clk]() {^omega}
  lambda = RealOutput@[clk]() {^lambda}
  v_ref_out = RealOutput@[clk]() {^v_ref_out}
  a_w_out = RealOutput@[clk]() {^a_w_out}
  parameter dt::Time(min = eps(Float64)) = 0.005
  parameter radius::Length = 0.31
  parameter a_ref::Acceleration = 10.0
  parameter v_ref0::Velocity = 25.0
  parameter omega0::AngularVelocity = v_ref0 / radius
  parameter v_eps::Velocity(min = eps(Float64)) = 0.5
  variable v_ref::Velocity
  variable v_w::Velocity
  variable a_w::Acceleration
  variable a_hat::Acceleration
  variable a_ref_effective::Acceleration
relations
  initial omega@(clk-1) = omega0
  initial v_ref@(clk-1) = v_ref0
  initial a_hat@(clk-1) = a_ref / 1.2
  v_w@clk = omega@clk * radius
  a_w@clk = (omega@clk - omega@(clk-1)) * radius / dt
  a_hat@clk = a_hat@(clk-1)
  a_ref_effective@clk = min(max(1.2 * a_hat@clk, 1.0), 12.0)
  v_ref@clk = ifelse(v_w@clk > v_ref@(clk-1), v_w@clk, max(v_ref@(clk-1) - a_ref_effective@clk * dt, v_w@clk))
  lambda@clk = (v_w@clk - v_ref@clk) / max(v_ref@clk, v_eps)
  v_ref_out = v_ref
  a_w_out = a_w
metadata {
  "_links": {
    "omega": {"Dyad": {"placement": {"icon": {"x1": -50, "x2": 50, "y1": 450, "y2": 550}}}},
    "lambda": {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 200, "y2": 300}}}},
    "v_ref_out": {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 450, "y2": 550}}}},
    "a_w_out": {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 700, "y2": 800}}}}
  }
}
end

"Wheel-speed-only sampled ABS controller."
component ABSControllerWheelOnly@[input clk extends Discrete]
  omega = RealInput@[clk]() {^omega}
  demand = RealInput@[clk]() {^demand}
  tau_cmd = RealOutput@[clk]() {^tau_cmd}
  phase_out = RealOutput@[clk]() {^phase_out}
  lambda_hat_out = RealOutput@[clk]() {^lambda_hat_out}
  v_ref_out = RealOutput@[clk]() {^v_ref_out}
  a_w_out = RealOutput@[clk]() {^a_w_out}
  estimator = VehicleSystemsComponents.Vehicle.ABSWheelOnlyEstimatorDiscrete(dt = dt, radius = radius, a_ref = a_ref, v_ref0 = v_ref0, omega0 = omega0, v_eps = v_eps) {^estimator}
  modulator = VehicleSystemsComponents.Vehicle.ABSModulatorDiscrete(dt = dt, T_p = T_p, lambda_1 = lambda_1, lambda_lock = lambda_lock, alpha_rel = alpha_rel, beta_reapply = beta_reapply, l_rec = l_rec, T_hold_max = T_hold_max, k_dec = k_dec, k_inc_fast = k_inc_fast, k_inc_slow = k_inc_slow, v_min = v_min) {^modulator}
  parameter dt::Time(min = eps(Float64)) = 0.005
  parameter radius::Length = 0.31
  parameter a_ref::Acceleration = 10.0
  parameter omega0::AngularVelocity = 0.0
  parameter v_ref0::Velocity = 0.0
  parameter v_eps::Velocity(min = eps(Float64)) = 0.5
  parameter T_p::Time(min = 0.0) = 0.03
  parameter lambda_1::Real = 0.04
  parameter lambda_lock::Real = 0.20
  parameter alpha_rel::Real = 0.6
  parameter beta_reapply::Real = 0.85
  parameter l_rec::Real = 0.03
  parameter T_hold_max::Time(min = eps(Float64)) = 0.06
  parameter k_dec::Real = 80000.0
  parameter k_inc_fast::Real = 80000.0
  parameter k_inc_slow::Real = 8000.0
  parameter v_min::Velocity = 1.5
relations
  connect(omega, estimator.omega) {^id10}
  connect(estimator.lambda, modulator.lambda) {^id11}
  connect(estimator.v_ref_out, modulator.v_ref) {^id12}
  connect(demand, modulator.demand) {^id13}
  connect(modulator.tau_cmd, tau_cmd) {^id14}
  connect(modulator.phase_out, phase_out) {^id15}
  connect(estimator.lambda, lambda_hat_out) {^id16}
  connect(estimator.v_ref_out, v_ref_out) {^id17}
  connect(estimator.a_w_out, a_w_out) {^id18}
