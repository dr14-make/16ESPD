"Shared continuous clipped brake-pressure integrator retained for the continuous ideal benchmark."
component ABSPressureIntegrator
  demand = RealInput() {^demand}
  requested_rate = RealInput() {^requested_rate}
  active = RealInput() {^active}
  tau_cmd = RealOutput() {^tau_cmd}
  parameter T_track::Time(min = eps(Float64)) = 0.01
  variable p::Torque
  variable pressure_rate::Real
relations
  initial p = 0.0
  pressure_rate = ifelse(active < 0.5, (max(demand, 0.0) - p) / T_track, ifelse(p > max(demand, 0.0), min((max(demand, 0.0) - p) / T_track, requested_rate), ifelse(p <= 0.0 and requested_rate < 0.0, 0.0, ifelse(p >= max(demand, 0.0) and requested_rate > 0.0, 0.0, requested_rate))))
  der(p) = pressure_rate
  tau_cmd = min(max(p, 0.0), max(demand, 0.0))
metadata {
  "_links": {
    "demand": {"Dyad": {"placement": {"icon": {"x1": -50, "x2": 50, "y1": 200, "y2": 300}}}},
    "requested_rate": {"Dyad": {"placement": {"icon": {"x1": -50, "x2": 50, "y1": 450, "y2": 550}}}},
    "active": {"Dyad": {"placement": {"icon": {"x1": -50, "x2": 50, "y1": 700, "y2": 800}}}},
    "tau_cmd": {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 450, "y2": 550}}}}
  }
}
end

"Ideal continuous ABS benchmark using true tire slip and true vehicle speed."
component ABSIdealController
  kappa = RealInput() {^kappa}
  v = RealInput() {^v}
  demand = RealInput() {^demand}
  tau_cmd = RealOutput() {^tau_cmd}
  pressure = VehicleSystemsComponents.Vehicle.ABSPressureIntegrator(T_track = T_track) {^pressure}
  parameter lambda_target::Real = 0.04
  parameter T_p::Time(min = eps(Float64)) = 0.03
  parameter T_f::Time(min = eps(Float64)) = 0.003
  parameter k_inc::Real = 20000.0
  parameter k_dec::Real = 40000.0
  parameter v_min::Velocity = 1.5
  parameter T_track::Time(min = eps(Float64)) = 0.01
  variable kappa_filtered::Real
  variable kappa_dot::Real
  variable kappa_pred::Real
  variable rate::Real
relations
  initial kappa_filtered = 0.0
  der(kappa_filtered) = (kappa - kappa_filtered) / T_f
  kappa_dot = (kappa - kappa_filtered) / T_f
  kappa_pred = kappa + T_p * kappa_dot
  rate = ifelse(kappa_pred < -lambda_target, -k_dec, k_inc)
  connect(demand, pressure.demand) {^id6}
  pressure.requested_rate = rate
  pressure.active = ifelse(v > v_min, 1.0, 0.0)
  connect(pressure.tau_cmd, tau_cmd) {^id7}
metadata {
  "_links": {
    "kappa": {
      "Dyad": {
        "placement": {
          "icon": {"x1": -50, "x2": 50, "y1": 200, "y2": 300},
          "diagram": {"x1": 20, "x2": 120, "y1": 20, "y2": 120}
        }
      }
    },
    "v": {
      "Dyad": {
        "placement": {
          "icon": {"x1": -50, "x2": 50, "y1": 450, "y2": 550},
          "diagram": {"x1": 140, "x2": 240, "y1": 20, "y2": 120}
        }
      }
    },
    "demand": {
      "Dyad": {
        "placement": {
          "icon": {"x1": -50, "x2": 50, "y1": 700, "y2": 800},
          "diagram": {"x1": 20, "x2": 120, "y1": 140, "y2": 240}
        }
      }
    },
    "tau_cmd": {
      "Dyad": {
        "placement": {
          "icon": {"x1": 950, "x2": 1050, "y1": 450, "y2": 550},
          "diagram": {"x1": 270, "x2": 370, "y1": 165, "y2": 265}
        }
      }
    },
