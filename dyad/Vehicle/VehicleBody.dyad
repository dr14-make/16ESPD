"""
Longitudinal vehicle body: tractive force in at the flange, resisted by drag,
rolling resistance and road grade.

Aerodynamic drag uses the `v*|v|` form (`ForceDirection = false`) so it opposes motion
in both travel directions rather than always braking forward. Rolling resistance and the
grade force share the single `grade` input — `RollingResistance` reads it as `inclination`
(tan of the road angle) to shed the cosine of normal load, and `GradeForce` reads it as the
gradient of the along-slope gravity term.
"""
component VehicleBody
  "Tractive force from the driveline"
  flange = Flange()
  "Road gradient, tan(alpha)"
  grade = RealInput()
  "Vehicle mass"
  parameter m::Dyad.Mass = 1400.0
  "Aerodynamic drag area (Cd * A)"
  parameter CdA::Area = 0.63
  "Air density"
  parameter rho::Density = 1.2
  "Speed at which drag equals its nominal value"
  parameter v_nominal::Velocity = 30.0
  "Rolling resistance coefficient"
  parameter f_r::Real = 0.012
  "Gravitational acceleration"
  parameter g::Acceleration = 9.80665
  mass = TranslationalComponents.Components.Mass(m = m)
  # f_nominal is negative so the quadratic force acts as a load (drag) rather than a
  # propulsion: the stdlib source drives the mass with -flange.f, and its own docstring
  # states a negative nominal force is what makes it oppose motion in the positive direction.
  drag = TranslationalComponents.Sources.QuadraticSpeedDependentForce(ForceDirection = false, v_nominal = v_nominal, f_nominal = -0.5 * rho * CdA * v_nominal ^ 2)
  rolling = TranslationalComponents.Components.RollingResistance(fWeight = m * g)
  cr_const = BlockComponents.Sources.Constant(k = f_r)
  gradeforce = VehicleSystemsComponents.Vehicle.GradeForce(m = m)
  "Road reference for the resistance reaction forces"
  ground = TranslationalComponents.Components.Fixed()
relations
  connect(flange, mass.flange_a)
  connect(drag.flange, mass.flange_a)
  connect(rolling.flange, mass.flange_a)
  connect(gradeforce.flange, mass.flange_a)
  connect(drag.support, ground.flange)
  connect(rolling.support, ground.flange)
  connect(gradeforce.support, ground.flange)
  connect(cr_const.y, rolling.cr)
  connect(grade, rolling.inclination)
  connect(grade, gradeforce.grade)
end

test component TestVehicleBody
  "Constant tractive force from rest on flat road"
  tractive = TranslationalComponents.Sources.ConstantForce(f_constant = 500.0)
  grade = BlockComponents.Sources.Constant(k = 0.0)
  body = VehicleSystemsComponents.Vehicle.VehicleBody()
  fixed = TranslationalComponents.Components.Fixed()
relations
  connect(tractive.flange, body.flange)
  connect(grade.y, body.grade)
  connect(tractive.support, fixed.flange)
  initial body.mass.s = 0.0
  initial body.mass.v = 0.0
metadata {
  "Dyad": {
    "tests": {
      "case1": {
        "stop": 800,
        "atol": {"body.mass.a": 0.001, "body.mass.v": 0.001},
        "expect": {
          "initial": {"body.mass.a": 0.35714285714285715, "body.mass.v": 0},
          "final": {"body.mass.a": 0, "body.mass.v": 29.780869893947216},
          "signals": ["body.mass.a", "body.mass.v"]
        }
      }
    }
  }
}
end
