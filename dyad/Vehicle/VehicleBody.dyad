"""
Longitudinal vehicle body: tractive force in at the flange, resisted by drag,
rolling resistance and road grade.

The body is a `RoadLoad` with the vehicle mass on its flange. The road load carries no mass of
its own, so the same resistance law also serves the planar car, whose mass lives in its
multibody body. The parameters, their provenance tags and the parts `drag`, `rolling`,
`gradeforce`, `cr_const` and `ground` are the road load's; the body adds only `mass`.
"""
component VehicleBody
  # Extends rather than holding a `roadload` part, so every path (`body.drag.f`, `body.m`) and
  # the generated equations stay exactly as they were. A subcomponent renames the variables,
  # which reorders the terms of the generated force sum: the one-ulp change shifts the solver's
  # steps through an ABS stop and moves the step-sampled braking distance by 5e-4 m.
  extends VehicleSystemsComponents.Vehicle.RoadLoad
  mass = TranslationalComponents.Components.Mass(m = m) {^mass}
relations
  connect(flange, mass.flange_a) {^id2}
metadata {
  "_links": {
    "mass": {
      "Dyad": {"placement": {"diagram": {"x1": 850, "x2": 750, "y1": 250, "y2": 350}}}
    },
    "id2": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 900, "y": 500}, {"x": 900, "y": 300}], "E": 2}],
        "path": {}
      }
    }
  }
}
end

test component TestVehicleBody
  "Constant tractive force from rest on flat road"
  tractive = TranslationalComponents.Sources.ConstantForce(f_constant = 500.0)
  grade = BlockComponents.Sources.Constant(k = 0.0)
  body = VehicleSystemsComponents.Vehicle.VehicleBody()
  fixed = TranslationalComponents.Components.Fixed()
relations
  connect(tractive.flange, body.flange)
  connect(grade.y, body.grade)
  connect(tractive.support, fixed.flange)
  initial body.mass.s = 0.0
  initial body.mass.v = 0.0
metadata {
  "Dyad": {
    "tests": {
      "case1": {
        "stop": 800,
        "atol": {"body.mass.a": 0.001, "body.mass.v": 0.001},
        "expect": {
          "initial": {"body.mass.a": 0.35714285714285715, "body.mass.v": 0},
          "final": {"body.mass.a": 0, "body.mass.v": 29.780869893947216},
          "signals": ["body.mass.a", "body.mass.v"]
        }
      }
    }
  }
}
end