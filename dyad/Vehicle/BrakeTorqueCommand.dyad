"""
Fixed-mode total wheel friction-brake magnitude command.
Engine mode converts the negative driver request with brake_gain; electric mode
converts the split's per-front-wheel brake magnitude through the current ratio.
All ports remain present in both structural configurations.
"""
component BrakeTorqueCommand
  structural parameter electric::Boolean = false
  parameter brake_gain::Real = 12.0
  "Signed driver request [N.m]"
  driver = RealInput() {^driver}
  "Positive per-front-wheel split brake torque before the CVT [N.m]"
  brake = RealInput() {^brake}
  "Actual input-to-wheel speed reduction"
  ratio = RealInput() {^ratio}
  "Positive total wheel brake torque magnitude [N.m]"
  magnitude = RealOutput() {^magnitude}
relations
  if electric
    magnitude = 2.0 * brake * ratio
  else
    magnitude = -min(driver, 0.0) * brake_gain
  end
metadata {
  "_links": {
    "driver": {"Dyad": {"placement": {"diagram": {"x1": -25, "y1": 175, "x2": 25, "y2": 225}, "icon": {"x1": -40, "y1": 160, "x2": 40, "y2": 240}}}},
    "brake": {"Dyad": {"placement": {"diagram": {"x1": -25, "y1": 475, "x2": 25, "y2": 525}, "icon": {"x1": -40, "y1": 460, "x2": 40, "y2": 540}}}},
    "ratio": {"Dyad": {"placement": {"diagram": {"x1": -25, "y1": 775, "x2": 25, "y2": 825}, "icon": {"x1": -40, "y1": 760, "x2": 40, "y2": 840}}}},
    "magnitude": {"Dyad": {"placement": {"diagram": {"x1": 975, "y1": 475, "x2": 1025, "y2": 525}, "icon": {"x1": 960, "y1": 460, "x2": 1040, "y2": 540}}}}
  }
}
end
