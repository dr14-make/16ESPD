"""
y = mod(u1, period)
Daily phase in seconds from elapsed time u1; preserves the original modulo boundary.
"""
component SoCPhaseEquation
  u1 = RealInput() {^u1}
  y = RealOutput() {^y}
  parameter period::Real = 86400.0
relations
  y = mod(u1, period)
