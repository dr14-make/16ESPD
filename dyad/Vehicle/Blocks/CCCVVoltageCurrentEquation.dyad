"""
y = min(I_cc, max(0.0, (V_max - u1) / R_reg))

CC-CV current ceiling [A] from terminal voltage u1 [V].
"""
component CCCVVoltageCurrentEquation
  parameter I_cc::Current = 143.0
  parameter V_max::Voltage = 403.2
  parameter R_reg::Resistance = 1e-5
  u1 = RealInput() {^u1}
  y = RealOutput() {^y}
relations
  y = min(I_cc, max(0.0, (V_max - u1) / R_reg))
