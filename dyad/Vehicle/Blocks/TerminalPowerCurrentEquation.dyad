"""
y = P / max(u1, 1.0).
Convert terminal power to current with the original one-volt denominator floor.
"""
component TerminalPowerCurrentEquation
  parameter P::Real = 20000.0
  u1 = RealInput() {^u1}
  y = RealOutput() {^y}
relations
  y = P / max(u1, 1.0)
