"""
y = exp(Ea / Rg * (1 / u1 - 1 / Tref)).
Resistance multiplier relative to Tref; u1 is absolute temperature [K].
"""
component ArrheniusFactorEquation
  parameter Ea::Real = 12500.0
  parameter Rg::Real = 8.314
  parameter Tref::Real = 298.15
  u1 = RealInput() {^u1}
  y = RealOutput() {^y}
relations
  y = exp(Ea / Rg * (1.0 / u1 - 1.0 / Tref))
