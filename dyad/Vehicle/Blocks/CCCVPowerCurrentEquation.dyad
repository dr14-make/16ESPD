"""
y = min(I_cc, max(0.0, u2) / max(u1, 1.0))

Terminal-power current ceiling [A], using voltage u1 [V] and power u2 [W].
Enable/disable selection is provided by the charger's standard Switch block.
"""
component CCCVPowerCurrentEquation
  parameter I_cc::Current = 143.0
  u1 = RealInput() {^u1}
  u2 = RealInput() {^u2}
  y = RealOutput() {^y}
relations
  y = min(I_cc, max(0.0, u2) / max(u1, 1.0))
