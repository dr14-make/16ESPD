test component TestCarPlant
  "Full torque (clamps to the engine limit)"
  cmd = BlockComponents.Sources.Constant(k = 300.0) {^cmd}
  "Road gradient, overridden per case"
  grade_src = BlockComponents.Sources.Constant(k = 0.0) {^grade_src}
  plant = VehicleSystemsComponents.Vehicle.CarPlant() {^plant}
relations
  connect(cmd.y, plant.tau_cmd) {^id4}
  connect(grade_src.y, plant.grade) {^id5}
  initial plant.body.mass.s = 0.0
  initial plant.engine.lag.x = 0.0
metadata {
  "Dyad": {
    "tests": {
      "terminal_flat": {
        "stop": 800,
        "params": {"grade_src.k": 0},
        "initial": {"plant.body.mass.v": 0},
        "atol": {"plant.v_kmh": 0.05, "plant.v": 0.02},
        "expect": {
          "initial": {"plant.v_kmh": 0},
          "final": {"plant.v_kmh": 246.3956505391459},
          "signals": ["plant.v_kmh", "plant.v"]
        }
      },
      "grade_saturation": {
        "stop": 800,
        "params": {"grade_src.k": 0.1},
        "initial": {"plant.body.mass.v": 36.111111111111114},
        "atol": {"plant.v_kmh": 0.05, "plant.engine.limiter.y": 0.001},
        "expect": {
          "initial": {"plant.v_kmh": 130.00000000000003},
          "final": {"plant.v_kmh": 117.90055362058746, "plant.engine.limiter.y": 150},
          "signals": ["plant.v_kmh", "plant.engine.limiter.y"]
        }
      }
    }
  },
  "_links": {
    "cmd": {"Dyad": {"placement": {"diagram": {"x1": 20, "x2": 120, "y1": 20, "y2": 120}}}},
    "grade_src": {
      "Dyad": {"placement": {"diagram": {"x1": 20, "x2": 120, "y1": 280, "y2": 380}}}
    },
    "plant": {
      "Dyad": {"placement": {"diagram": {"x1": 158, "x2": 258, "y1": 20, "y2": 120}}}
    },
    "id4": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id5": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 210, "y": 330}], "E": 2}], "path": {}}}
  }
}
end