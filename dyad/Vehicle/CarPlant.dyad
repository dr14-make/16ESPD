"""
Longitudinal car plant (L0): torque command and road grade in, speed out.

Chains the engine, driveline and body, and measures the body speed with a velocity sensor.
The measurement is exposed twice: `v` in SI (m/s) for the internal/physics view, and `v_kmh`
through the single `ToKmPerHour` conversion in the whole model. `v_kmh` is the primary
measurement so the control loop built around this plant runs entirely in km/h — setpoint,
measurement and error all in km/h. The plant internals stay SI; this is the only place a unit
is converted, and no second conversion is added anywhere downstream.
"""
component CarPlant
  "Commanded engine torque"
  tau_cmd = RealInput() {^tau_cmd}
  "Road gradient, tan(alpha)"
  grade = RealInput() {^grade}
  "Primary measurement: vehicle speed in km/h"
  v_kmh = RealOutput() {^v_kmh}
  "Vehicle speed in SI units (m/s)"
  v = RealOutput(units = "m/s") {^v}
  engine = VehicleSystemsComponents.Vehicle.IdealEngine() {^engine}
  driveline = VehicleSystemsComponents.Vehicle.Driveline() {^driveline}
  body = VehicleSystemsComponents.Vehicle.VehicleBody() {^body}
  vsensor = TranslationalComponents.Sensors.VelocitySensor() {^vsensor}
  tokmh = VehicleSystemsComponents.Vehicle.ToKmPerHour() {^tokmh}
  "Rotational ground for the engine mounts and gearbox housing"
  rot_ground = RotationalComponents.Components.Fixed() {^rot_ground}
  "Road reference for the driveline contact"
  trans_ground = TranslationalComponents.Components.Fixed() {^trans_ground}
relations
  connect(tau_cmd, engine.tau_cmd) {^id12}
  connect(engine.spline, driveline.spline) {^id13}
  connect(engine.support, rot_ground.spline) {^id14}
  connect(driveline.support_r, rot_ground.spline) {^id15}
  connect(driveline.flange, body.flange) {^id16}
  connect(driveline.support_t, trans_ground.flange) {^id17}
  connect(grade, body.grade) {^id18}
  connect(vsensor.flange, body.flange) {^id19}
  connect(vsensor.v, v) {^id20}
  connect(vsensor.v, tokmh.u) {^id21}
  connect(tokmh.y, v_kmh) {^id22}
metadata {
  "_links": {
