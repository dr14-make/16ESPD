"Zero-flow termination used to cap an unused hydraulic circuit."
component ClosedHydraulicPort
  "Hydraulic connector whose mass flow is constrained to zero"
  port = HydraulicComponents.Interfaces.Port() {^port}
relations
  port.m_flow = 0.0
metadata {
  "Dyad": {"icons": {"default": "dyad://VehicleSystemsComponents/Vehicle/Brake/ClosedHydraulicPort.svg"}},
  "_links": {
    "port": {
      "Dyad": {"placement": {"icon": {"iconName": "hydraulic_port_a", "x1": -50, "x2": 50, "y1": 450, "y2": 550}}}
    }
  }
}
end