"""
Normally-open ABS inlet solenoid with a reverse bypass check valve.

Defaults: 3 ms actuation lag (assumed); 1 bar laminar transition (assumed); discharge
coefficient 0.65 (assumed); 0.49 mm equivalent seat diameter (derived from the 580 bar/s
pressure-build target with the installed caliper compliance). The command is 1 open and 0 closed.
"""
component InletValve
  extends HydraulicComponents.Interfaces.TwoPorts
  "Solenoid command, 1 open"
  command = RealInput() {^command}
  "Valve actuation time constant (assumed)"
  parameter T_v::Time(min = 0.001) = 0.003
  "Equivalent seat diameter (derived)"
  parameter d_seat::Length(min = eps(Float64)) = 0.49e-3
  "Discharge coefficient (assumed)"
  parameter C_d::Real(min = eps(Float64)) = 0.65
  "Laminar-transition pressure difference (assumed)"
  parameter dp_cr::Pressure(min = eps(Float64)) = 1e5
  "Bypass-check flow area relative to the metering seat (assumed)"
  parameter check_area_ratio::Real(min = eps(Float64)) = 1.0
  "Wide service-passage resistance, below the front brake-line resistance (derived)"
  parameter R_service::Real(min = eps(Float64)) = 5.0e9
  "Opening above which the released solenoid uncovers the service passage (assumed)"
  parameter x_service::Real = 0.95
  "Initial inlet opening; released in normal service braking (assumed)"
  parameter x_start::Real = 1.0
  "Actual inlet opening"
  variable x::Real
  "Fluid density"
  variable rho::Density
  "Forward metering flow"
  variable m_meter::MassFlowRate
  "Wide service-passage flow"
  variable m_service::MassFlowRate
  "Reverse bypass-check flow"
  variable m_check::MassFlowRate
  "Seat area"
  variable A::Area
relations
  initial x = x_start
  der(x) = (min(max(command, 0.0), 1.0) - x) / T_v
  A = π * d_seat ^ 2 / 4
  rho = HydraulicComponents.density(port_a.medium, max(port_a.p, port_b.p))
  m_meter = x * C_d * A * sqrt(2 * rho) * Δp / (Δp ^ 2 + dp_cr ^ 2) ^ 0.25
  m_service = max((x - x_service) / (1.0 - x_service), 0.0) * rho * Δp / R_service
  m_check = -check_area_ratio * C_d * A * sqrt(2 * rho) * max(-Δp, 0.0) / ((max(-Δp, 0.0)) ^ 2 + dp_cr ^ 2) ^ 0.25
  m_flow = port_a.m_flow
  m_flow = m_meter + m_service + m_check
metadata {
  "Dyad": {"icons": {"default": "dyad://VehicleSystemsComponents/Vehicle/Brake/InletValve.svg"}},
  "_links": {
    "port_a": {"Dyad": {"placement": {"icon": {"iconName": "hydraulic_port_a", "x1": -50, "x2": 50, "y1": 450, "y2": 550}}}},
    "port_b": {"Dyad": {"placement": {"icon": {"iconName": "hydraulic_port_b", "x1": 950, "x2": 1050, "y1": 450, "y2": 550}}}},
    "command": {"Dyad": {"placement": {"icon": {"x1": 450, "x2": 550, "y1": -50, "y2": 50, "rot": 270}}}}
  }
}
end

"Hydraulic storage used to exercise valve flow against a changing pressure."
component ValveTestVolume
  port = HydraulicComponents.Interfaces.Port()
  parameter C::Real = 3.0e-13
  parameter V_start::Volume = 0.0
  variable V::Volume
  variable rho::Density
relations
  port.p = V / C
  rho = HydraulicComponents.density(port.medium, port.p)
  der(V) = port.m_flow / rho
  initial V = V_start
end

"Inlet-valve component check with hydraulic storage on the downstream node."
test component TestInletValve
  source = HydraulicComponents.Sources.BoundaryPressure()
  pressure = BlockComponents.Sources.Constant(k = 60e5)
  valve = InletValve()
  volume = ValveTestVolume()
  path medium::HydraulicComponents.Interfaces.AbstractMedium = HydraulicComponents.IsothermalCompressible(bulk_modulus = 1.4e9, density = 1045.0, let_gas = false)
relations
  connect(pressure.y, source.p)
  connect(source.port, valve.port_a)
  connect(valve.port_b, volume.port)
  continuity(medium, source.port.medium)
  valve.command = ifelse(time < 0.03, 0.0, 1.0)
end

analysis TestInletValveTransient
  extends TransientAnalysis(stop = 0.08, alg = ODEAlg.Tsit5(), dtmax = 1e-4)
  model = TestInletValve()
end
