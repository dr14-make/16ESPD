"Open-loop build, hold, dump, slow-build, and full-build sequence."
test component TestModulatorOpenLoop
  source = HydraulicComponents.Sources.BoundaryPressure()
  pressure = BlockComponents.Sources.Constant(k = 60e5)
  modulator = HydraulicModulator(inlet_valve(x_start = 0.0, R_service = 1e30))
  wheel = ValveTestVolume(C = 2.16e-13)
  parameter pump_enabled::Real = 1.0
  path medium::HydraulicComponents.Interfaces.AbstractMedium = HydraulicComponents.IsothermalCompressible(bulk_modulus = 1.4e9, density = 1045.0, let_gas = false)
relations
  connect(pressure.y, source.p)
  connect(source.port, modulator.port_a)
  connect(modulator.port_b, wheel.port)
  continuity(medium, source.port.medium)
  modulator.inlet = ifelse(time < 0.20, 1.0, ifelse(time < 0.28, 0.0, ifelse(time < 0.38, 0.0, ifelse(time < 0.46, 0.0, ifelse(time < 0.66, 0.2, 1.0)))))
  modulator.outlet = ifelse(time >= 0.28 and time < 0.38, 1.0, 0.0)
  modulator.motor = pump_enabled
end

analysis TestModulatorOpenLoopTransient
  extends TransientAnalysis(stop = 0.75, alg = ODEAlg.Tsit5(), dtmax = 1e-4)
  model = TestModulatorOpenLoop(pump_enabled = pump_enabled)
  parameter pump_enabled::Real = 1.0
relations
end