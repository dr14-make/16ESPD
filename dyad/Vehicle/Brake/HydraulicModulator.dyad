"""
One-channel ABS hydraulic control unit with inlet and outlet solenoids, low-pressure
accumulator, and return pump.

Defaults: 0.49 mm equivalent valve seats (derived from the 580 bar/s target), 3 ms valve
lags (assumed), 5–10 bar and 5.3 cm³ accumulator (US5015043), and 10 cm³/s return-pump
flow (assumed). The master-cylinder side is `port_a`; the wheel side is `port_b`.
"""
component HydraulicModulator
  "Master-cylinder-side connection"
  port_a = HydraulicComponents.Interfaces.Port() {^port_a}
  "Wheel-side connection"
  port_b = HydraulicComponents.Interfaces.Port() {^port_b}
  "Inlet-valve command, 1 open"
  inlet = RealInput() {^inlet}
  "Outlet-valve command, 1 open"
  outlet = RealInput() {^outlet}
  "Return-pump motor command, 1 on"
  motor = RealInput() {^motor}
  "Accumulator pressure diagnostic"
  p_lpa = RealOutput() {^p_lpa}
  "Accumulator stored-volume diagnostic"
  V_lpa = RealOutput() {^V_lpa}
  inlet_valve = InletValve(d_seat = d_seat) {^inlet_valve}
  outlet_valve = OutletValve(d_seat = d_seat) {^outlet_valve}
  accumulator = LowPressureAccumulator() {^accumulator}
  gallery = ValveBlockVolume() {^gallery}
  pump = ReturnPump() {^pump}
  "Equivalent valve-seat diameter (derived)"
  parameter d_seat::Length = 0.49e-3
  "Outlet restriction opening over the last 5% of accumulator capacity (assumed)"
  variable accumulator_acceptance::Real
  "First-order restriction motion prevents an algebraic closure at full volume (assumed)"
  variable accumulator_acceptance_filtered::Real
relations
  connect(port_a, inlet_valve.port_a) {^id13}
  connect(inlet_valve.port_b, port_b, outlet_valve.port_a, gallery.port) {^id14}
  connect(outlet_valve.port_b, accumulator.port, pump.port_a) {^id15}
  connect(pump.port_b, port_a) {^id16}
  connect(inlet, inlet_valve.command) {^id17}
  accumulator_acceptance = min(max((accumulator.V_max - accumulator.V) / (0.05 * accumulator.V_max), 0.0), 1.0)
  initial accumulator_acceptance_filtered = 1.0
  der(accumulator_acceptance_filtered) = (accumulator_acceptance - accumulator_acceptance_filtered) / 0.001
  outlet_valve.command = outlet * accumulator_acceptance_filtered
  connect(motor, pump.motor) {^id18}
  p_lpa = accumulator.port.p
  V_lpa = accumulator.V
metadata {
