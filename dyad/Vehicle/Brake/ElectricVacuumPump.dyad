"""
Electric vane vacuum pump with its suction hose, for a booster with no manifold vacuum: a diesel,
an unthrottled petrol engine, a hybrid or an EV.

The booster's check valve feeds `mdot_in` into the hose, whose pressure `p` is the booster's
`p_src`. The booster's vacuum sensor `p_sense` runs the pump through a continuous latch: on above
`p_on`, off below `p_off`. The switch reads the booster, not the hose, because the hose follows
the pump within milliseconds and would rebound past `p_off` as the pump slows, so the latch
would chatter. Running, the pump moves a constant volume flow `Q` down to its ultimate pressure
`p_min`:

    mdot_pump = Q / (R T) · max(p - p_min, 0) · y

Q and p_min come from Hella's UP28 data, which evacuates 3.2 L to 500 mbar in 5.5–6 s and reaches
at least 86 % vacuum. The switch points are the aftermarket 18 and 25 inHg of vacuum.
"""
component ElectricVacuumPump
  "Air mass flow into the hose from the booster's check valve [kg/s]"
  mdot_in = RealInput() {^mdot_in}
  "Booster vacuum-sensor pressure [Pa]"
  p_sense = RealInput() {^p_sense}
  "Hose absolute pressure, the booster's vacuum source [Pa]"
  p = RealOutput() {^p}
  "Pump on/off state, 0 to 1"
  running = RealOutput() {^running}
  "Displaced volume flow [m^3/s] (derived from Hella UP28)"
  parameter Q::Real = 0.40e-3
  "Ultimate pressure [Pa] (derived from Hella UP28, 86 % vacuum)"
  parameter p_min::Pressure = 14e3
  "Switch-on pressure, 18 inHg of vacuum [Pa] (aftermarket, Summit)"
  parameter p_on::Pressure = 40e3
  "Switch-off pressure, 25 inHg of vacuum [Pa] (aftermarket, Summit)"
  parameter p_off::Pressure = 17e3
  "Suction hose volume between check valve and pump [m^3] (assumed)"
  parameter V_h::Volume = 0.05e-3
  "Continuous latch transition time (assumed)"
  parameter T_latch::Time(min = 1e-3) = 0.01
  "Air temperature [K] (MathWorks)"
  parameter T::Temperature = 298.15
  "Gas constant of air [J/(kg.K)] (textbook)"
  parameter R::Real = 287.05
  "Hose absolute pressure at t = 0 [Pa]"
  parameter p_init::Pressure = 101325.0
  "Hose absolute pressure"
  variable p_h::Pressure
  "Latch state: relaxes to 1 while running, 0 while stopped"
  variable y::Real
  "Latch target"
  variable request::Real
  "Air mass flow the pump removes [kg/s]"
  variable mdot_pump::Real
relations
  request = ifelse(y < 0.5, ifelse(p_sense > p_on, 1.0, 0.0), ifelse(p_sense < p_off, 0.0, 1.0))
  der(y) = (request - y) / T_latch
  mdot_pump = Q / (R * T) * max(p_h - p_min, 0.0) * y
  V_h / (R * T) * der(p_h) = mdot_in - mdot_pump
  p = p_h
  running = y
  initial p_h = p_init
  initial y = ifelse(p_init > p_on, 1.0, 0.0)
metadata {
  "_links": {
    "mdot_in": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 650, "x2": 50, "y2": 750}}}},
    "p_sense": {"Dyad": {"placement": {"icon": {"x1": 450, "y1": -50, "x2": 550, "y2": 50, "rot": 90}}}},
    "p": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 250, "x2": 50, "y2": 350}}}},
    "running": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}}}}
  }
}
end
