"""
Increment 1a force-chain demonstration. The pedal command ramps from 0 to 1 in 5 s, which is
0 to 500 N of foot force, while closed front and rear hydraulic connectors hold both circuit flows
at zero.
"""
test component TestForceChain
  "Pedal command ramp, 0 to 1"
  pedal_force = BlockComponents.Sources.Ramp(offset = 0.0, height = 1.0, duration = 5.0, start_time = 0.0) {^pedal_force}
  "Pedal lever"
  pedal = VehicleSystemsComponents.Vehicle.Brake.BrakePedal() {^pedal}
  "Static vacuum booster"
  booster = VehicleSystemsComponents.Vehicle.Brake.StaticBooster(p_vac = p_vac) {^booster}
  "Quasi-static tandem master cylinder"
  master = VehicleSystemsComponents.Vehicle.Brake.TandemMasterCylinder() {^master}
  "Common fixed reference for pedal pivot, booster housing, and master-cylinder housing"
  fixed = TranslationalComponents.Components.Fixed() {^fixed}
  "Closed front circuit for the zero-flow increment"
  front_closed = VehicleSystemsComponents.Vehicle.Brake.ClosedHydraulicPort() {^front_closed}
  "Closed rear circuit for the zero-flow increment"
  rear_closed = VehicleSystemsComponents.Vehicle.Brake.ClosedHydraulicPort() {^rear_closed}
  "Vacuum-chamber absolute pressure [Pa] (PATH)"
  parameter p_vac::Pressure = 33e3
  path medium::HydraulicComponents.Interfaces.AbstractMedium = HydraulicComponents.IsothermalCompressible(bulk_modulus = 1.4e9, density = 1045.0, let_gas = false)

relations
  connect(pedal_force.y, pedal.u) {^id9}
  connect(pedal.rod, booster.input) {^id17}
  connect(booster.rod_out, master.pushrod) {^id18}
  connect(pedal.support, fixed.flange) {^id12}
  connect(booster.support, fixed.flange) {^id13}
  connect(master.support, fixed.flange) {^id14}
  continuity(medium, master.front.medium)

  connect(master.front, front_closed.port) {^id15}
  connect(master.rear, rear_closed.port) {^id16}
metadata {
  "Dyad": {
    "tests": {
      "default_force_chain": {
        "stop": 5,
        "atol": {"master.p_mc": 20000, "pedal.x_ped": 0.000001},
        "expect": {
          "initial": {"master.p_mc": 0, "pedal.x_ped": 0.00875},
          "final": {"master.p_mc": 10340000, "pedal.x_ped": 0.00875},
          "signals": [
            "pedal.F_ped",
            "pedal.F_rod",
            "booster.F_out",
            "master.p_mc",
            "master.V_disp",
            "pedal.x_ped"
          ]
        }
      }
    }
  },
  "_links": {
    "pedal_force": {
      "Dyad": {"placement": {"diagram": {"x1": -70, "x2": 30, "y1": 450, "y2": 550}}}
    },
    "pedal": {
