analysis ForceChainTransient
  extends TransientAnalysis(stop = 5.0, saveat = 0.01)
  model = VehicleSystemsComponents.Vehicle.Brake.TestForceChain(p_vac = p_vac)
  "Vacuum-chamber absolute pressure [Pa] (PATH)"
  parameter p_vac::Pressure = 33e3
relations
end