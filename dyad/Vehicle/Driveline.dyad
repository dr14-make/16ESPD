"""
Gearbox and wheel: engine shaft in, road force out.

The gear is kept as its own subcomponent rather than folded into an effective wheel
radius. Notebook 01 derives the tractive force as `T * i / r` on the board, and the
model is meant to read the same way: the gear supplies the ratio `i`, the rolling wheel
supplies the radius `r`, and the composition is their product.
"""
component Driveline
  "Rotational input from the engine"
  spline = Spline() {^spline}
  "Rotational support (gearbox housing)"
  support_r = Spline() {^support_r}
  "Translational output to the vehicle body"
  flange = Flange() {^flange}
  "Translational support (road reference)"
  support_t = Flange() {^support_t}
  gear = RotationalComponents.Components.IdealGear(ratio = i) {^gear}
  wheel = RotationalComponents.Components.IdealRollingWheel(radius = r) {^wheel}
  "Gear ratio (engine revolutions per wheel revolution)"
  parameter i::Real = 4.0
  "Wheel rolling radius"
  parameter r::Length = 0.31
relations
  connect(spline, gear.spline_a) {^id7}
  connect(gear.spline_b, wheel.spline) {^id8}
  connect(wheel.flange, flange) {^id9}
  connect(gear.support, support_r) {^id10}
  connect(wheel.support_r, support_r) {^id11}
  connect(wheel.support_t, support_t) {^id12}
metadata {
  "_links": {
    "spline": {
      "Dyad": {"placement": {"diagram": {"x1": -40, "x2": 60, "y1": 450, "y2": 550}}}
    },
    "support_r": {
      "Dyad": {"placement": {"diagram": {"x1": 330, "x2": 430, "y1": 950, "y2": 1050}}}
    },
    "flange": {
      "Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 450, "y2": 550}}}
    },
    "support_t": {
      "Dyad": {"placement": {"diagram": {"x1": 560, "x2": 660, "y1": 950, "y2": 1050}}}
    },
    "gear": {
      "Dyad": {"placement": {"diagram": {"x1": 330, "x2": 430, "y1": 450, "y2": 550}}}
    },
    "wheel": {
      "Dyad": {"placement": {"diagram": {"x1": 520, "x2": 620, "y1": 450, "y2": 550}}}
    },
    "id7": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id8": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id9": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id10": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id11": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 535, "y": 590}, {"x": 380, "y": 590}], "E": 2}],
        "path": {}
      }
    },
    "id12": {
      "Dyad": {"edges": [{"S": 1, "M": [{"x": 605, "y": 1000}], "E": 2}], "path": {}}
    }
  }
}
end

test component TestDriveline
  "Constant engine-side torque"
  torque = RotationalComponents.Sources.ConstantTorque(tau_constant = 100.0)
  driveline = VehicleSystemsComponents.Vehicle.Driveline()
  fixed_r = RotationalComponents.Components.Fixed()
  "Vehicle mass the tractive force accelerates"
  mass = TranslationalComponents.Components.Mass(m = 1400.0)
  fixed_t = TranslationalComponents.Components.Fixed()
relations
  connect(torque.spline, driveline.spline)
  connect(torque.support, fixed_r.spline)
  connect(driveline.support_r, fixed_r.spline)
  connect(driveline.flange, mass.flange_a)
  connect(driveline.support_t, fixed_t.flange)
  initial mass.s = 0.0
  initial mass.v = 0.0
metadata {
  "Dyad": {
    "tests": {
      "case1": {
        "stop": 10,
        "atol": {"mass.a": 0.0001, "mass.v": 0.001},
        "expect": {
          "initial": {"mass.a": 0.9216589862, "mass.v": 0},
          "final": {"mass.a": 0.9216589862, "mass.v": 9.216589862},
          "signals": ["mass.a", "mass.v"]
        }
      }
    }
  }
}
end