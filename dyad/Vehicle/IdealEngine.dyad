"""
Torque command in, shaft torque out, through the two lags that make the plant FOPTD.

The transport delay and the first-order lag are load-bearing, not decoration. Without
them the plant is first order: no proportional gain can drive it to sustained oscillation,
so Ziegler-Nichols has no ultimate gain to find and Cohen-Coon has no dead time to fit.
Both lags are physically real — injection-to-torque is a transport delay of roughly one
engine cycle, manifold filling is a first-order lag of a few tenths of a second — so they
stay explicit and must not be collapsed into an instantaneous torque source.
"""
component IdealEngine
  "Commanded torque"
  tau_cmd = RealInput() {^tau_cmd}
  "Engine output shaft"
  spline = Spline() {^spline}
  "Reaction support (engine mounts)"
  support = Spline() {^support}
  # Order 3 (m = n, all-pass): phase error stays under 0.005 rad out to omega*theta = 2.5,
  # so the delay's phase lag is faithful past the loop crossover and does not under-report
  # the lag the way a first-order Pade does. At theta_e = 0.3 s (where Ziegler-Nichols is
  # expected to need it) the fastest Pade pole is ~17 rad/s, only ~5x the lag pole, so it
  # does not stiffen the plant. Sized for that value so the order need not change when
  # theta_e rises.
  delay = BlockComponents.Nonlinear.PadeDelay(n = 3, delayTime = theta_e) {^delay}
  lag = BlockComponents.Continuous.FirstOrder(T = tau_e) {^lag}
  # y_min held at zero: the engine cannot deliver braking torque through this path.
  limiter = BlockComponents.Nonlinear.Limiter(y_max = T_max, y_min = 0) {^limiter}
  torque = RotationalComponents.Sources.TorqueSource() {^torque}
  # Structural because PadeDelay computes its coefficients from delayTime at construction,
  # so the delay must be a concrete value rather than a symbolic parameter.
  "Injection-to-torque transport delay"
  structural parameter theta_e::Time = 0.3
  "Manifold-filling first-order lag"
  parameter tau_e::Time = 0.3
  "Peak deliverable torque"
  parameter T_max::Torque = 150.0
relations
  connect(tau_cmd, delay.u) {^id8}
  connect(delay.y, lag.u) {^id9}
  connect(lag.y, limiter.u) {^id10}
  connect(limiter.y, torque.tau) {^id11}
  connect(torque.spline, spline) {^id12}
  connect(torque.support, support) {^id13}
metadata {
  "_links": {
    "tau_cmd": {
      "Dyad": {"placement": {"diagram": {"x1": -60, "x2": 40, "y1": 450, "y2": 550}}}
    },
    "spline": {
      "Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 450, "y2": 550}}}
    },
    "support": {
      "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 950, "y2": 1050}}}
    },
    "delay": {
      "Dyad": {"placement": {"diagram": {"x1": 150, "x2": 250, "y1": 450, "y2": 550}}}
    },
    "lag": {
      "Dyad": {"placement": {"diagram": {"x1": 280, "x2": 380, "y1": 450, "y2": 550}}}
    },
    "limiter": {
      "Dyad": {"placement": {"diagram": {"x1": 440, "x2": 540, "y1": 450, "y2": 550}}}
    },
    "torque": {
      "Dyad": {"placement": {"diagram": {"x1": 580, "x2": 680, "y1": 450, "y2": 550}}}
    },
    "id8": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id9": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id10": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id11": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id12": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id13": {
      "Dyad": {"edges": [{"S": 1, "M": [{"x": 630, "y": 1000}], "E": 2}], "path": {}}
    }
  }
}
end

test component TestIdealEngine
  "Command above the torque ceiling, applied after a settled start"
  cmd = BlockComponents.Sources.Step(height = 200.0, offset = 0.0, start_time = 0.5)
  engine = VehicleSystemsComponents.Vehicle.IdealEngine()
  "Unit inertia so delivered torque reads directly as angular acceleration"
  load = RotationalComponents.Components.Inertia(J = 1.0)
  fixed = RotationalComponents.Components.Fixed()
relations
  connect(cmd.y, engine.tau_cmd)
  connect(engine.spline, load.spline_a)
  connect(engine.support, fixed.spline)
  initial engine.lag.x = 0.0
  initial load.w = 0.0
  initial load.phi = 0.0
metadata {
  "Dyad": {
    "tests": {
      "case1": {
        "stop": 5,
        "atol": {"load.a": 0.001, "load.w": 0.01},
        "expect": {
          "initial": {"load.a": 0, "load.w": 0},
          "final": {"load.a": 150},
          "signals": ["load.a", "load.w", "engine.limiter.y"]
        }
      }
    }
  }
}
end