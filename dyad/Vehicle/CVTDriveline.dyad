"""
CVT and centrifugal launch clutch: engine shaft in, tractive force on the body out.

It preserves the Hands-on 1 driveline mechanical interface. The pedal schedules variator speed;
the clutch opens at idle and progressively couples the engine for launch.
"""
component CVTDriveline
  "From the engine"
  spline = Spline() {^spline}
  "Gearbox housing"
  support_r = Spline() {^support_r}
  "To the body"
  flange = Flange() {^flange}
  "Road"
  support_t = Flange() {^support_t}
  "Driver pedal command, 0 closed to 1 fully open"
  pedal = RealInput() {^pedal}
  "Wheel rolling radius (Hands-on 1 car)"
  parameter r::Length = 0.31
  "Initial total ratio (assumed launch setting; override for initialized cruise)"
  parameter ratio_initial::Real = 12.0
  clutch = VehicleSystemsComponents.Vehicle.CentrifugalClutch() {^clutch}
  variator = VehicleSystemsComponents.Vehicle.ControlledVariator(ratio_initial = ratio_initial) {^variator}
  wheel = RotationalComponents.Components.IdealRollingWheel(radius = r) {^wheel}
relations
  connect(spline, clutch.spline_a) {^w1}
  connect(clutch.spline_b, variator.spline_a) {^w2}
  connect(variator.spline_b, wheel.spline) {^w3}
  connect(pedal, variator.pedal) {^w4}
  connect(clutch.support, support_r) {^w5}
  connect(variator.support, support_r) {^w6}
  connect(wheel.support_r, support_r) {^w7}
  connect(wheel.flange, flange) {^w8}
  connect(wheel.support_t, support_t) {^w9}
metadata {
  "Dyad": {
    "icons": {"default": "dyad://VehicleSystemsComponents/Vehicle/CVTDriveline.svg"},
    "labels": [{"label": "$(instance)", "x": 500, "y": 1100, "rot": 0}]
  },
  "_links": {
    "spline": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 450, "x2": 50, "y2": 550}, "diagram": {"x1": -25, "y1": 475, "x2": 25, "y2": 525}}}},
    "pedal": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 150, "x2": 50, "y2": 250}, "diagram": {"x1": -25, "y1": 175, "x2": 25, "y2": 225}}}},
    "flange": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}, "diagram": {"x1": 975, "y1": 475, "x2": 1025, "y2": 525}}}},
    "support_r": {"Dyad": {"placement": {"icon": {"x1": 330, "y1": 950, "x2": 430, "y2": 1050}, "diagram": {"x1": 355, "y1": 975, "x2": 405, "y2": 1025}}}},
    "support_t": {"Dyad": {"placement": {"icon": {"x1": 570, "y1": 950, "x2": 670, "y2": 1050}, "diagram": {"x1": 595, "y1": 975, "x2": 645, "y2": 1025}}}},
    "clutch": {"Dyad": {"placement": {"diagram": {"x1": 180, "y1": 450, "x2": 280, "y2": 550}}}},
    "variator": {"Dyad": {"placement": {"diagram": {"x1": 430, "y1": 450, "x2": 530, "y2": 550}}}},
    "wheel": {"Dyad": {"placement": {"diagram": {"x1": 700, "y1": 450, "x2": 800, "y2": 550}}}},
    "w1": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w2": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w3": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w4": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 300, "y": 200}, {"x": 300, "y": 420}, {"x": 460, "y": 420}], "E": 2}]}},
    "w5": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 230, "y": 650}, {"x": 380, "y": 650}], "E": 2}]}},
    "w6": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 480, "y": 700}, {"x": 380, "y": 700}], "E": 2}]}},
    "w7": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 750, "y": 750}, {"x": 380, "y": 750}], "E": 2}]}},
    "w8": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w9": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 750, "y": 800}, {"x": 620, "y": 800}], "E": 2}]}}
  }
}
end

test component TestCVTDriveline
  "Constant engine-side torque (assumed test stimulus)"
  torque = RotationalComponents.Sources.ConstantTorque(tau_constant = 100.0) {^torque}
  "Specified Hands-on 02 flywheel inertia"
  flywheel = RotationalComponents.Components.Inertia(J = 0.15) {^flywheel}
  driveline = VehicleSystemsComponents.Vehicle.CVTDriveline() {^driveline}
  housing = RotationalComponents.Components.Fixed() {^housing}
  mass = TranslationalComponents.Components.Mass(m = 1400.0) {^mass}
  road = TranslationalComponents.Components.Fixed() {^road}
  full_pedal = BlockComponents.Sources.Constant(k = 1.0) {^full_pedal}
relations
  connect(torque.spline, flywheel.spline_a) {^w1}
  connect(flywheel.spline_b, driveline.spline) {^w2}
  connect(torque.support, housing.spline) {^w3}
  connect(driveline.support_r, housing.spline) {^w4}
  connect(driveline.flange, mass.flange_a) {^w5}
  connect(driveline.support_t, road.flange) {^w6}
  connect(full_pedal.y, driveline.pedal) {^w7}
  initial flywheel.phi = 0.0
  initial flywheel.w = 900 * pi / 30
  initial driveline.clutch.spline_b.phi = 0.0
  initial mass.s = 0.0
  initial mass.v = 0.0
metadata {
  "_links": {
    "torque": {"Dyad": {"placement": {"diagram": {"x1": 80, "y1": 450, "x2": 180, "y2": 550}}}},
    "flywheel": {"Dyad": {"placement": {"diagram": {"x1": 240, "y1": 450, "x2": 340, "y2": 550}}}},
    "driveline": {"Dyad": {"placement": {"diagram": {"x1": 420, "y1": 450, "x2": 520, "y2": 550}}}},
    "mass": {"Dyad": {"placement": {"diagram": {"x1": 700, "y1": 450, "x2": 800, "y2": 550}}}},
    "housing": {"Dyad": {"placement": {"diagram": {"x1": 220, "y1": 750, "x2": 320, "y2": 850}}}},
    "road": {"Dyad": {"placement": {"diagram": {"x1": 520, "y1": 750, "x2": 620, "y2": 850}}}},
    "full_pedal": {"Dyad": {"placement": {"diagram": {"x1": 420, "y1": 180, "x2": 520, "y2": 280}}}},
    "w1": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w2": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w3": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 130, "y": 650}, {"x": 270, "y": 650}], "E": 2}]}},
    "w4": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 460, "y": 680}, {"x": 270, "y": 680}], "E": 2}]}},
    "w5": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w6": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w7": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}}
  }
}

end

analysis CVTDrivelineTransient
  extends TransientAnalysis(stop = 10.0)
  model = TestCVTDriveline()
end
