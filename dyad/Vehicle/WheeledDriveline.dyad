"""
Gearbox and no-slip wheel with a rotational wheel state.

`J_w = 1 kg.m^2` is representative of a passenger-car road wheel and tire: most of a roughly
20 kg assembly lies between 0.2 and 0.3 m radius. The ideal rolling constraint remains, so this
is the intermediate model used to isolate the effect of wheel inertia before introducing slip.
"""
component WheeledDriveline
  "Rotational input from the engine"
  spline = Spline()
  "Rotational support (gearbox housing)"
  support_r = Spline()
  "Translational output to the vehicle body"
  flange = Flange()
  "Translational support (road reference)"
  support_t = Flange()
  "Gear ratio (engine revolutions per wheel revolution)"
  parameter i::Real = 4.0
  "Wheel rolling radius"
  parameter r::Length = 0.31
  "Road-wheel and tire moment of inertia"
  parameter J_w::MomentOfInertia = 1.0
  gear = RotationalComponents.Components.IdealGear(ratio = i)
  inertia = RotationalComponents.Components.Inertia(J = J_w)
  wheel = RotationalComponents.Components.IdealRollingWheel(radius = r)
relations
  connect(spline, gear.spline_a)
  connect(gear.spline_b, inertia.spline_a)
  connect(inertia.spline_b, wheel.spline)
  connect(wheel.flange, flange)
  connect(gear.support, support_r)
  connect(wheel.support_r, support_r)
  connect(wheel.support_t, support_t)
end

test component TestWheeledDriveline
  torque = RotationalComponents.Sources.ConstantTorque(tau_constant = 100.0)
  driveline = VehicleSystemsComponents.Vehicle.WheeledDriveline()
  fixed_r = RotationalComponents.Components.Fixed()
  mass = TranslationalComponents.Components.Mass(m = 1400.0)
  fixed_t = TranslationalComponents.Components.Fixed()
relations
  connect(torque.spline, driveline.spline)
  connect(torque.support, fixed_r.spline)
  connect(driveline.support_r, fixed_r.spline)
  connect(driveline.flange, mass.flange_a)
  connect(driveline.support_t, fixed_t.flange)
  initial driveline.inertia.phi = 0.0
  initial driveline.inertia.w = 0.0
  initial mass.s = 0.0
metadata {
  "Dyad": {
    "tests": {
      "case1": {
        "stop": 10,
        "atol": {"mass.a": 0.0001, "mass.v": 0.001},
        "expect": {
          "initial": {"mass.a": 0.9148590822, "mass.v": 0},
          "final": {"mass.a": 0.9148590822, "mass.v": 9.148590822},
          "signals": ["mass.a", "mass.v", "driveline.inertia.w"]
        }
      }
    }
  }
}
end
