"""Driver socket: implementations produce throttle and brake fractions in [0, 1] and a
steering-wheel angle in radians. Actuator response belongs to the car, not the driver."""
partial component Driver
  "Throttle pedal fraction"
  throttle_signal = RealOutput()
  "Brake pedal fraction"
  brake_signal = RealOutput()
  "Steering-wheel angle in radians"
  steer_signal = RealOutput()
end
