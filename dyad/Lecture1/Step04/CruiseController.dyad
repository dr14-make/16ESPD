"""Step 4: `add_pid`, the `integrator` on `u3` and the `zero_d` placeholder on `u2`."""
component CruiseController
  "Setpoint in km/h"
  u_s = RealInput() {^u_s}
  "Measured speed in km/h"
  u_m = RealInput() {^u_m}
  "Torque command in N·m"
  y = RealOutput() {^y}
  error = BlockComponents.Math.Add(k1 = 1, k2 = -1) {^error}
  integrator = BlockComponents.Continuous.Integrator(k = 1 / Ti, x0 = xi0) {^integrator}
  "Holds the derivative slot"
  zero_d = BlockComponents.Sources.Constant(k = 0) {^zero_d}
  add_pid = BlockComponents.Math.Add3(k1 = 1, k2 = 1, k3 = 1) {^add_pid}
  gain = BlockComponents.Math.Gain(k = k) {^gain}
  "Controller gain in N·m per km/h"
  parameter k::Real = 56
  "Integral time"
  parameter Ti::Time = 10
  "Initial integrator state"
  parameter xi0::Real = 0
relations
  connect(u_s, error.u1) {^id_us_error}
  connect(u_m, error.u2) {^id_um_error}
  connect(error.y, add_pid.u1) {^id_error_pid}
  connect(error.y, integrator.u) {^id_error_integrator}
  connect(integrator.y, add_pid.u3) {^id_integrator_pid}
  connect(zero_d.y, add_pid.u2) {^id_zero_d_pid}
  connect(add_pid.y, gain.u) {^id_pid_gain}
  connect(gain.y, y) {^id_gain_y}
metadata {
  "Dyad": {
    "icons": {"default": "dyad://VehicleSystemsComponents/Lecture1/CruiseController.svg"},
    "labels": [{"label": "$(instance)", "x": 500, "y": 1100, "rot": 0}]
  },
  "_links": {
    "u_s": {"Dyad": {"placement": {"icon": {"x1": -50, "x2": 50, "y1": 450, "y2": 550}, "diagram": {"x1": -50, "x2": 50, "y1": 420, "y2": 520}}}},
    "u_m": {"Dyad": {"placement": {"icon": {"x1": 450, "x2": 550, "y1": 950, "y2": 1050, "rot": 270}, "diagram": {"x1": 0, "x2": 100, "y1": 950, "y2": 1050, "rot": 270}}}},
    "y": {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 450, "y2": 550}, "diagram": {"x1": 950, "x2": 1050, "y1": 480, "y2": 580}}}},
    "error": {"Dyad": {"placement": {"diagram": {"x1": 120, "x2": 220, "y1": 450, "y2": 550}}}},
    "id_us_error": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id_um_error": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 50, "y": 530}], "E": 2}], "path": {}}},
    "id_error_pid": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id_error_integrator": {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 260, "y": 670}], "E": 2}], "junctions": [{"x": 260, "y": 500}], "path": {}}},
    "id_integrator_pid": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 440, "y": 670}, {"x": 440, "y": 560}], "E": 2}], "path": {}}},
    "id_zero_d_pid": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 465, "y": 850}, {"x": 465, "y": 530}], "E": 2}], "path": {}}},
    "zero_d": {"Dyad": {"placement": {"diagram": {"x1": 350, "x2": 450, "y1": 800, "y2": 900}}}},
    "integrator": {"Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 620, "y2": 720}}}},
    "add_pid": {"Dyad": {"placement": {"diagram": {"x1": 480, "x2": 580, "y1": 480, "y2": 580}}}},
    "id_pid_gain": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "gain": {"Dyad": {"placement": {"diagram": {"x1": 640, "x2": 740, "y1": 480, "y2": 580}}}},
    "id_gain_y": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  }
}
end
