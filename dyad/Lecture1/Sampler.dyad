        "path": {}
      }
    }
  }
}
end

"""
Flat-road 90 to 110 km/h setpoint step for `SampledCruiseLoop`.

Mirrors `CruiseLoopStep` using a sampled discrete controller, so notebook 09 can sweep `Ts`
and observe the effects of controller discretization and sample-and-hold delay.
"""
component SampledCruiseStep
  loop = VehicleSystemsComponents.Lecture1.SampledCruiseLoop(theta_e = theta_e, with_I = with_I, with_D = with_D, Ts = Ts, k = k, Ti = Ti, Td = Td, Nd = Nd, Ni = Ni, T_max = T_max, y_max = y_max, y_min = y_min, wp = wp, wd = wd, m0 = v_lo)
  demand = BlockComponents.Sources.Step(offset = v_lo, height = v_hi - v_lo, start_time = t_step)
  road = BlockComponents.Sources.Constant(k = 0.0)
  structural parameter theta_e::Time = 0.3
  structural parameter with_I::Boolean = false
  structural parameter with_D::Boolean = false
  structural parameter Ts::Time = 0.1
  parameter k::Real = 56.0
  parameter Ti::Time = 10.0
  parameter Td::Time = 0.1
  parameter Nd::Real = 10.0
  parameter Ni::Real = 0.9
  parameter T_max::Torque = 150.0
  parameter y_max::Real = T_max
  parameter y_min::Real = 0.0
  parameter wp::Real = 1.0
  parameter wd::Real = 1.0
  parameter v_lo::Real = 90.0
  parameter v_hi::Real = 110.0
  parameter v0::Velocity = 25.0
  parameter tau0::Torque = 31.078
  parameter t_step::Time = 0.0
relations
  connect(demand.y, loop.setpoint)
  connect(road.y, loop.grade)
  initial loop.plant.body.mass.s = 0.0
  initial loop.plant.body.mass.v = v0
  initial loop.plant.engine.lag.x = tau0
metadata {
  "Dyad": {
    "tests": {
      "p_only_small_Ts": {
        "stop": 100,
        "atol": {"loop.plant.v_kmh": 0.1},
        "expect": {
          "initial": {"loop.plant.v_kmh": 90},
          "final": {"loop.plant.v_kmh": 109.3},
          "signals": ["loop.plant.v_kmh", "loop.controller.y", "demand.y"]
        }
      }
    }
  }
}
end

analysis SampledCruiseTransient
  # `Ts` is structural because it defines the discrete clock. To sweep the sample period,
  # construct `SampledCruiseStep` with different `Ts` values before compilation.
  extends TransientAnalysis(stop = 100)
  model = VehicleSystemsComponents.Lecture1.SampledCruiseStep(k = k, Ti = Ti, Td = Td, Nd = Nd, Ni = Ni, T_max = T_max, y_max = y_max, y_min = y_min, wp = wp, wd = wd, v_lo = v_lo, v_hi = v_hi, v0 = v0, tau0 = tau0, t_step = t_step)
  parameter k::Real = 56.0
  parameter Ti::Time = 10.0
  parameter Td::Time = 0.1
  parameter Nd::Real = 10.0
  parameter Ni::Real = 0.9
  parameter T_max::Torque = 150.0
  parameter y_max::Real = T_max
  parameter y_min::Real = 0.0
  parameter wp::Real = 1.0
  parameter wd::Real = 1.0
  parameter v_lo::Real = 90.0
  parameter v_hi::Real = 110.0
  parameter v0::Velocity = 25.0
  parameter tau0::Torque = 31.078
  parameter t_step::Time = 0.0
relations
end