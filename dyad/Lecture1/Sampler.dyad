    },
    "id11": {
      "Dyad": {
        "edges": [
          {"S": 1, "M": [], "E": -1},
          {"S": -1, "M": [{"x": 267.5, "y": 280}, {"x": 267.5, "y": 362}], "E": 2},
          {"S": -1, "M": [{"x": 230, "y": 70}], "E": 3}
        ],
        "junctions": [{"x": 230, "y": 280}],
        "path": {}
      }
    },
    "id12": {
      "Dyad": {
