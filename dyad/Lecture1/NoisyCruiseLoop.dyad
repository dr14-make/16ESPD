"""
Cruise-control loop with deterministic noise in the speed-measurement path.

The plant speed remains available as `plant.v_kmh`, while `noise.y` is the measurement seen by
the controller. The loop signals and noise amplitude are in km/h.
"""
component NoisyCruiseLoop
  "Vehicle-speed setpoint in km/h"
  setpoint = RealInput() {^setpoint}
  "Road gradient, tan(alpha)"
  grade = RealInput() {^grade}
  "Powertrain transport delay"
  structural parameter theta_e::Time = 0.3
  "Whether to include integral action"
  structural parameter with_I::Boolean = true
  "Whether to include derivative action"
  structural parameter with_D::Boolean = true
  "Controller gain in N.m per km/h"
  parameter k::Real = 56.0
  parameter Ti::Time = 10.0
  parameter Td::Time = 0.1
  parameter Nd::Real = 10.0
  parameter T_max::Torque = 150.0
  parameter y_max::Real = T_max
  parameter y_min::Real = 0.0
  parameter wd::Real = 1.0
  parameter m::Dyad.Mass = 1400.0
  parameter CdA::Area = 0.63
  "Amplitude of each measurement-noise sinusoid in km/h"
  parameter amplitude::Real = 0.2
  "Initial measured speed in km/h, the settled cruise the loop starts from"
  parameter m0::Real = 90.0
  parameter xi0::Real = 0.0
  "Initial derivative-filter state, seeded from the initial measurement"
  parameter xd0::Real = (wd - 1) * m0
  plant = VehicleSystemsComponents.HandsOn.GradeCar(theta_e = theta_e, T_max = T_max, m = m, CdA = CdA) {^plant}
  controller = VehicleSystemsComponents.Lecture1.CruiseController(
    with_I = with_I,
    with_D = with_D,
    k = k,
    Ti = Ti,
    Td = Td,
    Nd = Nd,
    y_max = y_max,
    y_min = y_min,
    wd = wd,
    xi0 = xi0,
    xd0 = xd0) {^controller}
  noise = VehicleSystemsComponents.Lecture1.MeasurementNoise(amplitude = amplitude) {^noise}
relations
  connect(setpoint, controller.u_s) {^id1}
  connect(plant.v_kmh, noise.u) {^id2}
  connect(noise.y, controller.u_m) {^id3}
  connect(controller.y, plant.tau_cmd) {^id4}
  connect(grade, plant.grade) {^id5}
metadata {
  "_links": {
    "setpoint": {
      "Dyad": {
        "placement": {
          "icon": {"x1": -60, "x2": 40, "y1": 110, "y2": 210},
          "diagram": {"x1": -60, "x2": 40, "y1": 110, "y2": 210}
        }
      }
    },
    "grade": {
      "Dyad": {
        "placement": {
          "icon": {"x1": -60, "x2": 40, "y1": 770, "y2": 870},
          "diagram": {"x1": -60, "x2": 40, "y1": 770, "y2": 870}
        }
      }
    },
    "controller": {
      "Dyad": {"placement": {"diagram": {"x1": 240, "x2": 340, "y1": 450, "y2": 550}}}
    },
    "plant": {"Dyad": {"placement": {"diagram": {"x1": 690, "x2": 790, "y1": 450, "y2": 550}}}},
    "noise": {"Dyad": {"placement": {"diagram": {"x1": 850, "x2": 950, "y1": 450, "y2": 550}}}},
    "id1": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 130, "y": 160}, {"x": 130, "y": 477}], "E": 2}],
        "path": {}
      }
    },
    "id2": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id3": {
      "Dyad": {
        "edges": [
          {
            "S": 1,
            "M": [
              {"x": 1000, "y": 500},
              {"x": 1000, "y": 1010},
              {"x": -170, "y": 1010},
              {"x": -170, "y": 523}
            ],
            "E": 2
          }
        ],
        "path": {}
      }
    },
    "id4": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id5": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 630, "y": 820}, {"x": 630, "y": 545}], "E": 2}],
        "path": {}
      }
    }
  }
}
end

"""
Flat-road 90 to 110 km/h setpoint-step scenario for `NoisyCruiseLoop`.

The PID actions are enabled so varying the ordinary parameter `Nd` changes derivative filtering
without rebuilding the model.
"""
component NoisyCruiseStep
  structural parameter theta_e::Time = 0.3
  parameter k::Real = 56.0
  parameter Ti::Time = 10.0
  parameter Td::Time = 0.1
  parameter Nd::Real = 10.0
  parameter T_max::Torque = 150.0
  parameter y_max::Real = T_max
  parameter y_min::Real = 0.0
  parameter wd::Real = 1.0
  parameter m::Dyad.Mass = 1400.0
  parameter CdA::Area = 0.63
  parameter grade::Real = 0.0
  parameter v_lo::Real = 90.0
  parameter v_hi::Real = 110.0
  parameter v0::Velocity = 25.0
  parameter tau0::Torque = 31.078
  parameter t_step::Time = 0.0
  parameter amplitude::Real = 0.2
  loop = VehicleSystemsComponents.Lecture1.NoisyCruiseLoop(
    theta_e = theta_e,
    with_I = true,
    with_D = true,
    k = k,
    Ti = Ti,
    Td = Td,
    Nd = Nd,
    T_max = T_max,
    y_max = y_max,
    y_min = y_min,
    wd = wd,
    m = m,
    CdA = CdA,
    amplitude = amplitude,
    m0 = v_lo) {^loop}
  demand = BlockComponents.Sources.Step(offset = v_lo, height = v_hi - v_lo, start_time = t_step) {^demand}
  road = BlockComponents.Sources.Constant(k = grade) {^road}
relations
  connect(demand.y, loop.setpoint) {^id4}
  connect(road.y, loop.grade) {^id5}
  initial loop.plant.body.mass.s = 0.0
  initial loop.plant.body.mass.v = v0
  initial loop.plant.engine.lag.x = tau0
metadata {
  "Dyad": {
    "tests": {
      "filtered_derivative": {
        "stop": 100,
        "atol": {"loop.plant.v_kmh": 0.1, "loop.noise.y": 0.5},
        "expect": {
          "initial": {"loop.plant.v_kmh": 90.0, "loop.noise.y": 90.38071258530745},
          "final": {"loop.plant.v_kmh": 110.1561, "loop.noise.y": 110.5368},
          "signals": ["loop.plant.v_kmh", "loop.noise.y", "loop.controller.y", "demand.y"]
        }
      }
    }
  },
  "_links": {
    "loop": {"Dyad": {"placement": {"diagram": {"x1": 710, "x2": 810, "y1": 500, "y2": 600}}}},
    "demand": {"Dyad": {"placement": {"diagram": {"x1": 240, "x2": 340, "y1": 370, "y2": 470}}}},
    "road": {"Dyad": {"placement": {"diagram": {"x1": 240, "x2": 340, "y1": 640, "y2": 740}}}},
    "id4": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 500, "y": 420}, {"x": 500, "y": 516}], "E": 2}],
        "path": {}
      }
    },
    "id5": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 500, "y": 690}, {"x": 500, "y": 582}], "E": 2}],
        "path": {}
      }
    }
  }
}
end

analysis NoisyCruiseTransient
  extends TransientAnalysis(stop = 100)
  parameter k::Real = 56.0
  parameter Ti::Time = 10.0
  parameter Td::Time = 0.1
  parameter Nd::Real = 10.0
  parameter T_max::Torque = 150.0
  parameter y_max::Real = T_max
  parameter y_min::Real = 0.0
  parameter wd::Real = 1.0
  parameter m::Dyad.Mass = 1400.0
  parameter CdA::Area = 0.63
  parameter grade::Real = 0.0
  parameter v_lo::Real = 90.0
  parameter v_hi::Real = 110.0
  parameter v0::Velocity = 25.0
  parameter tau0::Torque = 31.078
  parameter t_step::Time = 0.0
  parameter amplitude::Real = 0.2
  model = VehicleSystemsComponents.Lecture1.NoisyCruiseStep(
    k = k,
    Ti = Ti,
    Td = Td,
    Nd = Nd,
    T_max = T_max,
    y_max = y_max,
    y_min = y_min,
    wd = wd,
    m = m,
    CdA = CdA,
    grade = grade,
    v_lo = v_lo,
    v_hi = v_hi,
    v0 = v0,
    tau0 = tau0,
    t_step = t_step,
    amplitude = amplitude)
relations
end
