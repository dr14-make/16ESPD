"Step 6b: `limiter` between `gain` and `y`."
component CruiseController
  "Setpoint in km/h"
  u_s = RealInput() {^u_s}
  "Measured speed in km/h"
  u_m = RealInput() {^u_m}
  "Torque command in N·m"
  y = RealOutput() {^y}
  error = BlockComponents.Math.Add(k1 = 1, k2 = -1) {^error}
  add_d = BlockComponents.Math.Add(k1 = wd, k2 = -1) {^add_d}
  derivative = BlockComponents.Continuous.Derivative(k = Td, T = Td / Nd, x0 = xd0) {^derivative}
  integrator = BlockComponents.Continuous.Integrator(k = 1 / Ti, x0 = xi0) {^integrator}
  add_pid = BlockComponents.Math.Add3(k1 = 1, k2 = 1, k3 = 1) {^add_pid}
  gain = BlockComponents.Math.Gain(k = k) {^gain}
  limiter = BlockComponents.Nonlinear.Limiter(y_max = y_max, y_min = y_min) {^limiter}
  "Controller gain in N·m per km/h"
  parameter k::Real = 56
  "Integral time"
  parameter Ti::Time = 10
  "Initial integrator state"
  parameter xi0::Real = 0
  "Derivative time"
  parameter Td::Time = 0.5
  "Derivative filter: the filter time constant is Td / Nd"
  parameter Nd::Real = 10
  "Setpoint weight in the derivative"
  parameter wd::Real = 0
  "Initial derivative-filter state, (wd - 1) * 90"
  parameter xd0::Real = -90
  "Output ceiling; no limit unless one is set"
  parameter y_max::Real = 1e300
  "Output floor"
  parameter y_min::Real = -y_max
relations
  connect(u_s, error.u1) {^id11}
  connect(u_m, error.u2) {^id12}
  connect(error.y, add_pid.u1) {^id13}
  connect(error.y, integrator.u) {^id14}
  connect(integrator.y, add_pid.u3) {^id15}
  connect(u_s, add_d.u1) {^id16}
  connect(u_m, add_d.u2) {^id17}
  connect(add_d.y, derivative.u) {^id18}
  connect(derivative.y, add_pid.u2) {^id19}
  connect(add_pid.y, gain.u) {^id20}
  connect(gain.y, limiter.u) {^id21}
  connect(limiter.y, y) {^id22}
metadata {
