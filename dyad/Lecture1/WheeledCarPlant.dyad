"""
Longitudinal car plant with no-slip rolling and explicit road-wheel inertia.

Its ports match `Vehicle.CarPlant`, allowing a controller or notebook scenario to exchange the
L0 and L1 plants without changing signal wiring.
"""
component WheeledCarPlant
  "Commanded engine torque"
  tau_cmd = RealInput()
  "Road gradient, tan(alpha)"
  grade = RealInput()
  "Vehicle speed in km/h"
  v_kmh = RealOutput()
  "Vehicle speed in m/s"
  v = RealOutput(units = "m/s")
  structural parameter theta_e::Time = 0.3
  parameter T_max::Torque = 150.0
  parameter m::Dyad.Mass = 1400.0
  parameter CdA::Area = 0.63
  parameter J_w::MomentOfInertia = 1.0
  engine = VehicleSystemsComponents.Vehicle.IdealEngine(theta_e = theta_e, T_max = T_max)
  driveline = VehicleSystemsComponents.Vehicle.WheeledDriveline(J_w = J_w)
  body = VehicleSystemsComponents.Vehicle.VehicleBody(m = m, CdA = CdA)
  vsensor = TranslationalComponents.Sensors.VelocitySensor()
  tokmh = VehicleSystemsComponents.Vehicle.ToKmPerHour()
  rot_ground = RotationalComponents.Components.Fixed()
  trans_ground = TranslationalComponents.Components.Fixed()
relations
  connect(tau_cmd, engine.tau_cmd)
  connect(engine.spline, driveline.spline)
  connect(engine.support, rot_ground.spline)
  connect(driveline.support_r, rot_ground.spline)
  connect(driveline.flange, body.flange)
  connect(driveline.support_t, trans_ground.flange)
  connect(grade, body.grade)
  connect(vsensor.flange, body.flange)
  connect(vsensor.v, v)
  connect(vsensor.v, tokmh.u)
  connect(tokmh.y, v_kmh)
end

test component TestWheeledCarPlant
  cmd = BlockComponents.Sources.Constant(k = 150.0)
  road = BlockComponents.Sources.Constant(k = 0.0)
  plant = VehicleSystemsComponents.Lecture1.WheeledCarPlant()
relations
  connect(cmd.y, plant.tau_cmd)
  connect(road.y, plant.grade)
  initial plant.body.mass.s = 0.0
  initial plant.body.mass.v = 0.0
  initial plant.engine.lag.x = 0.0
  initial plant.driveline.inertia.phi = 0.0
metadata {
  "Dyad": {
    "tests": {
      "case1": {
        "stop": 10,
        "atol": {"plant.v_kmh": 0.05},
        "expect": {
          "initial": {"plant.v_kmh": 0},
          "final": {"plant.v_kmh": 43.27408},
          "signals": ["plant.v_kmh", "plant.v", "plant.driveline.inertia.w"]
        }
      }
    }
  }
}
end
