"""
Cruise-control loop around the students' car and controller.

The setpoint and feedback signal are both in km/h, so `k` is interpreted as N.m per km/h.
`with_I = false, with_D = false` selects the P checkpoint at the end of section 03, while
`with_I = true, with_D = true` selects the PID checkpoint at the end of section 05.
"""
component CruiseLoop
  "Vehicle-speed setpoint in km/h"
  setpoint = RealInput()
  "Road gradient, tan(alpha)"
  grade = RealInput()
  "Powertrain transport delay"
  structural parameter theta_e::Time = 0.3
  "Whether to include integral action"
  structural parameter with_I::Boolean = true
  "Whether to include derivative action"
  structural parameter with_D::Boolean = true
  "Controller gain in N.m per km/h"
  parameter k::Real = 56.0
  parameter Ti::Time = 10.0
  parameter Td::Time = 0.1
  parameter Nd::Real = 10.0
  "Physical engine torque ceiling"
  parameter T_max::Torque = 150.0
  "Controller output ceiling; defaults to the physical ceiling"
  parameter y_max::Real = T_max
  parameter y_min::Real = 0.0
  parameter wd::Real = 1.0
  "Vehicle mass"
  parameter m::Dyad.Mass = 1400.0
  "Aerodynamic drag area (Cd * A)"
  parameter CdA::Area = 0.63
  "Initial measured speed in km/h, the settled cruise the loop starts from"
  parameter m0::Real = 90.0
  "Initial integrator state"
  parameter xi0::Real = 0.0
  # The derivative filter tracks its input wd*u_s - u_m. Starting it at zero while the
  # measurement is already m0 makes the filter see a step of -u_m at t=0 and command a spike
  # of -k*Nd*m0 (e.g. -50400 N.m at k=56, Nd=10, m0=90 with wd=0). Seeding it at the settled
  # value (wd-1)*m0 — the input the filter would hold at a steady cruise where u_s = u_m = m0 —
  # removes that spike while preserving any genuine derivative kick on a later setpoint change.
  "Initial derivative-filter state, seeded from the initial measurement"
  parameter xd0::Real = (wd - 1) * m0
  plant = VehicleSystemsComponents.HandsOn.GradeCar(theta_e = theta_e, T_max = T_max, m = m, CdA = CdA)
  controller = VehicleSystemsComponents.Lecture1.CruiseController(
    with_I = with_I,
    with_D = with_D,
    k = k,
    Ti = Ti,
    Td = Td,
    Nd = Nd,
    y_max = y_max,
    y_min = y_min,
    wd = wd,
    xi0 = xi0,
    xd0 = xd0)
relations
  connect(setpoint, controller.u_s)
  connect(plant.v_kmh, controller.u_m)
  connect(controller.y, plant.tau_cmd)
  connect(grade, plant.grade)
end

"""
Flat-road 90 to 110 km/h setpoint-step scenario for `CruiseLoop`.

The engine lag is preloaded with the torque holding the initial speed. The step occurs at the
start of the run, avoiding an artificial pre-step interval in which a P-only controller would
command zero torque at zero error.
"""
component CruiseLoopStep
  structural parameter theta_e::Time = 0.3
  structural parameter with_I::Boolean = true
  structural parameter with_D::Boolean = true
  parameter k::Real = 56.0
  parameter Ti::Time = 10.0
  parameter Td::Time = 0.1
  parameter Nd::Real = 10.0
  parameter T_max::Torque = 150.0
  parameter y_max::Real = T_max
  parameter y_min::Real = 0.0
  parameter wd::Real = 1.0
  "Vehicle mass"
  parameter m::Dyad.Mass = 1400.0
  "Aerodynamic drag area (Cd * A)"
  parameter CdA::Area = 0.63
  "Constant road gradient, tan(alpha)"
  parameter grade::Real = 0.0
  parameter v_lo::Real = 90.0
  parameter v_hi::Real = 110.0
  parameter v0::Velocity = 25.0
  parameter tau0::Torque = 31.078
  parameter t_step::Time = 0.0
  loop = VehicleSystemsComponents.Lecture1.CruiseLoop(
    theta_e = theta_e,
    with_I = with_I,
    with_D = with_D,
    k = k,
    Ti = Ti,
    Td = Td,
    Nd = Nd,
    T_max = T_max,
    y_max = y_max,
    y_min = y_min,
    wd = wd,
    m = m,
    CdA = CdA,
    m0 = v_lo)
  demand = BlockComponents.Sources.Step(offset = v_lo, height = v_hi - v_lo, start_time = t_step)
  road = BlockComponents.Sources.Constant(k = grade)
relations
  connect(demand.y, loop.setpoint)
  connect(road.y, loop.grade)
  initial loop.plant.body.mass.s = 0.0
  initial loop.plant.body.mass.v = v0
  initial loop.plant.engine.lag.x = tau0
# The p_only case pins an unlimited actuator. Notebooks 03 to 05 all run the proportional
# loop that way: any gain leaving a visible steady-state error commands several times the
# holding torque during the step, so a real ceiling would clip every curve in the gain family.
# The engine limit is introduced deliberately in the windup notebook. Pinned here rather than
# left to default, so the case keeps testing the lecture rather than tracking CruiseLoop.
metadata {
  "Dyad": {
    "tests": {
      "p_only": {
        "stop": 100,
        "params": {"with_I": false, "with_D": false, "T_max": 1e6, "y_max": 1e6},
        "atol": {"loop.plant.v_kmh": 0.05},
        "expect": {
          "initial": {"loop.plant.v_kmh": 90.0},
          "final": {"loop.plant.v_kmh": 109.3},
          "signals": ["loop.plant.v_kmh", "loop.controller.y", "demand.y"]
        }
      }
    }
  }
}
end

analysis CruiseLoopTransient
  extends TransientAnalysis(stop = 100)
  parameter k::Real = 56.0
  parameter Ti::Time = 10.0
  parameter Td::Time = 0.1
  parameter Nd::Real = 10.0
  parameter T_max::Torque = 150.0
  parameter y_max::Real = T_max
  parameter y_min::Real = 0.0
  parameter wd::Real = 1.0
  "Vehicle mass"
  parameter m::Dyad.Mass = 1400.0
  "Aerodynamic drag area (Cd * A)"
  parameter CdA::Area = 0.63
  "Constant road gradient, tan(alpha)"
  parameter grade::Real = 0.0
  parameter v_lo::Real = 90.0
  parameter v_hi::Real = 110.0
  parameter v0::Velocity = 25.0
  parameter tau0::Torque = 31.078
  parameter t_step::Time = 0.0
  model = VehicleSystemsComponents.Lecture1.CruiseLoopStep(
    k = k,
    Ti = Ti,
    Td = Td,
    Nd = Nd,
    T_max = T_max,
    y_max = y_max,
    y_min = y_min,
    wd = wd,
    m = m,
    CdA = CdA,
    grade = grade,
    v_lo = v_lo,
    v_hi = v_hi,
    v0 = v0,
    tau0 = tau0,
    t_step = t_step)
relations
end
