"""
Open-loop wide-open-throttle run: full torque from rest on flat road.

A `Car` cannot be a `TransientAnalysis` model on its own because its `tau_cmd` input would be
unconnected. This harness drives it from a constant source and carries the initial conditions,
so notebook 01 can run it to terminal speed and read the transient.
The command is well above the torque ceiling so the engine clamps at its limit throughout.
"""
component WideOpenThrottle
  plant = VehicleSystemsComponents.HandsOn.Car() {^plant}
  "Full throttle: commanded torque above the ceiling so the engine clamps at T_max"
  cmd = BlockComponents.Sources.Constant(k = 300.0) {^cmd}
relations
  connect(cmd.y, plant.tau_cmd) {^id4}
  initial plant.body.mass.s = 0.0
  initial plant.body.mass.v = 0.0
  initial plant.engine.lag.x = 0.0
metadata {
  "Dyad": {
    "tests": {
      "case1": {
        "stop": 300,
        "atol": {"plant.v_kmh": 0.05, "plant.engine.limiter.y": 0.001},
        "expect": {
          "initial": {"plant.v_kmh": 0},
          "final": {"plant.v_kmh": 246.4, "plant.engine.limiter.y": 150},
          "signals": ["plant.v_kmh", "plant.engine.limiter.y", "cmd.y"]
        }
      }
    }
  },
  "_links": {
    "plant": {
      "Dyad": {"placement": {"diagram": {"x1": 158, "x2": 258, "y1": 20, "y2": 120}}}
    },
    "cmd": {"Dyad": {"placement": {"diagram": {"x1": 20, "x2": 120, "y1": 20, "y2": 120}}}},
    "id4": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  }
}
end

analysis WideOpenThrottleTransient
  # stop = 300 s is about twice the 143 s the car needs to reach 99% of terminal speed,
  # so the plot shows the full approach to the steady state.
  extends TransientAnalysis(stop = 300)
  model = VehicleSystemsComponents.Lecture1.WideOpenThrottle()
relations
end
