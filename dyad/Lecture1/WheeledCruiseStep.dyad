"""PID setpoint step around the hands-on no-slip wheeled car."""
component WheeledCruiseStep
  parameter k::Real = 56.0
  parameter Ti::Time = 10.0
  parameter Td::Time = 0.5
  parameter Nd::Real = 10.0
  parameter T_max::Torque = 1e6
  parameter y_max::Real = T_max
  parameter y_min::Real = 0.0
  parameter wd::Real = 0.0
  parameter J_w::MomentOfInertia = 1.0
  parameter v_lo::Real = 90.0
  parameter v_hi::Real = 110.0
  parameter v0::Velocity = 25.0
  parameter tau0::Torque = 31.078
  parameter t_step::Time = 0.0
  plant = VehicleSystemsComponents.HandsOn.WheeledCar(T_max = T_max, J_w = J_w)
  controller = VehicleSystemsComponents.Lecture1.CruiseController(
    with_I = true, with_D = true, k = k, Ti = Ti, Td = Td, Nd = Nd,
    y_max = y_max, y_min = y_min, wd = wd, xi0 = 0.0, xd0 = (wd - 1) * v_lo)
  demand = BlockComponents.Sources.Step(offset = v_lo, height = v_hi - v_lo, start_time = t_step)
relations
  connect(demand.y, controller.u_s)
  connect(plant.v_kmh, controller.u_m)
  connect(controller.y, plant.tau_cmd)
  initial plant.body.mass.s = 0.0
  initial plant.body.mass.v = v0
  initial plant.engine.lag.x = tau0
  initial plant.driveline.inertia.phi = 0.0
metadata {
  "Dyad": {"tests": {"case1": {
    "stop": 60,
    "atol": {"plant.v_kmh": 0.05},
    "expect": {
      "initial": {"plant.v_kmh": 90},
      "final": {"plant.v_kmh": 110},
      "signals": ["plant.v_kmh", "controller.y", "demand.y"]
    }
  }}}
}
end

analysis WheeledCruiseTransient
  extends TransientAnalysis(stop = 60)
  parameter k::Real = 56.0
  parameter Ti::Time = 10.0
  parameter Td::Time = 0.5
  parameter Nd::Real = 10.0
  parameter T_max::Torque = 1e6
  parameter y_max::Real = T_max
  parameter y_min::Real = 0.0
  parameter wd::Real = 0.0
  parameter J_w::MomentOfInertia = 1.0
  parameter v_lo::Real = 90.0
  parameter v_hi::Real = 110.0
  parameter v0::Velocity = 25.0
  parameter tau0::Torque = 31.078
  parameter t_step::Time = 0.0
  model = VehicleSystemsComponents.Lecture1.WheeledCruiseStep(
    k = k, Ti = Ti, Td = Td, Nd = Nd, T_max = T_max, y_max = y_max,
    y_min = y_min, wd = wd, J_w = J_w, v_lo = v_lo, v_hi = v_hi,
    v0 = v0, tau0 = tau0, t_step = t_step)
relations
end
