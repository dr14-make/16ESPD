"""Step 6c: a 130 km/h cruise into a 120 s, 10 % climb, here with the clamping controller."""
component CruiseClimb
  demand = BlockComponents.Sources.Constant(k = 130) {^demand}
  controller = CruiseController(y_max = 150, y_min = 0, xd0 = -130) {^controller}
  plant = GradeCar() {^plant}
  road = BlockComponents.Sources.Pulse(amplitude = 0.10, offset = 0, start_time = 30, duty_cycle = 1.0, period = 120) {^road}
relations
  connect(demand.y, controller.u_s) {^id_demand}
  connect(plant.v_kmh, controller.u_m) {^id_feedback}
  connect(controller.y, plant.tau_cmd) {^id_command}
  connect(road.y, plant.grade) {^id_road}
  initial plant.body.mass.s = 0
  initial plant.body.mass.v = 36.111111111111114
  initial plant.engine.lag.x = 50.9693
metadata {
  "Dyad": {
    "tests": {
      "crest": {
        "stop": 150,
        "atol": {"plant.v_kmh": 0.05, "controller.y": 0.01, "controller.integrator.y": 0.01},
        "expect": {
          "initial": {"plant.v_kmh": 130},
          "final": {"plant.v_kmh": 119.05, "controller.y": 150, "controller.integrator.y": 0.876}
        }
      },
      "recovery": {
        "stop": 400,
        "atol": {"plant.v_kmh": 0.1},
        "expect": {
          "initial": {"plant.v_kmh": 130},
          "final": {"plant.v_kmh": 130.0}
        }
      }
    }
  },
  "_links": {
    "demand": {"Dyad": {"placement": {"diagram": {"x1": 100, "x2": 200, "y1": 450, "y2": 550}}}},
    "controller": {"Dyad": {"placement": {"diagram": {"x1": 350, "x2": 450, "y1": 450, "y2": 550}}}},
    "plant": {"Dyad": {"placement": {"diagram": {"x1": 650, "x2": 750, "y1": 450, "y2": 550}}}},
    "road": {"Dyad": {"placement": {"diagram": {"x1": 480, "x2": 580, "y1": 620, "y2": 720}}}},
    "id_demand": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id_command": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id_road": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 615, "y": 670}, {"x": 615, "y": 545}], "E": 2}], "path": {}}},
    "id_feedback": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 800, "y": 500}, {"x": 800, "y": 850}, {"x": 400, "y": 850}], "E": 2}], "path": {}}}
  }
}
end

analysis CruiseClimbTransient
  extends TransientAnalysis(stop = 400)
  model = CruiseClimb()
end
