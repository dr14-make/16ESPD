"""Step 8: `GradeCar` with `m` and `theta_e` exposed next to `T_max`."""
component GradeCar
  "Commanded engine torque"
  tau_cmd = RealInput() {^tau_cmd}
  "Road gradient, tan(alpha)"
  grade = RealInput() {^grade}
  "Vehicle speed in km/h"
  v_kmh = RealOutput() {^v_kmh}
  engine = VehicleSystemsComponents.HandsOn.Engine(T_max = T_max, theta_e = theta_e) {^engine}
  driveline = VehicleSystemsComponents.HandsOn.Driveline() {^driveline}
  body = VehicleSystemsComponents.HandsOn.GradeBody(m = m) {^body}
  vsensor = TranslationalComponents.Sensors.VelocitySensor() {^vsensor}
  to_kmh = BlockComponents.Math.Gain(k = 3.6) {^to_kmh}
  "Engine mounts and gearbox housing"
  rot_ground = RotationalComponents.Components.Fixed() {^rot_ground}
  "Road under the wheel"
  trans_ground = TranslationalComponents.Components.Fixed() {^trans_ground}
  "Peak deliverable torque"
  parameter T_max::Torque = 150
  "Vehicle mass"
  parameter m::Dyad.Mass = 1400
  # Structural because the engine's Pade delay builds its coefficients from it.
  "Injection-to-torque transport delay"
  structural parameter theta_e::Time = 0.3
relations
  connect(tau_cmd, engine.tau_cmd) {^id1}
  connect(engine.spline, driveline.spline) {^id2}
  connect(engine.support, rot_ground.spline) {^id3}
  connect(driveline.support_r, rot_ground.spline) {^id4}
  connect(driveline.flange, body.flange) {^id5}
  connect(driveline.support_t, trans_ground.flange) {^id6}
  connect(vsensor.flange, body.flange) {^id7}
  connect(vsensor.v, to_kmh.u) {^id8}
  connect(to_kmh.y, v_kmh) {^id9}
  connect(grade, body.grade) {^id_grade}
metadata {
  "Dyad": {
    "icons": {"default": "dyad://VehicleSystemsComponents/HandsOn/GradeCar.svg"},
    "labels": [{"label": "$(instance)", "x": 500, "y": 1100, "rot": 0}]
  },
  "_links": {
    "tau_cmd": {"Dyad": {"placement": {"diagram": {"x1": -50, "x2": 50, "y1": 450, "y2": 550}}}},
    "grade": {"Dyad": {"placement": {"diagram": {"x1": -50, "x2": 50, "y1": 900, "y2": 1000}}}},
    "v_kmh": {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 450, "y2": 550}}}},
    "engine": {"Dyad": {"placement": {"diagram": {"x1": 120, "x2": 220, "y1": 450, "y2": 550}}}},
    "driveline": {"Dyad": {"placement": {"diagram": {"x1": 320, "x2": 420, "y1": 450, "y2": 550}}}},
    "body": {"Dyad": {"placement": {"diagram": {"x1": 560, "x2": 660, "y1": 450, "y2": 550}}}},
    "vsensor": {"Dyad": {"placement": {"diagram": {"x1": 560, "x2": 660, "y1": 250, "y2": 350}}}},
    "to_kmh": {"Dyad": {"placement": {"diagram": {"x1": 760, "x2": 860, "y1": 250, "y2": 350}}}},
    "rot_ground": {"Dyad": {"placement": {"diagram": {"x1": 120, "x2": 220, "y1": 700, "y2": 800}}}},
    "trans_ground": {"Dyad": {"placement": {"diagram": {"x1": 331, "x2": 431, "y1": 800, "y2": 900}}}},
    "id1": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id2": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id3": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id4": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 358, "y": 650}, {"x": 170, "y": 650}], "E": 2}], "path": {}}},
    "id5": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 480, "y": 500}, {"x": 480, "y": 400}, {"x": 700, "y": 400}, {"x": 700, "y": 500}], "E": 2}], "path": {}}},
    "id6": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id7": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 480, "y": 300}, {"x": 480, "y": 400}], "E": -1}, {"S": -1, "M": [{"x": 700, "y": 400}, {"x": 700, "y": 500}], "E": 2}], "junctions": [{"x": 480, "y": 400}], "path": {}}},
    "id8": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
