"""
Cruise-control loop around the slip-capable car plant.

The controller retains the existing km/h convention and tuning interface. Road friction is an
explicit input so the loop cannot hide the tire saturation from the scenario that drives it.
"""
component SlipCruiseLoop
  "Vehicle-speed setpoint in km/h"
  setpoint = RealInput() {^setpoint}
  "Road gradient, tan(alpha)"
  grade = RealInput() {^grade}
  "Road-friction multiplier"
  mu_scale = RealInput() {^mu_scale}
  structural parameter theta_e::Time = 0.3
  parameter with_I::Boolean = true
  parameter with_D::Boolean = true
  parameter k::Real = 56.0
  parameter Ti::Time = 10.0
  parameter Td::Time = 0.1
  parameter Nd::Real = 10.0
  parameter T_max::Torque = 150.0
  parameter y_max::Real = T_max
  parameter y_min::Real = 0.0
  parameter wd::Real = 1.0
  parameter m::Dyad.Mass = 1400.0
  parameter CdA::Area = 0.63
  "Initial measured speed in km/h"
  parameter m0::Real = 90.0
  "Initial integrator state"
  parameter xi0::Real = 0.0
  parameter xd0::Real = (wd - 1) * m0
  plant = VehicleSystemsComponents.HandsOn.SlipCar(theta_e = theta_e, T_max = T_max,
    m = m, CdA = CdA) {^plant}
  controller = VehicleSystemsComponents.Lecture1.CruiseController(with_I = with_I,
    with_D = with_D, k = k, Ti = Ti, Td = Td, Nd = Nd, y_max = y_max, y_min = y_min,
    wd = wd, xi0 = xi0, xd0 = xd0) {^controller}
relations
  connect(setpoint, controller.u_s) {^id1}
  connect(plant.v_kmh, controller.u_m) {^id2}
  connect(controller.y, plant.tau_cmd) {^id3}
  connect(grade, plant.grade) {^id4}
  connect(mu_scale, plant.mu_scale) {^id5}
metadata {
  "Dyad": {
    "icons": {"default": "dyad://VehicleSystemsComponents/Lecture1/SlipCruiseLoop.svg"},
    "labels": [{"label": "$(instance)", "x": 500, "y": 1100, "rot": 0}]
  },
  "_links": {
    "grade": {
      "Dyad": {
        "placement": {
          "icon": {"x1": -50, "x2": 50, "y1": 150, "y2": 250},
          "diagram": {"x1": -50, "x2": 50, "y1": 50, "y2": 150}
        }
      }
    },
    "mu_scale": {
      "Dyad": {
        "placement": {
          "icon": {"x1": -50, "x2": 50, "y1": 450, "y2": 550},
          "diagram": {"x1": -50, "x2": 50, "y1": 200, "y2": 300}
        }
      }
    },
    "setpoint": {
      "Dyad": {
        "placement": {
          "icon": {"x1": -50, "x2": 50, "y1": 750, "y2": 850},
          "diagram": {"x1": -50, "x2": 50, "y1": 350, "y2": 450}
        }
      }
    },
    "controller": {
      "Dyad": {"placement": {"diagram": {"x1": 240, "x2": 340, "y1": 450, "y2": 550}}}
    },
    "plant": {"Dyad": {"placement": {"diagram": {"x1": 690, "x2": 790, "y1": 415, "y2": 515}}}},
    "id1": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 130, "y": 400}, {"x": 130, "y": 477}], "E": 2}],
        "path": {}
      }
    },
    "id2": {
      "Dyad": {
        "edges": [
          {
            "S": 1,
            "M": [
              {"x": 880, "y": 480},
              {"x": 880, "y": 700},
              {"x": 190, "y": 700},
              {"x": 190, "y": 523}
            ],
            "E": 2
          }
        ],
        "path": {}
      }
    },
    "id3": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id4": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 650, "y": 100}, {"x": 650, "y": 422}], "E": 2}],
        "path": {}
      }
    },
    "id5": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 630, "y": 250}, {"x": 630, "y": 437}], "E": 2}],
        "path": {}
      }
    }
  }
}
end

"""Settled 90 km/h cruise crossing a finite low-friction patch."""
component SlipCruiseIcePatch
  structural parameter theta_e::Time = 0.3
  parameter with_I::Boolean = true
  parameter with_D::Boolean = true
  parameter k::Real = 56.0
  parameter Ti::Time = 10.0
  parameter Td::Time = 0.1
  parameter Nd::Real = 10.0
  parameter T_max::Torque = 150.0
  parameter y_max::Real = T_max
  parameter y_min::Real = 0.0
  parameter wd::Real = 1.0
  parameter m::Dyad.Mass = 1400.0
  parameter CdA::Area = 0.63
  parameter v_set::Real = 90.0
  parameter v0::Velocity = 25.0
  parameter tau0::Torque = 31.078
  parameter mu_low::Real = 0.05
  parameter patch_start::Time = 10.0
  parameter patch_duration::Time = 2.0
  loop = VehicleSystemsComponents.Lecture1.SlipCruiseLoop(theta_e = theta_e,
    with_I = with_I, with_D = with_D, k = k, Ti = Ti, Td = Td, Nd = Nd,
    T_max = T_max, y_max = y_max, y_min = y_min, wd = wd, m = m, CdA = CdA,
    m0 = v_set, xi0 = tau0 / k) {^loop}
  demand = BlockComponents.Sources.Constant(k = v_set) {^demand}
  road = BlockComponents.Sources.Constant(k = 0.0) {^road}
  friction = VehicleSystemsComponents.Vehicle.FrictionProfile(low = mu_low,
    start_time = patch_start, duration = patch_duration) {^friction}
relations
  connect(demand.y, loop.setpoint) {^id4}
  connect(road.y, loop.grade) {^id5}
  connect(friction.y, loop.mu_scale) {^id6}
  initial loop.plant.body.mass.s = 0.0
  initial loop.plant.body.mass.v = v0
  initial loop.plant.engine.lag.x = tau0
  initial loop.plant.wheel_inertia.phi = 0.0
  initial loop.plant.wheel_inertia.w = v0 / loop.plant.r
metadata {
  "Dyad": {
    "tests": {
      "ice_patch": {
        "stop": 30,
        "atol": {"loop.plant.v_kmh": 0.1, "loop.plant.wheel.kappa": 0.05},
        "expect": {
          "initial": {"loop.plant.v_kmh": 90, "loop.plant.wheel.kappa": 0},
          "final": {"loop.plant.v_kmh": 89.99954, "loop.plant.wheel.kappa": 0.0015586},
          "signals": ["loop.plant.v_kmh", "loop.plant.wheel_kmh", "loop.plant.wheel.kappa", "loop.controller.y", "friction.y"]
        }
      }
    }
  },
  "_links": {
    "loop": {"Dyad": {"placement": {"diagram": {"x1": 600, "x2": 700, "y1": 400, "y2": 500}}}},
    "road": {"Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 370, "y2": 470}}}},
    "friction": {"Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 520, "y2": 620}}}},
    "demand": {"Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 670, "y2": 770}}}},
    "id4": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 540, "y": 720}, {"x": 540, "y": 480}], "E": 2}],
        "path": {}
      }
    },
    "id5": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id6": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 500, "y": 570}, {"x": 500, "y": 450}], "E": 2}],
        "path": {}
      }
    }
  }
}
end

analysis SlipCruiseTransient
  extends TransientAnalysis(stop = 30)
  parameter k::Real = 56.0
  parameter Ti::Time = 10.0
  parameter Td::Time = 0.1
  parameter Nd::Real = 10.0
  parameter T_max::Torque = 150.0
  parameter y_max::Real = T_max
  parameter y_min::Real = 0.0
  parameter wd::Real = 1.0
  parameter m::Dyad.Mass = 1400.0
  parameter CdA::Area = 0.63
  parameter v_set::Real = 90.0
  parameter v0::Velocity = 25.0
  parameter tau0::Torque = 31.078
  parameter mu_low::Real = 0.05
  parameter patch_start::Time = 10.0
  parameter patch_duration::Time = 2.0
  model = VehicleSystemsComponents.Lecture1.SlipCruiseIcePatch(k = k, Ti = Ti, Td = Td,
    Nd = Nd, T_max = T_max, y_max = y_max, y_min = y_min, wd = wd, m = m, CdA = CdA,
    v_set = v_set, v0 = v0, tau0 = tau0, mu_low = mu_low, patch_start = patch_start,
    patch_duration = patch_duration)
relations
end
