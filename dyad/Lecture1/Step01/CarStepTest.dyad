"""Step 1a: a torque step from the 90 to the 110 km/h cruise torque on `Car`."""
component CarStepTest
  cmd = BlockComponents.Sources.Step(offset = 31.078, height = 9.041, start_time = 50) {^cmd}
  plant = VehicleSystemsComponents.HandsOn.Car() {^plant}
relations
  connect(cmd.y, plant.tau_cmd) {^id1}
  initial plant.body.mass.s = 0
  initial plant.body.mass.v = 25
  initial plant.engine.lag.x = 31.078
metadata {
  "Dyad": {
    "tests": {
      "step": {
        "stop": 500,
        "atol": {"plant.v_kmh": 0.05, "plant.engine.limiter.y": 0.001},
        "expect": {
          "initial": {"plant.v_kmh": 90, "plant.engine.limiter.y": 31.078},
          "final": {"plant.v_kmh": 110, "plant.engine.limiter.y": 40.119}
        }
      }
    }
  },
  "_links": {
    "cmd": {"Dyad": {"placement": {"diagram": {"x1": 150, "x2": 250, "y1": 450, "y2": 550}}}},
    "plant": {"Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 450, "y2": 550}}}},
    "id1": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  }
}
end

analysis CarStepTestTransient
  extends TransientAnalysis(stop = 500)
  model = CarStepTest()
end
