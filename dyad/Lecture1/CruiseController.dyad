    "id_limiter_y": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 975, "y": 330}, {"x": 975, "y": 500}], "E": 2}], "path": {}}},
    "id_us_d": {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 90, "y": 580}], "E": 2}], "junctions": [{"x": 90, "y": 270}], "path": {}}},
    "id_um_d": {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 60, "y": 640}], "E": 2}], "junctions": [{"x": 60, "y": 730}], "path": {}}},
    "id_add_d_derivative": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id_derivative_pid": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 490, "y": 610}, {"x": 490, "y": 330}], "E": 2}], "path": {}}},
    "id_zero_d_pid": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 490, "y": 470}, {"x": 490, "y": 330}], "E": 2}], "path": {}}},
    "id_integrator_pid": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 520, "y": 770}, {"x": 520, "y": 360}], "E": 2}], "path": {}}},
    "id_zero_i_pid": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 520, "y": 910}, {"x": 520, "y": 360}], "E": 2}], "path": {}}}
  }
}
end

test component TestCruiseController
  "Constant setpoint above the measurement: a fixed positive error"
  sp = BlockComponents.Sources.Constant(k = 3.0) {^sp}
  "Constant measurement"
  meas = BlockComponents.Sources.Constant(k = 0.0) {^meas}
  # PI with a low ceiling: the proportional term alone (3) is below y_max = 5, so the loop
  # starts unsaturated and the integrator ramps. It saturates when P + I reaches 5, at I = 2,
  # after which the error is still positive and the output is at the limit, so clamping freezes
  # the integrator there rather than letting it wind up without bound.
  ctrl = VehicleSystemsComponents.Lecture1.CruiseController(with_I = true, with_D = false, k = 1.0, Ti = 1.0, y_max = 5.0, y_min = -5.0) {^ctrl}
relations
  connect(sp.y, ctrl.u_s) {^id1}
  connect(meas.y, ctrl.u_m) {^id2}
metadata {
  "Dyad": {
    "tests": {
      "clamp_freeze": {
        "stop": 5,
        # The integrator freezes at the analytic value 2.0 (where P + I first reaches y_max).
        # A default-tolerance solve overshoots the ifelse threshold by ~0.17 once, then holds
        # flat; the tolerance covers that one-time step-through of the discontinuity.
        "atol": {"ctrl.y": 0.01, "ctrl.integrator.y": 0.25},
        "expect": {
          "initial": {"ctrl.y": 3.0, "ctrl.integrator.y": 0.0},
          "final": {"ctrl.y": 5.0, "ctrl.integrator.y": 2.0},
          "signals": ["ctrl.y", "ctrl.integrator.y"]
        }
      }
    }
  },
  "_links": {
    "sp": {"Dyad": {"placement": {"diagram": {"x1": 150, "x2": 250, "y1": 427, "y2": 527}}}},
    "meas": {"Dyad": {"placement": {"diagram": {"x1": 150, "x2": 250, "y1": 600, "y2": 700}}}},
    "ctrl": {"Dyad": {"placement": {"diagram": {"x1": 400, "x2": 500, "y1": 450, "y2": 550}}}},
    "id1": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id2": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 330, "y": 650}, {"x": 330, "y": 523}], "E": 2}],
        "path": {}
      }
    }
  }
}
end
