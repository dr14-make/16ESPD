"""
PID cruise controller with output limiting and clamping anti-windup.

The proportional branch acts on the control error, the integral branch supplies steady-state
correction, and the filtered derivative branch acts on the weighted setpoint and measurement.
`with_I` and `with_D` switch the integral and derivative branches on and off through the
`i_switch` and `d_switch` blocks, so P, PI, PD and PID are the same diagram with different
parameter values. A switched-off branch contributes zero: `clamp` feeds the integrator zero, so
it holds `xi0`, and the derivative filter runs with a harmless 1 s time constant whose output is
discarded.

`clamp` freezes the integrator only when both conditions hold:

1. the output is saturated at a limit, and
2. the control error has the same sign as that limit, so integrating further would push the
   command deeper into saturation.

The same-sign condition lets the integrator unwind as soon as the error reverses rather than
trapping it at the value reached during saturation.
"""
component CruiseController
  extends BlockComponents.Interfaces.SingleVariableController
  error = BlockComponents.Math.Add(k1 = 1, k2 = -1) {^error}
  add_d = BlockComponents.Math.Add(k1 = wd, k2 = -1) {^add_d}
  # With D off, Td may be zero and a 1e-14 s filter would be a stiff state; a 1 s filter is
  # harmless because d_switch discards its output.
  derivative = BlockComponents.Continuous.Derivative(k = Td, T = ifelse(with_D, max(Td / Nd, 1e-14), 1.0), x0 = xd0) {^derivative}
  d_switch = VehicleSystemsComponents.Lecture1.OnOff(on = with_D) {^d_switch}
  clamp = VehicleSystemsComponents.Lecture1.ClampingGate(y_max = y_max, y_min = y_min, on = with_I) {^clamp}
  integrator = BlockComponents.Continuous.Integrator(k = 1 / Ti, x0 = xi0) {^integrator}
  i_switch = VehicleSystemsComponents.Lecture1.OnOff(on = with_I) {^i_switch}
  add_pid = BlockComponents.Math.Add3(k1 = 1, k2 = 1, k3 = 1) {^add_pid}
  gain = BlockComponents.Math.Gain(k = k) {^gain}
  limiter = BlockComponents.Nonlinear.Limiter(y_max = y_max, y_min = y_min) {^limiter}
  variable control_error::Real
  "Switch the integral part on"
  parameter with_I::Boolean = true
  "Switch the derivative part on"
  parameter with_D::Boolean = true
  "Gain of controller"
  parameter k::Real = 1
  "Time constant of the integrator block (used when `with_I = true`)"
  parameter Ti::Time = 0.5
  "Time constant of the derivative block (used when `with_D = true`)"
  parameter Td::Time = 0.1
  "Maximum output"
  parameter y_max::Real = 1e300
  "Minimum output"
  parameter y_min::Real = -y_max
  "Set-point weight for derivative block (used when `with_D = true`)"
  parameter wd::Real = 1
  "Maximum derivative gain (used when `with_D = true`)"
  parameter Nd::Real = 10
  "Initial value for integrator state; held there when `with_I = false`"
  parameter xi0::Real = 0
  "Initial value for derivative-filter state"
  parameter xd0::Real = 0
relations
  connect(u_s, error.u1) {^id10}
  connect(u_m, error.u2) {^id11}
  connect(error.y, add_pid.u1) {^id12}
  connect(add_pid.y, gain.u) {^id13}
  connect(gain.y, limiter.u) {^id14}
  connect(limiter.y, y) {^id15}
  control_error = error.y
  connect(u_s, add_d.u1) {^id16}
  connect(u_m, add_d.u2) {^id17}
  connect(add_d.y, derivative.u) {^id18}
  connect(derivative.y, d_switch.u) {^id19}
  connect(d_switch.y, add_pid.u2) {^id20}
  connect(error.y, clamp.u) {^id23}
  connect(limiter.y, clamp.u_lim) {^id24}
  connect(clamp.y, integrator.u) {^id25}
  connect(integrator.y, i_switch.u) {^id21}
  connect(i_switch.y, add_pid.u3) {^id22}
metadata {
  "_links": {
    "error": {
      "Dyad": {"placement": {"diagram": {"x1": 150, "x2": 250, "y1": 250, "y2": 350}}}
    },
    "add_d": {
      "Dyad": {"placement": {"diagram": {"x1": 150, "x2": 250, "y1": 560, "y2": 660}}}
    },
    "derivative": {
