    "add_pid": {"Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 280, "y2": 380}}}},
    "gain": {"Dyad": {"placement": {"diagram": {"x1": 700, "x2": 800, "y1": 280, "y2": 380}}}},
    "limiter": {"Dyad": {"placement": {"diagram": {"x1": 850, "x2": 950, "y1": 280, "y2": 380}}}},
    "id_us_error": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id_um_error": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 60, "y": 730}, {"x": 60, "y": 330}], "E": 2}], "path": {}}},
    "id_error_pid": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
