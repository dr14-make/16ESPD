    "w08": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 420, "y": 230}, {"x": 420, "y": 660}], "E": 2}]}},
    "w09": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
