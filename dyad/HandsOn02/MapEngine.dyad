    "w05": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 970, "y": 110}, {"x": 970, "y": 30}, {"x": 400, "y": 30}, {"x": 400, "y": 460}], "E": 2}]}},
    "w06": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
