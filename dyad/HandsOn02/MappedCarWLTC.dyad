"""
Bonus bench: the Lecture 1 PID drives the mapped-engine CVT car over a speed trace.

The controller emits one normalized driver demand. Two limiters split positive demand to the
accelerator and negative demand to a service-brake command, so the actuators cannot overlap.
The default gains were tuned once against the complete WLTC class 3b cycle: gain was raised
until hard accelerations stayed near the tolerance band, integral time was shortened to remove
sustained error, and derivative time was then raised to limit overshoot.
"""
component MappedCarWLTC
  "Controller gain [normalized demand per km/h] (whole-cycle tuning)"
  parameter k::Real = 0.14
  "Controller integral time (whole-cycle tuning)"
  parameter Ti::Time = 3.5
  "Controller derivative time (whole-cycle tuning)"
  parameter Td::Time = 0.7
  "Brake force at a normalized demand of -1 [N] (firm 0.3 g stop assumption)"
  parameter F_brake_max::Force = 4000
  "Initial idle speed [rpm] (MappedCarBrakeStop reference run)"
  parameter rpm0::Real = 775
  "Initial idle manifold pressure [Pa] (MappedCarBrakeStop reference run)"
  parameter p_m0::Pressure = 33600

  "Prescribed speed [km/h]"
  v_ref_kmh = RealOutput() {^v_ref_kmh}
  "Measured speed [km/h]"
  v_kmh = RealOutput() {^v_kmh}
  "Signed normalized driver demand"
  driver_demand = RealOutput() {^driver_demand}
  "Fuel consumed since cycle start [L]"
  fuel_l = RealOutput() {^fuel_l}
  "Distance driven since cycle start [km]"
  distance_km = RealOutput() {^distance_km}
  "Cumulative fuel consumption [L/100 km]"
  fuel_l_per_100km = RealOutput() {^fuel_l_per_100km}
  "Cumulative carbon dioxide [g/km]"
  co2_g_per_km = RealOutput() {^co2_g_per_km}

  trace = VehicleSystemsComponents.Vehicle.DriveCycle() {^trace}
  controller = VehicleSystemsComponents.Lecture1.CruiseController(k = k, Ti = Ti, Td = Td, y_min = -1, y_max = 1) {^controller}
  pedal = BlockComponents.Nonlinear.Limiter(y_min = 0, y_max = 1) {^pedal}
  brake_part = BlockComponents.Nonlinear.Limiter(y_min = -1, y_max = 0) {^brake_part}
  brake_gain = BlockComponents.Math.Gain(k = -F_brake_max) {^brake_gain}
  car = VehicleSystemsComponents.HandsOn02.MappedCarWithBrake(ratio_initial = 12) {^car}

  "L/h to L: the time base is seconds"
  fuel_integrator = BlockComponents.Continuous.Integrator(k = 1 / 3600, x0 = 0) {^fuel_integrator}
  "km/h to km: the time base is seconds"
  distance_integrator = BlockComponents.Continuous.Integrator(k = 1 / 3600, x0 = 0) {^distance_integrator}
  "Avoid an undefined 0/0 display before the car has moved"
  distance_floor = BlockComponents.Sources.Constant(k = 1e-9) {^distance_floor}
  safe_distance = BlockComponents.Math.Max() {^safe_distance}
  consumption_ratio = BlockComponents.Math.Division() {^consumption_ratio}
  to_l_per_100km = BlockComponents.Math.Gain(k = 100) {^to_l_per_100km}
  "2302 g CO2/L petrol (Hands-on 02 step 05)"
  to_co2 = BlockComponents.Math.Gain(k = 23.02) {^to_co2}
relations
  connect(trace.y, controller.u_s) {^w1}
  connect(car.v_kmh, controller.u_m) {^w2}
  connect(controller.y, pedal.u) {^w3}
  connect(controller.y, brake_part.u) {^w4}
  connect(pedal.y, car.pedal) {^w5}
  connect(brake_part.y, brake_gain.u) {^w6}
  connect(brake_gain.y, car.F_brake) {^w7}

  connect(trace.y, v_ref_kmh) {^w8}
  connect(car.v_kmh, v_kmh) {^w9}
  connect(controller.y, driver_demand) {^w10}
  connect(car.fuel_lph, fuel_integrator.u) {^w11}
  connect(fuel_integrator.y, fuel_l) {^w12}
  connect(car.v_kmh, distance_integrator.u) {^w13}
  connect(distance_integrator.y, distance_km) {^w14}
  connect(distance_integrator.y, safe_distance.u1) {^w15}
  connect(distance_floor.y, safe_distance.u2) {^w16}
  connect(fuel_integrator.y, consumption_ratio.u1) {^w17}
  connect(safe_distance.y, consumption_ratio.u2) {^w18}
  connect(consumption_ratio.y, to_l_per_100km.u) {^w19}
  connect(to_l_per_100km.y, fuel_l_per_100km) {^w20}
  connect(to_l_per_100km.y, to_co2.u) {^w21}
  connect(to_co2.y, co2_g_per_km) {^w22}

  initial car.body.mass.s = 0
  initial car.body.mass.v = 0
  initial car.flywheel.w = rpm0 * pi / 30
  initial car.flywheel.phi = 0
  initial car.driveline.clutch.spline_b.phi = 0
  initial car.engine.air.manifold.p = p_m0
metadata {
  "Dyad": {"labels": [{"label": "$(instance)", "x": 500, "y": 1100, "rot": 0}]},
  "_links": {
    "trace": {"Dyad": {"placement": {"diagram": {"x1": 50, "x2": 150, "y1": 220, "y2": 320}}}},
    "controller": {"Dyad": {"placement": {"diagram": {"x1": 230, "x2": 350, "y1": 210, "y2": 330}}}},
    "pedal": {"Dyad": {"placement": {"diagram": {"x1": 410, "x2": 500, "y1": 160, "y2": 250}}}},
    "brake_part": {"Dyad": {"placement": {"diagram": {"x1": 410, "x2": 500, "y1": 310, "y2": 400}}}},
    "brake_gain": {"Dyad": {"placement": {"diagram": {"x1": 540, "x2": 630, "y1": 310, "y2": 400}}}},
    "car": {"Dyad": {"placement": {"diagram": {"x1": 700, "x2": 850, "y1": 210, "y2": 360}}}},
