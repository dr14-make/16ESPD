    "distance_integrator": {"Dyad": {"placement": {"diagram": {"x1": 610, "x2": 690, "y1": 620, "y2": 700}}}},
    "distance_floor": {"Dyad": {"placement": {"diagram": {"x1": 390, "x2": 470, "y1": 760, "y2": 840}}}},
    "safe_distance": {"Dyad": {"placement": {"diagram": {"x1": 510, "x2": 590, "y1": 730, "y2": 810}}}},
    "consumption_ratio": {"Dyad": {"placement": {"diagram": {"x1": 650, "x2": 730, "y1": 750, "y2": 830}}}},
    "to_l_per_100km": {"Dyad": {"placement": {"diagram": {"x1": 770, "x2": 850, "y1": 750, "y2": 830}}}},
    "to_co2": {"Dyad": {"placement": {"diagram": {"x1": 880, "x2": 960, "y1": 840, "y2": 920}}}},
    "v_ref_kmh": {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 100, "y2": 180}, "diagram": {"x1": 950, "x2": 1050, "y1": 100, "y2": 180}}}},
    "v_kmh": {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 200, "y2": 280}, "diagram": {"x1": 950, "x2": 1050, "y1": 200, "y2": 280}}}},
    "driver_demand": {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 300, "y2": 380}, "diagram": {"x1": 950, "x2": 1050, "y1": 300, "y2": 380}}}},
    "fuel_l": {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 450, "y2": 530}, "diagram": {"x1": 950, "x2": 1050, "y1": 450, "y2": 530}}}},
    "distance_km": {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 550, "y2": 630}, "diagram": {"x1": 950, "x2": 1050, "y1": 550, "y2": 630}}}},
    "fuel_l_per_100km": {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 700, "y2": 780}, "diagram": {"x1": 950, "x2": 1050, "y1": 700, "y2": 780}}}},
    "co2_g_per_km": {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 820, "y2": 900}, "diagram": {"x1": 950, "x2": 1050, "y1": 820, "y2": 900}}}},
    "w1": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}}, "w2": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 880, "y": 285}, {"x": 880, "y": 430}, {"x": 290, "y": 430}], "E": 2}]}},
    "w3": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}}, "w4": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 380, "y": 270}, {"x": 380, "y": 355}], "E": 2}]}},
    "w5": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}}, "w6": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}}, "w7": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w8": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 180, "y": 270}, {"x": 180, "y": 140}], "E": 2}]}}, "w9": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}}, "w10": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 370, "y": 270}, {"x": 370, "y": 340}], "E": 2}]}},
    "w11": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}}, "w12": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}}, "w13": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 870, "y": 285}, {"x": 870, "y": 660}], "E": 2}]}}, "w14": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w15": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}}, "w16": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}}, "w17": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 720, "y": 540}, {"x": 720, "y": 730}], "E": 2}]}}, "w18": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}}, "w19": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}}, "w20": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}}, "w21": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 860, "y": 790}, {"x": 860, "y": 880}], "E": 2}]}}, "w22": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}}
  }
}
end

analysis MappedCarWLTCTransient
  extends TransientAnalysis(stop = 1800, saveat = 1.0, alg = ODEAlg.Rodas5P())
  parameter k::Real = 0.14
  parameter Ti::Time = 3.5
  parameter Td::Time = 0.7
  model = MappedCarWLTC(k = k, Ti = Ti, Td = Td)
end

analysis MappedCarWLTCLowMediumTransient
  extends TransientAnalysis(stop = 589, saveat = 1.0, alg = ODEAlg.Rodas5P())
  parameter k::Real = 0.14
  parameter Ti::Time = 3.5
  parameter Td::Time = 0.7
  model = MappedCarWLTC(k = k, Ti = Ti, Td = Td)
end
