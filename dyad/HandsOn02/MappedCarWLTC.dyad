"""
Bonus bench: the Lecture 1 step 6d PID drives the mapped-engine CVT car over the WLTC trace.

The driver emits one effort from -1 to +1. Two limiters split it: the positive part goes to the
pedal, the negative part, times `F_brake_max`, to the brake, so pedal and brake never act
together. Two integrators add up the fuel in liters and the distance in kilometers; the label
figures are their ratio at the end of the run.
"""
component MappedCarWLTC
  "Controller gain [effort per km/h] (tuned once on the full cycle)"
  parameter k::Real = 0.14
  "Controller integral time (tuned once on the full cycle)"
  parameter Ti::Time = 3.5
  "Controller derivative time (tuned once on the full cycle)"
  parameter Td::Time = 0.7
  "Brake force at an effort of -1 [N] (firm 0.3 g stop assumption)"
  parameter F_brake_max::Force = 4000
  "Initial idle speed [rpm] (MappedCarBrakeStop reference run)"
  parameter rpm0::Real = 775
  "Initial idle manifold pressure [Pa] (MappedCarBrakeStop reference run)"
  parameter p_m0::Pressure = 33600

  trace = VehicleSystemsComponents.Vehicle.DriveCycle() {^trace}
  "The car starts at rest and the derivative acts on the measurement only (wd = 0), so the filter starts at rest"
  driver = VehicleSystemsComponents.Lecture1.Step06d.CruiseController(k = k, Ti = Ti, Td = Td, xi0 = 0, xd0 = 0, y_min = -1, y_max = 1) {^driver}
  to_pedal = BlockComponents.Nonlinear.Limiter(y_min = 0, y_max = 1) {^to_pedal}
  brake_part = BlockComponents.Nonlinear.Limiter(y_min = -1, y_max = 0) {^brake_part}
  to_brake = BlockComponents.Math.Gain(k = -F_brake_max) {^to_brake}
  car = VehicleSystemsComponents.HandsOn02.MappedCarWithBrake() {^car}
  "L/h into liters: the time base is seconds"
  fuel_L = BlockComponents.Continuous.Integrator(k = 1 / 3600, x0 = 0) {^fuel_L}
  "km/h into kilometers: the time base is seconds"
  dist_km = BlockComponents.Continuous.Integrator(k = 1 / 3600, x0 = 0) {^dist_km}
relations
  connect(trace.y, driver.u_s) {^w1}
  connect(car.v_kmh, driver.u_m) {^w2}
  connect(driver.y, to_pedal.u) {^w3}
  connect(driver.y, brake_part.u) {^w4}
  connect(to_pedal.y, car.pedal) {^w5}
  connect(brake_part.y, to_brake.u) {^w6}
  connect(to_brake.y, car.F_brake) {^w7}
  connect(car.fuel_lph, fuel_L.u) {^w8}
  connect(car.v_kmh, dist_km.u) {^w9}

  initial car.body.mass.s = 0
  initial car.body.mass.v = 0
  initial car.flywheel.w = rpm0 * pi / 30
  initial car.flywheel.phi = 0
  initial car.driveline.clutch.spline_b.phi = 0
  initial car.engine.air.manifold.p = p_m0
metadata {
  "Dyad": {"labels": [{"label": "$(instance)", "x": 500, "y": 1100, "rot": 0}]},
  "_links": {
    "trace": {"Dyad": {"placement": {"diagram": {"x1": 40, "x2": 140, "y1": 250, "y2": 350}}}},
    "driver": {"Dyad": {"placement": {"diagram": {"x1": 220, "x2": 340, "y1": 240, "y2": 360}}}},
    "to_pedal": {"Dyad": {"placement": {"diagram": {"x1": 420, "x2": 500, "y1": 180, "y2": 260}}}},
    "brake_part": {"Dyad": {"placement": {"diagram": {"x1": 420, "x2": 500, "y1": 326, "y2": 406}}}},
    "to_brake": {"Dyad": {"placement": {"diagram": {"x1": 560, "x2": 640, "y1": 326, "y2": 406}}}},
    "car": {"Dyad": {"placement": {"diagram": {"x1": 700, "x2": 900, "y1": 180, "y2": 380}}}},
    "dist_km": {"Dyad": {"placement": {"diagram": {"x1": 560, "x2": 640, "y1": 500, "y2": 580}}}},
    "fuel_L": {"Dyad": {"placement": {"diagram": {"x1": 560, "x2": 640, "y1": 620, "y2": 700}}}},
    "w1": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w2": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 940, "y": 272}, {"x": 940, "y": 460}, {"x": 280, "y": 460}], "E": 2}]}},
    "w3": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 380, "y": 300}, {"x": 380, "y": 220}], "E": 2}]}},
    "w4": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 380, "y": 300}, {"x": 380, "y": 366}], "E": 2}]}},
    "w5": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w6": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w7": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w8": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 970, "y": 246}, {"x": 970, "y": 600}, {"x": 500, "y": 600}, {"x": 500, "y": 660}], "E": 2}]}},
    "w9": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 940, "y": 272}, {"x": 940, "y": 480}, {"x": 520, "y": 480}, {"x": 520, "y": 540}], "E": 2}]}}
  }
}
end

analysis MappedCarWLTCTransient
  extends TransientAnalysis(stop = 1800, saveat = 1.0, alg = ODEAlg.Rodas5P())
  parameter k::Real = 0.14
  parameter Ti::Time = 3.5
  parameter Td::Time = 0.7
  model = MappedCarWLTC(k = k, Ti = Ti, Td = Td)
end

analysis MappedCarWLTCLowMediumTransient
  extends TransientAnalysis(stop = 1022, saveat = 1.0, alg = ODEAlg.Rodas5P())
  parameter k::Real = 0.14
  parameter Ti::Time = 3.5
  parameter Td::Time = 0.7
  model = MappedCarWLTC(k = k, Ti = Ti, Td = Td)
end
