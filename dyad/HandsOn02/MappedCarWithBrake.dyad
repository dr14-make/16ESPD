"""
Hands-on 02 step 06 B: `MappedCar` with a service brake between the body and the road.
"""
component MappedCarWithBrake
  "Initial CVT ratio, engine to wheel; 12 is CVTDriveline's launch setting"
  parameter ratio_initial::Real = 12
  "Pedal, 0 released to 1 floored"
  pedal = RealInput() {^pedal}
  "Brake force command [N], 0 released"
  F_brake = RealInput() {^F_brake}
  "Vehicle speed [km/h]"
  v_kmh = RealOutput() {^v_kmh}
  "Manifold absolute pressure [Pa]"
  p_m = RealOutput() {^p_m}
  "Fuel volume flow [L/h]"
  fuel_lph = RealOutput() {^fuel_lph}
  engine = VehicleSystemsComponents.HandsOn02.MapEngineFuelCut() {^engine}
  "Crankshaft and flywheel, J as MappedEngine assumes"
  flywheel = RotationalComponents.Components.Inertia(J = 0.15) {^flywheel}
  "kg/s of petrol to L/h: 3600 s/h / 0.745 kg/L (Hands-on 02)"
  to_lph = BlockComponents.Math.Gain(k = 4832.2) {^to_lph}
  driveline = VehicleSystemsComponents.Vehicle.CVTDriveline(ratio_initial = ratio_initial) {^driveline}
  body = VehicleSystemsComponents.HandsOn.Body() {^body}
  vsensor = TranslationalComponents.Sensors.VelocitySensor() {^vsensor}
  to_kmh = BlockComponents.Math.Gain(k = 3.6) {^to_kmh}
  brake = VehicleSystemsComponents.Vehicle.RoadBrake() {^brake}
  "Engine mounts and gearbox housing"
  rot_ground = RotationalComponents.Components.Fixed() {^rot_ground}
  "Road under the wheel"
  trans_ground = TranslationalComponents.Components.Fixed() {^trans_ground}
relations
  connect(pedal, engine.pedal) {^w1}
  connect(pedal, driveline.pedal) {^w2}
  connect(engine.spline, flywheel.spline_a) {^w4}
  connect(flywheel.spline_b, driveline.spline) {^w5}
  connect(engine.support, rot_ground.spline) {^w6}
  connect(driveline.support_r, rot_ground.spline) {^w7}
  connect(driveline.flange, body.flange) {^w8}
  connect(driveline.support_t, trans_ground.flange) {^w9}
  connect(vsensor.flange, body.flange) {^w10}
  connect(vsensor.v, to_kmh.u) {^w11}
  connect(to_kmh.y, v_kmh) {^w12}
  connect(engine.p_m, p_m) {^w13}
  connect(engine.mdot_fuel, to_lph.u) {^w14}
  connect(to_lph.y, fuel_lph) {^w15}
  connect(F_brake, brake.F_cmd) {^w16}
  connect(brake.flange, body.flange) {^w17}
  connect(brake.support, trans_ground.flange) {^w18}
metadata {
  "Dyad": {
    "icons": {"default": "dyad://VehicleSystemsComponents/HandsOn/Car.svg"},
    "labels": [{"label": "$(instance)", "x": 500, "y": 1100, "rot": 0}]
  },
