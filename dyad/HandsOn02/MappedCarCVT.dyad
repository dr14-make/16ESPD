"""Hands-on 02 mapped-engine car with a centrifugal launch clutch and CVT."""
component MappedCarCVT
  "Initial total CVT ratio (assumed launch setting; override for initialized cruise)"
  parameter ratio_initial::Real = 12.0
  "Pedal, 0 released to 1 floored"
  pedal = RealInput() {^pedal}
  "Vehicle speed [km/h]"
  v_kmh = RealOutput() {^v_kmh}
  "Manifold absolute pressure [Pa]"
  p_m = RealOutput() {^p_m}
  "Fuel volume flow [L/h]"
  fuel_lph = RealOutput() {^fuel_lph}
  engine = VehicleSystemsComponents.HandsOn02.MapEngineFuelCut() {^engine}
  "Specified Hands-on 02 flywheel inertia"
  flywheel = RotationalComponents.Components.Inertia(J = 0.15) {^flywheel}
  driveline = VehicleSystemsComponents.Vehicle.CVTDriveline(ratio_initial = ratio_initial) {^driveline}
  body = VehicleSystemsComponents.HandsOn.Body() {^body}
  zero_booster = BlockComponents.Sources.Constant(k = 0.0) {^zero_booster}
  speed_sensor = TranslationalComponents.Sensors.VelocitySensor() {^speed_sensor}
  to_kmh = BlockComponents.Math.Gain(k = 3.6) {^to_kmh}
  "3600 s/h divided by gasoline density 0.745 kg/L (Hands-on 02)"
  fuel_to_lph = BlockComponents.Math.Gain(k = 4832.2) {^fuel_to_lph}
  rot_ground = RotationalComponents.Components.Fixed() {^rot_ground}
  road = TranslationalComponents.Components.Fixed() {^road}
relations
  connect(pedal, engine.pedal, driveline.pedal) {^w1}
  connect(zero_booster.y, engine.mdot_bst) {^w2}
  connect(engine.spline, flywheel.spline_a) {^w3}
  connect(flywheel.spline_b, driveline.spline) {^w4}
  connect(engine.support, rot_ground.spline) {^w5}
  connect(driveline.support_r, rot_ground.spline) {^w6}
  connect(driveline.flange, body.flange, speed_sensor.flange) {^w7}
  connect(driveline.support_t, road.flange) {^w8}
  connect(speed_sensor.v, to_kmh.u) {^w9}
  connect(to_kmh.y, v_kmh) {^w10}
  connect(engine.p_m, p_m) {^w11}
  connect(engine.mdot_fuel, fuel_to_lph.u) {^w12}
  connect(fuel_to_lph.y, fuel_lph) {^w13}
metadata {
  "Dyad": {"icons": {"default": "dyad://VehicleSystemsComponents/HandsOn/Car.svg"}},
  "_links": {
    "pedal": {"Dyad": {"placement": {"diagram": {"x1": -25, "y1": 175, "x2": 25, "y2": 225}}}},
    "v_kmh": {"Dyad": {"placement": {"diagram": {"x1": 1175, "y1": 175, "x2": 1225, "y2": 225}}}},
    "p_m": {"Dyad": {"placement": {"diagram": {"x1": 1175, "y1": 275, "x2": 1225, "y2": 325}}}},
