"""CVT car initialized at a requested steady road speed for cruise measurements."""
component MappedCarCVTCruise
  "Road speed [km/h] (test scenario)"
  parameter speed_kmh::Real = 90.0
  "Constant pedal setting (test scenario)"
  parameter pedal_cmd::Real = 0.06
  "Initial manifold pressure [Pa] (derived steady-state guess)"
  parameter p_m0::Pressure = 45e3
  "Initial CVT ratio (derived from target engine speed and road speed)"
  parameter ratio0::Real = 6.0
  pedal_source = BlockComponents.Sources.Constant(k = pedal_cmd)
  car = VehicleSystemsComponents.HandsOn02.MappedCarCVT(ratio_initial = ratio0)
relations
  connect(pedal_source.y, car.pedal)
  initial car.body.mass.s = 0.0
  initial car.body.mass.v = speed_kmh / 3.6
  initial car.flywheel.phi = 0.0
  initial car.driveline.clutch.spline_b.phi = 0.0
  initial car.engine.air.manifold.p = p_m0
  initial car.engine.cut_logic.decel.y = 0.0
end

analysis MappedCarCVTCruiseTransient
  extends TransientAnalysis(stop = 60.0)
  parameter speed_kmh::Real = 90.0
  parameter pedal_cmd::Real = 0.06
  parameter p_m0::Pressure = 45e3
  parameter ratio0::Real = 6.0
  model = MappedCarCVTCruise(speed_kmh = speed_kmh, pedal_cmd = pedal_cmd, p_m0 = p_m0, ratio0 = ratio0)
end

"""Wide-open acceleration from rest and idle to CVT-car terminal speed."""
component MappedCarCVTWOT
  full_pedal = BlockComponents.Sources.Constant(k = 1.0) {^full_pedal}
  car = VehicleSystemsComponents.HandsOn02.MappedCarCVT() {^car}
relations
  connect(full_pedal.y, car.pedal) {^w1}
  initial car.body.mass.s = 0.0
  initial car.body.mass.v = 0.0
  initial car.flywheel.phi = 0.0
  initial car.flywheel.w = 900 * pi / 30
  initial car.driveline.clutch.spline_b.phi = 0.0
  initial car.engine.air.manifold.p = 101325.0
metadata {
  "_links": {
    "full_pedal": {"Dyad": {"placement": {"diagram": {"x1": 180, "y1": 450, "x2": 280, "y2": 550}}}},
    "car": {"Dyad": {"placement": {"diagram": {"x1": 520, "y1": 400, "x2": 660, "y2": 540}}}},
    "w1": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}}
  }
}

end

analysis MappedCarCVTWOTTransient
  extends TransientAnalysis(stop = 300.0)
  model = MappedCarCVTWOT()
end
