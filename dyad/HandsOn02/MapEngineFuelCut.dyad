"""
`MapEngine` after the hands-on 02 fuel-cut paste: deceleration fuel cut and a rev limiter.

`cut_logic` cuts the fuel with the pedal closed above 1300 rpm, until the engine falls below
1000 rpm or the pedal opens, and above 6500 rpm, until 6300 rpm. While it cuts, the fuel map gives
zero and the torque map gives the measured closed-throttle (motoring) torque instead of the map.
Students paste this into their own `MapEngine`; `MapEngine` stays the engine before the paste.
"""
component MapEngineFuelCut
  "Pedal, 0 released to 1 floored"
  pedal = RealInput() {^pedal}
  "Vacuum take-off: the hose to the brake booster, at manifold pressure"
  vacuum = VehicleSystemsComponents.Vehicle.GasPort() {^vacuum}
  "Output shaft"
  spline = Spline() {^spline}
  "Engine mounts"
  support = Spline() {^support}
  "Manifold absolute pressure [Pa]"
  p_m = RealOutput() {^p_m}
  "Fuel mass flow [kg/s]"
  mdot_fuel = RealOutput() {^mdot_fuel}
  "CO2 mass flow [kg/s]"
  mdot_co2 = RealOutput() {^mdot_co2}
  air = VehicleSystemsComponents.Vehicle.Engine.AirPath() {^air}
  speed = RotationalComponents.Sensors.VelocitySensor() {^speed}
  torque_map = VehicleSystemsComponents.Vehicle.Engine.CutTorqueMap() {^torque_map}
  fuel_map = VehicleSystemsComponents.Vehicle.Engine.CutFuelMap() {^fuel_map}
  "Fuel cut on overrun and at the rev limiter"
  cut_logic = VehicleSystemsComponents.Vehicle.Engine.FuelCutLogic() {^cut_logic}
  "CO2 per kilogram of petrol burned completely, 3.09 (textbook)"
  co2 = BlockComponents.Math.Gain(k = 3.09) {^co2}
  torque = RotationalComponents.Sources.TorqueSource() {^torque}
relations
  connect(pedal, air.u_thr) {^w01}
  connect(vacuum, air.vacuum) {^w02}
  connect(speed.w, air.omega) {^w03}
  connect(speed.w, torque_map.omega) {^w04}
  connect(speed.w, fuel_map.omega) {^w05}
  connect(air.p_m, torque_map.p_m) {^w06}
  connect(air.p_m, fuel_map.p_m) {^w07}
  connect(air.p_m, p_m) {^w08}
  connect(torque_map.y, torque.tau) {^w09}
  connect(fuel_map.y, co2.u) {^w10}
  connect(fuel_map.y, mdot_fuel) {^w11}
  connect(co2.y, mdot_co2) {^w12}
  connect(torque.spline, spline) {^w13}
  connect(speed.spline, spline) {^w14}
  connect(torque.support, support) {^w15}
  connect(pedal, cut_logic.pedal) {^w16}
  connect(speed.w, cut_logic.omega) {^w17}
  connect(cut_logic.cut, fuel_map.cut) {^w18}
  connect(cut_logic.cut, torque_map.cut) {^w19}
metadata {
  "Dyad": {"icons": {"default": "dyad://VehicleSystemsComponents/Vehicle/Engine/MappedEngine.svg"}},
  "_links": {
    "pedal": {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 250, "x2": 50, "y2": 350}, "diagram": {"x1": -25, "y1": 175, "x2": 25, "y2": 225}}}},
    "vacuum": {"Dyad": {"placement": {"icon": {"iconName": "gas_port_a", "x1": 150, "y1": 950, "x2": 250, "y2": 1050}, "diagram": {"iconName": "gas_port_a", "x1": -25, "y1": 275, "x2": 25, "y2": 325}}}},
    "spline": {"Dyad": {"placement": {"icon": {"iconName": "spline_b", "x1": 950, "y1": 850, "x2": 1050, "y2": 950}, "diagram": {"iconName": "spline_b", "x1": 975, "y1": 185, "x2": 1025, "y2": 235}}}},
    "support": {"Dyad": {"placement": {"icon": {"x1": 450, "y1": 950, "x2": 550, "y2": 1050}, "diagram": {"x1": 975, "y1": 305, "x2": 1025, "y2": 355}}}},
