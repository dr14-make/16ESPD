    "id4": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 145, "y": 415}], "E": -1}, {"S": -1, "M": [], "E": 2}, {"S": -1, "M": [{"x": 370, "y": 415}], "E": 3}, {"S": -1, "M": [], "E": 4}], "junctions": [{"x": 250, "y": 415}]}},
