"Hydraulic ABS stop with physical two-solenoid modulators and return pumps."
component HydraulicABSStop
  parameter pedal::Real = 0.6
  parameter road_mu::Real = 1.0
  parameter a_ref::Acceleration = 8.0 * road_mu
  parameter pump_enabled::Real = 1.0
  command = BlockComponents.Sources.Step(height = pedal, offset = 0.0, start_time = 0.5) {^command}
  road = BlockComponents.Sources.Constant(k = road_mu) {^road}
  pedal_unit = VehicleSystemsComponents.Vehicle.Brake.BrakePedal() {^pedal_unit}
  booster = VehicleSystemsComponents.Vehicle.Brake.StaticBooster() {^booster}
  master = VehicleSystemsComponents.Vehicle.Brake.TandemMasterCylinder() {^master}
  modulator_f = VehicleSystemsComponents.Vehicle.Brake.HydraulicModulator() {^modulator_f}
  modulator_r = VehicleSystemsComponents.Vehicle.Brake.HydraulicModulator() {^modulator_r}
  line_f = VehicleSystemsComponents.Vehicle.Brake.BrakeLine() {^line_f}
  line_r = VehicleSystemsComponents.Vehicle.Brake.BrakeLine(L = 4.0) {^line_r}
  controller = VehicleSystemsComponents.Vehicle.ABSValveController() {^controller}
  est = RefSpeedEstimator(a_ref = a_ref) {^est}
  wspeed = RotationalComponents.Sensors.VelocitySensor() {^wspeed}
  wheel = VehicleSystemsComponents.Vehicle.Wheel.HydraulicBrakedWheel() {^wheel}
  body = VehicleSystemsComponents.HandsOn.Body() {^body}
  fixed = RotationalComponents.Components.Fixed() {^fixed}
  fixed_hydraulic = TranslationalComponents.Components.Fixed() {^fixed_hydraulic}
  speed = TranslationalComponents.Sensors.VelocitySensor() {^speed}
  path medium::HydraulicComponents.Interfaces.AbstractMedium = HydraulicComponents.IsothermalCompressible(bulk_modulus = 1.4e9, density = 1045.0, let_gas = false)
relations
  connect(command.y, pedal_unit.u)
  connect(pedal_unit.rod, booster.input)
  connect(booster.rod_out, master.pushrod)
  connect(pedal_unit.support, booster.support, master.support, fixed_hydraulic.flange)
  connect(master.front, modulator_f.port_a)
  connect(modulator_f.port_b, line_f.port_a)
  connect(line_f.port_b, wheel.front)
  connect(master.rear, modulator_r.port_a)
  connect(modulator_r.port_b, line_r.port_a)
  connect(line_r.port_b, wheel.rear)
  continuity(medium, master.front.medium)
  connect(wspeed.spline, wheel.spline)
  connect(wspeed.w, est.omega)
  connect(est.kappa_hat, controller.kappa)
  connect(est.v_ref, controller.v_ref)
  connect(est.a_w, controller.a_w)
  connect(master.p_mc, controller.p_mc)
  connect(controller.inlet, modulator_f.inlet, modulator_r.inlet)
  connect(controller.outlet, modulator_f.outlet, modulator_r.outlet)
  modulator_f.motor = pump_enabled * controller.motor
  modulator_r.motor = pump_enabled * controller.motor
  connect(road.y, wheel.mu_scale)
  connect(wheel.support, fixed.spline)
  connect(wheel.flange, body.flange, speed.flange)
  initial wheel.inertia.phi = 0
  initial wheel.inertia.w = 25 / 0.31
  initial body.mass.s = 0
  initial body.mass.v = 25
  initial modulator_f.gallery.V = 0
  initial modulator_r.gallery.V = 0
metadata {
  "_links": {
    "command": {"Dyad": {"placement": {"diagram": {"x1": -120, "x2": -20, "y1": 120, "y2": 220}}}},
    "pedal_unit": {"Dyad": {"placement": {"diagram": {"x1": 40, "x2": 140, "y1": 120, "y2": 220}}}},
    "booster": {"Dyad": {"placement": {"diagram": {"x1": 190, "x2": 290, "y1": 120, "y2": 220}}}},
    "master": {"Dyad": {"placement": {"diagram": {"x1": 340, "x2": 460, "y1": 110, "y2": 230}}}},
    "modulator_f": {"Dyad": {"placement": {"diagram": {"x1": 530, "x2": 680, "y1": 20, "y2": 170}}}},
    "modulator_r": {"Dyad": {"placement": {"diagram": {"x1": 530, "x2": 680, "y1": 230, "y2": 380}}}},
    "line_f": {"Dyad": {"placement": {"diagram": {"x1": 750, "x2": 850, "y1": 45, "y2": 145}}}},
    "line_r": {"Dyad": {"placement": {"diagram": {"x1": 750, "x2": 850, "y1": 255, "y2": 355}}}},
    "wheel": {"Dyad": {"placement": {"diagram": {"x1": 930, "x2": 1100, "y1": 100, "y2": 270}}}},
    "body": {"Dyad": {"placement": {"diagram": {"x1": 1190, "x2": 1290, "y1": 135, "y2": 235}}}},
    "speed": {"Dyad": {"placement": {"diagram": {"x1": 1190, "x2": 1290, "y1": -20, "y2": 80}}}},
    "road": {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 400, "y2": 500}}}},
    "controller": {"Dyad": {"placement": {"diagram": {"x1": 500, "x2": 700, "y1": 560, "y2": 760}}}},
    "est": {"Dyad": {"placement": {"diagram": {"x1": 230, "x2": 380, "y1": 570, "y2": 720}}}},
    "wspeed": {"Dyad": {"placement": {"diagram": {"x1": 900, "x2": 1000, "y1": 650, "y2": 750}}}},
    "fixed": {"Dyad": {"placement": {"diagram": {"x1": 1050, "x2": 1150, "y1": 650, "y2": 750}}}},
    "fixed_hydraulic": {"Dyad": {"placement": {"diagram": {"x1": 40, "x2": 140, "y1": 400, "y2": 500}}}}
  }
}
end

analysis HydraulicABSStopTransient
  extends TransientAnalysis(stop = 6.0, alg = ODEAlg.Rodas5P(), dtmax = 1e-3, saveat = 0.001, tstops = [0.5], abstol = 1e-5, reltol = 1e-5)
  parameter pedal::Real = 0.6
  parameter road_mu::Real = 1.0
  parameter pump_enabled::Real = 1.0
  model = HydraulicABSStop(pedal = pedal, road_mu = road_mu, pump_enabled = pump_enabled)
end

analysis HydraulicABSStopReportTransient
  extends TransientAnalysis(stop = 11.0, alg = ODEAlg.Rodas5P(), dtmax = 1e-3, saveat = 0.001, tstops = [0.5], abstol = 1e-5, reltol = 1e-5)
  parameter pedal::Real = 0.6
  parameter road_mu::Real = 0.3
  parameter pump_enabled::Real = 1.0
  model = HydraulicABSStop(pedal = pedal, road_mu = road_mu, pump_enabled = pump_enabled)
end

