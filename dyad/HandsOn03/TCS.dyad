"""
Traction controller that builds brake torque above the target positive driving slip and releases it
below the target.
"""
component TCS
  "Longitudinal tire slip, positive while driving"
  kappa = RealInput()
  "Commanded TCS brake torque"
  tau_cmd = RealOutput()
  pressure = VehicleSystemsComponents.Vehicle.ABSPressureIntegrator(T_track = T_track)
  "Slip held just past the tire's peak"
  parameter lambda_target::Real = 0.04
  "Maximum TCS brake torque"
  parameter tau_tcs_max::Torque = 2000.0
  "Brake-torque build rate"
  parameter k_inc::Real = 40000.0
  "Brake-torque release rate"
  parameter k_dec::Real = 80000.0
  "Look-ahead, the brake's lag"
  parameter T_p::Time = 0.03
  "Slip-rate filter"
  parameter T_f::Time = 0.003
  "Integrator tracking time"
  parameter T_track::Time = 0.01
  variable kappa_f::Real
  variable kappa_dot::Real
  variable kappa_pred::Real
relations
  initial kappa_f = 0.0
  der(kappa_f) = (kappa - kappa_f) / T_f
  kappa_dot = (kappa - kappa_f) / T_f
  kappa_pred = kappa + T_p * kappa_dot
  pressure.demand = tau_tcs_max
  pressure.requested_rate = ifelse(kappa_pred > lambda_target, k_inc, -k_dec)
  pressure.active = 1.0
  tau_cmd = min(max(pressure.cmd, 0.0), tau_tcs_max)
end
