"""
Whole-car TCS plant: the hands-on 02 mapped engine, launch clutch and CVT drive the hands-on 03
hydraulic braked wheel. A prescribed pressure boundary represents the ABS pump and accumulator.
"""
component TCSCar
  "Driver's throttle pedal, 0 released to 1 floored"
  pedal = RealInput() {^pedal}
  "TCS throttle limit, zero to one"
  u_tcs = RealInput() {^u_tcs}
  "Allowed wheel-circuit pressure"
  p_cmd = RealInput() {^p_cmd}
  "Road-friction multiplier"
  mu_scale = RealInput() {^mu_scale}
  "Longitudinal tire slip"
  kappa = RealOutput() {^kappa}
  "Vehicle speed"
  v = RealOutput() {^v}
  throttle_limit = BlockComponents.Math.Min() {^throttle_limit}
  engine = VehicleSystemsComponents.HandsOn02.MapEngineFuelCut() {^engine}
  "Crankshaft and flywheel, J as MappedEngine assumes"
  flywheel = RotationalComponents.Components.Inertia(J = 0.15) {^flywheel}
  clutch = VehicleSystemsComponents.Vehicle.CentrifugalClutch() {^clutch}
  variator = VehicleSystemsComponents.Vehicle.ControlledVariator() {^variator}
  supply_command = BlockComponents.Sources.Constant(k = supply_pressure) {^supply_command}
  supply = HydraulicComponents.Sources.BoundaryPressure() {^supply}
  valve_f = VehicleSystemsComponents.Vehicle.Brake.ABSValve() {^valve_f}
  valve_r = VehicleSystemsComponents.Vehicle.Brake.ABSValve() {^valve_r}
  line_f = VehicleSystemsComponents.Vehicle.Brake.BrakeLine() {^line_f}
  line_r = VehicleSystemsComponents.Vehicle.Brake.BrakeLine(L = 4.0) {^line_r}
  wheel = VehicleSystemsComponents.Vehicle.Wheel.HydraulicBrakedWheel(F_z = m * g / 2) {^wheel}
  body = VehicleSystemsComponents.HandsOn.Body(m = m, g = g) {^body}
  "Engine mounts, transmission housing, and brake support"
  housing = RotationalComponents.Components.Fixed() {^housing}
  speed = TranslationalComponents.Sensors.VelocitySensor() {^speed}
  path medium::HydraulicComponents.Interfaces.AbstractMedium = HydraulicComponents.IsothermalCompressible(bulk_modulus = 1.4e9, density = 1045.0, let_gas = false)
  "Vehicle mass; the driven axle carries half of it"
  parameter m::Dyad.Mass = 1400.0
  "Gravitational acceleration"
  parameter g::Acceleration = 9.80665
  "Pressure available from the pump and accumulator"
  parameter supply_pressure::Pressure = 8.9e6
relations
  connect(pedal, throttle_limit.u1, variator.pedal) {^id1}
  connect(u_tcs, throttle_limit.u2) {^id0}
  connect(throttle_limit.y, engine.pedal) {^id00}
  connect(engine.spline, flywheel.spline_a) {^id2}
  connect(flywheel.spline_b, clutch.spline_a) {^id3}
  connect(clutch.spline_b, variator.spline_a) {^id4}
  connect(variator.spline_b, wheel.spline) {^id5}
  connect(engine.support, clutch.support, variator.support, wheel.support, housing.spline) {^id6}
  connect(supply_command.y, supply.p) {^id7}
  connect(supply.port, valve_f.port_a, valve_r.port_a) {^id8}
  connect(valve_f.port_b, line_f.port_a) {^id9}
  connect(line_f.port_b, wheel.front) {^id10}
  connect(valve_r.port_b, line_r.port_a) {^id11}
  connect(line_r.port_b, wheel.rear) {^id12}
  continuity(medium, supply.port.medium)
  connect(p_cmd, valve_f.p_cmd, valve_r.p_cmd) {^id13}
  connect(mu_scale, wheel.mu_scale) {^id14}
  connect(wheel.flange, body.flange, speed.flange) {^id15}
  connect(wheel.kappa, kappa) {^id16}
  connect(speed.v, v) {^id17}
metadata {
  "_links": {
    "pedal": {"Dyad": {"placement": {"diagram": {"x1": -50, "y1": 50, "x2": 50, "y2": 150}}}},
    "u_tcs": {"Dyad": {"placement": {"diagram": {"x1": -50, "y1": 180, "x2": 50, "y2": 280}}}},
    "throttle_limit": {"Dyad": {"placement": {"diagram": {"x1": 50, "y1": 50, "x2": 130, "y2": 130}}}},
