"""
Hands-on 03 step 04 bench: `ABSStop` with only a wheel-speed sensor. `RefSpeedEstimator` turns
the wheel speed into the slip and the vehicle speed the controller reads.
"""
component ABSStopWheelOnly
  "Road-friction multiplier (1 dry, 0.5 wet, 0.3 snow)"
  parameter road_mu::Real = 1.0
  "Deceleration the estimator assumes while the wheel slips"
  parameter a_ref::Acceleration = 8
  "Look-ahead"
  parameter T_p::Time = 0.03
  "Driver's brake demand, 6000 N·m from 0.5 s"
  demand = BlockComponents.Sources.Step(height = 6000, start_time = 0.5) {^demand}
  road = BlockComponents.Sources.Constant(k = road_mu) {^road}
  abs = SlipABS(T_p = T_p) {^abs}
  est = RefSpeedEstimator(a_ref = a_ref) {^est}
  wspeed = RotationalComponents.Sensors.VelocitySensor() {^wspeed}
  wheel = VehicleSystemsComponents.Vehicle.Wheel.BrakedWheel() {^wheel}
  body = VehicleSystemsComponents.HandsOn.Body() {^body}
  fixed = RotationalComponents.Components.Fixed() {^fixed}
  speed = TranslationalComponents.Sensors.VelocitySensor() {^speed}
relations
  connect(demand.y, abs.demand) {^id1}
  connect(abs.tau_cmd, wheel.tau_cmd) {^id5}
  connect(wspeed.spline, wheel.spline) {^id6}
  connect(wspeed.w, est.omega) {^id7}
  connect(est.kappa_hat, abs.kappa) {^id8}
  connect(est.v_ref, abs.v) {^id9}
  connect(road.y, wheel.mu_scale) {^id2}
  connect(wheel.support, fixed.spline) {^id3}
  connect(wheel.flange, body.flange, speed.flange) {^id4}
  initial wheel.brake.tau_actual = 0
  initial wheel.inertia.phi = 0
  initial wheel.inertia.w = 25 / 0.31
  initial body.mass.s = 0
  initial body.mass.v = 25
metadata {
  "Dyad": {
    "tests": {
      "dry": {
        "stop": 6.0,
        "solver": "Tsit5",
        "atol": {"body.mass.s": 0.01, "speed.v": 0.01},
        "expect": {
          "initial": {"speed.v": 25.0, "est.v_ref": 25.0},
          "final": {"body.mass.s": 59.424, "speed.v": 0.0},
          "signals": ["speed.v", "est.v_ref", "wheel.brake.tau_actual"]
        }
      }
    }
  },
  "_links": {
    "demand": {"Dyad": {"placement": {"diagram": {"x1": -100, "y1": 100, "x2": 0, "y2": 200}}}},
    "abs": {"Dyad": {"placement": {"diagram": {"x1": 100, "y1": 100, "x2": 250, "y2": 250}}}},
    "est": {"Dyad": {"placement": {"diagram": {"x1": -100, "y1": 300, "x2": 0, "y2": 400}}}},
    "wspeed": {"Dyad": {"placement": {"diagram": {"x1": -100, "y1": 450, "x2": 0, "y2": 550}}}},
    "road": {"Dyad": {"placement": {"diagram": {"x1": 100, "y1": 600, "x2": 200, "y2": 700}}}},
    "wheel": {"Dyad": {"placement": {"diagram": {"x1": 350, "y1": 350, "x2": 550, "y2": 550}}}},
    "body": {"Dyad": {"placement": {"diagram": {"x1": 750, "y1": 400, "x2": 850, "y2": 500}}}},
    "fixed": {"Dyad": {"placement": {"diagram": {"x1": 400, "y1": 700, "x2": 500, "y2": 800}}}},
    "speed": {"Dyad": {"placement": {"diagram": {"x1": 750, "y1": 200, "x2": 850, "y2": 300}}}},
    "id1": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 50, "y": 150}, {"x": 50, "y": 212}], "E": 2}]}},
    "id5": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 450, "y": 175}], "E": 2}]}},
    "id6": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 200, "y": 500}, {"x": 200, "y": 450}], "E": 2}]}},
    "id7": {"Dyad": {"edges": [{"S": 1, "M": [{"x": -150, "y": 500}, {"x": -150, "y": 350}], "E": 2}]}},
    "id8": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 60, "y": 325}, {"x": 60, "y": 137}], "E": 2}]}},
    "id9": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 80, "y": 375}, {"x": 80, "y": 175}], "E": 2}]}},
    "id2": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 514, "y": 650}], "E": 2}]}},
    "id3": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "id4": {
      "Dyad": {
        "edges": [
          {"S": 1, "M": [], "E": -1},
          {"S": -1, "M": [], "E": 2},
          {"S": -1, "M": [{"x": 650, "y": 250}], "E": 3}
        ],
        "junctions": [{"x": 650, "y": 450}]
      }
    }
  }
}
end

"""
The ABS stop on the wheel speed only. `a_ref` is the estimator's assumed deceleration, the knob of
step 05's trap; `road_mu` and `stop` are the sweep's.
"""
analysis ABSStopWheelOnlyTransient
  extends TransientAnalysis(stop = 6.0, alg = ODEAlg.Tsit5(), dtmax = 1e-3)
  parameter road_mu::Real = 1.0
  parameter a_ref::Acceleration = 8
  parameter T_p::Time = 0.03
  model = ABSStopWheelOnly(road_mu = road_mu, a_ref = a_ref, T_p = T_p)
end
