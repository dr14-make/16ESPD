"""
Hands-on 03 step 04 hydraulic ABS bench using only a wheel-speed sensor. `RefSpeedEstimator`
provides estimated slip, vehicle speed, and wheel acceleration to the three-phase controller.
"""
component ABSStopWheelOnly
  parameter road_mu::Real = 1.0
  parameter a_ref::Acceleration = 8
  parameter pedal::Real = 0.6
  command = BlockComponents.Sources.Step(height = pedal, offset = 0.0, start_time = 0.5) {^command}
  road = BlockComponents.Sources.Constant(k = road_mu) {^road}
  pedal_unit = VehicleSystemsComponents.Vehicle.Brake.BrakePedal() {^pedal_unit}
  booster = VehicleSystemsComponents.Vehicle.Brake.StaticBooster() {^booster}
  master = VehicleSystemsComponents.Vehicle.Brake.TandemMasterCylinder() {^master}
  valve_f = VehicleSystemsComponents.Vehicle.Brake.ABSValve() {^valve_f}
  valve_r = VehicleSystemsComponents.Vehicle.Brake.ABSValve() {^valve_r}
  line_f = VehicleSystemsComponents.Vehicle.Brake.BrakeLine() {^line_f}
  line_r = VehicleSystemsComponents.Vehicle.Brake.BrakeLine(L = 4.0) {^line_r}
  abs = PhaseABS() {^abs}
  est = RefSpeedEstimator(a_ref = a_ref) {^est}
  wspeed = RotationalComponents.Sensors.VelocitySensor() {^wspeed}
  wheel = VehicleSystemsComponents.Vehicle.Wheel.HydraulicBrakedWheel() {^wheel}
  body = VehicleSystemsComponents.HandsOn.Body() {^body}
  fixed = RotationalComponents.Components.Fixed() {^fixed}
  fixed_hydraulic = TranslationalComponents.Components.Fixed() {^fixed_hydraulic}
  speed = TranslationalComponents.Sensors.VelocitySensor() {^speed}
  path medium::HydraulicComponents.Interfaces.AbstractMedium = HydraulicComponents.IsothermalCompressible(bulk_modulus = 1.4e9, density = 1045.0, let_gas = false)
relations
  connect(command.y, pedal_unit.u)
  connect(pedal_unit.rod, booster.input)
  connect(booster.rod_out, master.pushrod)
  connect(pedal_unit.support, booster.support, master.support, fixed_hydraulic.flange)
  connect(master.front, valve_f.port_a)
  connect(valve_f.port_b, line_f.port_a)
  connect(line_f.port_b, wheel.front)
  connect(master.rear, valve_r.port_a)
  connect(valve_r.port_b, line_r.port_a)
  connect(line_r.port_b, wheel.rear)
  continuity(medium, master.front.medium)
  connect(master.p_mc, abs.demand)
  connect(abs.p_cmd, valve_f.p_cmd, valve_r.p_cmd)
  connect(wspeed.spline, wheel.spline)
  connect(wspeed.w, est.omega)
  connect(est.kappa_hat, abs.kappa)
  connect(est.v_ref, abs.v)
  connect(est.a_w, abs.a_w)
  connect(road.y, wheel.mu_scale)
  connect(wheel.support, fixed.spline)
  connect(wheel.flange, body.flange, speed.flange)
  initial wheel.inertia.phi = 0
  initial wheel.inertia.w = 25 / 0.31
  initial body.mass.s = 0
  initial body.mass.v = 25
metadata {
  "_links": {
    "command": {"Dyad": {"placement": {"diagram": {"x1": -150, "y1": 150, "x2": -50, "y2": 250}}}},
    "pedal_unit": {"Dyad": {"placement": {"diagram": {"x1": 20, "y1": 150, "x2": 120, "y2": 250}}}},
    "booster": {"Dyad": {"placement": {"diagram": {"x1": 170, "y1": 150, "x2": 270, "y2": 250}}}},
    "master": {"Dyad": {"placement": {"diagram": {"x1": 320, "y1": 150, "x2": 420, "y2": 250}}}},
    "valve_f": {"Dyad": {"placement": {"diagram": {"x1": 480, "y1": 60, "x2": 580, "y2": 160}}}},
    "valve_r": {"Dyad": {"placement": {"diagram": {"x1": 480, "y1": 250, "x2": 580, "y2": 350}}}},
    "line_f": {"Dyad": {"placement": {"diagram": {"x1": 640, "y1": 60, "x2": 740, "y2": 160}}}},
    "line_r": {"Dyad": {"placement": {"diagram": {"x1": 640, "y1": 250, "x2": 740, "y2": 350}}}},
    "wheel": {"Dyad": {"placement": {"diagram": {"x1": 810, "y1": 110, "x2": 1010, "y2": 310}}}},
    "body": {"Dyad": {"placement": {"diagram": {"x1": 1100, "y1": 160, "x2": 1200, "y2": 260}}}},
    "abs": {"Dyad": {"placement": {"diagram": {"x1": 410, "y1": 500, "x2": 560, "y2": 650}}}},
    "est": {"Dyad": {"placement": {"diagram": {"x1": 200, "y1": 690, "x2": 300, "y2": 790}}}},
    "wspeed": {"Dyad": {"placement": {"diagram": {"x1": 700, "y1": 690, "x2": 800, "y2": 790}}}},
    "speed": {"Dyad": {"placement": {"diagram": {"x1": 1100, "y1": 20, "x2": 1200, "y2": 120}}}},
    "road": {"Dyad": {"placement": {"diagram": {"x1": 900, "y1": 500, "x2": 1000, "y2": 600}}}},
    "fixed": {"Dyad": {"placement": {"diagram": {"x1": 850, "y1": 690, "x2": 950, "y2": 790}}}},
    "fixed_hydraulic": {"Dyad": {"placement": {"diagram": {"x1": 50, "y1": 500, "x2": 150, "y2": 600}}}}
  }
}
end

analysis ABSStopWheelOnlyTransient
  extends TransientAnalysis(stop = 6.0, alg = ODEAlg.Tsit5(), dtmax = 1e-3)
  parameter road_mu::Real = 1.0
  parameter a_ref::Acceleration = 8
  model = ABSStopWheelOnly(road_mu = road_mu, a_ref = a_ref)
end
