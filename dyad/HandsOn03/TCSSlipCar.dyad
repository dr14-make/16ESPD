"""Hands-on 1's slipping-wheel car with an in-line brake for traction control."""
component TCSSlipCar
  "Commanded engine torque"
  tau_cmd = RealInput() {^tau_cmd}
  "Commanded TCS brake torque"
  tau_tcs = RealInput() {^tau_tcs}
  "Road gradient, tan(alpha)"
  grade = RealInput() {^grade}
  "Road-friction multiplier"
  mu_scale = RealInput() {^mu_scale}
  "Vehicle speed in km/h"
  v_kmh = RealOutput() {^v_kmh}
  "Wheel surface speed, omega * radius, in km/h"
  wheel_kmh = RealOutput() {^wheel_kmh}
  "Longitudinal tire slip"
  kappa = RealOutput() {^kappa}
  engine = VehicleSystemsComponents.HandsOn.Engine(theta_e = theta_e, T_max = T_max) {^engine}
  gear = RotationalComponents.Components.IdealGear(ratio = i) {^gear}
  wheel_inertia = RotationalComponents.Components.Inertia(J = J_w) {^wheel_inertia}
  brake = VehicleSystemsComponents.Vehicle.Wheel.BrakeActuator() {^brake}
  wheel = VehicleSystemsComponents.HandsOn.SlipWheel1D(radius = r, F_z = m * g / 2) {^wheel}
  body = VehicleSystemsComponents.HandsOn.GradeBody(m = m, CdA = CdA, g = g) {^body}
  vsensor = TranslationalComponents.Sensors.VelocitySensor() {^vsensor}
  to_kmh = BlockComponents.Math.Gain(k = 3.6) {^to_kmh}
  wsensor = RotationalComponents.Sensors.VelocitySensor() {^wsensor}
  wheel_to_kmh = BlockComponents.Math.Gain(k = r * 3.6) {^wheel_to_kmh}
  "Engine, gearbox, and brake housing"
  rot_ground = RotationalComponents.Components.Fixed() {^rot_ground}
  "Injection-to-torque transport delay"
  structural parameter theta_e::Time = 0.3
  "Peak deliverable torque"
  parameter T_max::Torque = 150
  "Gear ratio"
  parameter i::Real = 4.0
  "Road wheel and tire inertia"
  parameter J_w::MomentOfInertia = 1.0
  "Wheel rolling radius"
  parameter r::Length = 0.31
  "Vehicle mass; the driven axle carries half of it"
  parameter m::Dyad.Mass = 1400
  "Aerodynamic drag area, Cd * A"
  parameter CdA::Area = 0.63
  "Gravitational acceleration"
  parameter g::Acceleration = 9.80665
relations
  connect(tau_cmd, engine.tau_cmd) {^id1}
  connect(tau_tcs, brake.tau_cmd) {^id2}
  connect(engine.spline, gear.spline_a) {^id3}
  connect(gear.spline_b, wheel_inertia.spline_a) {^id4}
  connect(wheel_inertia.spline_b, brake.spline_a) {^id5}
  connect(brake.spline_b, wheel.spline) {^id6}
  connect(engine.support, gear.support, brake.support, rot_ground.spline) {^id7}
  connect(wheel.flange, body.flange) {^id8}
  connect(grade, body.grade) {^id9}
  connect(mu_scale, wheel.mu_scale) {^id10}
  connect(vsensor.flange, wheel.flange) {^id11}
  connect(vsensor.v, to_kmh.u) {^id12}
  connect(to_kmh.y, v_kmh) {^id13}
  connect(wsensor.spline, wheel.spline) {^id14}
  connect(wsensor.w, wheel_to_kmh.u) {^id15}
  connect(wheel_to_kmh.y, wheel_kmh) {^id16}
  kappa = wheel.kappa
