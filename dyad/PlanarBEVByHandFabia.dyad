"By-hand planar BEV whose speed, motor speed and ABS activity drive a Fabia cluster over SocketCAN."
component PlanarBEVByHandFabia
  parameter m::Mass = 1500.0
  parameter esp_on::Real = 1.0
  parameter abs_on::Real = 1.0
  parameter mu::Real = 1.0
  "Displayed rpm divided by machine rpm"
  parameter tachometer_scale::Real = 0.5
  parameter dimming::Real = 1.0
  "Speed conditioning for the deceleration estimate"
  parameter speed_filter_time::Time = 0.15
  parameter emergency_deceleration::Real = 6.0
  parameter emergency_min_speed::Real = 5.0
  parameter hazard_charge_time::Time = 0.05
  "Decay from a fully charged hold to 0.1 takes about 6.9 seconds"
  parameter hazard_decay_time::Time = 3.0
  structural parameter road_file::String = "dyad://VehicleSystemsComponents/roads/uniform_mu.crg"
  structural parameter height_file::String = "dyad://VehicleSystemsComponents/roads/flat_z.crg"
  structural parameter default_grip::Real = 1.0
  structural parameter default_height::Length = 0.0
  structural parameter blend_width::Length = 2.0
  driver = VehicleSystemsComponents.Vehicle.Planar.FabiaHumanDriver() {^driver}
  vehicle = VehicleSystemsComponents.Vehicle.Planar.FabiaRoadVehicle(road_file = road_file, height_file = height_file, default_grip = default_grip, default_height = default_height, blend_width = blend_width, m = m, esp_on = esp_on, abs_on = abs_on, mu = mu) {^vehicle}
  display = VehicleSystemsComponents.Vehicle.Planar.FabiaCluster(dimming = dimming) {^display}
  speed_limit = BlockComponents.Nonlinear.Limiter(y_min = 0.0, y_max = 1e300) {^speed_limit}
  motor_abs = BlockComponents.Math.Abs() {^motor_abs}
  rpm_gain = BlockComponents.Math.Gain(k = 60.0 / (2.0 * 3.141592653589793)) {^rpm_gain}
  rpm_scale = BlockComponents.Math.Gain(k = tachometer_scale) {^rpm_scale}
  rpm_limit = BlockComponents.Nonlinear.Limiter(y_min = 0.0, y_max = 6000.0) {^rpm_limit}
  emergency_hazard = VehicleSystemsComponents.Vehicle.Planar.EmergencyHazard(speed_filter_time = speed_filter_time, emergency_deceleration = emergency_deceleration, emergency_min_speed = emergency_min_speed, hazard_charge_time = hazard_charge_time, hazard_decay_time = hazard_decay_time) {^emergency_hazard}
  abs_active = BlockComponents.Logical.GreaterThreshold(threshold = 0.5) {^abs_active}
  flash_sine = BlockComponents.Sources.Sine(amplitude = 1.0, frequency = 2.5) {^flash_sine}
  flash_positive = BlockComponents.Logical.GreaterThreshold(threshold = 0.0) {^flash_positive}
  esp_flash = BlockComponents.Logical.And() {^esp_flash}
  coolant = BlockComponents.Sources.Constant(k = 90.0) {^coolant}
  off = BlockComponents.Sources.BooleanConstant(k = false) {^off}
relations
  connect(driver.throttle_signal, vehicle.throttle) {^w1}
  connect(driver.brake_signal, vehicle.brake) {^w2}
  connect(driver.steer_signal, vehicle.steer) {^w3}
  connect(vehicle.speed, speed_limit.u, emergency_hazard.speed) {^w4}
  connect(speed_limit.y, display.speed) {^w5}
  connect(vehicle.motor_speed, motor_abs.u) {^w6}
  connect(motor_abs.y, rpm_gain.u) {^w7}
  connect(rpm_gain.y, rpm_scale.u) {^w8}
  connect(rpm_scale.y, rpm_limit.u) {^w9}
  connect(rpm_limit.y, display.rpm) {^w10}
  connect(emergency_hazard.y, display.hazard) {^w11}
  connect(vehicle.abs_active, abs_active.u) {^w12}
  connect(abs_active.y, esp_flash.u1) {^w13}
  connect(flash_sine.y, flash_positive.u) {^w14}
  connect(flash_positive.y, esp_flash.u2) {^w15}
  connect(esp_flash.y, display.asr_lamp) {^w16}
  connect(coolant.y, display.coolant) {^w17}
  connect(off.y, display.left, display.right, display.abs_lamp, display.brake_lamp, display.mil, display.epc, display.charging, display.airbag_lamp) {^w18}
