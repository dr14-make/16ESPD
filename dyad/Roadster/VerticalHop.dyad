"Open-loop full-thrust hop followed by ballistic coast."
test component TestVerticalHop
  hop = VehicleSystemsComponents.Roadster.VerticalHop(m = m, tank_volume = tank_volume, tank_pressure = tank_pressure, A_t = A_t, contact_c = contact_c, contact_d = contact_d)
  "Full-thrust burn duration"
  parameter t_b::Time = 0.5
  parameter m::Dyad.Mass = 2000
  parameter tank_volume::Volume = 0.6
  parameter tank_pressure::Pressure = 380e5
  parameter A_t::Area = 1.286e-3
  "Hop landing stiffness, selected to limit penetration below 50 mm in the presentation sweep"
  parameter contact_c::TranslationalSpringConstant = 2.0e8
  "Hop landing damping, selected to suppress rebound in the presentation sweep"
  parameter contact_d::TranslationalDampingConstant = 4.0e6
relations
  hop.command = ifelse(time < t_b, 1.0, 0.0)
end

"PI altitude hold from rest, including a gravity feed-forward valve command."
test component TestVerticalHover
  hover = VehicleSystemsComponents.Roadster.VerticalHop(m = m, tank_volume = tank_volume, tank_pressure = tank_pressure, A_t = A_t)
  "Car mass"
  parameter m::Dyad.Mass = 2000
  "Initial tank pressure"
  parameter tank_pressure::Pressure = 380e5
  "Tank volume"
  parameter tank_volume::Volume = 0.6
  "Total nozzle throat area"
  parameter A_t::Area = 1.286e-3
  "Altitude target"
  parameter target::Length = 2.0
  "Proportional valve gain; assumed"
  parameter k_p::Real(units = "1/m") = 0.15
  "Integral valve gain; assumed"
  parameter k_i::Real(units = "1/(m.s)") = 0.2
  "Vertical-speed damping gain used with the altitude PI; assumed"
  parameter k_v::Real(units = "s/m") = 0.2
  "Full-open thrust at the initial pressure; the 80 kN design point at 380 bar, scaled with pressure because choked thrust is nearly proportional to it"
  final parameter F_full::Force = 80000 * tank_pressure / 380e5
  variable integral_error::Real(units = "m.s")
  variable unsaturated_command::Real
relations
  initial integral_error = 0
  der(integral_error) = target - hover.altitude
  unsaturated_command = m * hover.g / F_full + k_p * (target - hover.altitude) + k_i * integral_error - k_v * hover.body.v
  hover.command = max(0, min(1, unsaturated_command))
end

analysis Hop
  # Symbolic discontinuity detection freezes the unilateral contact on stale branches after
  # landing. Numerical evaluation resolves the valve cutoff and contact law deterministically.
  extends TransientAnalysis(stop = 10.0, abstol = 1e-8, reltol = 1e-6,
                            automatic_discontinuity_detection = false)
  parameter t_b::Time = 0.5
  parameter m::Dyad.Mass = 2000
  parameter tank_volume::Volume = 0.6
  parameter tank_pressure::Pressure = 380e5
  parameter A_t::Area = 1.286e-3
  model = VehicleSystemsComponents.Roadster.TestVerticalHop(t_b = t_b, m = m, tank_volume = tank_volume, tank_pressure = tank_pressure, A_t = A_t)
end

analysis Hover
  # Symbolic discontinuity detection can freeze the unilateral contact on the wrong branch
  # across repeated solves. Numerical evaluation of the contact law is deterministic here.
  extends TransientAnalysis(stop = 15.0, abstol = 1e-8, reltol = 1e-6,
                            automatic_discontinuity_detection = false)
  parameter m::Dyad.Mass = 2000
  parameter tank_volume::Volume = 0.6
  parameter tank_pressure::Pressure = 380e5
  parameter A_t::Area = 1.286e-3
  parameter target::Length = 2.0
  parameter k_p::Real(units = "1/m") = 0.15
  parameter k_i::Real(units = "1/(m.s)") = 0.2
  parameter k_v::Real(units = "s/m") = 0.2
  model = VehicleSystemsComponents.Roadster.TestVerticalHover(m = m, tank_volume = tank_volume, tank_pressure = tank_pressure, A_t = A_t, target = target, k_p = k_p, k_i = k_i, k_v = k_v)
end
