    "id7": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 800, "y": 430}], "E": 2}], "path": {}}},
    "id8": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 730, "y": 530}], "E": 2}], "path": {}}},
    "id9": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
