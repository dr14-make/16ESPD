test component TestRoadsterLaunch
  launch = VehicleSystemsComponents.Roadster.RoadsterLaunch()
metadata {
  "Dyad": {
    "tests": {
      "rear_wheel_drive": {
        "stop": 4,
        "params": {"launch.share": 0.55, "launch.h_over_L": 0.17},
        "atol": {"launch.v": 0.02, "launch.wheel.kappa": 0.001},
        "expect": {
          "initial": {"launch.v": 0, "launch.wheel.kappa": 0},
          "final": {"launch.v": 32.18359, "launch.wheel.kappa": 0.034254},
          "signals": ["launch.v", "launch.wheel.kappa"]
        }
      },
      "all_wheel_drive": {
        "stop": 4,
        "params": {"launch.share": 1, "launch.h_over_L": 0},
        "atol": {"launch.v": 0.02, "launch.wheel.kappa": 0.001},
        "expect": {
          "initial": {"launch.v": 0, "launch.wheel.kappa": 0},
          "final": {"launch.v": 46.44041, "launch.wheel.kappa": 0.026170},
          "signals": ["launch.v", "launch.wheel.kappa"]
        }
      },
      "suction_rear_wheel_drive": {
        "stop": 2,
        "params": {"launch.fan_cmd": 1, "launch.share": 0.55, "launch.h_over_L": 0.17},
        "expect": {
          "initial": {"launch.fan.dp": 11522.81375},
          "final": {"launch.fan.dp": 11522.81375}
        },
        "atol": {"launch.fan.dp": 0.1}
      },
      "suction_all_wheel_drive": {
        "stop": 2,
        "params": {"launch.fan_cmd": 1, "launch.share": 1, "launch.h_over_L": 0},
        "expect": {
          "initial": {"launch.fan.dp": 11522.81375},
          "final": {"launch.fan.dp": 11522.81375}
        },
        "atol": {"launch.fan.dp": 0.1}
      }
    }
  }
}
end


analysis RoadsterLaunchTransient
  extends TransientAnalysis(stop = 6.0, abstol = 1e-8, reltol = 1e-6)
  "Vehicle mass"
  parameter m::Dyad.Mass = 2000
  "Aerodynamic drag area, Cd * A; assumed"
  parameter CdA::Area = 0.6
  "Rated power"
  parameter P_max::Power = 1.0e6
  "Peak wheel torque"
  parameter T_max::Torque = 12000
  "Normalized suction-fan command"
  parameter fan_cmd::Real = 0.0
  "Effective skirt gap; assumed"
  parameter skirt_gap::Length = 0.003
  "Normalized rear-thrust valve command"
  parameter thrust_cmd::Real = 0.0
  "Compressed-air tank volume"
  parameter tank_volume::Volume = 0.6
  "Initial compressed-air pressure"
  parameter tank_pressure::Pressure = 380e5
  "Tank polytropic index"
  parameter tank_n::Real = 1.4
  "Total nozzle throat area"
  parameter A_t::Area = 1.286e-3
  "Share of thrust directed downward"
  parameter down_fraction::Real = 0.0
  "Peak tire adhesion"
  parameter mu_A::Real = 1.26
  "Static fraction of weight on the driven axle; 1 for all-wheel drive"
  parameter share::Real = 0.55
  "Center-of-mass height over wheelbase; 0 for all-wheel drive"
  parameter h_over_L::Real = 0.17
  model = VehicleSystemsComponents.Roadster.RoadsterLaunch(m = m, CdA = CdA, P_max = P_max, T_max = T_max, fan_cmd = fan_cmd, skirt_gap = skirt_gap, thrust_cmd = thrust_cmd, tank_volume = tank_volume, tank_pressure = tank_pressure, tank_n = tank_n, A_t = A_t, down_fraction = down_fraction, mu_A = mu_A, share = share, h_over_L = h_over_L)
relations
end
