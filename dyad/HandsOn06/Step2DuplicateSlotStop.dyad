test component Step2DuplicateSlotStop
  extends WiringStop(networked = true, ideal = false)
  duplicate = VehicleSystemsComponents.Vehicle.Planar.CanTxReal(slot = 6, id = 273, ideal = true, scale = 0.1, raw_min = -32768, raw_max = 32767) {^duplicate}
relations
  connect(ecu.regen, duplicate.u) {^duplicate_input}
  connect(duplicate.bus, ecu.bus) {^duplicate_bus}
metadata {
  "_links": {
    "duplicate": {"Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 50, "y2": 100}}}},
    "duplicate_input": {"Dyad": {"edges": [{"S": 1, "E": 2, "M": [{"x": 880, "y": 400}, {"x": 880, "y": 120}, {"x": 280, "y": 120}, {"x": 280, "y": 75}]}]}},
    "duplicate_bus": {"Dyad": {"edges": [{"S": 1, "E": 2, "M": [{"x": 350, "y": 30}, {"x": 750, "y": 30}]}]}}
  }
}
end

analysis Step2DuplicateSlotStopTransient
  extends TransientAnalysis(stop = 6, dtmax = 0.005, reltol = 1e-7, optimize = OptimizationLevel.None())
  model = Step2DuplicateSlotStop()
end
