"Finished manual regen sender/receiver repair; historical exercise name retained."
test component PedalMessageStop
  extends WiringStop(networked = true, drive_networked = true, transmit_regen = true, receive_regen = true, ideal = true)
end

analysis PedalMessageStopTransient
  extends TransientAnalysis(stop = 6, alg = ODEAlg.Rodas5P(), dtmax = 0.005, tstops = [0.5, 0.6], optimize = OptimizationLevel.None(), abstol = 1e-9, reltol = 1e-9)
  model = PedalMessageStop()
end
