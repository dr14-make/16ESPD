"40 ms period comparison, not a bitrate simulation; use can_schedule for Step 4."
test component Step4SlowCanStop
  extends WiringStop(networked = true, ideal = false, chassis_period = 0.04)
end

analysis Step4SlowCanStopTransient
  extends TransientAnalysis(stop = 6, alg = ODEAlg.Rodas5P(), dtmax = 0.005, tstops = [0.5, 0.6], optimize = OptimizationLevel.None(), abstol = 1e-9, reltol = 1e-9)
  model = Step4SlowCanStop()
end
