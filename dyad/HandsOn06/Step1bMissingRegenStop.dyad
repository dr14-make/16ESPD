"Step 1b starter: the brake ECU does not send the regen request yet; a direct wire stands in."
test component Step1bMissingRegenStop
  extends WiringStop(networked = true, drive_networked = false, transmit_regen = false, receive_regen = true, ideal = true)
relations
  connect(ecu.regen, drive.regen) {^bypass}
metadata {
  "_links": {
    "bypass": {
      "Dyad": {
        "edges": [
          {
            "S": 1,
            "E": 2,
            "M": [
              {
                "x": 515.0,
                "y": 320
              },
              {
                "x": 424.0,
                "y": 320
              }
            ]
          }
        ],
        "renderStyle": "standard"
      }
    }
  }
}
end

analysis Step1bMissingRegenStopTransient
  extends TransientAnalysis(stop = 6, alg = ODEAlg.Rodas5P(), dtmax = 0.005, tstops = [0.5, 0.6], optimize = OptimizationLevel.None(), abstol = 1e-9, reltol = 1e-9)
  model = Step1bMissingRegenStop()
end
