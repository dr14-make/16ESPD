component WiringBrakeNode
  bus = VehicleSystemsComponents.Vehicle.Planar.CanNet() {^bus}
  omega_fl = RealInput(units = "rad/s") {^omega_fl}
  omega_fr = RealInput(units = "rad/s") {^omega_fr}
  omega_rl = RealInput(units = "rad/s") {^omega_rl}
  omega_rr = RealInput(units = "rad/s") {^omega_rr}
  tau_fl = RealOutput() {^tau_fl}
  tau_fr = RealOutput() {^tau_fr}
  tau_rl = RealOutput() {^tau_rl}
  tau_rr = RealOutput() {^tau_rr}
  structural parameter ideal::Boolean = false
  structural parameter speed_period::Real = 0.01
  structural parameter abs_period::Real = 0.01
  structural parameter wheel_period::Real = 0.01
  parameter esp_on::Real = 1
  parameter abs_on::Real = 1
  parameter radius::Length = 0.31
  parameter T_full::Torque = 2500
  ecu = VehicleSystemsComponents.Vehicle.Planar.BrakeControlUnit(report_front = true, esp_on = esp_on, abs_on = abs_on, radius = radius, T_max = T_full) {^ecu}
  abs_tx = VehicleSystemsComponents.Vehicle.Planar.CanTxReal(slot = 5, id = 112, ideal = ideal, period = abs_period, scale = 1, raw_min = 0, raw_max = 1) {^abs_tx}
  estimator = VehicleSystemsComponents.Vehicle.Planar.BrakeWheelEstimator(radius = radius) {^estimator}
  abs_hold = VehicleSystemsComponents.Vehicle.Planar.AbsControlHold() {^abs_hold}
  speed_tx = VehicleSystemsComponents.Vehicle.Planar.CanTxReal(slot = 1, id = 128, ideal = ideal, period = speed_period, scale = 0.01, raw_min = -32768, raw_max = 32767) {^speed_tx}
  wheel_fl_tx = VehicleSystemsComponents.Vehicle.Planar.CanTxReal(slot = 8, id = 176, ideal = ideal, period = wheel_period, scale = 0.01, raw_min = -32768, raw_max = 32767) {^wheel_fl_tx}
  wheel_fr_tx = VehicleSystemsComponents.Vehicle.Planar.CanTxReal(slot = 9, id = 177, ideal = ideal, period = wheel_period, scale = 0.01, raw_min = -32768, raw_max = 32767) {^wheel_fr_tx}
  wheel_rl_tx = VehicleSystemsComponents.Vehicle.Planar.CanTxReal(slot = 10, id = 178, ideal = ideal, period = wheel_period, scale = 0.01, raw_min = -32768, raw_max = 32767) {^wheel_rl_tx}
  wheel_rr_tx = VehicleSystemsComponents.Vehicle.Planar.CanTxReal(slot = 11, id = 179, ideal = ideal, period = wheel_period, scale = 0.01, raw_min = -32768, raw_max = 32767) {^wheel_rr_tx}
  steering_angle_rx = VehicleSystemsComponents.Vehicle.Planar.CanRxReal(slot = 2, id = 144) {^steering_angle_rx}
  yaw_rate_rx = VehicleSystemsComponents.Vehicle.Planar.CanRxReal(slot = 3, id = 160) {^yaw_rate_rx}
  friction_demand_rx = VehicleSystemsComponents.Vehicle.Planar.CanRxReal(slot = 4, id = 256) {^friction_demand_rx}
  structural parameter networked::Boolean = false
  demand = RealInput() {^demand}
  demand_route = BlockComponents.Math.Gain(k = 1.0) {^demand_route}
  steering = RealInput() {^steering}
  yaw = RealInput() {^yaw}
  speed = RealOutput() {^speed}
  active = RealOutput() {^active}
relations
  connect(bus, steering_angle_rx.bus, yaw_rate_rx.bus, friction_demand_rx.bus, speed_tx.bus, wheel_fl_tx.bus, wheel_fr_tx.bus, wheel_rl_tx.bus, wheel_rr_tx.bus) {^network}
  if networked
    demand_route.u = friction_demand_rx.y
    demand = 0
  else
    demand_route.u = demand
  end
  connect(demand_route.y, ecu.demand, abs_hold.demand) {^hold_demand}
  connect(estimator.vx, ecu.vx, speed_tx.u, abs_hold.vx) {^wire_speed}
  if networked
    ecu.delta_sw = steering_angle_rx.y
    steering = 0
  else
    ecu.delta_sw = steering
  end
  if networked
    ecu.r = yaw_rate_rx.y
    yaw = 0
  else
    ecu.r = yaw
  end
  connect(estimator.kappa_fl, ecu.kappa_fl) {^slip_fl}
  connect(omega_fl, estimator.omega_fl, wheel_fl_tx.u) {^wheel_fl}
  connect(estimator.kappa_fr, ecu.kappa_fr) {^slip_fr}
  connect(omega_fr, estimator.omega_fr, wheel_fr_tx.u) {^wheel_fr}
  connect(estimator.kappa_rl, ecu.kappa_rl) {^slip_rl}
  connect(omega_rl, estimator.omega_rl, wheel_rl_tx.u) {^wheel_rl}
  connect(estimator.kappa_rr, ecu.kappa_rr) {^slip_rr}
  connect(omega_rr, estimator.omega_rr, wheel_rr_tx.u) {^wheel_rr}
  connect(ecu.tau_fl, tau_fl) {^torque_fl}
  connect(ecu.tau_fr, tau_fr) {^torque_fr}
  connect(ecu.tau_rl, tau_rl) {^torque_rl}
  connect(ecu.tau_rr, tau_rr) {^torque_rr}
  connect(ecu.front_active, abs_hold.active) {^abs_state}
  connect(abs_hold.y, abs_tx.u) {^abs_held}
  connect(bus, abs_tx.bus) {^abs_bus}
  connect(estimator.vx, speed) {^direct_speed}
  connect(abs_hold.y, active) {^direct_active}
metadata {
  "_links": {
    "abs_hold": {
      "Dyad": {
        "placement": {
          "diagram": {
            "x1": 470,
            "x2": 570,
            "y1": 820,
            "y2": 900
          }
        }
      }
    },
    "abs_held": {
      "Dyad": {
        "edges": [
          {
            "E": 2,
            "M": [
              {
