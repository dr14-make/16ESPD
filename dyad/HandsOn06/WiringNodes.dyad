"VCU: accelerator stays local; only the ECU's negative regen request travels on CAN."
component WiringDriveNode
  bus = VehicleSystemsComponents.Vehicle.Planar.CanNet() {^bus}
  accelerator_request = RealInput() {^accelerator_request}
  regen = RealInput() {^regen}
  spline = Spline() {^spline}
  support = Spline() {^support}
  structural parameter networked::Boolean = false
  structural parameter receive_regen::Boolean = true
  structural parameter ideal::Boolean = true
  parameter ratio::Real = 8.193
  parameter P_aux::Power = 300
  parameter T_receive::Time = 0.01
  drive = VehicleSystemsComponents.Vehicle.Electric.ElectricDrive(ratio = ratio, P_aux = P_aux) {^drive}
  response = BlockComponents.Continuous.FirstOrder(T = T_receive) {^response}
  regen_rx = VehicleSystemsComponents.Vehicle.Planar.CanRxReal(slot = 6, id = 272) if receive_regen {^regen_rx}
  "Networked passes the CAN regen request; otherwise the wired one"
  network_select = VehicleSystemsComponents.Vehicle.ParameterSwitch(on = networked) {^network_select}
  "Ideal passes the selected request; otherwise the conditioned one"
  response_select = VehicleSystemsComponents.Vehicle.ParameterSwitch(on = ideal) {^response_select}
  request_sum = BlockComponents.Math.Add() {^request_sum}
relations
  if receive_regen
    connect(regen_rx.bus, bus) {^receive_bus}
    connect(regen_rx.y, network_select.u1) {^regen_can}
  else
    network_select.u1 = 0
  end
  if networked
    regen = 0
  end
  connect(regen, network_select.u2) {^regen_wired}
  connect(network_select.y, response.u, response_select.u1) {^selected}
  connect(response.y, response_select.u2) {^conditioned}
  connect(accelerator_request, request_sum.u1) {^accelerator}
  connect(response_select.y, request_sum.u2) {^regen_request}
  connect(request_sum.y, drive.tau_ref) {^request}
  initial response.x = 0
  connect(drive.spline, spline) {^shaft}
  connect(drive.support, support) {^mount}
metadata {
