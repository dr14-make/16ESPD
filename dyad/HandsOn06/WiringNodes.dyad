component WiringDriveNode
  bus = VehicleSystemsComponents.Vehicle.Planar.CanNet() {^bus}
  spline = Spline() {^spline}
  support = Spline() {^support}
  structural parameter ideal::Boolean = false
  parameter ratio::Real = 8.193
  parameter P_aux::Power = 300
  "Receiver conditioning keeps the inverter request continuous above base speed"
  parameter T_receive::Time = 0.01
  drive = VehicleSystemsComponents.Vehicle.Electric.ElectricDrive(ratio = ratio, P_aux = P_aux) {^drive}
  response = BlockComponents.Continuous.FirstOrder(T = T_receive) if !ideal {^response}
  motor_request_rx = VehicleSystemsComponents.Vehicle.Planar.CanRxReal(slot = 6, id = 272) {^motor_request_rx}
  structural parameter networked::Boolean = false
  variable selected::Real
  torque = RealInput() {^torque}
relations
  connect(bus, motor_request_rx.bus) {^drive_wire_1}
  if ideal
    drive.tau_ref = selected
  else
    response.u = selected
    drive.tau_ref = response.y
    initial response.x = 0
  end
  connect(drive.spline, spline) {^drive_wire_2}
  connect(drive.support, support) {^drive_wire_3}
  if networked
    selected = motor_request_rx.y
    torque = 0
  else
    selected = torque
  end
