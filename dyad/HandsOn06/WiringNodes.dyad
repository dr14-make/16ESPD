"Shared expanded physical canvas. Exercise models inherit these top-level nodes and placements."
partial component WiringStop
  throttle = BlockComponents.Sources.Constant(k = 0) {^throttle}
  brake = BlockComponents.Sources.Ramp(height = 1, duration = 0.1, start_time = 0.5) {^brake}
  steer = BlockComponents.Sources.Constant(k = 0) {^steer}
  structural parameter networked::Boolean = true
  structural parameter drive_networked::Boolean = networked
  structural parameter transmit_regen::Boolean = true
  structural parameter receive_regen::Boolean = true
  structural parameter ideal::Boolean = true
  structural parameter chassis_period::Real = 0.01
  structural parameter regen_period::Real = chassis_period
  structural parameter dashboard_period::Real = 0.1
  parameter T_actuator::Time = 0.05
  parameter esp_on::Real = 1
  parameter abs_on::Real = 1
  parameter mu::Real = 1
  parameter m::Mass = 1500
  parameter radius::Length = 0.31
  parameter T_full::Torque = 2500
  parameter tau_max::Torque = 320
  parameter ratio::Real = 8.193
  parameter P_charge::Power = 80.5e3
  parameter v_fade::Real = 10
  parameter P_aux::Power = 300
  parameter v0::Velocity = 22.22222222222222
  parameter dv_wheel::Velocity = 0.01
  accelerator_gain = BlockComponents.Math.Gain(k = tau_max) {^accelerator_gain}
  brake_gain = BlockComponents.Math.Gain(k = -4.0 * T_full / ratio) {^brake_gain}
  accelerator_response = BlockComponents.Continuous.FirstOrder(T = T_actuator) {^accelerator_response}
  brake_response = BlockComponents.Continuous.FirstOrder(T = T_actuator) {^brake_response}
  steering_response = BlockComponents.Continuous.FirstOrder(T = T_actuator) {^steering_response}
  robot = VehicleSystemsComponents.Vehicle.Planar.SteeringRobot() {^robot}
  ecu = WiringBrakeNode(networked = networked, transmit_regen = transmit_regen, ideal = ideal, abs_period = chassis_period, wheel_period = chassis_period, speed_period = chassis_period, regen_period = regen_period, esp_on = esp_on, abs_on = abs_on, radius = radius, T_full = T_full, ratio = ratio, tau_max = tau_max, P_charge = P_charge, v_fade = v_fade) {^ecu}
  drive = WiringDriveNode(networked = drive_networked, receive_regen = receive_regen, ideal = ideal, ratio = ratio, P_aux = P_aux) {^drive}
  differential = MultibodyComponents.PlanarMechanics.DifferentialGear() {^differential}
  mount = RotationalComponents.Components.Fixed() {^mount}
  car = VehicleSystemsComponents.Vehicle.Planar.PlanarCar(mu_scale_fl = mu, mu_scale_fr = mu, mu_scale_rl = mu, mu_scale_rr = mu, m = m, radius = radius, tau_max = T_full) {^car}
  roadload = VehicleSystemsComponents.Vehicle.Planar.PlanarRoadLoad(m = m) {^roadload}
  flat = BlockComponents.Sources.Constant(k = 0) {^flat}
  motion = WiringSensorNode(ideal = ideal, steering_period = chassis_period, yaw_period = chassis_period, dashboard_period = dashboard_period) {^motion}
  cluster = VehicleSystemsComponents.Vehicle.Planar.CanClusterNode() {^cluster}
  wheel_speeds = VehicleSystemsComponents.Vehicle.Planar.BusWheelSpeed() {^wheel_speeds}
relations
  connect(motion.bus, ecu.bus, drive.bus, cluster.bus) {^network}
  connect(car.bus, motion.measurements, wheel_speeds.bus) {^measurements}
  connect(throttle.y, accelerator_gain.u) {^accelerator_pedal}
  connect(accelerator_gain.y, accelerator_response.u) {^accelerator_filter}
  connect(accelerator_response.y, drive.accelerator_request) {^local_accelerator}
  connect(brake.y, brake_gain.u) {^brake_pedal}
  connect(brake_gain.y, brake_response.u) {^brake_filter}
  connect(brake_response.y, ecu.brake_request) {^local_brake}
  connect(steer.y, steering_response.u) {^steering_filter}
  connect(steering_response.y, robot.delta_sw_ref) {^steering_request}
  connect(robot.steering, car.steering) {^steering_mechanical}
  connect(drive.spline, differential.flange_b) {^shaft}
  connect(differential.flange_left, car.spin_fl) {^shaft_fl}
  connect(differential.flange_right, car.spin_fr) {^shaft_fr}
  connect(drive.support, mount.spline) {^mount_wire}
  connect(wheel_speeds.omega_fl, ecu.omega_fl) {^wheel_fl}
  connect(wheel_speeds.omega_fr, ecu.omega_fr) {^wheel_fr}
  connect(wheel_speeds.omega_rl, ecu.omega_rl) {^wheel_rl}
  connect(wheel_speeds.omega_rr, ecu.omega_rr) {^wheel_rr}
  connect(ecu.tau_fl, car.tau_fl) {^caliper_fl}
  connect(ecu.tau_fr, car.tau_fr) {^caliper_fr}
  connect(ecu.tau_rl, car.tau_rl) {^caliper_rl}
  connect(ecu.tau_rr, car.tau_rr) {^caliper_rr}
  connect(flat.y, roadload.grade) {^grade}
  connect(car.chassis, roadload.chassis) {^road}
  initial car.body.r = [0, 0]
  initial car.body.v = [v0, 0]
  initial car.body.phi = 0
  initial car.body.w = 0
  initial car.fl.inertia.w = (v0 + dv_wheel) / radius
  initial car.fr.inertia.w = (v0 + dv_wheel) / radius
  initial car.rl.inertia.w = (v0 + dv_wheel) / radius
  initial car.rr.inertia.w = (v0 + dv_wheel) / radius
  initial car.fl.inertia.phi = 0
  initial car.fr.inertia.phi = 0
  initial car.rl.inertia.phi = 0
  initial car.rr.inertia.phi = 0
  initial car.fl.brake.tau_actual = 0
  initial car.fr.brake.tau_actual = 0
  initial car.rl.brake.tau_actual = 0
  initial car.rr.brake.tau_actual = 0
  initial drive.drive.converter.i_out = 0
  initial accelerator_response.x = 0
  initial brake_response.x = 0
  initial steering_response.x = 0
metadata {
