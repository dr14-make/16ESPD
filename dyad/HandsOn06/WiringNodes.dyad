"Dual-mode motion sender: local steering/yaw wires can be replaced by messages."
component WiringSensorNode
  measurements = VehicleSystemsComponents.Vehicle.Planar.CarBusIn() {^measurements}
  bus = VehicleSystemsComponents.Vehicle.Planar.CanNet() {^bus}
  steering = RealOutput() {^steering}
  yaw = RealOutput() {^yaw}
  structural parameter ideal::Boolean = true
  structural parameter steering_period::Real = 0.01
  structural parameter yaw_period::Real = 0.01
  structural parameter dashboard_period::Real = 0.1
  motion = VehicleSystemsComponents.Vehicle.Planar.BusMotion() {^motion}
  steering_tx = VehicleSystemsComponents.Vehicle.Planar.CanTxReal(slot = 2, id = 144, ideal = ideal, period = steering_period, scale = 0.001, raw_min = -32768, raw_max = 32767) {^steering_tx}
  yaw_tx = VehicleSystemsComponents.Vehicle.Planar.CanTxReal(slot = 3, id = 160, ideal = ideal, period = yaw_period, scale = 0.001, raw_min = -32768, raw_max = 32767) {^yaw_tx}
  dashboard_tx = VehicleSystemsComponents.Vehicle.Planar.CanTxReal(slot = 7, id = 768, ideal = ideal, period = dashboard_period, scale = 0.01, raw_min = -32768, raw_max = 32767) {^dashboard_tx}
relations
  connect(measurements, motion.bus) {^measure}
  connect(motion.delta_sw, steering, steering_tx.u) {^steering_wire}
  connect(motion.r, yaw, yaw_tx.u) {^yaw_wire}
  connect(motion.vx, dashboard_tx.u) {^dashboard_wire}
  connect(bus, steering_tx.bus, yaw_tx.bus, dashboard_tx.bus) {^network}
