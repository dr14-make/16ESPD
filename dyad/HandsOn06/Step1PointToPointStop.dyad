test component Step1PointToPointStop
  extends WiringStop(networked = false, ideal = true)
relations
  connect(ecu.regen, drive.regen) {^direct_regen}
  connect(motion.steering, ecu.steering) {^direct_steering}
  connect(motion.yaw, ecu.yaw) {^direct_yaw}
metadata {
  "_links": {
    "direct_regen": {"Dyad": {"edges": [{"S": 1, "E": 2, "M": [{"x": 880, "y": 400}, {"x": 880, "y": 320}, {"x": 580, "y": 320}, {"x": 580, "y": 240}]}]}},
    "direct_steering": {"Dyad": {"edges": [{"S": 1, "E": 2, "M": [{"x": 880, "y": 730}, {"x": 880, "y": 660}, {"x": 600, "y": 660}, {"x": 600, "y": 420}]}]}},
    "direct_yaw": {"Dyad": {"edges": [{"S": 1, "E": 2, "M": [{"x": 900, "y": 770}, {"x": 900, "y": 680}, {"x": 620, "y": 680}, {"x": 620, "y": 440}]}]}}
  }
}
end

analysis Step1PointToPointStopTransient
  extends TransientAnalysis(stop = 6, alg = ODEAlg.Rodas5P(), dtmax = 0.005, tstops = [0.5, 0.6], optimize = OptimizationLevel.None(), abstol = 1e-9, reltol = 1e-9)
  model = Step1PointToPointStop()
end
