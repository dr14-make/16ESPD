test component Step1IdealBusStop
  extends WiringStop(networked = true, ideal = true)
end

analysis Step1IdealBusStopTransient
  extends TransientAnalysis(stop = 6, alg = ODEAlg.Rodas5P(), dtmax = 0.005, tstops = [0.5, 0.6], optimize = OptimizationLevel.None(), abstol = 1e-9, reltol = 1e-9)
  model = Step1IdealBusStop()
end
