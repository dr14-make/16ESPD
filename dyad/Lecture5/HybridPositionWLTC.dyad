"""
Shared planar WLTC driver, road, brakes and energy accounting for the position benches.
Driver limits reflect crank-equivalent machine torque; position-dependent plants supply
shaft speed, ratio and stored power without introducing structural branches on states.
"""
partial component HybridPositionWLTC
  "Vehicle and road-load mass (assumed; shared planar benchmark)"
  parameter m::Mass = 1500.0
  "Wheel radius (derived; shared planar benchmark)"
  parameter radius::Length = 0.31
  "PI gain [N.m per km/h] (assumed; shared WLTC driver)"
  parameter k::Real = 110.0
  "PI integral time (assumed; shared WLTC driver)"
  parameter Ti::Time = 1.0
  "Driver ceiling [N.m] (derived; engine peak plus machine torque referred to CVT input; output machines use launch ratio)"
  parameter tau_max::Torque = tau_engine_peak + 205.0
  "Engine peak torque (derived; full-load table peak)"
  parameter tau_engine_peak::Torque = 150.233567
  "Negative PI ceiling at transmission input (derived; P2 engine peak plus 205 N.m machine torque)"
  parameter tau_brake::Torque = tau_engine_peak + 205.0
  "Initial wheel surface speed offset (assumed; MultibodyComponents #185)"
  parameter dv_wheel::Velocity = 0.01
  "Center of K0 launch engagement [rpm] (assumed; shared P2 launch calibration)"
  parameter engage_rpm::Real = 1300.0
  "Width of K0 launch engagement [rpm] (assumed; shared P2 launch calibration)"
  parameter engage_width_rpm::Real(min = eps(Float64)) = 120.0
  "Center of machine-side K0 lock-up [rpm] (assumed; shared P2 launch calibration)"
  parameter lock_rpm::Real = 840.0
  "Width of machine-side K0 lock-up [rpm] (assumed; shared P2 launch calibration)"
  parameter lock_width_rpm::Real(min = eps(Float64)) = 12.0
  "Minimum transmission target [rpm] (assumed; shared P2 launch calibration)"
  parameter N_locked::Real = 1000.0
  "Permit electric-only operation (derived; false for crank-coupled P0)"
  structural parameter electric_drive::Boolean = true
  trace = VehicleSystemsComponents.Vehicle.DriveCycle() {^trace}
  driver = BlockComponents.Continuous.LimPID(with_D = false, k = k, Ti = Ti, y_max = tau_max, y_min = -tau_brake) {^driver}
  no_ff = BlockComponents.Sources.Constant(k = 0.0) {^no_ff}
  kmh = VehicleSystemsComponents.Vehicle.ToKmPerHour() {^kmh}
  manager = VehicleSystemsComponents.Vehicle.EnergyManager(mapped_limits = true, geared_limit = true, electric_drive = electric_drive, SoC_on = 0.52, SoC_off = 0.55, P_line_max = 30.0e3) {^manager}
  map = VehicleSystemsComponents.Vehicle.TorqueToPedal() {^map}
  speed_command = VehicleSystemsComponents.Vehicle.HybridLineSpeedCommand(N_locked = N_locked) {^speed_command}
  differential = MultibodyComponents.PlanarMechanics.DifferentialGear() {^differential}
  mount = RotationalComponents.Components.Fixed() {^mount}
  straight = RotationalComponents.Components.Fixed() {^straight}
  flat = BlockComponents.Sources.Constant(k = 0.0) {^flat}
  car = VehicleSystemsComponents.Vehicle.Planar.PlanarCar(m = m, radius = radius) {^car}
  motion = VehicleSystemsComponents.Vehicle.Planar.BusMotion() {^motion}
  roadload = VehicleSystemsComponents.Vehicle.Planar.PlanarRoadLoad(m = m) {^roadload}
  meter = VehicleSystemsComponents.Vehicle.SoCCorrectedFuel() {^meter}
  "CVT input-to-output ratio supplied by the position plant"
  ratio = RealOutput() {^ratio}
  "Net stored-power draw including any separate starter [W]"
  variable P_stored::Power
  "Stored-energy charging integral [J]; includes regen and load-point charging"
  variable E_charge::Energy
  "Requested regenerative energy in the manager torque frame [J]"
  variable E_regen::Energy
  "Actual four-wheel friction-brake dissipation [J]"
  variable E_friction::Energy
  brakes = VehicleSystemsComponents.Vehicle.BrakeSplit(gain = 1.0) {^brakes}
  brake_product = BlockComponents.Math.Product() {^brake_product}
relations
  connect(car.bus, motion.bus) {^bus_wire}
  connect(trace.y, driver.u_s) {^trace_wire}
  connect(motion.vx, kmh.u, meter.speed) {^vx_wire}
  connect(kmh.y, driver.u_m, manager.v) {^kmh_wire}
  connect(no_ff.y, driver.u_ff) {^ff_wire}
  connect(driver.y, manager.tau_dem) {^dem_wire}
  connect(manager.P_engine, speed_command.P_engine) {^line_wire}
  connect(manager.tau_engine, map.tau) {^map_torque_wire}
  connect(manager.P_drive, speed_command.P_drive) {^drive_power_wire}
  connect(manager.engine_on, speed_command.engine_on) {^line_on_wire}
  connect(differential.flange_left, car.spin_fl) {^left_wire}
  connect(differential.flange_right, car.spin_fr) {^right_wire}
  connect(car.steering, straight.spline) {^steering_wire}
  connect(flat.y, roadload.grade) {^grade_wire}
  connect(car.chassis, roadload.chassis) {^chassis_wire}
  connect(manager.tau_friction, brake_product.u1) {^friction_input_wire}
  connect(ratio, brake_product.u2) {^brake_ratio_wire}
  connect(brake_product.y, brakes.u) {^brake_demand_wire}
  connect(brakes.tau_fl, car.tau_fl) {^brake_fl_wire}
  connect(brakes.tau_fr, car.tau_fr) {^brake_fr_wire}
  connect(brakes.tau_rl, car.tau_rl) {^brake_rl_wire}
  connect(brakes.tau_rr, car.tau_rr) {^brake_rr_wire}
  der(E_charge) = max(-P_stored, 0.0)
  der(E_regen) = manager.tau_regen * max(manager.w_shaft, 0.0)
  der(E_friction) = car.fl.brake.tau_friction * car.fl.brake.w + car.fr.brake.tau_friction * car.fr.brake.w + car.rl.brake.tau_friction * car.rl.brake.w + car.rr.brake.tau_friction * car.rr.brake.w
  initial E_charge = 0.0
  initial E_regen = 0.0
  initial E_friction = 0.0
  initial car.body.r = [0.0, 0.0]
  initial car.body.v = [0.0, 0.0]
  initial car.body.phi = 0.0
  initial car.body.w = 0.0
  initial car.fl.inertia.w = dv_wheel / radius
  initial car.fr.inertia.w = dv_wheel / radius
  initial car.rl.inertia.w = dv_wheel / radius
  initial car.rr.inertia.w = dv_wheel / radius
  initial car.fl.inertia.phi = 0.0
  initial car.fr.inertia.phi = 0.0
  initial car.rl.inertia.phi = 0.0
  initial car.rr.inertia.phi = 0.0
  initial car.fl.brake.tau_actual = 0.0
  initial car.fr.brake.tau_actual = 0.0
  initial car.rl.brake.tau_actual = 0.0
  initial car.rr.brake.tau_actual = 0.0
metadata {"_links":{"brake_product":{"Dyad":{"placement":{"diagram":{"x1":160,"y1":460,"x2":240,"y2":540}}}},"friction_input_wire":{"Dyad":{"edges":[{"E":2,"M":[{"x":343.0,"y":354.0},{"x":343.0,"y":476.0}],"S":1}],"renderStyle":"standard"}},"brake_ratio_wire":{"Dyad":{"edges":[{"E":2,"M":[{"x":78.0,"y":500.0},{"x":78.0,"y":524.0}],"S":1}],"renderStyle":"standard"}},"brake_demand_wire":{"Dyad":{"edges":[{"E":2,"M":[{"x":272.0,"y":500.0},{"x":272.0,"y":640.0}],"S":1}],"renderStyle":"standard"}},"ratio":{"Dyad":{"placement":{"diagram":{"x1":-20,"y1":480,"x2":20,"y2":520},"icon":{"x1":460,"y1":-40,"x2":540,"y2":40}}}},"trace":{"Dyad":{"placement":{"diagram":{"x1":0,"y1":140,"x2":70,"y2":210}}}},"driver":{"Dyad":{"placement":{"diagram":{"x1":130,"y1":150.7,"x2":220,"y2":240.7}}}},"no_ff":{"Dyad":{"placement":{"diagram":{"x1":100,"y1":30,"x2":160,"y2":90}}}},"kmh":{"Dyad":{"placement":{"diagram":{"x1":10,"y1":245,"x2":80,"y2":315}}}},"manager":{"Dyad":{"placement":{"diagram":{"x1":270,"y1":120,"x2":530,"y2":380}}}},"map":{"Dyad":{"placement":{"diagram":{"x1":575,"y1":152.6,"x2":635,"y2":202.6}}}},"speed_command":{"Dyad":{"placement":{"diagram":{"x1":550,"x2":650,"y1":20,"y2":100}}}},"differential":{"Dyad":{"placement":{"diagram":{"x1":640,"y1":740,"x2":880,"y2":500}}}},"mount":{"Dyad":{"placement":{"diagram":{"x1":675,"y1":355,"x2":725,"y2":405}}}},"straight":{"Dyad":{"placement":{"diagram":{"x1":735,"y1":745,"x2":785,"y2":795,"rot":180}}}},"flat":{"Dyad":{"placement":{"diagram":{"x1":480,"y1":880,"x2":520,"y2":920}}}},"car":{"Dyad":{"placement":{"diagram":{"x1":690,"y1":800,"x2":830,"y2":940}}}},"motion":{"Dyad":{"placement":{"diagram":{"x1":880,"y1":810,"x2":1000,"y2":930}}}},"roadload":{"Dyad":{"placement":{"diagram":{"x1":560,"y1":865,"x2":630,"y2":935}}}},"meter":{"Dyad":{"placement":{"diagram":{"x1":930,"y1":16,"x2":1000,"y2":86}}}},"brakes":{"Dyad":{"placement":{"diagram":{"x1":300,"x2":420,"y1":580,"y2":700}}}},"bus_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"r