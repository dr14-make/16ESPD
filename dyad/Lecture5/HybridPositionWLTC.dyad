"""
Shared planar WLTC driver, road, brakes and energy accounting for the position benches.
Driver and brake limits retain the P2 benchmark; position-dependent plants supply
shaft speed, ratio and stored power without introducing structural branches on states.
"""
partial component HybridPositionWLTC
  "Vehicle and road-load mass (assumed; shared planar benchmark)"
  parameter m::Mass = 1500.0
  "Wheel radius (derived; shared planar benchmark)"
  parameter radius::Length = 0.31
  "PI gain [N.m per km/h] (assumed; shared WLTC driver)"
  parameter k::Real = 110.0
  "PI integral time (assumed; shared WLTC driver)"
  parameter Ti::Time = 1.0
  "Signed driver ceiling [N.m] (derived; engine full-load peak plus HybridDrive default 205 N.m)"
  parameter tau_max::Torque = 150.233567 + 205.0
  "Negative PI ceiling at transmission input (assumed; shared brake demand)"
  parameter tau_brake::Torque = tau_max
  "Initial wheel surface speed offset (assumed; MultibodyComponents #185)"
  parameter dv_wheel::Velocity = 0.01
  "Center of K0 launch engagement [rpm] (assumed; P2 step 2)"
  parameter engage_rpm::Real = 1300.0
  "Width of K0 launch engagement [rpm] (assumed; P2 step 2)"
  parameter engage_width_rpm::Real(min = eps(Float64)) = 120.0
  "Center of machine-side K0 lock-up [rpm] (assumed; P2 step 2)"
  parameter lock_rpm::Real = 840.0
  "Width of machine-side K0 lock-up [rpm] (assumed; P2 step 2)"
  parameter lock_width_rpm::Real(min = eps(Float64)) = 12.0
  "Minimum transmission target [rpm] (assumed; P2 step 2)"
  parameter N_locked::Real = 1000.0
  "Permit electric-only operation (derived; false for crank-coupled P0)"
  structural parameter electric_drive::Boolean = true
  trace = VehicleSystemsComponents.Vehicle.DriveCycle()
  driver = BlockComponents.Continuous.LimPID(with_D = false, k = k, Ti = Ti, y_max = tau_max, y_min = -tau_brake)
  no_ff = BlockComponents.Sources.Constant(k = 0.0)
  kmh = VehicleSystemsComponents.Vehicle.ToKmPerHour()
  manager = VehicleSystemsComponents.Vehicle.EnergyManager(mapped_limits = true, geared_limit = true, electric_drive = electric_drive, SoC_on = 0.52, SoC_off = 0.55, P_line_max = 30.0e3)
  map = VehicleSystemsComponents.Vehicle.TorqueToPedal()
  line = VehicleSystemsComponents.Vehicle.OperatingLine()
  demand_line = VehicleSystemsComponents.Vehicle.OperatingLine()
  differential = MultibodyComponents.PlanarMechanics.DifferentialGear()
  mount = RotationalComponents.Components.Fixed()
  straight = RotationalComponents.Components.Fixed()
  flat = BlockComponents.Sources.Constant(k = 0.0)
  car = VehicleSystemsComponents.Vehicle.Planar.PlanarCar(m = m, radius = radius)
  motion = VehicleSystemsComponents.Vehicle.Planar.BusMotion()
  roadload = VehicleSystemsComponents.Vehicle.Planar.PlanarRoadLoad(m = m)
  meter = VehicleSystemsComponents.Vehicle.SoCCorrectedFuel()
  "CVT input-to-output ratio supplied by the position plant"
  variable ratio::Real
  "Net stored-power draw including any separate starter [W]"
  variable P_stored::Power
  "CVT target blended between electric demand and engine operating line [rpm]"
  variable N_target::Real
  "Stored-energy charging integral [J]; includes regen and load-point charging"
  variable E_charge::Energy
  "Requested regenerative energy in the manager torque frame [J]"
  variable E_regen::Energy
  "Actual four-wheel friction-brake dissipation [J]"
  variable E_friction::Energy
relations
  connect(car.bus, motion.bus)
  connect(trace.y, driver.u_s)
  connect(motion.vx, kmh.u, meter.speed)
  connect(kmh.y, driver.u_m, manager.v)
  connect(no_ff.y, driver.u_ff)
  connect(driver.y, manager.tau_dem)
  connect(manager.P_engine, line.P)
  connect(manager.tau_engine, map.tau)
  demand_line.P = manager.P_drive
  N_target = max(manager.engine_on * line.N + (1.0 - manager.engine_on) * demand_line.N, N_locked)
  connect(differential.flange_left, car.spin_fl)
  connect(differential.flange_right, car.spin_fr)
  connect(car.steering, straight.spline)
  connect(flat.y, roadload.grade)
  connect(car.chassis, roadload.chassis)
  meter.P_stored = P_stored
  car.tau_fl = manager.tau_friction * ratio / 2.0
  car.tau_fr = car.tau_fl
  car.tau_rl = 0.0
  car.tau_rr = 0.0
  der(E_charge) = max(-P_stored, 0.0)
  der(E_regen) = manager.tau_regen * max(manager.w_shaft, 0.0)
  der(E_friction) = car.fl.brake.tau_friction * car.fl.brake.w + car.fr.brake.tau_friction * car.fr.brake.w + car.rl.brake.tau_friction * car.rl.brake.w + car.rr.brake.tau_friction * car.rr.brake.w
  initial E_charge = 0.0
  initial E_regen = 0.0
  initial E_friction = 0.0
  initial car.body.r = [0.0, 0.0]
  initial car.body.v = [0.0, 0.0]
  initial car.body.phi = 0.0
  initial car.body.w = 0.0
  initial car.fl.inertia.w = dv_wheel / radius
  initial car.fr.inertia.w = dv_wheel / radius
  initial car.rl.inertia.w = dv_wheel / radius
  initial car.rr.inertia.w = dv_wheel / radius
  initial car.fl.inertia.phi = 0.0
  initial car.fr.inertia.phi = 0.0
  initial car.rl.inertia.phi = 0.0
  initial car.rr.inertia.phi = 0.0
  initial car.fl.brake.tau_actual = 0.0
  initial car.fr.brake.tau_actual = 0.0
  initial car.rl.brake.tau_actual = 0.0
  initial car.rr.brake.tau_actual = 0.0
end
