:876},{"x":980,"y":10},{"x":10,"y":10},{"x":10,"y":360}],"E":2},{"S":1,"M":[{"x":980,"y":876},{"x":980,"y":272},{"x":860,"y":272},{"x":860,"y":228}],"E":3}],"renderStyle":"standard"}},"unused_command":{"Dyad":{"placement":{"diagram":{"x1":410,"x2":470,"y1":116,"y2":176}}}},"unused_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":515,"y":146},{"x":515,"y":292}],"E":2},{"S":1,"M":[],"E":3}],"renderStyle":"standard"}},"speed_command":{"Dyad":{"placement":{"diagram":{"x1":460,"x2":500,"y1":395,"y2":465}}}},"line_pedal_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"speed_command_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":506,"y":430},{"x":506,"y":272}],"E":2}],"renderStyle":"standard"}},"brakes":{"Dyad":{"placement":{"diagram":{"x1":240,"x2":360,"y1":690,"y2":810}}}},"brake_fl_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":525,"y":714},{"x":525,"y":847.5}],"E":2}],"renderStyle":"standard"}},"brake_fr_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":745,"y":738},{"x":745,"y":810},{"x":770,"y":810},{"x":770,"y":847.5}],"E":2}],"renderStyle":"standard"}},"brake_rl_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":500,"y":762},{"x":500,"y":892},{"x":580,"y":892},{"x":580,"y":922.5}],"E":2}],"renderStyle":"standard"}},"brake_rr_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":630,"y":786},{"x":630,"y":770},{"x":775,"y":770},{"x":775,"y":922.5}],"E":2}],"renderStyle":"standard"}},"brake_demand_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":212,"y":252},{"x":212,"y":750}],"E":2}],"renderStyle":"standard"}},"pedal_gain":{"Dyad":{"placement":{"diagram":{"x1":255,"x2":295,"y1":410,"y2":450}}}},"pedal_gain_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":212,"y":252},{"x":212,"y":430}],"E":2}],"renderStyle":"standard"}},"pedal_limit_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"pedal_command":{"Dyad":{"placement":{"diagram":{"x1":375,"x2":415,"y1":410,"y2":450}}}},"pedal_command_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":437,"y":430},{"x":437,"y":205.6}],"E":2}],"renderStyle":"standa