"""
Engine-only operating-line WLTC with pedal-based power demand and shaft-speed K0 lock-up.
The line target is floored above idle. Machine torque, losses and inertia are zero.
"""
test component P2OperatingLineWLTC
  "Vehicle and road-load mass (assumed; shared planar benchmark)"
  parameter m::Mass = 1500.0
  "Wheel radius (derived; planar benchmark)"
  parameter radius::Length = 0.31
  "PI gain [N.m per km/h], shared with H0"
  parameter k::Real = 110.0
  "PI integral time (assumed; shared Lecture 5 driver)"
  parameter Ti::Time = 1.0
  "Positive PI ceiling [N.m], pedal saturation"
  parameter tau_max::Torque = 150.0
  "Initial wheel surface speed offset (assumed; MultibodyComponents #185)"
  parameter dv_wheel::Velocity = 0.01
  "Center of K0 launch engagement [rpm] (assumed; CentrifugalClutch)"
  parameter engage_rpm::Real = 1300.0
  "Width of K0 launch engagement [rpm] (assumed; CentrifugalClutch)"
  parameter engage_width_rpm::Real(min = eps(Float64)) = 120.0
  "Negative PI limit [N.m], independent of propulsion saturation"
  parameter tau_brake::Torque = 205.0
  "Total wheel brake torque per negative driver N.m, launch ratio reference"
  parameter brake_gain::Real = 12.0
  "Center of machine-side K0 lock-up ramp [rpm]; open at 800 rpm idle, closed by 880 rpm"
  parameter lock_rpm::Real = 840.0
  "Width of machine-side K0 lock-up ramp [rpm]"
  parameter lock_width_rpm::Real(min = eps(Float64)) = 12.0
  trace = VehicleSystemsComponents.Vehicle.DriveCycle() {^trace}
  driver = BlockComponents.Continuous.LimPID(with_D = false, k = k, Ti = Ti, y_max = tau_max, y_min = -tau_brake) {^driver}
  no_ff = BlockComponents.Sources.Constant(k = 0.0) {^no_ff}
  kmh = VehicleSystemsComponents.Vehicle.ToKmPerHour() {^kmh}
  powertrain = VehicleSystemsComponents.Vehicle.P2Powertrain(speed_commanded = true, position_start = 0.0, drive(P_aux = 0.0, T_f = 0.0, K_i = 0.0, k_w = 0.0, C = 0.0, J = 0.0)) {^powertrain}
  differential = MultibodyComponents.PlanarMechanics.DifferentialGear() {^differential}
  mount = RotationalComponents.Components.Fixed() {^mount}
  straight = RotationalComponents.Components.Fixed() {^straight}
  flat = BlockComponents.Sources.Constant(k = 0.0) {^flat}
  car = VehicleSystemsComponents.Vehicle.Planar.PlanarCar(m = m, radius = radius) {^car}
  motion = VehicleSystemsComponents.Vehicle.Planar.BusMotion() {^motion}
  roadload = VehicleSystemsComponents.Vehicle.Planar.PlanarRoadLoad(m = m) {^roadload}
  meter = VehicleSystemsComponents.Vehicle.SoCCorrectedFuel() {^meter}
  speed_command = VehicleSystemsComponents.Vehicle.LineSpeedCommand() {^speed_command}
  "Zero for unused command inputs (assumed; fixed-mode fixture)"
  unused_command = BlockComponents.Sources.Constant(k = 0.0) {^unused_command}
  brakes = VehicleSystemsComponents.Vehicle.BrakeSplit(gain = brake_gain, input = VehicleSystemsComponents.Vehicle.BrakeInput.SignedDriver()) {^brakes}
  pedal_gain = BlockComponents.Math.Gain(k = 1 / tau_max) {^pedal_gain}
  pedal_command = BlockComponents.Nonlinear.Limiter(y_min = 0.0, y_max = 1.0) {^pedal_command}
  stored_power = BlockComponents.Math.Product() {^stored_power}
  engagement_command = VehicleSystemsComponents.Vehicle.EngagementCommand(engage_rpm = engage_rpm, engage_width_rpm = engage_width_rpm, lock_rpm = lock_rpm, lock_width_rpm = lock_width_rpm) {^engagement_command}
  no_machine = BlockComponents.Sources.Constant(k = 0.0) {^no_machine}
relations
  connect(powertrain.E, stored_power.u1) {^stored_voltage_wire}
  connect(powertrain.i, stored_power.u2) {^stored_current_wire}
  connect(stored_power.y, meter.P_stored) {^stored_power_wire}
  connect(powertrain.engine_speed, engagement_command.engine_speed) {^engagement_engine_wire}
  connect(powertrain.shaft_speed, engagement_command.shaft_speed) {^engagement_shaft_wire}
  connect(engagement_command.y, powertrain.engage) {^engagement_wire}
  connect(unused_command.y, powertrain.cvt_pedal, powertrain.engine_torque_ref) {^unused_wire}
  connect(car.bus, motion.bus) {^bus_wire}
  connect(trace.y, driver.u_s) {^trace_wire}
  connect(motion.vx, kmh.u, meter.speed) {^vx_wire}
  connect(kmh.y, driver.u_m) {^kmh_wire}
  connect(no_ff.y, driver.u_ff) {^ff_wire}
  connect(powertrain.spline, differential.flange_b) {^spline_wire}
  connect(differential.flange_left, car.spin_fl) {^left_wire}
  connect(differential.flange_right, car.spin_fr) {^right_wire}
  connect(powertrain.support, mount.spline) {^mount_wire}
  connect(car.steering, straight.spline) {^steering_wire}
  connect(flat.y, roadload.grade) {^grade_wire}
  connect(car.chassis, roadload.chassis) {^chassis_wire}
  connect(powertrain.mdot_fuel, meter.mdot_fuel) {^fuel_wire}
  connect(pedal_command.y, speed_command.pedal) {^line_pedal_wire}
  connect(speed_command.N_ref, powertrain.N_ref) {^speed_command_wire}
  connect(driver.y, pedal_gain.u) {^pedal_gain_wire}
  connect(pedal_gain.y, pedal_command.u) {^pedal_limit_wire}
  connect(pedal_command.y, powertrain.engine_pedal) {^pedal_command_wire}

  connect(no_machine.y, powertrain.tau_ref) {^no_machine_wire}
  connect(driver.y, brakes.u) {^brake_demand_wire}
  connect(brakes.tau_fl, car.tau_fl) {^brake_fl_wire}
  connect(brakes.tau_fr, car.tau_fr) {^brake_fr_wire}
  connect(brakes.tau_rl, car.tau_rl) {^brake_rl_wire}
  connect(brakes.tau_rr, car.tau_rr) {^brake_rr_wire}
  initial car.body.r = [0, 0]
  initial car.body.v = [0, 0]
  initial car.body.phi = 0.0
  initial car.body.w = 0.0
  initial car.fl.inertia.w = dv_wheel / radius
  initial car.fr.inertia.w = dv_wheel / radius
  initial car.rl.inertia.w = dv_wheel / radius
  initial car.rr.inertia.w = dv_wheel / radius
  initial car.fl.inertia.phi = 0.0
  initial car.fr.inertia.phi = 0.0
  initial car.rl.inertia.phi = 0.0
  initial car.rr.inertia.phi = 0.0
  initial car.fl.brake.tau_actual = 0.0
  initial car.fr.brake.tau_actual = 0.0
  initial car.rl.brake.tau_actual = 0.0
  initial car.rr.brake.tau_actual = 0.0
  initial powertrain.drive.converter.i_out = 0.0
