"""
P0 crank-coupled hybrid WLTC with a drive-side crank torque limit including belt efficiency.
EnergyManager shares this conservative limit between drive and regeneration.
"""
test component CoupledHybridWLTC
  extends HybridPositionWLTC(electric_drive = false, tau_max = tau_engine_peak + T_max * i_crank * eta_crank)
  "Machine/crank ratio (assumed; illustrative P0 pulley sizing)"
  parameter i_crank::Real = 2.5
  "Belt efficiency (assumed; illustrative P0 belt)"
  parameter eta_crank::Real = 0.96
  "Machine peak torque (ORNL-2012 Hyundai HSG)"
  parameter T_max::Torque = 43.0
  "K0 capacity [N.m] (derived; 390 N.m accommodates combined crank-side torque)"
  parameter k0_capacity::Torque = 390.0
  powertrain = VehicleSystemsComponents.Vehicle.CoupledHybridPowertrain(speed_commanded = true, i_crank = i_crank, eta_crank = eta_crank, T_max = T_max, k0(tau_max = k0_capacity)) {^powertrain}
relations
  manager.w_shaft = powertrain.engine_speed
  manager.T_lim = powertrain.drive.T_max * powertrain.i_crank * powertrain.eta_crank
  connect(powertrain.SoC, manager.SoC) {^soc_wire}
  connect(powertrain.engine_speed, manager.engine_speed, map.omega) {^speed_wire}
  connect(powertrain.available_torque, manager.available_torque) {^torque_wire}
  connect(manager.tau_engine, powertrain.engine_torque_ref) {^torque_ref_wire}
  connect(map.pedal, powertrain.engine_pedal) {^pedal_wire}
  connect(manager.engine_on, powertrain.engine_on) {^engine_on_wire}
  # The belt applies losses physically; the PI driver supplies the resulting torque deficit.
  powertrain.tau_ref = manager.tau_machine / powertrain.i_crank
  connect(speed_command.N_ref, powertrain.N_ref) {^speed_command_wire}
  powertrain.engage = max(0.5 * (1 + tanh((powertrain.engine_speed * 30 / pi - engage_rpm) / engage_width_rpm)), 0.5 * (1 + tanh((powertrain.speed_variator.w_a * 30 / pi - lock_rpm) / lock_width_rpm)))
  connect(powertrain.spline, differential.flange_b) {^spline_wire}
  connect(powertrain.support, mount.spline) {^mount_wire}
  connect(powertrain.mdot_fuel, meter.mdot_fuel) {^fuel_wire}
  ratio = powertrain.speed_variator.ratio
  P_stored = powertrain.E * powertrain.i
  initial powertrain.drive.converter.i_out = 0.0
metadata {"_links":{
