end

"Full WLTC P0 position analysis (derived; shared duration and solver)."
analysis CoupledHybridWLTCTransient
  extends TransientAnalysis(stop = 1800.0, alg = ODEAlg.Rodas5P(), dtmax = 1.0, optimize = OptimizationLevel.None())
  model = CoupledHybridWLTC()
end
