"""
Prepared ground for a series-hybrid WLTC run: the planar car with its road load, the WLTC
trace, the PI driver, the torque split onto the front friction brakes and the SoC-corrected fuel
meter, with no powertrain. A bench `extends` it and adds the powertrain.

    trace -> driver -> split -> tau_motor (open)
                             -> front friction brakes
    differential.flange_b (open) -> front wheels
    meter: speed wired; mdot_fuel and P_stored (open)

What the extending bench has to provide:

| Open end | Carries |
|---|---|
| `split.tau_motor` | traction-machine torque asked for, at the machine shaft [N.m] |
| `differential.flange_b` | the reduction output that drives the front wheels |
| `mount.spline` | a fixed housing for every powertrain support |
| `meter.mdot_fuel` | the engine's fuel mass flow [kg/s] |
| `meter.P_stored` | the power out of the battery's store, `E i` [W] |

The driver, the split and the start are those of `Planar.PlanarBEVWLTC`: the driver's PI output
is a machine torque in N.m per km/h of speed error, limited to the traction machine's peak
torque `tau_max`; the split's `ratio` has to equal the traction drive's reduction, so that the
friction brakes take the right wheel torque below `v_fade`. Both have to match the traction
drive, and nothing checks it: build the drive from the ground's own parameters,
`TractionDrive(T_max = tau_max, ratio = ratio)`, so they cannot drift apart. The wheels start
`dv_wheel` ahead of the body (MultibodyComponents.jl#185). A run of the full cycle needs `optimize =
OptimizationLevel.None()` on its analysis (four identical tire blocks; see docs/HANDOVER.md).
"""
partial component SeriesWLTCGround
  "Vehicle mass, shared by the car and its road load (probe)"
  parameter m::Mass = 1500.0
  "Wheel radius (repository default)"
  parameter radius::Length = 0.31
  "Driver gain, machine torque per km/h of speed error (assumed; PlanarBEVWLTC)"
  parameter k::Real = 50.0
  "Driver integral time (assumed; PlanarBEVWLTC)"
  parameter Ti::Time = 2.0
  "Driver torque limit, the traction machine's peak torque (derived; TractionDrive T_max)"
  parameter tau_max::Torque = 250.0
  "Machine-to-differential reduction the split carries the brake torque through (derived; TractionDrive ratio)"
  parameter ratio::Real = 8.193
  "Speed below which the machine's braking share fades to zero, km/h (assumed; PlanarBEVWLTC)"
  parameter v_fade::Real = 10.0
  "Initial wheel surface speed above the body's, keeps the start off zero slip (assumed)"
  parameter dv_wheel::Velocity = 0.01
  trace = VehicleSystemsComponents.Vehicle.DriveCycle() {^trace}
  driver = BlockComponents.Continuous.LimPID(with_D = false, k = k, Ti = Ti, y_max = tau_max, y_min = -tau_max) {^driver}
  no_ff = BlockComponents.Sources.Constant(k = 0.0) {^no_ff}
  kmh = VehicleSystemsComponents.Vehicle.ToKmPerHour() {^kmh}
  split = VehicleSystemsComponents.Vehicle.Electric.TorqueSplit(ratio = ratio, v_fade = v_fade) {^split}
  differential = MultibodyComponents.PlanarMechanics.DifferentialGear() {^differential}
  mount = RotationalComponents.Components.Fixed() {^mount}
  straight = RotationalComponents.Components.Fixed() {^straight}
  flat = BlockComponents.Sources.Constant(k = 0.0) {^flat}
  car = VehicleSystemsComponents.Vehicle.Planar.PlanarCar(m = m, radius = radius) {^car}
  motion = VehicleSystemsComponents.Vehicle.Planar.BusMotion() {^motion}
  roadload = VehicleSystemsComponents.Vehicle.Planar.PlanarRoadLoad(m = m) {^roadload}
  meter = VehicleSystemsComponents.Vehicle.SoCCorrectedFuel() {^meter}
  brakes = VehicleSystemsComponents.Vehicle.BrakeSplit(gain = 2.0) {^brakes}
relations
  connect(car.bus, motion.bus) {^bus_wire}
  connect(trace.y, driver.u_s) {^trace_wire}
  connect(motion.vx, kmh.u, meter.speed) {^speed_wire}
  connect(kmh.y, driver.u_m, split.v) {^kmh_wire}
  connect(no_ff.y, driver.u_ff) {^ff_wire}
  connect(driver.y, split.tau_ref) {^demand_wire}
  connect(split.tau_brake, brakes.u) {^brake_demand_wire}
  connect(brakes.tau_fl, car.tau_fl) {^brake_wire}
  connect(brakes.tau_fr, car.tau_fr) {^brake_fr_wire}
  connect(differential.flange_left, car.spin_fl) {^left_wire}
  connect(differential.flange_right, car.spin_fr) {^right_wire}
  connect(car.steering, straight.spline) {^steer_wire}
  connect(flat.y, roadload.grade) {^grade_wire}
  connect(car.chassis, roadload.chassis) {^load_wire}
  connect(brakes.tau_rl, car.tau_rl) {^brake_rl_wire}
  connect(brakes.tau_rr, car.tau_rr) {^brake_rr_wire}
  initial car.body.r = [0, 0]
  initial car.body.v = [0, 0]
  initial car.body.phi = 0.0
  initial car.body.w = 0.0
  initial car.fl.inertia.w = dv_wheel / radius
  initial car.fr.inertia.w = dv_wheel / radius
  initial car.rl.inertia.w = dv_wheel / radius
  initial car.rr.inertia.w = dv_wheel / radius
  initial car.fl.inertia.phi = 0.0
  initial car.fr.inertia.phi = 0.0
  initial car.rl.inertia.phi = 0.0
  initial car.rr.inertia.phi = 0.0
  initial car.fl.brake.tau_actual = 0.0
  initial car.fr.brake.tau_actual = 0.0
  initial car.rl.brake.tau_actual = 0.0
  initial car.rr.brake.tau_actual = 0.0
metadata {"_links":{"bus_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"trace_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"speed_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":900,"y":876},{"x":900,"y":430},{"x":590,"y":430},{"x":590,"y":440},{"x":10,"y":440},{"x":10,"y":360}],"E":2}],"renderStyle":"standard"}},"kmh_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":100,"y":360},{"x":100,"y":272.7}],"E":2}],"renderStyle":"standard"}},"ff_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":155,"y":125}],"E":2}],"renderStyle":"standard"}},"demand_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"left_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":538,"y":862.5}],"E":2}],"renderStyle":"standard"}},"right_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":802,"y":762},{"x":760,"y":762},{"x":760,"y":862.5}],"E":2}],"renderStyle":"standard"}},"steer_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"grade_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"load_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":570,"y":975},{"x":570,"y":940}],"E":2}],"renderStyle":"standard"}},"brake_demand_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":320,"y":284},{"x":320,"y":680},{"x":230,"y":680},{"x":230,"y":750}],"E":2}],"renderStyle":"standard"}},"brakes":{"Dyad":{"placement":{"diagram":{"x1":240,"x2":360,"y1":690,"y2":810}}}},"brake_fr_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":745,"y":738},{"x":745,"y":810},{"x":770,"y":810},{"x":770,"y":847.5}],"E":2}],"renderStyle":"standard"}},"brake_rl_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":500,"y":762},{"x":500,"y":892},{"x":580,"y":892},{"x":580,"y":922.5}],"E":2}],"renderStyle":"standard"}},"brake_rr_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":630,"y":786},{"x":630,"y":770},{"x":775,"y":770},{"x":775,"y":922.5}],"E":2}],"renderStyle":"standard"}},"trace":{"Dyad":{"placement":{"diagram":{"x1":20,"x2":80,"y1":201.3,"y2":261.3}}}},"driver":{"Dyad":{"placement":{"diagram":{"x1":110,"x2":200,"y1":207,"y2":297}}}},"no_ff":{"Dyad":{"placement":{"diagram":{"x1":80,"x2":130,"y1":100,"y2":150}}}},"kmh":{"Dyad":{"placement":{"diagram":{"x1":20,"x2":80,"y1":330,"y2":390}}}},"split":{"Dyad":{"placement":{"diagram":{"x1":230,"x2":310,"y1":228,"y2":308}}}},"differential":{"Dyad":{"placement":{"diagram":{"x1":550,"x2":790,"y1":720,"y2":480}}}},"mount":{"Dyad":{"placement":{"diagram":{"x1":530,"x2":580,"y1":380,"y2":420}}}},"straight":{"Dyad":{"placement":{"diagram":{"x1":650,"x2":690,"y1":785,"y2":820,"rot":180}}}},"flat":{"Dyad":{"placement":{"diagram":{"x1":415,"x2":455,"y1":920,"y2":960}}}},"car":{"Dyad":{"placement":{"diagram":{"x1":595,"x2":745,"y1":825,"y2":975}}}},"motion":{"Dyad":{"placement":{"diagram":{"x1":785,"x2":885,"y1":850,"y2":950}}}},"roadload":{"Dyad":{"placement":{"diagram":{"x1":485,"x2":555,"y1":905,"y2":975}}}},"meter":{"Dyad":{"placement":{"diagram":{"x1":870,"x2":960,"y1":156,"y2":246}}}},"brake_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":520,"y":714},{"x":520,"y":847.5}],"E":2}],"renderStyle":"standard"}}}}
end

"""
The ground driven electric-only through the WLTC Low phase: `Vehicle.Electric.TractionDrive` on
a battery of `HybridDrive`'s pack defaults, 270 V, 1.4 kWh and 0.33 Ohm, with the 12 V
auxiliaries on the same bus and no engine, so the meter's fuel input is zero. It checks that the
ground and the traction drive follow the trace; a charge-depleting run, not a series hybrid.
"""
test component SeriesGroundElectric
  extends VehicleSystemsComponents.Lecture5.SeriesWLTCGround
  "Pack open-circuit voltage (ORNL-2011; HybridDrive)"
  parameter E_pack::Voltage = 270.0
  "Pack capacity, 1.4 kWh / E_pack (derived; HybridDrive)"
  parameter Q_pack::ElectricCharge = 1.4e3 * 3600.0 / E_pack
  "Pack resistance (INL; HybridDrive)"
  parameter R0_pack::Resistance = 0.33
  "Initial SoC (assumed; HybridDrive)"
  parameter SoC0::Real = 0.6
  "Power drawn by the 12 V network (assumed; PlanarBEVWLTC)"
  parameter P_aux::Power = 300.0
  battery = VehicleSystemsComponents.Vehicle.Electric.Battery(E = E_pack, Q_nom = Q_pack, R0 = R0_pack, SoC0 = SoC0) {^battery}
  aux = VehicleSystemsComponents.Vehicle.Electric.AuxLoad(P_aux = P_aux) {^aux}
  ground = ElectricalComponents.Analog.Basic.Ground() {^ground}
  drive = VehicleSystemsComponents.Vehicle.Electric.TractionDrive(T_max = tau_max, ratio = ratio) {^drive}
  no_fuel = BlockComponents.Sources.Constant(k = 0.0) {^no_fuel}
  stored_power = BlockComponents.Math.Product() {^stored_power}
relations
  connect(battery.p, aux.p, drive.p) {^positive_wire}
  connect(battery.n, aux.n, drive.n, ground.g) {^negative_wire}
  connect(split.tau_motor, drive.tau_ref) {^machine_wire}
  connect(drive.spline, differential.flange_b) {^drive_shaft_wire}
  connect(drive.support, mount.spline) {^drive_mount_wire}
  connect(no_fuel.y, meter.mdot_fuel) {^zero_fuel_wire}
  connect(battery.stored_voltage, stored_power.u1) {^stored_voltage_wire}
  connect(battery.stored_current, stored_power.u2) {^stored_current_wire}
  connect(stored_power.y, meter.P_stored) {^stored_power_wire}
  initial drive.converter.i_out = 0.0
metadata {"_links":{"battery":{"Dyad":{"placement":{"diagram":{"x1":230,"x2":410,"y1":40,"y2":140}}}},"aux":{"Dyad":{"placement":{"diagram":{"x1":470,"x2":530,"y1":60,"y2":120}}}},"ground":{"Dyad":{"placement":{"diagram":{"x1":600,"x2":640,"y1":130,"y2":170}}}},"drive":{"Dyad":{"placement":{"diagram":{"x1":400,"x2":560,"y1":172,"y2":332}}}},"no_fuel":{"Dyad":{"placement":{"diagram":{"x1":760,"x2":800,"y1":154,"y2":194}}}},"positive_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":204.5,"y":90},{"x":204.5,"y":10},{"x":460,"y":10},{"x":460,"y":90}],"E":2},{"S":1,"M":[{"x":204.5,"y":90},{"x":204.5,"y":10},{"x":432,"y":10}],"E":3}],"renderStyle":"standard"}},"negative_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":450,"y":90},{"x":450,"y":50},{"x":538,"y":50},{"x":538,"y":90}],"E":2},{"S":1,"M":[{"x":420,"y":90},{"x":420,"y":160},{"x":390,"y":160},{"x":390,"y":340},{"x":432,"y":340}],"E":3},{"S":1,"M":[{"x":450,"y":90},{"x":450,"y":50},{"x":620,"y":50}],"E":4}],"renderStyle":"standard"}},"machine_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"drive_shaft_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":620,"y":252},{"x":620,"y":468}],"E":2}],"renderStyle":"standard"}},"drive_mount_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":555,"y":332}],"E":2}],"renderStyle":"standard"}},"zero_fuel_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"stored_power":{"Dyad":{"placement":{"diagram":{"x1":680,"x2":740,"y1":60,"y2":120}}}},"stored_power_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":860,"y":90},{"x":860,"y":201}],"E":2}],"renderStyle":"standard"}},"stored_current_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":356,"y":150},{"x":590,"y":150},{"x":590,"y":108}],"E":2}],"renderStyle":"standard"}},"stored_voltage_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":284,"y":150},{"x":220,"y":150},{"x":220,"y":30},{"x":670,"y":30},{"x":670,"y":72}],"E":2}],"renderStyle":"standard"}}}}
end

"Electric-only WLTC Low phase on the series ground (derived; UNECE phase boundary 589 s)."
analysis SeriesGroundElectricTransient
  extends TransientAnalysis(stop = 589.0, alg = ODEAlg.Rodas5P(), dtmax = 1.0, optimize = OptimizationLevel.None())
  model = SeriesGroundElectric()
end
