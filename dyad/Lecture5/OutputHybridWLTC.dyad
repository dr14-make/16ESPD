ard"}},"starter_sum_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":540,"y":580},{"x":540,"y":500},{"x":260,"y":500},{"x":260,"y":660},{"x":430,"y":660},{"x":430,"y":678}],"E":2}],"renderStyle":"standard"}},"stored_current_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":985,"y":293.09},{"x":985,"y":498}],"E":2}],"renderStyle":"standard"}},"stored_power":{"Dyad":{"placement":{"diagram":{"x1":965,"x2":905,"y1":450,"y2":510}}}},"stored_power_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":538,"y":660},{"x":538,"y":530},{"x":490,"y":530},{"x":490,"y":228},{"x":650,"y":228},{"x":650,"y":100},{"x":870,"y":100},{"x":870,"y":200}],"E":2}],"renderStyle":"standard"}},"stored_voltage_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":975,"y":277.31},{"x":975,"y":462}],"E":2}],"renderStyle":"standard"}},"torque_ref_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":630,"y":182},{"x":630,"y":250},{"x":650,"y":250},{"x":650,"y":266.8}],"E":2}],"renderStyle":"standard"}},"torque_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":845,"y":198.46},{"x":845,"y":391},{"x":288,"y":391}],"E":2}],"renderStyle":"standard"}},"total_stored_power":{"Dyad":{"placement":{"diagram":{"x1":440,"x2":500,"y1":630,"y2":690}}}},"unused_pedal":{"Dyad":{"placement":{"diagram":{"x1":560,"x2":600,"y1":283.7,"y2":323.7}}}},"unused_pedal_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":630,"y":303.7},{"x":630,"y":303.6}],"E":2}],"renderStyle":"standard"}}}}
end

"Full WLTC P3 position analysis (derived; shared duration and solver)."
analysis OutputHybridWLTCTransient
  extends TransientAnalysis(stop = 1800.0, alg = ODEAlg.Rodas5P(), dtmax = 1.0, optimize = OptimizationLevel.None())
  model = OutputHybridWLTC()
end
