x":655.0,"y":330.0},{"x":655.0,"y":224.0}],"S":1}],"renderStyle":"standard"}},"machine_limit_wire":{"Dyad":{"edges":[{"E":2,"M":[{"x":410.0,"y":50.0},{"x":410.0,"y":32.0}],"S":1}],"renderStyle":"standard"}},"limit_ratio_wire":{"Dyad":{"edges":[{"E":2,"M":[{"x":658.0,"y":408.0},{"x":658.0,"y":68.0}],"S":1}],"renderStyle":"standard"}},"manager_shaft_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"referred_limit_wire":{"Dyad":{"edges":[{"E":2,"M":[{"x":501.0,"y":50.0},{"x":501.0,"y":380.0}],"S":1}],"renderStyle":"standard"}},"ratio_export_wire":{"Dyad":{"edges":[{"E":2,"M":[],"S":1}]}},"mount":{"Dyad":{"placement":{"diagram":{"x1":675,"x2":725,"y1":435,"y2":485}}}}}}
end

"Full WLTC P3 position analysis (derived; shared duration and solver)."
analysis OutputHybridWLTCTransient
  extends TransientAnalysis(stop = 1800.0, alg = ODEAlg.Rodas5P(), dtmax = 1.0, optimize = OptimizationLevel.None())
  model = OutputHybridWLTC()
end
