"""
Rule-based P2 hybrid on the planar WLTC bench (derived; Lecture 5 step 3).
The manager commands engine power and torque; K0 retains the step-2 launch and lock ramps.
The electric-mode CVT target follows demand power to avoid starting against an idle-speed ratio.
"""
test component P2HybridWLTC
  "Vehicle and road-load mass (assumed; shared planar benchmark)"
  parameter m::Mass = 1500.0
  "Wheel radius (derived; planar benchmark)"
  parameter radius::Length = 0.31
  "PI gain [N.m per km/h] (assumed; shared WLTC driver)"
  parameter k::Real = 110.0
  "PI integral time (assumed; shared Lecture 5 driver)"
  parameter Ti::Time = 1.0
  "Signed driver ceiling [N.m]: Engine full-load peak 150.233567 (full_load.csv rounds to 150.234) plus HybridDrive default T_max 205"
  parameter tau_max::Torque = 150.233567 + 205.0
  "Negative PI limit including friction demand at the transmission input [N.m]"
  parameter tau_brake::Torque = tau_max
  "Initial wheel surface speed offset (assumed; MultibodyComponents #185)"
  parameter dv_wheel::Velocity = 0.01
  "Center of K0 launch engagement [rpm] (assumed; step 2)"
  parameter engage_rpm::Real = 1300.0
  "Width of K0 launch engagement [rpm] (assumed; step 2)"
  parameter engage_width_rpm::Real(min = eps(Float64)) = 120.0
  "Center of machine-side K0 lock-up [rpm] (assumed; step 2)"
  parameter lock_rpm::Real = 840.0
  "Width of machine-side K0 lock-up [rpm] (assumed; step 2)"
  parameter lock_width_rpm::Real(min = eps(Float64)) = 12.0
  trace = VehicleSystemsComponents.Vehicle.DriveCycle() {^trace}
  driver = BlockComponents.Continuous.LimPID(with_D = false, k = k, Ti = Ti, y_max = tau_max, y_min = -tau_brake) {^driver}
  no_ff = BlockComponents.Sources.Constant(k = 0.0) {^no_ff}
  kmh = VehicleSystemsComponents.Vehicle.ToKmPerHour() {^kmh}
  powertrain = VehicleSystemsComponents.Vehicle.P2Powertrain(speed_commanded = true, start_stop = true, position_start = 0.0, engine_speed_start = 0.0) {^powertrain}
  manager = VehicleSystemsComponents.Vehicle.EnergyManager(mapped_limits = true, SoC_on = 0.52, SoC_off = 0.55, P_line_max = 30.0e3) {^manager}
  map = VehicleSystemsComponents.Vehicle.TorqueToPedal() {^map}
  speed_command = VehicleSystemsComponents.Vehicle.HybridLineSpeedCommand() {^speed_command}
  differential = MultibodyComponents.PlanarMechanics.DifferentialGear() {^differential}
  mount = RotationalComponents.Components.Fixed() {^mount}
  straight = RotationalComponents.Components.Fixed() {^straight}
  flat = BlockComponents.Sources.Constant(k = 0.0) {^flat}
  car = VehicleSystemsComponents.Vehicle.Planar.PlanarCar(m = m, radius = radius) {^car}
  motion = VehicleSystemsComponents.Vehicle.Planar.BusMotion() {^motion}
  roadload = VehicleSystemsComponents.Vehicle.Planar.PlanarRoadLoad(m = m) {^roadload}
  meter = VehicleSystemsComponents.Vehicle.SoCCorrectedFuel() {^meter}
  "Stored-energy charging integral [J]; includes regen and engine-driven charging"
  variable E_charge::Energy
  "Requested regenerative braking energy at the machine shaft [J], excludes load-point charging"
  variable E_regen::Energy
  "Actual wheel friction-brake dissipation [J]"
  variable E_friction::Energy
  "Zero for unused command inputs (assumed; fixed-mode fixture)"
  unused_command = BlockComponents.Sources.Constant(k = 0.0) {^unused_command}
  brakes = VehicleSystemsComponents.Vehicle.BrakeSplit(gain = 1.0) {^brakes}
  brake_product = BlockComponents.Math.Product() {^brake_product}
  stored_power = BlockComponents.Math.Product() {^stored_power}
  engagement_command = VehicleSystemsComponents.Vehicle.EngagementCommand(engage_rpm = engage_rpm, engage_width_rpm = engage_width_rpm, lock_rpm = lock_rpm, lock_width_rpm = lock_width_rpm, managed = true) {^engagement_command}
relations
  connect(powertrain.E, stored_power.u1) {^stored_voltage_wire}
  connect(powertrain.i, stored_power.u2) {^stored_current_wire}
  connect(stored_power.y, meter.P_stored) {^stored_power_wire}
  connect(powertrain.engine_speed, engagement_command.engine_speed) {^engagement_engine_wire}
  connect(powertrain.shaft_speed, engagement_command.shaft_speed) {^engagement_shaft_wire}
  connect(manager.engage, engagement_command.enable) {^engagement_enable_wire}
  connect(engagement_command.y, powertrain.engage) {^engagement_wire}
  connect(unused_command.y, powertrain.cvt_pedal) {^unused_wire}
  connect(car.bus, motion.bus) {^bus_wire}
  connect(trace.y, driver.u_s) {^trace_wire}
  connect(motion.vx, kmh.u, meter.speed) {^vx_wire}
  connect(kmh.y, driver.u_m, manager.v) {^kmh_wire}
  connect(no_ff.y, driver.u_ff) {^ff_wire}
  connect(driver.y, manager.tau_dem) {^dem_wire}
  connect(powertrain.shaft_speed, manager.w_shaft) {^manager_shaft_wire}
  connect(powertrain.SoC, manager.SoC) {^soc_wire}
  connect(powertrain.engine_speed, manager.engine_speed, map.omega) {^speed_wire}
  connect(powertrain.available_torque, manager.available_torque) {^torque_wire}
  connect(manager.P_engine, speed_command.P_engine) {^line_wire}
  connect(manager.tau_engine, map.tau, powertrain.engine_torque_ref) {^torque_ref_wire}
  connect(map.pedal, powertrain.engine_pedal) {^pedal_wire}
  connect(manager.engine_on, powertrain.engine_on) {^engine_on_wire}
  connect(manager.tau_machine, powertrain.tau_ref) {^machine_wire}
  connect(manager.P_drive, speed_command.P_drive) {^drive_power_wire}
  connect(manager.engine_on, speed_command.engine_on) {^line_on_wire}
  connect(speed_command.N_ref, powertrain.N_ref) {^speed_command_wire}

  connect(powertrain.spline, differential.flange_b) {^spline_wire}
  connect(differential.flange_left, car.spin_fl) {^left_wire}
  connect(differential.flange_right, car.spin_fr) {^right_wire}
  connect(powertrain.support, mount.spline) {^mount_wire}
  connect(car.steering, straight.spline) {^steering_wire}
  connect(flat.y, roadload.grade) {^grade_wire}
  connect(car.chassis, roadload.chassis) {^chassis_wire}
  connect(powertrain.mdot_fuel, meter.mdot_fuel) {^fuel_wire}
  connect(manager.tau_friction, brake_product.u1) {^friction_input_wire}
  connect(powertrain.ratio, brake_product.u2) {^brake_ratio_wire}
  connect(brake_product.y, brakes.u) {^brake_demand_wire}
  connect(brakes.tau_fl, car.tau_fl) {^brake_fl_wire}
  connect(brakes.tau_fr, car.tau_fr) {^brake_fr_wire}
  connect(brakes.tau_rl, car.tau_rl) {^brake_rl_wire}
  connect(brakes.tau_rr, car.tau_rr) {^brake_rr_wire}
  der(E_charge) = max(-meter.P_stored, 0.0)
  der(E_regen) = manager.tau_regen * max(manager.w_shaft, 0.0)
  der(E_friction) = car.fl.brake.tau_friction * car.fl.brake.w + car.fr.brake.tau_friction * car.fr.brake.w + car.rl.brake.tau_friction * car.rl.brake.w + car.rr.brake.tau_friction * car.rr.brake.w
  initial E_charge = 0.0
  initial E_regen = 0.0
  initial E_friction = 0.0
  initial car.body.r = [0, 0]
  initial car.body.v = [0, 0]
  initial car.body.phi = 0.0
  initial car.body.w = 0.0
  initial car.fl.inertia.w = dv_wheel / radius
  initial car.fr.inertia.w = dv_wheel / radius
  initial car.rl.inertia.w = dv_wheel / radius
  initial car.rr.inertia.w = dv_wheel / radius
  initial car.fl.inertia.phi = 0.0
  initial car.fr.inertia.phi = 0.0
  initial car.rl.inertia.phi = 0.0
  initial car.rr.inertia.phi = 0.0
  initial car.fl.brake.tau_actual = 0.0
  initial car.fr.brake.tau_actual = 0.0
  initial car.rl.brake.tau_actual = 0.0
  initial car.rr.brake.tau_actual = 0.0
  initial powertrain.drive.converter.i_out = 0.0
metadata {"_links":{"brake_product":{"Dyad":{"placement":{"diagram":{"x1":380,"x2":320,"y1":540,"y2":600}}}},"friction_input_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":455,"y":310},{"x":455,"y":552}],"E":2}],"renderStyle":"standard"}},"brake_ratio_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":649,"y":437},{"x":475,"y":437},{"x":475,"y":588}],"E":2}],"renderStyle":"standard"}},"brake_demand_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":230,"y":570},{"x":230,"y":750}],"E":2}],"renderStyle":"standard"}},"trace":{"Dyad":{"placement":{"diagram":{"x1":20,"x2":80,"y1":109.3,"y2":169.3}}}},"no_ff":{"Dyad":{"placement":{"diagram":{"x1":80,"x2":130,"y1":30,"y2":80}}}},"driver":{"Dyad":{"placement":{"diagram":{"x1":110,"x2":200,"y1":115,"y2":205}}}},"kmh":{"Dyad":{"placement":{"diagram":{"x1":20,"x2":80,"y1":200,"y2":260}}}},"powertrain":{"Dyad":{"placement":{"diagram":{"x1":640,"x2":820,"y1":110,"y2":350}}}},"mount":{"Dyad":{"placement":{"diagram":{"x1":805,"x2":855,"y1":485,"y2":520}}}},"differential":{"Dyad":{"placement":{"diagram":{"x1":550,"x2":790,"y1":720,"y2":480}}}},"meter":{"Dyad":{"placement":{"diagram":{"x1":890,"x2":970,"y1":158.8,"y2":238.8}}}},"straight":{"Dyad":{"placement":{"diagram":{"x1":650,"x2":690,"y1":785,"y2":820,"rot":180}}}},"car":{"Dyad":{"placement":{"diagram":{"x1":595,"x2":745,"y1":825,"y2":975}}}},"motion":{"Dyad":{"placement":{"diagram":{"x1":785,"x2":885,"y1":850,"y2":950}}}},"roadload":{"Dyad":{"placement":{"diagram":{"x1":485,"x2":555,"y1":905,"y2":975}}}},"flat":{"Dyad":{"placement":{"diagram":{"x1":415,"x2":455,"y1":920,"y2":960}}}},"manager":{"Dyad":{"placement":{"diagram":{"x1":250,"x2":440,"y1":130,"y2":330}}}},"map":{"Dyad":{"placement":{"diagram":{"x1":600,"x2":625,"y1":227.7,"y2":197.7}}}},"ff_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":155,"y":55}],"E":2}],"renderStyle":"standard"}},"dem_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"kmh_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":95,"y":230},{"x":95,"y":180.7}],"E":2},{"S":1,"M":[],"E":3}],"renderStyle":"standard"}},"line_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":448,"y":150},{"x":448,"y":110},{"x":434,"y":110},{"x":434,"y":26}],"E":2}],"renderStyle":"standard"}},"torque_ref_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":470,"y":182},{"x":470,"y":206.7}],"E":2},{"S":1,"M":[{"x":470,"y":182},{"x":470,"y":141.2}],"E":3}],"renderStyle":"standard"}},"pedal_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"machine_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":480,"y":278},{"x":480,"y":268.4}],"E":2}],"renderStyle":"standard"}},"mount_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":830,"y":350}],"E":2}],"renderStyle":"standard"}},"spline_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":868,"y":141.2},{"x":868,"y":468}],"E":2}],"renderStyle":"standard"}},"left_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":538,"y":862.5}],"E":2}],"renderStyle":"standard"}},"chassis_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":570,"y":975},{"x":570,"y":940}],"E":2}],"renderStyle":"standard"}},"right_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":802,"y":762},{"x":760,"y":762},{"x":760,"y":862.5}],"E":2}],"renderStyle":"standard"}},"speed_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":850,"y":191.6},{"x":850,"y":415},{"x":227,"y":415},{"x":227,"y":265}],"E":2},{"S":1,"M":[{"x":850,"y":191.6},{"x":850,"y":415},{"x":612.5,"y":415}],"E":3}],"renderStyle":"standard"}},"soc_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":840,"y":208.4},{"x":840,"y":403},{"x":239,"y":403},{"x":239,"y":300}],"E":2}],"renderStyle":"standard"}},"torque_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":830,"y":225.2},{"x":830,"y":391},{"x":288,"y":391}],"E":2}],"renderStyle":"standard"}},"fuel_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"vx_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":990,"y":876},{"x":990,"y":3},{"x":5,"y":3},{"x":5,"y":230}],"E":2},{"S":1,"M":[{"x":990,"y":876},{"x":990,"y":260},{"x":884,"y":260},{"x":884,"y":222.8}],"E":3}],"renderStyle":"standard"}},"unused_command":{"Dyad":{"placement":{"diagram":{"x1":502,"x2":542,"y1":296.4,"y2":336.4}}}},"unused_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"speed_command":{"Dyad":{"placement":{"diagram":{"x1":480,"x2":540,"y1":12,"y2":82}}}},"drive_power_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":345,"y":47}],"E":2}],"renderStyle":"standard"}},"line_on_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":460,"y":214},{"x":460,"y":118},{"x":427,"y":118},{"x":427,"y":68}],"E":2}],"renderStyle":"standard"}},"speed_command_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":594,"y":47},{"x":594,"y":292.4}],"E":2}],"renderStyle":"standard"}},"brakes":{"Dyad":{"placement":{"diagram":{"x1":240,"x2":360,"y1":690,"y2":810}}}},"brake_fl_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":520,"y":714},{"x":520,"y":847.5}],"E":2}],"renderStyle":"standard"}},"brake_fr_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":745,"y":738},{"x":745,"y":810},{"x":770,"y":810},{"x":770,"y":847.5}],"E":2}],"renderStyle":"standard"}},"brake_rl_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":500,"y":762},{"x":500,"y":892},{"x":580,"y":892},{"x":580,"y":922.5}],"E":2}],"renderStyle":"standard"}},"brake_rr_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":630,"y":786},{"x":630,"y":770},{"x":775,"y":770},{"x":775,"y":922.5}],"E":2}],"renderStyle":"standard"}},"bus_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"trace_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"engine_on_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":460,"y":214},{"x":460,"y":239.1}],"E":2}],"renderStyle":"standard"}},"steering_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"grade_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"stored_power":{"Dyad":{"placement":{"diagram":{"x1":900,"x2":960,"y1":290,"y2":350}}}},"engagement_command":{"Dyad":{"placement":{"diagram":{"x1":780,"x2":700,"y1":25,"y2":75}}}},"stored_voltage_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"stored_current_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":890,"y":326},{"x":890,"y":338}],"E":2}],"renderStyle":"standard"}},"stored_power_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":975,"y":320},{"x":975,"y":275},{"x":876,"y":275},{"x":876,"y":198.8}],"E":2}],"renderStyle":"standard"}},"engagement_engine_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":850,"y":191.6},{"x":850,"y":37.5}],"E":2}],"renderStyle":"standard"}},"engagement_shaft_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":860,"y":122},{"x":860,"y":62.5}],"E":2}],"renderStyle":"standard"}},"engagement_enable_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":578,"y":246},{"x":578,"y":14},{"x":740,"y":14}],"E":2}],"renderStyle":"standard"}},"engagement_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":630,"y":50},{"x":630,"y":162.8}],"E":2}],"renderStyle":"standard"}},"manager_shaft_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":860,"y":122},{"x":860,"y":427},{"x":215,"y":427},{"x":215,"y":195}],"E":2}],"renderStyle":"standard"}}}}
end

"Full WLTC hybrid energy-management analysis (derived; Lecture 5 step 3)."
analysis P2HybridWLTCTransient
  extends TransientAnalysis(stop = 1800.0, alg = ODEAlg.Rodas5P(), dtmax = 1.0, optimize = OptimizationLevel.None())
  model = P2HybridWLTC()
end
