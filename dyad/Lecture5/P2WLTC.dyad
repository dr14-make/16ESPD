,"y":320}],"E":2}],"renderStyle":"standard"}},"spline_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":740,"y":146},{"x":740,"y":468}],"E":2}],"renderStyle":"standard"}},"left_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":538,"y":862.5}],"E":2}],"renderStyle":"standard"}},"right_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":802,"y":762},{"x":760,"y":762},{"x":760,"y":862.5}],"E":2}],"renderStyle":"standard"}},"chassis_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":570,"y":975},{"x":570,"y":940}],"E":2}],"renderStyle":"standard"}},"fuel_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard"}},"vx_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":980,"y":876},{"x":980,"y":10},{"x":10,"y":10},{"x":10,"y":360}],"E":2},{"S":1,"M":[{"x":980,"y":876},{"x":980,"y":272},{"x":860,"y":272},{"x":860,"y":228}],"E":3}],"renderStyle":"standard"}},"unused_command":{"Dyad":{"placement":{"diagram":{"x1":375,"x2":435,"y1":116,"y2":176}}}},"pedal_command":{"Dyad":{"placement":{"diagram":{"x1":375,"x2":435,"y1":340,"y2":400}}}},"unused_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":470,"y":146},{"x":470,"y":272}],"E":2},{"S":1,"M":[],"E":3}],"renderStyle":"standard"}},"cvt_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":510,"y":385},{"x":510,"y":292}],"E":2}],"renderStyle":"standard"}},"brakes":{"Dyad":{"placement":{"diagram":{"x1":240,"x2":360,"y1":690,"y2":810}}}},"brake_fl_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":525,"y":714},{"x":525,"y":847.5}],"E":2}],"renderStyle":"standard"}},"brake_fr_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":745,"y":738},{"x":745,"y":810},{"x":770,"y":810},{"x":770,"y":847.5}],"E":2}],"renderStyle":"standard"}},"brake_rl_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":500,"y":762},{"x":500,"y":892},{"x":580,"y":892},{"x":580,"y":922.5}],"E":2}],"renderStyle":"standard"}},"brake_rr_wire":{"Dyad":{"edges":[{"S":1,"M":[{"x":630,"y":786},{"x":630,"y":770},{"x":775,"y":770},{"x":775,"y":922.5}],"E":2}],"renderStyle":"standard"}},"bus_wire":{"Dyad":{"edges":[{"S":1,"M":[],"E":2}],"renderStyle":"standard