"""Split-friction straight stop with four-channel ABS and optional yaw-control braking."""
test component SplitMuStop
  parameter v0::Velocity = 22.22222222222222
  parameter T_cmd::Torque = 2500.0
  parameter mu_scale_right::Real = 0.3
  parameter select_low::Real = 0.0
  parameter esp_on::Real = 0.0
  parameter Kp::Real = 40000.0
  parameter Ki::Real = 100000.0
  parameter radius::Length = 0.31
  parameter k_dec::Real = 40000.0
  parameter k_inc_fast::Real = 160000.0
  parameter k_inc_slow::Real = 16000.0
  parameter h_cg::Length = 0.0
  parameter R_build::Real = 1.0e9
  structural parameter load_transfer::Boolean = true
  steer = BlockComponents.Sources.Constant(k = 0.0) {^steer}
  demand = BlockComponents.Sources.Step(offset = 0.0, height = T_cmd, start_time = 0.5) {^demand}
  steering_robot = VehicleSystemsComponents.Vehicle.Planar.SteeringRobot() {^steering_robot}
  car = VehicleSystemsComponents.Vehicle.Planar.PlanarCar(radius = radius, mu_scale_fr = mu_scale_right, mu_scale_rr = mu_scale_right, h_cg = h_cg, load_transfer = load_transfer) {^car}
  motion = VehicleSystemsComponents.Vehicle.Planar.BusMotion() {^motion}
  slips = VehicleSystemsComponents.Vehicle.Planar.BusSlip() {^slips}
  ecu = VehicleSystemsComponents.Vehicle.Planar.BrakeControlUnit(R_build = R_build, esp_on = esp_on, Kp = Kp, Ki = Ki, radius = radius, select_low = select_low, k_dec = k_dec, k_inc_fast = k_inc_fast, k_inc_slow = k_inc_slow) {^ecu}
relations
  connect(car.bus, motion.bus, slips.bus) {^wbus}
  connect(steer.y, steering_robot.delta_sw_ref) {^w1}
  connect(steering_robot.steering, car.steering) {^w2}
  connect(demand.y, ecu.demand) {^w14}
  connect(motion.delta_sw, ecu.delta_sw) {^w15}
  connect(motion.r, ecu.r) {^w16}
  connect(motion.vx, ecu.vx) {^w17}
  connect(slips.kappa_fl, ecu.kappa_fl) {^w18}
  connect(slips.kappa_fr, ecu.kappa_fr) {^w19}
  connect(slips.kappa_rl, ecu.kappa_rl) {^w20}
  connect(slips.kappa_rr, ecu.kappa_rr) {^w21}
  connect(ecu.tau_fl, car.tau_fl) {^w22}
  connect(ecu.tau_fr, car.tau_fr) {^w23}
  connect(ecu.tau_rl, car.tau_rl) {^w24}
  connect(ecu.tau_rr, car.tau_rr) {^w25}
  initial car.body.r = [0, 0]
  initial car.body.v = [v0, 0]
  initial car.body.phi = 0.0
  initial car.body.w = 0.0
  initial car.fl.inertia.w = (v0 + 0.01) / radius
  initial car.fr.inertia.w = (v0 + 0.01) / radius
  initial car.rl.inertia.w = (v0 + 0.01) / radius
  initial car.rr.inertia.w = (v0 + 0.01) / radius
  initial car.fl.inertia.phi = 0.0
  initial car.fr.inertia.phi = 0.0
  initial car.rl.inertia.phi = 0.0
  initial car.rr.inertia.phi = 0.0
  initial car.fl.brake.tau_actual = 0.0
  initial car.fr.brake.tau_actual = 0.0
  initial car.rl.brake.tau_actual = 0.0
  initial car.rr.brake.tau_actual = 0.0
metadata {
  "Dyad": {
    "tests": {
      "abs_only": {
        "solver": "Tsit5", "stop": 6.0,
        "params": {"load_transfer": false},
        "expect": {"signals": ["car.bus.x", "car.bus.y", "car.bus.psi", "car.bus.vx", "car.bus.kappa_fl", "car.bus.kappa_fr", "ecu.abs.hold_fl.y", "ecu.abs.hold_fr.y"]}
      }
    }
  },
  "_links": {
    "motion": {"Dyad": {"placement": {"diagram": {"x1": 720, "y1": 380, "x2": 800, "y2": 580}}}},
    "slips": {"Dyad": {"placement": {"diagram": {"x1": 840, "y1": 430, "x2": 900, "y2": 530}}}},
    "wbus": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}, {"S": 1, "M": [], "E": 3}]}},
    "car": {"Dyad": {"placement": {"diagram": {"x1": 440, "y1": 380, "x2": 640, "y2": 580}}}},
    "steer": {"Dyad": {"placement": {"diagram": {"x1": 30, "y1": 210, "x2": 110, "y2": 290}}}},
    "steering_robot": {"Dyad": {"placement": {"diagram": {"x1": 180, "y1": 200, "x2": 280, "y2": 300}}}},
    "ecu": {"Dyad": {"placement": {"diagram": {"x1": 180, "y1": 380, "x2": 380, "y2": 580}}}},
    "demand": {"Dyad": {"placement": {"diagram": {"x1": 30, "y1": 370, "x2": 90, "y2": 430}}}},
    "w1": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w2": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 540.0, "y": 250.0}], "E": 2}]}},
    "w14": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w21": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 915, "y": 520.0}, {"x": 915, "y": 630}, {"x": 250.0, "y": 630}], "E": 2}]}},
    "w20": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 925, "y": 500.0}, {"x": 925, "y": 640}, {"x": 220.0, "y": 640}], "E": 2}]}},
    "w19": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 935, "y": 480.0}, {"x": 935, "y": 650}, {"x": 150, "y": 650}, {"x": 150, "y": 550.0}], "E": 2}]}},
    "w18": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 945, "y": 460.0}, {"x": 945, "y": 660}, {"x": 140, "y": 660}, {"x": 140, "y": 520.0}], "E": 2}]}},
    "w17": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 955, "y": 440.0}, {"x": 955, "y": 670}, {"x": 130, "y": 670}, {"x": 130, "y": 490.0}], "E": 2}]}},
    "w16": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 965, "y": 420.0}, {"x": 965, "y": 680}, {"x": 120, "y": 680}, {"x": 120, "y": 460.0}], "E": 2}]}},
    "w15": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 975, "y": 400.0}, {"x": 975, "y": 690}, {"x": 110, "y": 690}, {"x": 110, "y": 430.0}], "E": 2}]}},
    "w22": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w23": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w24": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w25": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}}
  }
}
end

analysis SplitMuStopTransient
  extends TransientAnalysis(stop = 6.0, alg = ODEAlg.Tsit5(), dtmax = 0.005, optimize = OptimizationLevel.None())
  parameter v0::Velocity = 22.22222222222222
  parameter T_cmd::Torque = 2500.0
  parameter mu_scale_right::Real = 0.3
  parameter select_low::Real = 0.0
  parameter esp_on::Real = 0.0
  parameter Kp::Real = 40000.0
  parameter Ki::Real = 100000.0
  parameter k_dec::Real = 40000.0
  parameter k_inc_fast::Real = 160000.0
  parameter k_inc_slow::Real = 16000.0
  parameter h_cg::Length = 0.0
  parameter R_build::Real = 1.0e9
  model = VehicleSystemsComponents.Lecture3.SplitMuStop(R_build = R_build, v0 = v0, T_cmd = T_cmd, mu_scale_right = mu_scale_right, select_low = select_low, esp_on = esp_on, Kp = Kp, Ki = Ki, k_dec = k_dec, k_inc_fast = k_inc_fast, k_inc_slow = k_inc_slow, h_cg = h_cg)
relations
end
