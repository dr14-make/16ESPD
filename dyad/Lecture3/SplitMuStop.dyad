"""Split-friction straight stop with four-channel ABS and optional yaw-control braking."""
test component SplitMuStop
  parameter v0::Velocity = 22.22222222222222
  parameter T_cmd::Torque = 2500.0
  parameter mu_scale_right::Real = 0.3
  parameter select_low::Real = 0.0
  parameter esp_on::Real = 0.0
  parameter Kp::Real = 40000.0
  parameter Ki::Real = 100000.0
  parameter radius::Length = 0.31
  parameter k_dec::Real = 40000.0
  parameter k_inc_fast::Real = 160000.0
  parameter k_inc_slow::Real = 16000.0
  parameter h_cg::Length = 0.0
  structural parameter load_transfer::Boolean = true
  steer = BlockComponents.Sources.Constant(k = 0.0) {^steer}
  demand = BlockComponents.Sources.Step(offset = 0.0, height = T_cmd, start_time = 0.5) {^demand}
  wheel_pos = RotationalComponents.Sources.Position() {^wheel_pos}
  steering_fixed = RotationalComponents.Components.Fixed() {^steering_fixed}
  car = VehicleSystemsComponents.Vehicle.Planar.PlanarCar(radius = radius, mu_scale_fr = mu_scale_right, mu_scale_rr = mu_scale_right, h_cg = h_cg, load_transfer = load_transfer) {^car}
  sensors = VehicleSystemsComponents.Vehicle.Planar.PlanarCarSensors(radius = radius) {^sensors}
  esp = VehicleSystemsComponents.Vehicle.Planar.ESPController(Kp = Kp, Ki = Ki, radius = radius) {^esp}
  clock = DiscreteComponents.PeriodicClock(dt = 0.005) {^clock}
  demand_sampler = DiscreteComponents.Sampler() {^demand_sampler}
  speed_sampler = DiscreteComponents.Sampler() {^speed_sampler}
  kappa_fl_sampler = DiscreteComponents.Sampler() {^kappa_fl_sampler}
  kappa_fr_sampler = DiscreteComponents.Sampler() {^kappa_fr_sampler}
  kappa_rl_sampler = DiscreteComponents.Sampler() {^kappa_rl_sampler}
  kappa_rr_sampler = DiscreteComponents.Sampler() {^kappa_rr_sampler}
  dT_fl_sampler = DiscreteComponents.Sampler() {^dT_fl_sampler}
  dT_fr_sampler = DiscreteComponents.Sampler() {^dT_fr_sampler}
  dT_rl_sampler = DiscreteComponents.Sampler() {^dT_rl_sampler}
  dT_rr_sampler = DiscreteComponents.Sampler() {^dT_rr_sampler}
  abs = VehicleSystemsComponents.Vehicle.Planar.FourChannelABS(select_low = select_low, k_dec = k_dec, k_inc_fast = k_inc_fast, k_inc_slow = k_inc_slow) {^abs}
  hold_fl = DiscreteComponents.ZeroOrderHold() {^hold_fl}
  hold_fr = DiscreteComponents.ZeroOrderHold() {^hold_fr}
  hold_rl = DiscreteComponents.ZeroOrderHold() {^hold_rl}
  hold_rr = DiscreteComponents.ZeroOrderHold() {^hold_rr}
relations
  connect(steer.y, wheel_pos.phi_ref) {^w1}
  connect(wheel_pos.spline, car.steering) {^w2}
  connect(wheel_pos.support, steering_fixed.spline) {^w3}
  connect(car.chassis, sensors.chassis) {^w4}
  connect(car.steering, sensors.steering) {^w5}
  connect(car.wheel_fl, sensors.wheel_fl) {^w6}
  connect(car.wheel_fr, sensors.wheel_fr) {^w7}
  connect(car.wheel_rl, sensors.wheel_rl) {^w8}
  connect(car.wheel_rr, sensors.wheel_rr) {^w9}
  connect(car.spin_fl, sensors.spin_fl) {^w10}
  connect(car.spin_fr, sensors.spin_fr) {^w11}
  connect(car.spin_rl, sensors.spin_rl) {^w12}
  connect(car.spin_rr, sensors.spin_rr) {^w13}
  connect(sensors.delta_sw, esp.delta_sw) {^w14}
  connect(sensors.r, esp.r) {^w15}
  connect(sensors.vx, esp.vx) {^w16}
  connect(demand.y, demand_sampler.u) {^w17}
  connect(sensors.vx, speed_sampler.u) {^w18}
  connect(sensors.kappa_fl, kappa_fl_sampler.u) {^w19}
  connect(sensors.kappa_fr, kappa_fr_sampler.u) {^w20}
  connect(sensors.kappa_rl, kappa_rl_sampler.u) {^w21}
  connect(sensors.kappa_rr, kappa_rr_sampler.u) {^w22}
  dT_fl_sampler.u = esp_on * esp.dT_fl
  dT_fr_sampler.u = esp_on * esp.dT_fr
  dT_rl_sampler.u = esp_on * esp.dT_rl
  dT_rr_sampler.u = esp_on * esp.dT_rr
  connect(demand_sampler.y, abs.demand, clock.y) {^w23}
  connect(speed_sampler.y, abs.v_ref) {^w24}
  connect(kappa_fl_sampler.y, abs.kappa_fl) {^w25}
  connect(kappa_fr_sampler.y, abs.kappa_fr) {^w26}
  connect(kappa_rl_sampler.y, abs.kappa_rl) {^w27}
  connect(kappa_rr_sampler.y, abs.kappa_rr) {^w28}
  connect(dT_fl_sampler.y, abs.dT_fl) {^w29}
  connect(dT_fr_sampler.y, abs.dT_fr) {^w30}
  connect(dT_rl_sampler.y, abs.dT_rl) {^w31}
  connect(dT_rr_sampler.y, abs.dT_rr) {^w32}
  connect(abs.tau_fl, hold_fl.u) {^w33}
  connect(abs.tau_fr, hold_fr.u) {^w34}
  connect(abs.tau_rl, hold_rl.u) {^w35}
  connect(abs.tau_rr, hold_rr.u) {^w36}
  connect(hold_fl.y, car.tau_fl) {^w37}
  connect(hold_fr.y, car.tau_fr) {^w38}
  connect(hold_rl.y, car.tau_rl) {^w39}
  connect(hold_rr.y, car.tau_rr) {^w40}
  initial car.body.r = [0, 0]
  initial car.body.v = [v0, 0]
  initial car.body.phi = 0.0
  initial car.body.w = 0.0
  initial car.fl.inertia.w = (v0 + 0.01) / radius
  initial car.fr.inertia.w = (v0 + 0.01) / radius
  initial car.rl.inertia.w = (v0 + 0.01) / radius
  initial car.rr.inertia.w = (v0 + 0.01) / radius
  initial car.fl.inertia.phi = 0.0
  initial car.fr.inertia.phi = 0.0
  initial car.rl.inertia.phi = 0.0
  initial car.rr.inertia.phi = 0.0
  initial car.fl.brake.tau_actual = 0.0
  initial car.fr.brake.tau_actual = 0.0
  initial car.rl.brake.tau_actual = 0.0
  initial car.rr.brake.tau_actual = 0.0
  initial wheel_pos.w = 0.0
metadata {
  "Dyad": {
    "tests": {
      "abs_only": {
        "solver": "Tsit5", "stop": 6.0,
        "params": {"load_transfer": false},
        "expect": {"signals": ["sensors.x", "sensors.y", "sensors.psi", "sensors.vx", "sensors.kappa_fl", "sensors.kappa_fr", "hold_fl.y", "hold_fr.y"]}
      }
    }
  },
  "_links": {
    "steer": {"Dyad": {"placement": {"diagram": {"x1": 950, "y1": 250, "x2": 1050, "y2": 350}}}},
    "demand": {"Dyad": {"placement": {"diagram": {"x1": 100, "y1": 495, "x2": 200, "y2": 595}}}},
