end

"""
Dry-road stop of `FullCarVacuumStop` from the 90 km/h cruise at the brake pedal of
`VacuumPedalStop`. Tsit5 with dtmax 1 ms resolves the booster chambers and the brake lines without
stiffness trouble; the car is at rest by 3.5 s.
"""
analysis FullCarVacuumStopTransient
  extends TransientAnalysis(stop = 6.0, alg = ODEAlg.Tsit5(), dtmax = 1e-3)
  parameter pedal::Real = 0.3
  parameter road_mu::Real = 1.0
  parameter p_vac0::Pressure = 54420
  model = FullCarVacuumStop(pedal = pedal, road_mu = road_mu, p_vac0 = p_vac0)
end
