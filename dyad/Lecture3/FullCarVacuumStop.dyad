"""
Lecture 3 whole-car vacuum stop: the Hands-on 02 map engine with fuel cut, its flywheel and the
CVT (centrifugal clutch and pedal-scheduled variator) drive the hydraulic braked wheel, and build
02's brake chain, with `Vehicle.Brake.VacuumBooster` in place of the static booster, stops it.
One hose joins the booster to that engine's intake manifold: the booster sees the manifold
pressure, and the air it draws flows back into the manifold.

The car cruises steadily at `speed_kmh` with the throttle pedal at `pedal_cmd`. At `brake_time`
the driver lifts off, so the throttle closes and the manifold falls toward full vacuum, and the
brake pedal steps to `pedal`. While the clutch holds, the engine and flywheel inertia, reflected
through the variator ratio squared, and the closed-throttle motoring torque sit on the braked
wheel; the clutch opens once the engine falls toward its 1300 rpm engagement speed.

`p_vac0` defaults to the cruise manifold pressure: through a long cruise the front-chamber leak
brings the store up to the manifold, where the check valve holds it.
"""
component FullCarVacuumStop
  "Brake pedal command after brake_time, 0 released to 1 floored"
  parameter pedal::Real = 0.3
  parameter road_mu::Real = 1.0
  "Throttle released and brake applied at [s]"
  parameter brake_time::Time = 0.5
  "Initial road speed [km/h], 90 km/h cruise (Hands-on 02)"
  parameter speed_kmh::Real = 90
  "Throttle pedal that holds speed_kmh (MappedCarBrakeStop, derived)"
  parameter pedal_cmd::Real = 0.0916
  "Initial engine speed [rpm], steady at pedal_cmd (MappedCarBrakeStop, derived)"
  parameter rpm0::Real = 2182
  "Initial manifold pressure, steady at pedal_cmd (MappedCarBrakeStop, derived)"
  parameter p_m0::Pressure = 54420
  "Booster front-chamber pressure at the start [Pa], the cruise manifold"
  parameter p_vac0::Pressure = p_m0
  final parameter r_w::Length = 0.31
  "Driver's throttle pedal, released at brake_time"
  throttle_pedal = BlockComponents.Sources.Step(height = -pedal_cmd, offset = pedal_cmd, start_time = brake_time) {^throttle_pedal}
  command = BlockComponents.Sources.Step(height = pedal, offset = 0.0, start_time = brake_time) {^command}
  road = BlockComponents.Sources.Constant(k = road_mu) {^road}
  engine = VehicleSystemsComponents.HandsOn02.MapEngineFuelCut() {^engine}
  "Crankshaft and flywheel, J as MappedEngine assumes"
  flywheel = RotationalComponents.Components.Inertia(J = 0.15) {^flywheel}
  clutch = VehicleSystemsComponents.Vehicle.CentrifugalClutch() {^clutch}
  variator = VehicleSystemsComponents.Vehicle.ControlledVariator(ratio_initial = rpm0 * pi / 30 * r_w / (speed_kmh / 3.6)) {^variator}
  "Engine mounts and gearbox housing"
  housing = RotationalComponents.Components.Fixed() {^housing}
  pedal_unit = VehicleSystemsComponents.Vehicle.Brake.BrakePedal() {^pedal_unit}
  booster = VehicleSystemsComponents.Vehicle.Brake.VacuumBooster(p_init = p_vac0) {^booster}
  master = VehicleSystemsComponents.Vehicle.Brake.TandemMasterCylinder() {^master}
  line_f = VehicleSystemsComponents.Vehicle.Brake.BrakeLine() {^line_f}
  line_r = VehicleSystemsComponents.Vehicle.Brake.BrakeLine(L = 4.0) {^line_r}
  wheel = VehicleSystemsComponents.Vehicle.Wheel.HydraulicBrakedWheel(radius = r_w) {^wheel}
  body = VehicleSystemsComponents.HandsOn.Body() {^body}
  fixed = RotationalComponents.Components.Fixed() {^fixed}
  fixed_hydraulic = TranslationalComponents.Components.Fixed() {^fixed_hydraulic}
  speed = TranslationalComponents.Sensors.VelocitySensor() {^speed}
  path medium::HydraulicComponents.Interfaces.AbstractMedium = HydraulicComponents.IsothermalCompressible(bulk_modulus = 1.4e9, density = 1045.0, let_gas = false)
relations
  connect(throttle_pedal.y, engine.pedal, variator.pedal) {^id1}
  connect(engine.spline, flywheel.spline_a) {^id2}
  connect(flywheel.spline_b, clutch.spline_a) {^id3}
  connect(clutch.spline_b, variator.spline_a) {^id4}
  connect(variator.spline_b, wheel.spline) {^id5}
  connect(engine.support, clutch.support, variator.support, housing.spline) {^id6}
  connect(engine.vacuum, booster.vacuum) {^id7}
  connect(command.y, pedal_unit.u) {^id9}
  connect(pedal_unit.rod, booster.input) {^id10}
  connect(booster.rod_out, master.pushrod) {^id11}
  connect(pedal_unit.support, booster.support, master.support, fixed_hydraulic.flange) {^id12}
  connect(master.front, line_f.port_a) {^id13}
  connect(line_f.port_b, wheel.front) {^id14}
  connect(master.rear, line_r.port_a) {^id15}
  connect(line_r.port_b, wheel.rear) {^id16}
  continuity(medium, master.front.medium)
  connect(road.y, wheel.mu_scale) {^id17}
  connect(wheel.support, fixed.spline) {^id18}
  connect(wheel.flange, body.flange, speed.flange) {^id19}
  initial engine.air.manifold.p = p_m0
  initial flywheel.w = rpm0 * pi / 30
  initial flywheel.phi = 0
  initial clutch.spline_b.phi = 0
  initial wheel.inertia.phi = 0
  initial wheel.inertia.w = speed_kmh / 3.6 / r_w
  initial body.mass.s = 0
  initial body.mass.v = speed_kmh / 3.6
metadata {
