"""
Lecture 3 demo bench: the whole brake chain on one wheel. The engine's air path, at a
prescribed throttle and engine speed, or an electric vacuum pump feeds the vacuum booster
through its check valve. The booster drives the tandem master cylinder, and each circuit runs
through its own two-solenoid ABS modulator and brake line to the calipers of the hydraulic
braked wheel. A wheel-speed sensor, a reference-speed estimate and the valve-level ABS
controller close the loop.

`p_vac0` is the booster's front-chamber pressure at the start of the stop: 33 kPa is a full
vacuum store (PATH idle), a value near ambient a store the driver has already used up. With
`engine_on = 0` the manifold sits at ambient and the check valve stays shut, so nothing refills
it. `abs_on = 0` holds the inlet valves open and the outlet valves and return pumps off, which
leaves a plain hydraulic brake with the modulators' flow paths in the lines.
"""
component FullBrakeABSStop
  parameter pedal::Real = 0.6
  parameter road_mu::Real = 1.0
  "Throttle position: 0 closed (idle), 1 wide open"
  parameter u_thr::Real = 0.0
  "Engine running: 1 on, 0 off (manifold at ambient)"
  parameter engine_on::Real = 1.0
  "Engine speed while running, 83.776 rad/s = 800 rpm"
  parameter omega_e::AngularVelocity = 83.776
  "Vacuum source: 0 the intake manifold, 1 an electric pump"
  parameter ev_pump::Real = 0.0
  "Booster front-chamber pressure at the start [Pa] (PATH idle)"
  parameter p_vac0::Pressure = 33e3
  "ABS: 1 active, 0 valves held at build with the pumps off"
  parameter abs_on::Real = 1.0
  parameter a_ref::Acceleration = 8.0 * road_mu
  final parameter p_atm::Pressure = 101325.0
  command = BlockComponents.Sources.Step(height = pedal, offset = 0.0, start_time = 0.5) {^command}
  road = BlockComponents.Sources.Constant(k = road_mu) {^road}
  throttle = BlockComponents.Sources.Constant(k = u_thr) {^throttle}
  engine_speed = BlockComponents.Sources.Constant(k = engine_on * omega_e) {^engine_speed}
  air = VehicleSystemsComponents.Vehicle.Engine.AirPath() {^air}
  pump = VehicleSystemsComponents.Vehicle.Brake.ElectricVacuumPump(p_init = p_vac0) {^pump}
  pedal_unit = VehicleSystemsComponents.Vehicle.Brake.BrakePedal() {^pedal_unit}
  booster = VehicleSystemsComponents.Vehicle.Brake.VacuumBooster(p_init = p_vac0) {^booster}
  master = VehicleSystemsComponents.Vehicle.Brake.TandemMasterCylinder() {^master}
  modulator_f = VehicleSystemsComponents.Vehicle.Brake.HydraulicModulator() {^modulator_f}
  modulator_r = VehicleSystemsComponents.Vehicle.Brake.HydraulicModulator() {^modulator_r}
  line_f = VehicleSystemsComponents.Vehicle.Brake.BrakeLine() {^line_f}
  line_r = VehicleSystemsComponents.Vehicle.Brake.BrakeLine(L = 4.0) {^line_r}
  controller = VehicleSystemsComponents.Vehicle.ABSValveController() {^controller}
  est = VehicleSystemsComponents.HandsOn03.RefSpeedEstimator(a_ref = a_ref) {^est}
  wspeed = RotationalComponents.Sensors.VelocitySensor() {^wspeed}
  wheel = VehicleSystemsComponents.Vehicle.Wheel.HydraulicBrakedWheel() {^wheel}
  body = VehicleSystemsComponents.HandsOn.Body() {^body}
  fixed = RotationalComponents.Components.Fixed() {^fixed}
  fixed_hydraulic = TranslationalComponents.Components.Fixed() {^fixed_hydraulic}
  speed = TranslationalComponents.Sensors.VelocitySensor() {^speed}
  path medium::HydraulicComponents.Interfaces.AbstractMedium = HydraulicComponents.IsothermalCompressible(bulk_modulus = 1.4e9, density = 1045.0, let_gas = false)
relations
  connect(command.y, pedal_unit.u) {^id1}
  connect(pedal_unit.rod, booster.input) {^id2}
  connect(booster.rod_out, master.pushrod) {^id3}
  connect(pedal_unit.support, booster.support, master.support, fixed_hydraulic.flange) {^id4}
  connect(master.front, modulator_f.port_a) {^id5}
  connect(modulator_f.port_b, line_f.port_a) {^id6}
  connect(line_f.port_b, wheel.front) {^id7}
  connect(master.rear, modulator_r.port_a) {^id8}
  connect(modulator_r.port_b, line_r.port_a) {^id9}
  connect(line_r.port_b, wheel.rear) {^id10}
  continuity(medium, master.front.medium)
  connect(throttle.y, air.u_thr) {^id11}
  connect(engine_speed.y, air.omega) {^id12}
  connect(booster.p_vac, pump.p_sense) {^id13}
  booster.p_src = ifelse(ev_pump > 0.5, pump.p, air.p_m)
  air.mdot_bst = ifelse(ev_pump > 0.5, 0.0, booster.mdot_out)
  pump.mdot_in = ifelse(ev_pump > 0.5, booster.mdot_out, 0.0)
  connect(wspeed.spline, wheel.spline) {^id14}
  connect(wspeed.w, est.omega) {^id15}
  connect(est.kappa_hat, controller.kappa) {^id16}
  connect(est.v_ref, controller.v_ref) {^id17}
  connect(est.a_w, controller.a_w) {^id18}
  connect(master.p_mc, controller.p_mc) {^id19}
  modulator_f.inlet = ifelse(abs_on > 0.5, controller.inlet, 1.0)
  modulator_r.inlet = ifelse(abs_on > 0.5, controller.inlet, 1.0)
  modulator_f.outlet = abs_on * controller.outlet
  modulator_r.outlet = abs_on * controller.outlet
  modulator_f.motor = abs_on * controller.motor
  modulator_r.motor = abs_on * controller.motor
  connect(road.y, wheel.mu_scale) {^id20}
  connect(wheel.support, fixed.spline) {^id21}
  connect(wheel.flange, body.flange, speed.flange) {^id22}
  initial air.manifold.p = ifelse(engine_on > 0.5, 32955.7, p_atm)
  initial wheel.inertia.phi = 0
  initial wheel.inertia.w = 25 / 0.31
  initial body.mass.s = 0
  initial body.mass.v = 25
  initial modulator_f.gallery.V = 0
  initial modulator_r.gallery.V = 0
