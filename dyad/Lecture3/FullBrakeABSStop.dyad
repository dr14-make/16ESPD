end

analysis FullBrakeABSStopTransient
  extends TransientAnalysis(stop = 6.0, alg = ODEAlg.Rodas5P(), dtmax = 1e-3, saveat = 0.001, tstops = [0.5], abstol = 1e-5, reltol = 1e-5)
  parameter pedal::Real = 0.6
  parameter road_mu::Real = 1.0
  parameter u_thr::Real = 0.0
  parameter engine_on::Real = 1.0
  parameter omega_e::AngularVelocity = 83.776
  parameter ev_pump::Real = 0.0
  parameter p_vac0::Pressure = 33e3
  parameter abs_on::Real = 1.0
  model = FullBrakeABSStop(pedal = pedal, road_mu = road_mu, u_thr = u_thr, engine_on = engine_on, omega_e = omega_e, ev_pump = ev_pump, p_vac0 = p_vac0, abs_on = abs_on)
end

analysis FullBrakeABSStopReportTransient
  extends TransientAnalysis(stop = 11.0, alg = ODEAlg.Rodas5P(), dtmax = 1e-3, saveat = 0.001, tstops = [0.5], abstol = 1e-5, reltol = 1e-5)
  parameter pedal::Real = 0.6
  parameter road_mu::Real = 0.3
  parameter u_thr::Real = 0.0
  parameter engine_on::Real = 1.0
  parameter omega_e::AngularVelocity = 83.776
  parameter ev_pump::Real = 0.0
  parameter p_vac0::Pressure = 33e3
  parameter abs_on::Real = 1.0
  model = FullBrakeABSStop(pedal = pedal, road_mu = road_mu, u_thr = u_thr, engine_on = engine_on, omega_e = omega_e, ev_pump = ev_pump, p_vac0 = p_vac0, abs_on = abs_on)
end
