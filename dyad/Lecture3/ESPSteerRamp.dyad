"""Steering ramp with reduced front friction for continuous-ESP understeer checks."""
test component ESPSteerRamp
  parameter v0::Velocity = 22.22222222222222
  parameter delta_sw_final::Angle = 1.7671458676442586
  parameter t_ramp::Time = 7.5
  parameter t_steer::Time = 0.5
  parameter mu_scale_front::Real = 0.7
  parameter esp_on::Real = 1.0
  parameter Kp::Real = 40000.0
  parameter Ki::Real = 0.0
  parameter T_build::Time = 0.1
  parameter radius::Length = 0.31
  parameter h_cg::Length = 0.0
  structural parameter load_transfer::Boolean = true
  steer = BlockComponents.Sources.Ramp(offset = 0.0, height = delta_sw_final, duration = t_ramp, start_time = t_steer) {^steer}
  wheel_pos = RotationalComponents.Sources.Position() {^wheel_pos}
  steering_fixed = RotationalComponents.Components.Fixed() {^steering_fixed}
  car = VehicleSystemsComponents.Vehicle.Planar.PlanarCar(radius = radius, mu_scale_fl = mu_scale_front, mu_scale_fr = mu_scale_front, h_cg = h_cg, load_transfer = load_transfer) {^car}
  sensors = VehicleSystemsComponents.Vehicle.Planar.PlanarCarSensors(radius = radius) {^sensors}
  esp = VehicleSystemsComponents.Vehicle.Planar.ESPController(Kp = Kp, Ki = Ki, T_build = T_build, radius = radius) {^esp}
relations
  connect(steer.y, wheel_pos.phi_ref) {^w1}
  connect(wheel_pos.spline, car.steering) {^w2}
  connect(wheel_pos.support, steering_fixed.spline) {^w3}
  connect(car.chassis, sensors.chassis) {^w4}
  connect(car.steering, sensors.steering) {^w5}
  connect(car.wheel_fl, sensors.wheel_fl) {^w6}
  connect(car.wheel_fr, sensors.wheel_fr) {^w7}
  connect(car.wheel_rl, sensors.wheel_rl) {^w8}
  connect(car.wheel_rr, sensors.wheel_rr) {^w9}
  connect(car.spin_fl, sensors.spin_fl) {^w10}
  connect(car.spin_fr, sensors.spin_fr) {^w11}
  connect(car.spin_rl, sensors.spin_rl) {^w12}
  connect(car.spin_rr, sensors.spin_rr) {^w13}
  connect(sensors.delta_sw, esp.delta_sw) {^w14}
  connect(sensors.r, esp.r) {^w15}
  connect(sensors.vx, esp.vx) {^w16}
  car.tau_fl = esp_on * max(0.0, esp.dT_fl)
  car.tau_fr = esp_on * max(0.0, esp.dT_fr)
  car.tau_rl = esp_on * max(0.0, esp.dT_rl)
  car.tau_rr = esp_on * max(0.0, esp.dT_rr)
  initial car.body.r = [0, 0]
  initial car.body.v = [v0, 0]
  initial car.body.phi = 0.0
  initial car.body.w = 0.0
  initial car.fl.inertia.w = (v0 + 0.01) / radius
  initial car.fr.inertia.w = (v0 + 0.01) / radius
  initial car.rl.inertia.w = (v0 + 0.01) / radius
  initial car.rr.inertia.w = (v0 + 0.01) / radius
  initial car.fl.inertia.phi = 0.0
  initial car.fr.inertia.phi = 0.0
  initial car.rl.inertia.phi = 0.0
  initial car.rr.inertia.phi = 0.0
  initial car.fl.brake.tau_actual = 0.0
  initial car.fr.brake.tau_actual = 0.0
  initial car.rl.brake.tau_actual = 0.0
  initial car.rr.brake.tau_actual = 0.0
  initial wheel_pos.w = 0.0
metadata {
  "Dyad": {
    "tests": {
      "front_low_mu": {
        "solver": "Tsit5", "stop": 8.0,
        "params": {"load_transfer": false},
        "expect": {"signals": ["sensors.r", "sensors.vx", "esp.r_ref", "car.tau_fl", "car.tau_fr", "car.tau_rl", "car.tau_rr"]}
      }
    }
  },
  "_links": {
    "steer": {"Dyad": {"placement": {"diagram": {"x1": 100, "y1": 250, "x2": 200, "y2": 350}}}},
    "wheel_pos": {"Dyad": {"placement": {"diagram": {"x1": 300, "y1": 250, "x2": 400, "y2": 350}}}},
    "steering_fixed": {"Dyad": {"placement": {"diagram": {"x1": 300, "y1": 400, "x2": 400, "y2": 500}}}},
    "car": {"Dyad": {"placement": {"diagram": {"x1": 650, "y1": 500, "x2": 950, "y2": 800}}}},
    "sensors": {"Dyad": {"placement": {"diagram": {"x1": 1100, "y1": 500, "x2": 1400, "y2": 800}}}},
    "esp": {"Dyad": {"placement": {"diagram": {"x1": 50, "y1": 550, "x2": 350, "y2": 850}}}},
    "w1": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w2": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 800, "y": 300}], "E": 2}]}},
    "w3": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w4": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w5": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 800, "y": 460}, {"x": 1250, "y": 460}], "E": 2}]}},
    "w6": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w7": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w8": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w9": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w10": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w11": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w12": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w13": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w14": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1440, "y": 530}, {"x": 1440, "y": 60}, {"x": 20, "y": 60}, {"x": 20, "y": 625}], "E": 2}]}},
    "w15": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1470, "y": 560}, {"x": 1470, "y": 30}, {"x": -10, "y": 30}, {"x": -10, "y": 700}], "E": 2}]}},
    "w16": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1500, "y": 590}, {"x": 1500, "y": 0}, {"x": -40, "y": 0}, {"x": -40, "y": 775}], "E": 2}]}}
  }
}
end

analysis ESPSteerRampTransient
  extends TransientAnalysis(stop = 8.0, alg = ODEAlg.Tsit5(), dtmax = 0.005)
  parameter v0::Velocity = 22.22222222222222
  parameter delta_sw_final::Angle = 1.7671458676442586
  parameter t_ramp::Time = 7.5
  parameter t_steer::Time = 0.5
  parameter mu_scale_front::Real = 0.7
  parameter esp_on::Real = 1.0
  parameter Kp::Real = 40000.0
  parameter Ki::Real = 0.0
  parameter T_build::Time = 0.1
  parameter h_cg::Length = 0.0
  model = VehicleSystemsComponents.Lecture3.ESPSteerRamp(v0 = v0, delta_sw_final = delta_sw_final, t_ramp = t_ramp, t_steer = t_steer, mu_scale_front = mu_scale_front, esp_on = esp_on, Kp = Kp, Ki = Ki, T_build = T_build, h_cg = h_cg)
relations
end
