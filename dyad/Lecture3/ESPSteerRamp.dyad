    "w14": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 935, "y": 400.0}, {"x": 935, "y": 650}, {"x": 110, "y": 650}, {"x": 110, "y": 430.0}], "E": 2}]}},
    "w17": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 366, "y": 420.0}, {"x": 366, "y": 375.0}], "E": 2}]}},
