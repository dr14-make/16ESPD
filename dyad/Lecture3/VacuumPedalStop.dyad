"""
Lecture 3 demo bench: hands-on 03's `PedalStop` with the vacuum booster in place of the static
one, drawing on the engine's air path at a prescribed throttle and engine speed, or on an
electric vacuum pump.

`engine_on = 0` stops the engine, so the manifold sits at ambient and the check valve stays
shut. `n_apply` is the number of full applications the driver has already made since the vacuum
source was lost, with the car parked. Each one lets the rear chamber fill to atmosphere at a
piston travel of `x_full`, and its release mixes that air into the front chamber, so the
booster starts the stop at

    p_atm - max(0, β^n (p_atm - p_vac0) - γ (1 - β^n) / (1 - β)),
    β = V_f0 / (V_f0 + V_r0),  γ = p_atm A_d x_full / (V_f0 + V_r0)

which is the mass balance `BrakeVacuumReserveTransient` simulates, at a fixed travel.
"""
component VacuumPedalStop
  parameter pedal::Real = 0.3
  parameter road_mu::Real = 1.0
  "Throttle position: 0 closed (idle), 1 wide open"
  parameter u_thr::Real = 0.0
  "Engine running: 1 on, 0 off (manifold at ambient)"
  parameter engine_on::Real = 1.0
  "Engine speed while running, 83.776 rad/s = 800 rpm"
  parameter omega_e::AngularVelocity = 83.776
  "Full applications made before the stop with no vacuum supply"
  parameter n_apply::Real = 0.0
  "Vacuum source: 0 the intake manifold, 1 an electric pump"
  parameter ev_pump::Real = 0.0
  "Booster front-chamber pressure before those applications [Pa] (PATH idle)"
  parameter p_vac0::Pressure = 33e3
  "Piston travel of a full application [m] (derived from BrakeVacuumReserveTransient)"
  parameter x_full::Length = 8.0e-3
  final parameter p_atm::Pressure = 101325.0
  final parameter beta::Real = 2.4e-3 / (2.4e-3 + 0.43e-3)
  final parameter gamma::Pressure = p_atm * 0.0533 * x_full / (2.4e-3 + 0.43e-3)
  final parameter p_start::Pressure = p_atm - max(0.0, beta ^ n_apply * (p_atm - p_vac0) - gamma * (1.0 - beta ^ n_apply) / (1.0 - beta))
  command = BlockComponents.Sources.Step(height = pedal, offset = 0.0, start_time = 0.5) {^command}
  road = BlockComponents.Sources.Constant(k = road_mu) {^road}
  throttle = BlockComponents.Sources.Constant(k = u_thr) {^throttle}
  speed = BlockComponents.Sources.Constant(k = engine_on * omega_e) {^speed}
  air = VehicleSystemsComponents.Vehicle.Engine.AirPath() {^air}
  pump = VehicleSystemsComponents.Vehicle.Brake.ElectricVacuumPump(p_init = p_start) {^pump}
  pedal_unit = VehicleSystemsComponents.Vehicle.Brake.BrakePedal() {^pedal_unit}
  booster = VehicleSystemsComponents.Vehicle.Brake.VacuumBooster(p_init = p_start) {^booster}
  master = VehicleSystemsComponents.Vehicle.Brake.TandemMasterCylinder() {^master}
  line_f = VehicleSystemsComponents.Vehicle.Brake.BrakeLine() {^line_f}
  line_r = VehicleSystemsComponents.Vehicle.Brake.BrakeLine(L = 4.0) {^line_r}
  wheel = VehicleSystemsComponents.Vehicle.Wheel.HydraulicBrakedWheel() {^wheel}
  body = VehicleSystemsComponents.HandsOn.Body() {^body}
  fixed = RotationalComponents.Components.Fixed() {^fixed}
  fixed_hydraulic = TranslationalComponents.Components.Fixed() {^fixed_hydraulic}
  speed_sensor = TranslationalComponents.Sensors.VelocitySensor() {^speed_sensor}
  path medium::HydraulicComponents.Interfaces.AbstractMedium = HydraulicComponents.IsothermalCompressible(bulk_modulus = 1.4e9, density = 1045.0, let_gas = false)
relations
  connect(command.y, pedal_unit.u) {^id1}
  connect(pedal_unit.rod, booster.input) {^id2}
  connect(booster.rod_out, master.pushrod) {^id3}
  connect(pedal_unit.support, booster.support, master.support, fixed_hydraulic.flange) {^id4}
  connect(master.front, line_f.port_a) {^id5}
  connect(line_f.port_b, wheel.front) {^id6}
  connect(master.rear, line_r.port_a) {^id7}
  connect(line_r.port_b, wheel.rear) {^id8}
  continuity(medium, master.front.medium)
  connect(road.y, wheel.mu_scale) {^id9}
  connect(wheel.support, fixed.spline) {^id10}
  connect(wheel.flange, body.flange, speed_sensor.flange) {^id11}
  connect(throttle.y, air.u_thr) {^id12}
  connect(speed.y, air.omega) {^id13}
  connect(booster.p_vac, pump.p_sense)
  booster.p_src = ifelse(ev_pump > 0.5, pump.p, air.p_m)
  air.mdot_bst = ifelse(ev_pump > 0.5, 0.0, booster.mdot_out)
  pump.mdot_in = ifelse(ev_pump > 0.5, booster.mdot_out, 0.0)
  initial air.manifold.p = ifelse(engine_on > 0.5, 32955.7, p_atm)
  initial wheel.inertia.phi = 0
  initial wheel.inertia.w = 25 / 0.31
  initial body.mass.s = 0
  initial body.mass.v = 25
metadata {
  "_links": {
    "throttle": {"Dyad": {"placement": {"diagram": {"x1": -150, "y1": -150, "x2": -50, "y2": -50}}}},
    "speed": {"Dyad": {"placement": {"diagram": {"x1": -150, "y1": 0, "x2": -50, "y2": 100}}}},
    "air": {"Dyad": {"placement": {"diagram": {"x1": 50, "y1": -150, "x2": 150, "y2": -50}}}},
    "pump": {"Dyad": {"placement": {"diagram": {"x1": 390, "y1": -150, "x2": 490, "y2": -50}}}},
    "command": {"Dyad": {"placement": {"diagram": {"x1": -150, "y1": 150, "x2": -50, "y2": 250}}}},
    "pedal_unit": {"Dyad": {"placement": {"diagram": {"x1": 50, "y1": 150, "x2": 150, "y2": 250}}}},
    "booster": {"Dyad": {"placement": {"diagram": {"x1": 220, "y1": 150, "x2": 320, "y2": 250}}}},
    "master": {"Dyad": {"placement": {"diagram": {"x1": 390, "y1": 150, "x2": 490, "y2": 250}}}},
    "line_f": {"Dyad": {"placement": {"diagram": {"x1": 560, "y1": 80, "x2": 660, "y2": 180}}}},
    "line_r": {"Dyad": {"placement": {"diagram": {"x1": 560, "y1": 250, "x2": 660, "y2": 350}}}},
    "wheel": {"Dyad": {"placement": {"diagram": {"x1": 730, "y1": 130, "x2": 930, "y2": 330}}}},
    "body": {"Dyad": {"placement": {"diagram": {"x1": 1050, "y1": 180, "x2": 1150, "y2": 280}}}},
    "speed_sensor": {"Dyad": {"placement": {"diagram": {"x1": 1050, "y1": 20, "x2": 1150, "y2": 120}}}},
    "road": {"Dyad": {"placement": {"diagram": {"x1": 560, "y1": 500, "x2": 660, "y2": 600}}}},
    "fixed": {"Dyad": {"placement": {"diagram": {"x1": 760, "y1": 500, "x2": 860, "y2": 600}}}},
    "fixed_hydraulic": {"Dyad": {"placement": {"diagram": {"x1": 250, "y1": 500, "x2": 350, "y2": 600}}}},
    "id1": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "id2": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "id3": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "id4": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 300, "y": 420}], "E": -1}, {"S": -1, "M": [], "E": 2}, {"S": -1, "M": [], "E": 3}, {"S": -1, "M": [], "E": 4}], "junctions": [{"x": 300, "y": 420}]}},
    "id5": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 525, "y": 175}], "E": 2}]}},
    "id6": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 695, "y": 130}], "E": 2}]}},
    "id7": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 525, "y": 300}], "E": 2}]}},
    "id8": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 695, "y": 300}], "E": 2}]}},
    "id9": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 810, "y": 550}], "E": 2}]}},
    "id10": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "id11": {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [], "E": 2}, {"S": -1, "M": [{"x": 990, "y": 70}], "E": 3}], "junctions": [{"x": 990, "y": 230}]}},
    "id12": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "id13": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 0, "y": 50}, {"x": 0, "y": -70}], "E": 2}]}}
  }
}
end

analysis VacuumPedalStopTransient
  extends TransientAnalysis(stop = 6.0, alg = ODEAlg.Tsit5(), dtmax = 1e-3)
  parameter pedal::Real = 0.3
  parameter road_mu::Real = 1.0
  parameter u_thr::Real = 0.0
  parameter engine_on::Real = 1.0
  parameter omega_e::AngularVelocity = 83.776
  parameter n_apply::Real = 0.0
  parameter ev_pump::Real = 0.0
  parameter p_vac0::Pressure = 33e3
  model = VacuumPedalStop(pedal = pedal, road_mu = road_mu, u_thr = u_thr, engine_on = engine_on, omega_e = omega_e, n_apply = n_apply, ev_pump = ev_pump, p_vac0 = p_vac0)
end
