end

analysis ESPSineWithDwellTransient
  extends TransientAnalysis(stop = 6.0, alg = ODEAlg.Tsit5(), dtmax = 0.005, optimize = OptimizationLevel.None())
  parameter A_sw::Angle = 0.5585053606381855
  parameter v0::Velocity = 22.22222222222222
  parameter esp_on::Real = 1.0
  parameter abs_on::Real = 0.0
  parameter Kp::Real = 40000.0
  parameter Ki::Real = 0.0
  parameter T_build::Time = 0.1
  parameter R_build::Real = 1.0e9
  parameter select_low::Real = 1.0
  parameter mu_scale_right::Real = 1.0
  parameter T_cmd::Torque = 0.0
  parameter k_dec::Real = 40000.0
  parameter k_inc_fast::Real = 160000.0
  parameter k_inc_slow::Real = 16000.0
  parameter h_cg::Length = 0.0
  model = VehicleSystemsComponents.Lecture3.ESPSineWithDwell(A_sw = A_sw, v0 = v0, esp_on = esp_on, abs_on = abs_on, Kp = Kp, Ki = Ki, T_build = T_build, R_build = R_build, select_low = select_low, mu_scale_right = mu_scale_right, T_cmd = T_cmd, k_dec = k_dec, k_inc_fast = k_inc_fast, k_inc_slow = k_inc_slow, h_cg = h_cg)
relations
end
