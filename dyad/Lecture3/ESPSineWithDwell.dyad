"""Planar car with ESP and an optional sampled four-channel ABS path."""
test component ESPSineWithDwell
  parameter A_sw::Angle = 0.5585053606381855
  parameter v0::Velocity = 22.22222222222222
  parameter esp_on::Real = 1.0
  parameter abs_on::Real = 0.0
  parameter Kp::Real = 40000.0
  parameter Ki::Real = 0.0
  parameter T_build::Time = 0.1
  parameter R_build::Real = 1.0e9
  parameter radius::Length = 0.31
  parameter select_low::Real = 1.0
  parameter mu_scale_right::Real = 1.0
  parameter T_cmd::Torque = 0.0
  parameter k_dec::Real = 40000.0
  parameter k_inc_fast::Real = 160000.0
  parameter k_inc_slow::Real = 16000.0
  parameter h_cg::Length = 0.0
  structural parameter load_transfer::Boolean = true
  steer = VehicleSystemsComponents.Vehicle.Planar.SineWithDwell(A = A_sw) {^steer}
  demand = BlockComponents.Sources.Step(offset = 0.0, height = T_cmd, start_time = 0.5) {^demand}
  steering_robot = VehicleSystemsComponents.Vehicle.Planar.SteeringRobot() {^steering_robot}
  car = VehicleSystemsComponents.Vehicle.Planar.PlanarCar(radius = radius, mu_scale_fr = mu_scale_right, mu_scale_rr = mu_scale_right, h_cg = h_cg, load_transfer = load_transfer) {^car}
  sensors = VehicleSystemsComponents.Vehicle.Planar.PlanarCarSensors(radius = radius) {^sensors}
  ecu = VehicleSystemsComponents.Vehicle.Planar.BrakeControlUnit(esp_on = esp_on, abs_on = abs_on, Kp = Kp, Ki = Ki, T_build = T_build, R_build = R_build, radius = radius, select_low = select_low, k_dec = k_dec, k_inc_fast = k_inc_fast, k_inc_slow = k_inc_slow) {^ecu}
relations
  connect(steer.y, steering_robot.delta_sw_ref) {^w1}
  connect(steering_robot.steering, car.steering) {^w2}
  connect(car.chassis, sensors.chassis) {^w4}
  connect(car.steering, sensors.steering) {^w5}
  connect(car.wheel_fl, sensors.wheel_fl) {^w6}
  connect(car.wheel_fr, sensors.wheel_fr) {^w7}
  connect(car.wheel_rl, sensors.wheel_rl) {^w8}
  connect(car.wheel_rr, sensors.wheel_rr) {^w9}
  connect(car.spin_fl, sensors.spin_fl) {^w10}
  connect(car.spin_fr, sensors.spin_fr) {^w11}
  connect(car.spin_rl, sensors.spin_rl) {^w12}
  connect(car.spin_rr, sensors.spin_rr) {^w13}
  connect(demand.y, ecu.demand) {^w14}
  connect(sensors.delta_sw, ecu.delta_sw) {^w15}
  connect(sensors.r, ecu.r) {^w16}
  connect(sensors.vx, ecu.vx) {^w17}
  connect(sensors.kappa_fl, ecu.kappa_fl) {^w18}
  connect(sensors.kappa_fr, ecu.kappa_fr) {^w19}
  connect(sensors.kappa_rl, ecu.kappa_rl) {^w20}
  connect(sensors.kappa_rr, ecu.kappa_rr) {^w21}
  connect(ecu.tau_fl, car.tau_fl) {^w22}
  connect(ecu.tau_fr, car.tau_fr) {^w23}
  connect(ecu.tau_rl, car.tau_rl) {^w24}
  connect(ecu.tau_rr, car.tau_rr) {^w25}
  initial car.body.r = [0, 0]
  initial car.body.v = [v0, 0]
  initial car.body.phi = 0.0
  initial car.body.w = 0.0
  initial car.fl.inertia.w = (v0 + 0.01) / radius
  initial car.fr.inertia.w = (v0 + 0.01) / radius
  initial car.rl.inertia.w = (v0 + 0.01) / radius
  initial car.rr.inertia.w = (v0 + 0.01) / radius
  initial car.fl.inertia.phi = 0.0
  initial car.fr.inertia.phi = 0.0
  initial car.rl.inertia.phi = 0.0
  initial car.rr.inertia.phi = 0.0
  initial car.fl.brake.tau_actual = 0.0
  initial car.fr.brake.tau_actual = 0.0
  initial car.rl.brake.tau_actual = 0.0
  initial car.rr.brake.tau_actual = 0.0
metadata {
  "Dyad": {
    "tests": {
      "esp_32deg": {
        "solver": "Tsit5", "stop": 6.0,
        "params": {"load_transfer": false, "A_sw": 0.5585053606381855},
        "expect": {"signals": ["sensors.vx", "sensors.r", "sensors.y", "sensors.beta", "ecu.esp.r_ref", "car.tau_fl", "car.tau_fr", "car.tau_rl", "car.tau_rr"]}
      }
    }
  },
  "_links": {
    "car": {"Dyad": {"placement": {"diagram": {"x1": 440, "y1": 380, "x2": 640, "y2": 580}}}},
    "sensors": {"Dyad": {"placement": {"diagram": {"x1": 700, "y1": 380, "x2": 900, "y2": 580}}}},
    "steer": {"Dyad": {"placement": {"diagram": {"x1": 30, "y1": 210, "x2": 110, "y2": 290}}}},
    "steering_robot": {"Dyad": {"placement": {"diagram": {"x1": 180, "y1": 200, "x2": 280, "y2": 300}}}},
    "ecu": {"Dyad": {"placement": {"diagram": {"x1": 180, "y1": 380, "x2": 380, "y2": 580}}}},
