"""Passive planar car in the FMVSS 126 sine-with-dwell maneuver."""
test component SineWithDwellRun
  "Steering-wheel amplitude"
  parameter A_sw::Angle = 0.5585053606381855
  "Initial vehicle speed (FMVSS 126)"
  parameter v0::Velocity = 22.22222222222222
  "Wheel radius (repository default)"
  parameter radius::Length = 0.31
  parameter h_cg::Length = 0.0
  structural parameter load_transfer::Boolean = true
  steer = VehicleSystemsComponents.Vehicle.Planar.SineWithDwell(A = A_sw) {^steer}
  zero = BlockComponents.Sources.Constant(k = 0.0) {^zero}
  steering_robot = VehicleSystemsComponents.Vehicle.Planar.SteeringRobot() {^steering_robot}
  car = VehicleSystemsComponents.Vehicle.Planar.PlanarCar(radius = radius, h_cg = h_cg, load_transfer = load_transfer) {^car}
relations
  connect(steer.y, steering_robot.delta_sw_ref) {^w1}
  connect(steering_robot.steering, car.steering) {^w2}
  connect(zero.y, car.tau_fl, car.tau_fr, car.tau_rl, car.tau_rr) {^w14}
  initial car.body.r = [0, 0]
  initial car.body.v = [v0, 0]
  initial car.body.phi = 0.0
  initial car.body.w = 0.0
  initial car.fl.inertia.w = (v0 + 0.01) / radius
  initial car.fr.inertia.w = (v0 + 0.01) / radius
  initial car.rl.inertia.w = (v0 + 0.01) / radius
  initial car.rr.inertia.w = (v0 + 0.01) / radius
  initial car.fl.inertia.phi = 0.0
  initial car.fr.inertia.phi = 0.0
  initial car.rl.inertia.phi = 0.0
  initial car.rr.inertia.phi = 0.0
  initial car.fl.brake.tau_actual = 0.0
  initial car.fr.brake.tau_actual = 0.0
  initial car.rl.brake.tau_actual = 0.0
  initial car.rr.brake.tau_actual = 0.0
metadata {
  "Dyad": {
    "tests": {
      "swd_32deg": {
        "solver": "Tsit5", "stop": 6.0,
        "params": {"load_transfer": false, "A_sw": 0.5585053606381855},
        "atol": {"car.bus.vx": 0.1, "car.bus.psi": 0.02},
        "expect": {"final": {"car.bus.vx": 22.0753, "car.bus.psi": -0.1039}, "signals": ["car.bus.vx", "car.bus.r", "car.bus.y", "car.bus.psi", "car.bus.beta", "car.bus.delta_sw"]}
      },
      "swd_270deg": {
        "solver": "Tsit5", "stop": 6.0,
        "params": {"load_transfer": false, "A_sw": 4.71238898038469},
        "atol": {"car.bus.vx": 0.1, "car.bus.psi": 0.02},
        "expect": {"final": {"car.bus.vx": 19.6498, "car.bus.psi": -0.2229}, "signals": ["car.bus.vx", "car.bus.r", "car.bus.y", "car.bus.psi", "car.bus.beta", "car.bus.delta_sw"]}
      }
    }
  },
  "_links": {
    "car": {"Dyad": {"placement": {"diagram": {"x1": 440, "y1": 380, "x2": 640, "y2": 580}}}},
    "steer": {"Dyad": {"placement": {"diagram": {"x1": 30, "y1": 210, "x2": 110, "y2": 290}}}},
    "steering_robot": {"Dyad": {"placement": {"diagram": {"x1": 180, "y1": 200, "x2": 280, "y2": 300}}}},
    "zero": {"Dyad": {"placement": {"diagram": {"x1": 280, "y1": 450, "x2": 340, "y2": 510}}}},
    "w1": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w2": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 540.0, "y": 250.0}], "E": 2}]}},
    "w14": {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 400, "y": 420.0}], "E": 2}, {"S": -1, "M": [{"x": 400, "y": 460.0}], "E": 3}, {"S": -1, "M": [{"x": 400, "y": 500.0}], "E": 4}, {"S": -1, "M": [{"x": 400, "y": 540.0}], "E": 5}], "junctions": [{"x": 400, "y": 480.0}]}}
  }
}
end

analysis SineWithDwellRunTransient
  extends TransientAnalysis(stop = 6.0, alg = ODEAlg.Tsit5(), dtmax = 0.005, optimize = OptimizationLevel.None())
  parameter A_sw::Angle = 0.5585053606381855
  parameter v0::Velocity = 22.22222222222222
  parameter h_cg::Length = 0.0
  model = VehicleSystemsComponents.Lecture3.SineWithDwellRun(A_sw = A_sw, v0 = v0, h_cg = h_cg)
relations
end
