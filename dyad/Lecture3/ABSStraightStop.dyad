"""Four-channel ABS stop from 80 km/h on a uniform dry road."""
test component ABSStraightStop
  parameter v0::Velocity = 22.22222222222222
  parameter T_cmd::Torque = 2500.0
  parameter brake_time::Time = 0.5
  parameter radius::Length = 0.31
  parameter select_low::Real = 0.0
  parameter k_dec::Real = 40000.0
  parameter k_inc_fast::Real = 160000.0
  parameter k_inc_slow::Real = 16000.0
  parameter h_cg::Length = 0.0
  structural parameter load_transfer::Boolean = true
  steer = BlockComponents.Sources.Constant(k = 0.0)
  demand = BlockComponents.Sources.Step(offset = 0.0, height = T_cmd, start_time = brake_time)
  zero = BlockComponents.Sources.Constant(k = 0.0)
  wheel_pos = RotationalComponents.Sources.Position()
  steering_fixed = RotationalComponents.Components.Fixed()
  car = VehicleSystemsComponents.Vehicle.Planar.PlanarCar(radius = radius, h_cg = h_cg, load_transfer = load_transfer)
  sensors = VehicleSystemsComponents.Vehicle.Planar.PlanarCarSensors(radius = radius)
  clock = DiscreteComponents.PeriodicClock(dt = 0.005)
  demand_sampler = DiscreteComponents.Sampler()
  speed_sampler = DiscreteComponents.Sampler()
  kappa_fl_sampler = DiscreteComponents.Sampler()
  kappa_fr_sampler = DiscreteComponents.Sampler()
  kappa_rl_sampler = DiscreteComponents.Sampler()
  kappa_rr_sampler = DiscreteComponents.Sampler()
  dT_fl_sampler = DiscreteComponents.Sampler()
  dT_fr_sampler = DiscreteComponents.Sampler()
  dT_rl_sampler = DiscreteComponents.Sampler()
  dT_rr_sampler = DiscreteComponents.Sampler()
  abs = VehicleSystemsComponents.Vehicle.Planar.FourChannelABS(select_low = select_low, k_dec = k_dec, k_inc_fast = k_inc_fast, k_inc_slow = k_inc_slow)
  hold_fl = DiscreteComponents.ZeroOrderHold()
  hold_fr = DiscreteComponents.ZeroOrderHold()
  hold_rl = DiscreteComponents.ZeroOrderHold()
  hold_rr = DiscreteComponents.ZeroOrderHold()
relations
  connect(steer.y, wheel_pos.phi_ref)
  connect(wheel_pos.spline, car.steering)
  connect(wheel_pos.support, steering_fixed.spline)
  connect(car.chassis, sensors.chassis)
  connect(car.steering, sensors.steering)
  connect(car.wheel_fl, sensors.wheel_fl)
  connect(car.wheel_fr, sensors.wheel_fr)
  connect(car.wheel_rl, sensors.wheel_rl)
  connect(car.wheel_rr, sensors.wheel_rr)
  connect(car.spin_fl, sensors.spin_fl)
  connect(car.spin_fr, sensors.spin_fr)
  connect(car.spin_rl, sensors.spin_rl)
  connect(car.spin_rr, sensors.spin_rr)
  connect(demand.y, demand_sampler.u)
  connect(sensors.vx, speed_sampler.u)
  connect(sensors.kappa_fl, kappa_fl_sampler.u)
  connect(sensors.kappa_fr, kappa_fr_sampler.u)
  connect(sensors.kappa_rl, kappa_rl_sampler.u)
  connect(sensors.kappa_rr, kappa_rr_sampler.u)
  connect(zero.y, dT_fl_sampler.u, dT_fr_sampler.u, dT_rl_sampler.u, dT_rr_sampler.u)
  connect(demand_sampler.y, abs.demand, clock.y)
  connect(speed_sampler.y, abs.v_ref)
  connect(kappa_fl_sampler.y, abs.kappa_fl)
  connect(kappa_fr_sampler.y, abs.kappa_fr)
  connect(kappa_rl_sampler.y, abs.kappa_rl)
  connect(kappa_rr_sampler.y, abs.kappa_rr)
  connect(dT_fl_sampler.y, abs.dT_fl)
  connect(dT_fr_sampler.y, abs.dT_fr)
  connect(dT_rl_sampler.y, abs.dT_rl)
  connect(dT_rr_sampler.y, abs.dT_rr)
  connect(abs.tau_fl, hold_fl.u)
  connect(abs.tau_fr, hold_fr.u)
  connect(abs.tau_rl, hold_rl.u)
  connect(abs.tau_rr, hold_rr.u)
  connect(hold_fl.y, car.tau_fl)
  connect(hold_fr.y, car.tau_fr)
  connect(hold_rl.y, car.tau_rl)
  connect(hold_rr.y, car.tau_rr)
  initial car.body.r = [0, 0]
  initial car.body.v = [v0, 0]
  initial car.body.phi = 0.0
  initial car.body.w = 0.0
  initial car.fl.inertia.w = (v0 + 0.01) / radius
  initial car.fr.inertia.w = (v0 + 0.01) / radius
  initial car.rl.inertia.w = (v0 + 0.01) / radius
  initial car.rr.inertia.w = (v0 + 0.01) / radius
  initial car.fl.inertia.phi = 0.0
  initial car.fr.inertia.phi = 0.0
  initial car.rl.inertia.phi = 0.0
  initial car.rr.inertia.phi = 0.0
  initial car.fl.brake.tau_actual = 0.0
  initial car.fr.brake.tau_actual = 0.0
  initial car.rl.brake.tau_actual = 0.0
  initial car.rr.brake.tau_actual = 0.0
  initial wheel_pos.w = 0.0
metadata {
  "Dyad": {
    "tests": {
      "dry_stop": {
        "solver": "Tsit5", "stop": 6.0,
        "params": {"load_transfer": false},
        "atol": {"sensors.x": 0.5, "sensors.vx": 0.05},
        "expect": {"final": {"sensors.x": 47.182, "sensors.vx": 0.0}, "signals": ["sensors.x", "sensors.vx", "sensors.r", "sensors.kappa_fl", "sensors.kappa_rl", "hold_fl.y", "hold_rl.y"]}
      }
    }
  }
}
end

analysis ABSStraightStopTransient
  extends TransientAnalysis(stop = 6.0, alg = ODEAlg.Tsit5(), dtmax = 0.005)
  parameter v0::Velocity = 22.22222222222222
  parameter T_cmd::Torque = 2500.0
  parameter select_low::Real = 0.0
  parameter k_dec::Real = 40000.0
  parameter k_inc_fast::Real = 160000.0
  parameter k_inc_slow::Real = 16000.0
  parameter h_cg::Length = 0.0
  model = VehicleSystemsComponents.Lecture3.ABSStraightStop(v0 = v0, T_cmd = T_cmd, select_low = select_low, k_dec = k_dec, k_inc_fast = k_inc_fast, k_inc_slow = k_inc_slow, h_cg = h_cg)
relations
end
