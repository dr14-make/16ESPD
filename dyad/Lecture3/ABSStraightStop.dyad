"""Four-channel ABS stop from 80 km/h on a uniform dry road."""
test component ABSStraightStop
  parameter v0::Velocity = 22.22222222222222
  parameter T_cmd::Torque = 2500.0
  parameter brake_time::Time = 0.5
  parameter radius::Length = 0.31
  parameter select_low::Real = 0.0
  parameter k_dec::Real = 40000.0
  parameter k_inc_fast::Real = 160000.0
  parameter k_inc_slow::Real = 16000.0
  parameter h_cg::Length = 0.0
  structural parameter load_transfer::Boolean = true
  steer = BlockComponents.Sources.Constant(k = 0.0) {^steer}
  demand = BlockComponents.Sources.Step(offset = 0.0, height = T_cmd, start_time = brake_time) {^demand}
  zero = BlockComponents.Sources.Constant(k = 0.0) {^zero}
  steering_robot = VehicleSystemsComponents.Vehicle.Planar.SteeringRobot() {^steering_robot}
  car = VehicleSystemsComponents.Vehicle.Planar.PlanarCar(radius = radius, h_cg = h_cg, load_transfer = load_transfer) {^car}
  motion = VehicleSystemsComponents.Vehicle.Planar.BusMotion() {^motion}
  slips = VehicleSystemsComponents.Vehicle.Planar.BusSlip() {^slips}
  abs = VehicleSystemsComponents.Vehicle.Planar.ABSUnit(select_low = select_low, k_dec = k_dec, k_inc_fast = k_inc_fast, k_inc_slow = k_inc_slow) {^abs}
relations
  connect(car.bus, motion.bus, slips.bus) {^wbus}
  connect(steer.y, steering_robot.delta_sw_ref) {^w1}
  connect(steering_robot.steering, car.steering) {^w2}
  connect(demand.y, abs.demand) {^w14}
  connect(motion.vx, abs.vx) {^w15}
  connect(slips.kappa_fl, abs.kappa_fl) {^w16}
  connect(slips.kappa_fr, abs.kappa_fr) {^w17}
  connect(slips.kappa_rl, abs.kappa_rl) {^w18}
  connect(slips.kappa_rr, abs.kappa_rr) {^w19}
  connect(zero.y, abs.dT_fl, abs.dT_fr, abs.dT_rl, abs.dT_rr) {^w20}
  connect(abs.tau_fl, car.tau_fl) {^w35}
  connect(abs.tau_fr, car.tau_fr) {^w36}
  connect(abs.tau_rl, car.tau_rl) {^w37}
  connect(abs.tau_rr, car.tau_rr) {^w38}
  initial car.body.r = [0, 0]
  initial car.body.v = [v0, 0]
  initial car.body.phi = 0.0
  initial car.body.w = 0.0
  initial car.fl.inertia.w = (v0 + 0.01) / radius
  initial car.fr.inertia.w = (v0 + 0.01) / radius
  initial car.rl.inertia.w = (v0 + 0.01) / radius
  initial car.rr.inertia.w = (v0 + 0.01) / radius
  initial car.fl.inertia.phi = 0.0
  initial car.fr.inertia.phi = 0.0
  initial car.rl.inertia.phi = 0.0
  initial car.rr.inertia.phi = 0.0
  initial car.fl.brake.tau_actual = 0.0
  initial car.fr.brake.tau_actual = 0.0
  initial car.rl.brake.tau_actual = 0.0
  initial car.rr.brake.tau_actual = 0.0
metadata {
  "Dyad": {
    "tests": {
      "dry_stop": {
        "solver": "Tsit5", "stop": 6.0,
        "params": {"load_transfer": false},
        "atol": {"car.bus.x": 0.5, "car.bus.vx": 0.05},
        "expect": {"final": {"car.bus.x": 47.182, "car.bus.vx": 0.0}, "signals": ["car.bus.x", "car.bus.vx", "car.bus.r", "car.bus.kappa_fl", "car.bus.kappa_rl", "abs.hold_fl.y", "abs.hold_rl.y"]}
      }
    }
  },
  "_links": {
    "motion": {"Dyad": {"placement": {"diagram": {"x1": 720, "y1": 400, "x2": 820, "y2": 600}}}},
    "slips": {"Dyad": {"placement": {"diagram": {"x1": 720, "y1": 660, "x2": 820, "y2": 760}}}},
    "wbus": {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [], "E": 2}, {"S": -1, "M": [{"x": 690, "y": 710}], "E": 3}], "junctions": [{"x": 690, "y": 500}]}},
    "car": {"Dyad": {"placement": {"diagram": {"x1": 450, "y1": 400, "x2": 650, "y2": 600}}}},
    "steer": {"Dyad": {"placement": {"diagram": {"x1": 30, "y1": 210, "x2": 110, "y2": 290}}}},
    "steering_robot": {"Dyad": {"placement": {"diagram": {"x1": 180, "y1": 200, "x2": 280, "y2": 300}}}},
    "abs": {"Dyad": {"placement": {"diagram": {"x1": 160, "y1": 390, "x2": 360, "y2": 590}}}},
    "demand": {"Dyad": {"placement": {"diagram": {"x1": 30, "y1": 320, "x2": 90, "y2": 380}}}},
    "zero": {"Dyad": {"placement": {"diagram": {"x1": 30, "y1": 420, "x2": 90, "y2": 480}}}},
    "w1": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w2": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 550, "y": 250}], "E": 2}]}},
    "w14": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 150, "y": 350}, {"x": 150, "y": 410.0}], "E": 2}]}},
    "w19": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 930, "y": 740.0}, {"x": 930, "y": 790}, {"x": 240.0, "y": 790}], "E": 2}]}},
    "w18": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 940, "y": 720.0}, {"x": 940, "y": 800}, {"x": 200.0, "y": 800}], "E": 2}]}},
    "w17": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 950, "y": 700.0}, {"x": 950, "y": 810}, {"x": 140, "y": 810}, {"x": 140, "y": 550.0}], "E": 2}]}},
    "w16": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 960, "y": 680.0}, {"x": 960, "y": 820}, {"x": 130, "y": 820}, {"x": 130, "y": 530.0}], "E": 2}]}},
    "w15": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 970, "y": 452.0}, {"x": 970, "y": 830}, {"x": 120, "y": 830}, {"x": 120, "y": 510.0}], "E": 2}]}},
    "w20": {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 145, "y": 430.0}], "E": 2}, {"S": -1, "M": [], "E": 3}, {"S": -1, "M": [], "E": -2}, {"S": -2, "M": [], "E": 4}, {"S": -2, "M": [{"x": 145, "y": 490.0}], "E": 5}], "junctions": [{"x": 145, "y": 450.0}, {"x": 145, "y": 470.0}]}},
    "w35": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w36": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 420, "y": 470.0}, {"x": 420, "y": 365}, {"x": 660, "y": 365}, {"x": 660, "y": 430}], "E": 2}]}},
    "w37": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 400, "y": 510.0}, {"x": 400, "y": 530}], "E": 2}]}},
    "w38": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 420, "y": 550.0}, {"x": 420, "y": 650}, {"x": 660, "y": 650}, {"x": 660, "y": 530}], "E": 2}]}}
  }
}
end

analysis ABSStraightStopTransient
  extends TransientAnalysis(stop = 6.0, alg = ODEAlg.Tsit5(), dtmax = 0.005, optimize = OptimizationLevel.None())
  parameter v0::Velocity = 22.22222222222222
  parameter T_cmd::Torque = 2500.0
  parameter select_low::Real = 0.0
  parameter k_dec::Real = 40000.0
  parameter k_inc_fast::Real = 160000.0
  parameter k_inc_slow::Real = 16000.0
  parameter h_cg::Length = 0.0
  model = VehicleSystemsComponents.Lecture3.ABSStraightStop(v0 = v0, T_cmd = T_cmd, select_low = select_low, k_dec = k_dec, k_inc_fast = k_inc_fast, k_inc_slow = k_inc_slow, h_cg = h_cg)
relations
end
