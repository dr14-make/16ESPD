"""
Dry-road stop of `FullCarABSStop` from the 90 km/h cruise.

Rodas5P: the hydraulic lines, valve flows and booster chambers make the system stiff, and Tsit5
goes unstable on it; dtmax 1 ms resolves the valve cycling. The car is at rest by 3.8 s (4.1 s with
`abs_on = 0`). About a second into standstill the reference-speed estimator's `ifelse` chatters
about zero and the step count climbs steeply, so the run ends shortly after the stop.
"""
analysis FullCarABSStopTransient
  extends TransientAnalysis(stop = 4.5, alg = ODEAlg.Rodas5P(), dtmax = 1e-3, saveat = 0.001, tstops = [0.5], abstol = 1e-5, reltol = 1e-5)
  parameter pedal::Real = 0.6
  parameter road_mu::Real = 1.0
  parameter ev_pump::Real = 0.0
  parameter p_vac0::Pressure = 54420
  parameter abs_on::Real = 1.0
  model = FullCarABSStop(pedal = pedal, road_mu = road_mu, ev_pump = ev_pump, p_vac0 = p_vac0, abs_on = abs_on)
end

"""
Low-µ (0.3) stop of `FullCarABSStop` for the report: at rest by 10.2 s with ABS, 11.5 s with
`abs_on = 0` (pass a longer `stop`). Rodas5P for the same stiffness as `FullCarABSStopTransient`.
"""
analysis FullCarABSStopReportTransient
  extends TransientAnalysis(stop = 11.0, alg = ODEAlg.Rodas5P(), dtmax = 1e-3, saveat = 0.001, tstops = [0.5], abstol = 1e-5, reltol = 1e-5)
  parameter pedal::Real = 0.6
  parameter road_mu::Real = 0.3
  parameter ev_pump::Real = 0.0
  parameter p_vac0::Pressure = 54420
  parameter abs_on::Real = 1.0
  model = FullCarABSStop(pedal = pedal, road_mu = road_mu, ev_pump = ev_pump, p_vac0 = p_vac0, abs_on = abs_on)
end
