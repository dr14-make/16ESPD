"""
Dry-road stop of `FullCarABSStop` from the 90 km/h cruise at the pedal that locks the wheel
without ABS. Pass `abs_on = 0` for the locked stop, and on a low-µ road a longer `stop`.

Tsit5 with dtmax 1 ms, as `ABSStopTransient`: the valves are not stiff.
"""
analysis FullCarABSStopTransient
  extends TransientAnalysis(stop = 6.0, alg = ODEAlg.Tsit5(), dtmax = 1e-3)
  parameter pedal::Real = 0.6
  parameter road_mu::Real = 1.0
  parameter abs_on::Real = 1.0
  model = FullCarABSStop(pedal = pedal, road_mu = road_mu, abs_on = abs_on)
end
