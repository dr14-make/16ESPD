    "w7": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 775, "y": 280}, {"x": 775, "y": 680}], "E": 2}]}},
    "w8": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 495, "y": 420}], "E": 2}]}},
    "w9": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w10": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w11": {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [], "E": 3}, {"S": 2, "M": [{"x": 795, "y": 135}], "E": -1}], "junctions": [{"x": 795, "y": 616}]}},
    "w12": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w13": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w14": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w15": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w16": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w17": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w18": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w19": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w20": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w21": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "w22": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 104, "y": 340}, {"x": 300, "y": 340}, {"x": 300, "y": 190}], "E": 2}]}},
    "w23": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 455, "y": 150}, {"x": 455, "y": 370}], "E": 2}]}},
    "w24": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 440, "y": 190}], "E": -1}, {"S": -1, "M": [], "E": 2}, {"S": -1, "M": [{"x": 440, "y": 664}], "E": 3}], "junctions": [{"x": 440, "y": 632}]}}
  }
}
end

analysis BEVWLTCTransient
  extends TransientAnalysis(stop = 1800.0, alg = ODEAlg.Rodas5P(), dtmax = 1.0, optimize = OptimizationLevel.None())
  parameter k::Real = 50.0
  parameter Ti::Time = 2.0
  parameter v_fade::Real = 10.0
  parameter P_aux::Power = 300.0
  model = BEVWLTC(k = k, Ti = Ti, v_fade = v_fade, P_aux = P_aux)
end
