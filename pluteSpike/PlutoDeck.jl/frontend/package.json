{
  "name": "@plutodeck/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "The PlutoDeck frontend: TypeScript and Lit, bundled into frontend-dist/ by esbuild.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@lit/context": "1.1.6",
    "@plutojl/rainbow": "0.6.21",
    "lit": "3.3.3",
    "marked": "18.0.13",
    "mathjax": "3.2.2"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-lit": "2.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
